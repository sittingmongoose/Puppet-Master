.claude/debug/
.cache/
.npm/

# Build outputs
target/
**/target/
dist/
coverage/
node_modules/

# Local browser/test capture output and disposable work areas
.playwright-mcp/
.tmp/
scratchpad/
# Audit history stays local except the current work item's published evidence bundle
# (WNC-R07): Plans/.audits/wnc-20260905/{implementation,audit} are tracked so the
# delivery's coverage, findings, and gate records are fetchable.
Plans/.audits/
!Plans/.audits/
Plans/.audits/*
!Plans/.audits/wnc-20260905
Plans/.audits/wnc-20260905/*
!Plans/.audits/wnc-20260905/implementation/
!Plans/.audits/wnc-20260905/audit/
tests/
# Keep reusable packet/custody regressions visible without admitting bulk evidence.
!/tests/
/tests/*
!/tests/test_pm_forge_backup_acceptance.py
!/tests/test_pm_touch_closure_source.py
!/tests/test_pm_packet_audit_verdicts.py
!/tests/test_pm_packet_audit_census.py
!/tests/test_pm_working_notebook_contracts.py
Concepts/**/evidence/
**/simulator_runs/
**/staged_windows_build*/
**/traces/
**/frames/
**/contact-sheets/

# Large generated media/archive artifacts belong in LFS or release storage
*.mkv
*.mov
*.mp4
*.webm
*.zip
# Compiled binaries: the R9 staged Windows builds are ~94MB each and are
# reproducible build output, not source. No .exe has ever been tracked here.
*.exe

# Local env/secrets
.env
.env.*
!.env.example
local.json
**/local.json

# Volatile Puppet Master runtime data
.puppet-master/
!tests/fixtures/project_output_artifacts/s2_011/golden/minimal_project/.puppet-master/
!tests/fixtures/project_output_artifacts/s2_011/golden/minimal_project/.puppet-master/**
transfer_state/
codex_goal_transfer_kit/

# Python cache
