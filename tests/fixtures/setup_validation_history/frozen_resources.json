      "producer_sequence_id": {
        "$ref": "#/$defs/nullable_non_negative_integer"
      },
      "correlation_id": {
        "$ref": "#/$defs/non_empty_string"
      },
      "causation_event_id": {
        "$ref": "#/$defs/nullable_non_empty_string"
      },
      "parent_event_id": {
        "$ref": "#/$defs/nullable_non_empty_string"
      },
      "idempotency_key": {
        "$ref": "#/$defs/non_empty_string"
      },
      "payload_schema_id": {
        "$ref": "#/$defs/non_empty_string"
      },
      "payload": {
        "type": "object",
        "additionalProperties": true
      },
      "payload_ref": {
        "$ref": "#/$defs/nullable_non_empty_string"
      },
      "redaction_profile": {
        "type": "string",
        "enum": [
          "no_secrets",
          "redacted",
          "secret_refs_only"
        ]
      },
      "replay_policy": {
        "type": "string",
        "enum": [
          "append_once",
          "dedupe_by_event_id",
          "dedupe_by_idempotency_key",
          "projector_replay_only"
        ]
      },
      "migration": {
        "$ref": "#/$defs/migration"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "scope_kind": {
              "const": "application"
            }
          },
          "required": [
            "scope_kind"
          ]
        },
        "then": {
          "properties": {
            "project_id": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "scope_kind": {
              "const": "project"
            }
          },
          "required": [
            "scope_kind"
          ]
        },
        "then": {
          "properties": {
            "project_id": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        }
      }
    ],
