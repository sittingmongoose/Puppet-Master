      "thread_id",
      "run_id",
      "node_id",
      "attempt_id",
      "actor_ref",
      "requested_account_ref",
      "effective_account_ref",
      "occurred_at_utc",
      "observed_at_utc",
      "persisted_at_utc",
      "sequence_id",
      "producer_sequence_id",
      "correlation_id",
      "causation_event_id",
      "parent_event_id",
      "idempotency_key",
      "payload_schema_id",
