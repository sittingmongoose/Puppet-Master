{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "selected_source_id", "execution_proven", "source_ids"],
  "properties": {
    "unit_id": {"type": "string", "enum": ["canary_evidence_02"]},
    "selected_source_id": {"type": "string", "enum": ["S1", "S2"]},
    "execution_proven": {"type": "boolean"},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "string", "enum": ["S1", "S2"]}
    }
  }
}
