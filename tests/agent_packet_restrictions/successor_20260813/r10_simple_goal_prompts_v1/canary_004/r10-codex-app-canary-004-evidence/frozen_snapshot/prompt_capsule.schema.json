{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/experiments/r10/prompt_capsule.schema.json",
  "title": "R10 Simple PromptCapsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "profile_id",
    "unit_id",
    "workflow_family",
    "objective",
    "admitted_context",
    "constraints",
    "output_contract",
    "lineage"
  ],
  "properties": {
    "schema_id": {"const": "pm.r10.prompt_capsule.v1"},
    "profile_id": {"const": "r10-simple-4k-v1"},
    "unit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "workflow_family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 768},
    "admitted_context": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/context_block"}
    },
    "constraints": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/constraint"}
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_sha256", "inline_schema"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "inline_schema": {
          "type": "object",
          "required": ["$schema", "type", "additionalProperties", "required", "properties"],
          "properties": {
            "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
            "type": {"const": "object"},
            "additionalProperties": {"const": false},
            "required": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "properties": {"type": "object", "minProperties": 1}
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_source_ids"],
      "properties": {
        "allowed_source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[1-9][0-9]{0,2}$"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "authority", "text", "utf8_bytes", "text_sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^S[1-9][0-9]{0,2}$"},
        "authority": {
          "type": "string",
          "enum": ["canonical_excerpt", "runtime_fact", "fixture_fact", "source_lineage_only", "untrusted_input"]
        },
        "text": {"type": "string", "minLength": 1, "maxLength": 1024},
        "utf8_bytes": {"type": "integer", "minimum": 1, "maximum": 1024},
        "text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "text", "source_ids"],
      "properties": {
        "constraint_id": {"type": "string", "pattern": "^C[1-9][0-9]{0,2}$"},
        "kind": {"type": "string", "enum": ["positive", "negative"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[1-9][0-9]{0,2}$"}
        }
      }
    }
  }
}
