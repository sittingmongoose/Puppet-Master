{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "selected_source_id", "capsule_grants_dispatch", "source_ids"],
  "properties": {
    "unit_id": {"type": "string"},
    "selected_source_id": {"type": "string", "enum": ["S1", "S2"]},
    "capsule_grants_dispatch": {"type": "boolean"},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["S1", "S2"]}
    }
  }
}
