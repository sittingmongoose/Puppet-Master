{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "authority",
    "reviewed_base",
    "fingerprint_scope",
    "nodes"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.event_datetime_inventory.v1"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_base": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint_scope": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "origin",
          "pointer",
          "resource_pointer",
          "resource_id",
          "fields",
          "resource_sha256",
          "node_sha256",
          "profile",
          "classification",
          "owner",
          "citation",
          "role_evidence"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^(?:/|$)"
          },
          "resource_pointer": {
            "type": "string",
            "pattern": "^(?:/|$)"
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "observed_at_utc",
                "persisted_at_utc"
              ]
            }
          },
          "resource_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "node_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "profile": {
            "enum": [
              "storage_utc_z",
              "owner_schema"
            ]
          },
          "classification": {
            "enum": [
              "EventRecord",
              "event_record_index",
              "original_storage_fields",
              "Storage issued original fields",
              "other_owner_observation",
              "source_lineage_schema_patch"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "owner_profile": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "path",
                    "quote"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 12
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "path",
                    "pointer",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pointer": {
                      "type": "string",
                      "pattern": "^(?:/|$)"
                    },
                    "value": {}
                  }
                }
              ]
            }
          },
          "role_evidence": {
            "type": "object",
            "required": [
              "resource_title",
              "schema_identity",
              "required"
            ],
            "additionalProperties": false,
            "properties": {
              "resource_title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "schema_identity": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
