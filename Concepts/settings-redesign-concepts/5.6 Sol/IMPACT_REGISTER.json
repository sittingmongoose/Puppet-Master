  "affected_concepts": [
    {
      "concept_id": "concept-01-index-house",
      "title": "5.6 Sol — Index House",
      "thesis": "Stable-address archive of settings, provenance, memory, policy, and delegated behavior.",
      "materially_affected": true,
      "distinct_thesis_preserved": true,
      "causal_effect": "Its archival records now consume compact/lazy manager data, sole-owner work/governor projections, corrected provider identity and bounded lifecycle behavior."
    },
    {
      "concept_id": "concept-02-switchboard",
      "title": "5.6 Sol — Switchboard",
      "thesis": "Quiet operational readiness surface for notifications, appearance, input, desktop, and help behavior.",
      "materially_affected": true,
      "distinct_thesis_preserved": true,
      "causal_effect": "Its signals now use truthful waits, finite hidden/preview motion, corrected provider policy, bounded detail and pressure projections."
    },
    {
      "concept_id": "concept-03-wayfinder",
      "title": "5.6 Sol — Wayfinder",
      "thesis": "Guided toolchain routes with explicit setup, verification, dependency, and recovery checkpoints.",
      "materially_affected": true,
      "distinct_thesis_preserved": true,
      "causal_effect": "Its setup checkpoints now enforce explicit official-source exact-Host/Environment provider consent, separate auth, current continuation and bounded work semantics."
    },
    {
      "concept_id": "concept-04-ledger",
      "title": "5.6 Sol — Ledger",
      "thesis": "Dense requested/effective and provenance folio for lifecycle, storage, source, and runtime systems.",
      "materially_affected": true,
      "distinct_thesis_preserved": true,
      "causal_effect": "Its folio now records truthful owner, generation, cache, persistence, pressure, provider and unresolved Server evidence without minting canon."
    }
  ],
  "causal_change_categories": [
    {
      "category": "runtime_owner_projection",
      "change": "RuntimeResourceGovernor is the sole resource/admission owner; ObservableWork is the sole progress/wait owner; Settings cards are projections only."
    },
    {
      "category": "compact_startup_and_lazy_detail",
      "change": "Home/search use compact metadata and selected manager detail is dynamically imported; startup/search do not hydrate or probe every provider, tool, Server or resource."
    },
    {
      "category": "bounded_cache_subscription_and_lists",
      "change": "Manager caches are byte-bounded with inactive eviction, heavy subscriptions are reference-counted/released, and list windows mount at most 40 rows."
    },
    {
      "category": "compact_persistence_and_render_deltas",
      "change": "Persistence is compact, debounced, byte-limited and transient-aware; rendering uses frame-coalesced latest-wins narrow patches with concept counters."
    },
    {
      "category": "provider_acquisition_auth_and_identity",
      "change": "First acquisition requires explicit official-source exact-Host/Environment consent; authentication is separate; requests coalesce; stale continuations fail closed; normal GUI is humanized and raw identities move to Advanced Details."
    },
    {
      "category": "truthful_state_pressure_and_motion",
      "change": "Deterministic work/pressure profiles preserve cached content and essential controls without false hardware claims; hidden/inactive clocks stop and reduced motion keeps semantic parity."
    },
    {
      "category": "coverage_candidates_and_tests",
      "change": "All four concepts gained 47-row matrices, corrected candidate artifacts, a 22-test causal state contract, a 12-test string/CSS render contract, and a Firefox-focused W3C harness."
    }
  ],
