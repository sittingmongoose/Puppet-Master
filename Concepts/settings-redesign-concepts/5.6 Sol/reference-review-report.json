  "material_impacts": {
    "governor_and_progress": {
      "material": true,
      "required_correction": "RuntimeResourceGovernor remains the only resource/admission owner; host enforcement consumes the same contract and is not a second governor. ObservableWork remains the only truthful progress/wait owner; concept cards and rows are projections only. Permit and work-state grammar now distinguishes queue, wait, degraded, permission/resource blocks, cancellation, terminal and recovery states without fabricated percentages."
    },
    "startup_lazy_hydration_and_search": {
      "material": true,
      "required_correction": "Settings Home and search use compact metadata; selected manager/detail data hydrates lazily; startup must not probe every provider/tool/server/resource; search uses latest-generation currentness and must not instantiate all managers."
    },
    "virtualization_subscriptions_persistence_and_render": {
      "material": true,
      "required_correction": "Large manager/catalog/search fixtures use bounded list windows, inactive detail surfaces unsubscribe or release shared refcounts, caches are byte-bounded, transient search/filter/drag/input is not persisted, persistence is compact and debounced, and frame-coalesced narrow patches replace avoidable full-scene renders."
    },
    "provider_policy_identity_and_continuation": {
      "material": true,
      "required_correction": "No provider CLI is bundled, baseline-preseeded or silently acquired by Project/model/provider/Goal/Plan/WorkNode/agent/Auto/On. First acquisition requires explicit human action, official source and exact Host/Environment; authentication is separate; post-consent lifecycle is allowed; GUI identity is humanized; continuation token/generation and installation identity reject stale or wrong-target resume."
    },
    "manager_coverage_and_states": {
      "material": true,
      "required_correction": "All assigned manager families require compact summaries, lazy detail, truthful dormant/loading/ready/stale/offline/error/managed/degraded states, deterministic large-catalog fixtures and no eager startup ownership."
    },
    "motion": {
      "material": true,
      "required_correction": "Hidden/off-screen surfaces stop decorative clocks; reduced motion retains semantic results; rapid navigation cancels superseded motion; frame activity and sound-wave animations must settle without ongoing hidden work."
    },
    "candidate_reports_and_tests": {
      "material": true,
      "required_correction": "Each concept's impact, manager coverage, candidate command, candidate wiring, candidate DRY and Plan-owner reports require correction-domain traceability. Browser, state, performance, loading/error/offline/managed, provider-policy, motion and accessibility evidence must be rerun; deterministic browser fixtures are not native Slint or physical-hardware proof."
    }
  },
