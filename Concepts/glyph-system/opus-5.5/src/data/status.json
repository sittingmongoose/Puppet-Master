 "extra": {
  "warning": {
   "glyph": "st-warning",
   "tone": "attention",
   "label": "warning",
   "meaning": "Something needs care, but nothing has failed: degraded, low quota, setup incomplete. The triangle (GLY-1).",
   "example": "Quota at 92 % this week"
  },
  "offline": {
   "glyph": "st-offline",
   "tone": "attention",
   "label": "offline",
   "meaning": "A service, provider or machine that should answer cannot be reached.",
   "example": "Codex provider unreachable"
  },
  "off": {
   "glyph": "st-off",
   "tone": "paused",
   "label": "off",
   "meaning": "Not set up, disabled or not installed: nothing is running and nothing is wrong. Drawn as the power symbol; a barred ring reads as no entry (blocked).",
   "example": "GitHub sync not set up"
  },
  "info": {
   "glyph": "st-info",
   "tone": "paused",
   "label": "info",
   "meaning": "A neutral notice: nothing is wrong and nothing is asked.",
   "example": "Syncing the project index"
  },
  "change-added": {
   "glyph": "change-added",
   "tone": "done",
   "label": "added",
   "meaning": "A new file or item (editor, source control, document history). Not a run state.",
   "example": "src/rail/menu.ts"
  },
  "change-modified": {
   "glyph": "change-modified",
   "tone": "changed",
   "label": "modified",
   "meaning": "Changed since it was saved or committed; also the dirty tab mark.",
   "example": "src/rail/menu.ts"
  },
  "change-deleted": {
   "glyph": "change-deleted",
   "tone": "blocked",
   "label": "deleted",
   "meaning": "Removed.",
   "example": "src/rail/legacy.ts"
  },
  "change-renamed": {
   "glyph": "change-renamed",
   "tone": "changed",
   "label": "renamed",
   "meaning": "Renamed or moved.",
   "example": "src/rail/index.ts"
  },
  "change-conflict": {
   "glyph": "change-conflict",
   "tone": "blocked",
   "label": "conflict",
   "meaning": "Two changes collide and someone must choose (a merge conflict). Not a run state.",
   "example": "src/rail/menu.ts"
  }
 },
 "meaning": {
  "waiting": "Needs you: a question, a permission, a sign-in, a choice. Leads every list.",
  "blocked": "Cannot go on until something outside it changes (stalled, locked, no access).",
  "failed": "Ended in an error. A ring with a cross (GLY-1); the triangle is warning's.",
  "recovering": "Retrying or taking a fallback route on its own.",
  "reviewing": "Checking or verifying work.",
  "working": "Running now.",
  "waiting-dep": "Waiting on something else to finish first (a dependency or a build window).",
  "pending": "Queued or next; it will start on its own.",
  "mixed": "Partly done, partly not (some checks passed, some failed).",
  "complete": "Finished successfully.",
  "paused": "Stopped on purpose; it can resume.",
  "skipped": "Will not run: cancelled, expired, stale or set aside.",
  "idle": "Ready; nothing is happening."
 },
