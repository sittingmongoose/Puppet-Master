// pm_loading_shimmer.slint - PuppetMaster loading indicator ("Shimmer Sweep")
// Generated by Concepts/Fableicon/generate.py - do not hand-edit.
// Slint 1.17: SVGs render statically via resvg (CSS-in-SVG animation is ignored),
// so this component re-creates the motion natively with layered images.
// Defaults are the friendly-dark palette; override the color properties per theme.
// The browser reference implementation is icons/animated/ + the dashboard Mix Lab.

// Note: the browser version sweeps a 20-degree diagonal band; this native
// re-creation sweeps a vertical band (a redesign, not a 1:1 port).
export component PmLoadingShimmer {
    in property <length> size: 44px;
    in property <color> tile-color: #322E3A;
    in property <color> mark-color: #C3B1E4;
    in property <color> string-color: #6FC6E8;
    in property <length> tile-radius: self.size * 8 / 43.2;
    width: size; height: size;
    in property <duration> period: 1700ms;
    in property <float> band-alpha: 0.35; // 0.55 on light themes
    property <float> t: Math.mod(animation-tick() / 1ms, root.period / 1ms) / (root.period / 1ms);
    // sweep during the first 55% of the cycle, rest for the remainder
    property <float> sweep: Math.min(root.t / 0.55, 1.0);

    Rectangle {
        width: 100%; height: 100%;
        background: root.tile-color;
        border-radius: root.tile-radius;
        clip: true;

        Image { source: @image-url("layers/pm-layer-bracketL.svg"); colorize: root.mark-color; width: 100%; height: 100%; }
        Image { source: @image-url("layers/pm-layer-bracketR.svg"); colorize: root.mark-color; width: 100%; height: 100%; }
        Image { source: @image-url("layers/pm-layer-glyphM.svg"); colorize: root.mark-color; width: 100%; height: 100%; }
        Image { source: @image-url("layers/pm-layer-glyphP.svg"); colorize: root.mark-color; width: 100%; height: 100%; }
        Image { source: @image-url("layers/pm-layer-pkeyline.svg"); colorize: root.tile-color; width: 100%; height: 100%; }
        // puppet strings as native rectangles (height-animatable)
        Rectangle { x: root.size * 14.42/43.2; y: root.size * 15.6/43.2; width: root.size * 0.97/43.2; height: root.size * 8.59/43.2; border-radius: self.width/2; background: root.string-color; }
        Rectangle { x: root.size * 28.85/43.2; y: root.size * 16.28/43.2; width: root.size * 0.97/43.2; height: root.size * 12.18/43.2; border-radius: self.width/2; background: root.string-color; }

        Rectangle {
            width: root.size * 0.42;
            height: 100%;
            x: -self.width + (root.size + 2 * self.width) * root.sweep;
            background: @linear-gradient(90deg,
                rgba(255,255,255,0) 0%,
                rgba(255,255,255,root.band-alpha) 50%,
                rgba(255,255,255,0) 100%);
        }
    }
}
