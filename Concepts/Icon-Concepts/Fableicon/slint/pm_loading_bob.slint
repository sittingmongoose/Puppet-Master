// pm_loading_bob.slint - PuppetMaster loading indicator ("Marionette Bob")
// Generated by Concepts/Fableicon/generate.py - do not hand-edit.
// Slint 1.17: SVGs render statically via resvg (CSS-in-SVG animation is ignored),
// so this component re-creates the motion natively with layered images.
// Defaults are the friendly-dark palette; override the color properties per theme.
// The browser reference implementation is icons/animated/ + the dashboard Mix Lab.

export component PmLoadingBob {
    in property <length> size: 44px;
    in property <color> tile-color: #322E3A;
    in property <color> mark-color: #C3B1E4;
    in property <color> string-color: #6FC6E8;
    in property <length> tile-radius: self.size * 8 / 43.2;
    width: size; height: size;
    in property <duration> period: 1200ms;
    property <angle> phase: 360deg * (animation-tick() / root.period);
    property <float> oscP: Math.sin(root.phase);
    property <float> oscM: Math.sin(root.phase + 180deg);

    Rectangle {
        width: 100%; height: 100%;
        background: root.tile-color;
        border-radius: root.tile-radius;
        clip: true;

        Image { source: @image-url("layers/pm-layer-bar.svg"); colorize: root.mark-color; width: 100%; height: 100%; }
        Image { source: @image-url("layers/pm-layer-bracketL.svg"); colorize: root.mark-color; width: 100%; height: 100%; }
        Image { source: @image-url("layers/pm-layer-bracketR.svg"); colorize: root.mark-color; width: 100%; height: 100%; }

        Image { source: @image-url("layers/pm-layer-glyphM.svg"); colorize: root.mark-color; width: 100%; height: 100%;
                y: root.oscM * root.size * 1.2/43.2; }
        Image { source: @image-url("layers/pm-layer-glyphP.svg"); colorize: root.mark-color; width: 100%; height: 100%;
                y: root.oscP * root.size * 1.2/43.2; }
        Image { source: @image-url("layers/pm-layer-pkeyline.svg"); colorize: root.tile-color; width: 100%; height: 100%;
                y: root.oscP * root.size * 1.2/43.2; }

        // strings stretch from their tops to stay attached to the letters
        Rectangle { x: root.size * 14.42/43.2; y: root.size * 15.6/43.2;
            width: root.size * 0.97/43.2;
            height: root.size * 8.59/43.2 + root.oscP * root.size * 1.2/43.2;
            border-radius: self.width/2; background: root.string-color; }
        Rectangle { x: root.size * 28.85/43.2; y: root.size * 16.28/43.2;
            width: root.size * 0.97/43.2;
            height: root.size * 12.18/43.2 + root.oscM * root.size * 1.2/43.2;
            border-radius: self.width/2; background: root.string-color; }
    }
}
