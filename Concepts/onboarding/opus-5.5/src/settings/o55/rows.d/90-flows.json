{
 "_about": "Inventory actions that used to open a generic panel: each now routes to the page that does it, or runs a small flow (kit.d/65-flows.js).",
 "rows": {
  "ai.accounts.github-connect": {
   "label": "GitHub connection",
   "actionLabel": "Open Source Control",
   "route": {
    "domain": "source",
    "workspace": "source-manager"
   },
   "routeToast": [
    "GitHub is set up in Source Control",
    "Connect or disconnect it with the other code services."
   ]
  },
  "branching.subagents.agent-control-envelope": {
   "actionLabel": "See the rules helpers get",
   "flow": {
    "kind": "list",
    "icon": "lock",
    "listTitle": "Every helper starts with",
    "intro": "Frozen before its first call; a helper can never loosen it.",
    "items": [
     {
      "label": "How freely it may act",
      "help": "Same as the chat that started it, or stricter",
      "value": "Regular"
     },
     {
      "label": "What it may write",
      "help": "Only its own workspace",
      "value": "Workspace only"
     },
     {
      "label": "Models",
      "help": "The helper model in Models, with its fallbacks",
      "value": "Claude Sonnet"
     },
     {
      "label": "Tools",
      "help": "Everything the parent has, minus web writes",
      "value": "24 tools"
     },
     {
      "label": "Budget",
      "help": "Stops when it has used this much",
      "value": "$2.00 per helper"
     }
    ]
   }
  },
  "branching.worktrees.clean-all-worktrees": {
   "actionLabel": "Remove all workspaces",
   "danger": true,
   "flow": {
    "kind": "confirm",
    "danger": true,
    "primary": "Remove all 4",
    "message": "Removes every AI workspace in this project: feature/recipe-scaling, fix/pagination, try/new-parser and chat-8812. Work that was never merged is lost. Your own branches and the main checkout are not touched.",
    "done": [
     "Workspaces removed",
     "4 workspaces are gone."
    ]
   }
  },
  "branching.worktrees.clean-workspace-now": {
   "actionLabel": "Clean this workspace",
   "flow": {
    "kind": "check",
    "icon": "trash",
    "primary": "Clean it",
    "summary": "Removes files that are not tracked and not ignored on purpose. Tracked changes are kept.",
    "steps": [
     {
      "title": "Find stray files",
      "desc": "target/, .cache/ and 38 other files",
      "result": "Found 40"
     },
     {
      "title": "Keep anything you marked to keep",
      "desc": ".env.local is kept",
      "result": "Kept 1"
     },
     {
      "title": "Remove the rest",
      "desc": "Moved to the trash first, so you can undo",
      "result": "Removed 39"
     }
    ],
    "outcome": "39 stray files removed"
   }
  },
  "branching.worktrees.recovery-tools": {
   "actionLabel": "Open recovery tools",
   "flow": {
    "kind": "list",
    "icon": "restore",
    "listTitle": "What went wrong?",
    "intro": "Pick what matches. Each one undoes safely instead of asking you to type git commands.",
    "items": [
     {
      "label": "A merge stopped halfway",
      "help": "Puts the branch back where it was before the merge",
      "action": "Undo the merge",
      "doneText": "The branch is back where it was."
     },
     {
      "label": "A workspace has no branch any more",
      "help": "Finds workspaces whose branch was deleted",
      "value": "2 found",
      "action": "Tidy them up",
      "doneText": "2 orphaned workspaces removed."
     },
     {
      "label": "I committed to the wrong branch",
      "help": "Moves your last commit to a new branch",
      "action": "Move my last commit",
      "doneText": "Moved to a new branch: rescue/last-commit."
     },
     {
      "label": "Something is locked",
      "help": "Clears a stale git lock left by a crash",
      "action": "Clear the lock",
      "doneText": "The lock is cleared."
     }
    ]
   }
  },
  "branching.worktrees.thread-worktree-binding": {
   "actionLabel": "Set up this chat's workspace",
   "flow": {
    "kind": "form",
    "icon": "branch",
    "primary": "Save",
    "summary": "Where this chat's changes are made. Status: clean, 2 commits ahead of main.",
    "fields": [
     {
      "key": "where",
      "label": "This chat works in",
      "type": "select",
      "options": [
       [
        "own",
        "Its own workspace (chat-8812)"
       ],
       [
        "main",
        "The main checkout"
       ],
       [
        "other",
        "Another workspace"
       ]
      ]
     },
     {
      "key": "branch",
      "label": "Branch name",
      "value": "chat/8812-recipe-scaling",
      "mono": true
     },
     {
      "key": "cleanup",
      "label": "Remove the workspace when the chat is archived",
      "type": "toggle",
      "value": true
     },
     {
      "key": "pr",
      "label": "Open a pull request when the work is done",
      "type": "toggle",
      "value": false
     }
    ]
   }
  },
  "code.execution.edit-publisher-xml": {
   "actionLabel": "Edit the publisher profile",
   "flow": {
    "kind": "form",
    "icon": "edit",
    "size": "wide",
    "primary": "Save profile",
    "fields": [
     {
      "key": "name",
      "label": "Publisher name",
      "value": "Tastebook"
     },
     {
      "key": "site",
      "label": "Support page",
      "value": "https://github.com/sittingmongoose/tastebook",
      "mono": true
     },
     {
      "key": "icon",
      "label": "Icon address",
      "placeholder": "https://…/icon.png",
      "mono": true
     },
     {
      "key": "xml",
      "label": "Other fields (raw ca_profile.xml)",
      "type": "textarea",
      "mono": true,
      "rows": 8,
      "value": "<Maintainer>\n  <Donate>https://…</Donate>\n  <Forum>https://forums.unraid.net/…</Forum>\n</Maintainer>",
      "help": "Only for fields the form above does not cover."
     }
