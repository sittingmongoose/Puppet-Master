{
 "_about": "Inventory actions that used to open a generic panel: each now routes to the page that does it, or runs a small flow (kit.d/65-flows.js).",
 "rows": {
  "branching.subagents.agent-control-envelope": {
   "actionLabel": "See the rules helpers get",
   "flow": {
    "kind": "list",
    "icon": "lock",
    "listTitle": "Every helper starts with",
    "intro": "Frozen before its first call; a helper can never loosen it.",
    "items": [
     {
      "label": "How freely it may act",
      "help": "Same as the chat that started it, or stricter",
      "value": "Regular"
     },
     {
      "label": "What it may write",
      "help": "Only its own workspace",
      "value": "Workspace only"
     },
     {
      "label": "Models",
      "help": "The helper model in Models, with its fallbacks",
      "value": "Claude Sonnet"
     },
     {
      "label": "Tools",
      "help": "Everything the parent has, minus web writes",
      "value": "24 tools"
     },
     {
      "label": "Budget",
      "help": "Stops when it has used this much",
      "value": "$2.00 per helper"
     }
    ]
   }
  },
  "code.execution.edit-publisher-xml": {
   "actionLabel": "Edit the publisher profile",
   "flow": {
    "kind": "form",
    "icon": "edit",
    "size": "wide",
    "primary": "Save profile",
    "fields": [
     {
      "key": "name",
      "label": "Publisher name",
      "value": "Tastebook"
     },
     {
      "key": "site",
      "label": "Support page",
      "value": "https://github.com/sittingmongoose/tastebook",
      "mono": true
     },
     {
      "key": "icon",
      "label": "Icon address",
      "placeholder": "https://…/icon.png",
      "mono": true
     },
     {
      "key": "xml",
      "label": "Other fields (raw ca_profile.xml)",
      "type": "textarea",
      "mono": true,
      "rows": 8,
      "value": "<Maintainer>\n  <Donate>https://…</Donate>\n  <Forum>https://forums.unraid.net/…</Forum>\n</Maintainer>",
      "help": "Only for fields the form above does not cover."
     }
    ]
   }
  },
  "code.execution.unraid-repo-setup": {
   "actionLabel": "Set up the template repository",
   "flow": {
    "kind": "form",
    "icon": "archive",
    "primary": "Set it up",
    "external": true,
    "fields": [
     {
      "key": "mode",
      "label": "Repository",
      "type": "select",
      "options": [
       [
        "new",
        "Make a new one"
       ],
       [
        "existing",
        "Use one I already have"
       ]
      ]
     },
     {
      "key": "repo",
      "label": "Repository address",
      "placeholder": "github.com/you/unraid-templates",
      "required": true,
      "mono": true
     },
     {
      "key": "branch",
      "label": "Branch",
      "value": "main",
      "mono": true
     },
     {
      "key": "folder",
      "label": "Templates folder",
      "value": "templates/",
      "mono": true
     },
     {
      "key": "push",
      "label": "Push new templates straight away",
      "type": "toggle",
      "value": false
     }
    ],
    "note": "Puppet Master checks the branch and folder layout before it pushes anything.",
    "done": [
     "Template repository set up",
     "Checked the branch and layout."
    ]
   }
  },
  "code.execution.unraid-review-state": {
   "actionLabel": "Check the template repository",
   "flow": {
    "kind": "check",
    "icon": "test",
    "primary": "Check it",
    "steps": [
     {
      "title": "Settings file",
      "desc": "templates/ca_profile.xml reads cleanly",
      "result": "OK"
     },
     {
      "title": "In step with GitHub",
      "desc": "1 commit behind origin/main",
      "result": "Behind",
      "resultTone": "attention"
     },
     {
      "title": "Unrelated changes",
      "desc": "None found",
      "result": "OK"
     }
    ],
    "outcome": "1 thing to fix: pull the latest commit"
   }
  },
  "general.interaction.settings-search": {
   "actionLabel": "Search settings",
   "pm51": "pm51-o55-focus-search"
  },
  "general.startup.reset-home-layout": {
   "actionLabel": "Reset Home layout",
   "flow": {
    "kind": "confirm",
    "primary": "Reset layout",
    "message": "Home panels, docks, the terminal position and floating windows go back to the default. Open files, terminal sessions, the browser, dashboard widgets and chats are kept.",
    "done": [
     "Home layout reset",
     "Everything is back in its default place."
    ]
   }
  },
  "general.visual.manage-custom-themes": {
   "actionLabel": "Manage your themes",
   "flow": {
    "kind": "list",
    "icon": "image",
    "listTitle": "Your themes",
    "empty": "No themes of your own yet. The eight built-in looks are under Appearance.",
    "items": [
     {
      "label": "Tastebook Night",
      "help": "Based on Glass Dark · made by you",
      "value": "Your theme",
      "action": "Use it",
      "doneTitle": "Theme applied",
      "remove": true
     },
     {
      "label": "High contrast warm",
      "help": "Imported from a file · 1 problem skipped",
      "value": "Imported",
      "action": "Use it",
      "doneTitle": "Theme applied",
      "remove": true
     }
    ],
    "add": {
     "title": "Add a theme",
     "label": "Add theme",
     "labelKey": "name",
     "helpKeys": [
      "base"
     ],
     "item": {
      "value": "Your theme",
      "action": "Use it",
      "doneTitle": "Theme applied",
      "remove": true
     },
     "fields": [
      {
       "key": "name",
       "label": "Name",
       "placeholder": "e.g. Soft paper",
       "required": true
      },
      {
       "key": "base",
       "label": "Start from",
       "type": "select",
       "options": [
        "Friendly Light",
        "Friendly Dark",
        "Glass Light",
        "Glass Dark",
        "Retro Light",
        "Retro Dark",
        "Basic Light",
        "Basic Dark",
        "A theme file"
       ]
      }
     ]
    }
   }
  },
