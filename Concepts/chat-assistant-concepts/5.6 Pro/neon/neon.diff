+/* ---- end of generated block ---- */
+
+/* ------------------------------------------------------------------ the ground */
+/* The pre-boot html colour-scheme is dark; the parchment ground follows the mode. */
+html[data-o55-nier="on"] body { background: var(--canvas); }
+
+/* ------------------------------------------------------------------ Orbit phase inks (motion.css --pm-step) */
+/* Thinking is the ink; reading and the web are the secondary ink; making is the olive; testing the warning ink; the
+   agents, skills and artifacts the umber; the shell and tools the muted ink. Failure keeps the rust to itself. */
+html[data-o55-nier="on"] [data-step-kind] { --pm-step: var(--accent); }
+html[data-o55-nier="on"] [data-step-kind]:is([data-step-kind="files"], [data-step-kind="web-search"], [data-step-kind="web-fetch"], [data-step-kind="browser"]) { --pm-step: var(--accent-2); }
+html[data-o55-nier="on"] [data-step-kind]:is([data-step-kind="edit"], [data-step-kind="app"], [data-step-kind="validate"], [data-step-kind="complete"], [data-step-kind="file"]) { --pm-step: var(--o55-nier-ok); }
+html[data-o55-nier="on"] [data-step-kind]:is([data-step-kind="test"], [data-step-kind="testing"]) { --pm-step: var(--o55-nier-warn); }
+html[data-o55-nier="on"] [data-step-kind]:is([data-step-kind="agents"], [data-step-kind="skill"], [data-step-kind="artifact"]) { --pm-step: var(--o55-nier-umber); }
+html[data-o55-nier="on"] [data-step-kind]:is([data-step-kind="bash"], [data-step-kind="mcp"]) { --pm-step: var(--muted); }
+
+/* ------------------------------------------------------------------ the NieR motion voice */
+/* NieR moves in Retro's stepped voice (app.js motionVoice), with Basic's durations: pmx's family block for retro is
+   keyed on body[data-theme^="retro"], which a painted Basic never matches, so its stepped eases are restated here
+   (pmx-system.js keys its token cache on the NieR attribute too). */
+html[data-o55-nier="on"] body[data-theme^="basic"] {
+  --pmx-ease-out: steps(4, jump-end); --pmx-ease-in: steps(3, jump-end); --pmx-ease-emph: steps(8, jump-end);
+  --pmx-ease-move: steps(6, jump-end); --pmx-ease-pop: steps(3, jump-end);
+}
+/* ------------------------------------------------------------------ nothing glows */
+/* NieR has no bloom: every coloured blur the default themes use as a glow (box-shadow 0 0 N, drop-shadow, a
+   text-shadow flash) is dropped under the contract; the shape and its ink carry the state alone. Retro's voice (the
+   NieR voice) keeps its stepped typing and blinking caret, without the phosphor flash or the caret's bloom; a word in
+   any other voice still fades in, stepped, without its blur and glow. */
+html[data-o55-nier="on"] [data-voice="retro"] .tx-w { animation: none; }
+html[data-o55-nier="on"] .tx-caret { box-shadow: none; }
+html[data-o55-nier="on"] .transcript:not([data-voice="retro"]) .tx-w { animation-name: o55n-word; animation-timing-function: steps(3, end); }
+@keyframes o55n-word { from { opacity: 0; } to { opacity: 1; } }
+html[data-o55-nier="on"] .sp-mark[data-state="live"] .sp-sat { filter: none; }
+html[data-o55-nier="on"] .sp-comet { filter: none; }
+html[data-o55-nier="on"] .orbit-node.live { box-shadow: none; }
+html[data-o55-nier="on"] .orbit-node.current { box-shadow: none; }
+html[data-o55-nier="on"] .orbit-node.waiting { box-shadow: none; }
+html[data-o55-nier="on"] .orbit-core { box-shadow: none; }
+html[data-o55-nier="on"] .orbit-core.waiting { box-shadow: none; }
+html[data-o55-nier="on"] .orbit-narration-mark { box-shadow: none; }
+html[data-o55-nier="on"] .brand-mark { background: var(--o55-nier-ink); box-shadow: none; }
+
+/* ------------------------------------------------------------------ surfaces that paint their own colour */
+/* Literal or gradient paint the token tables cannot reach, found by the palette audit (scratch nier-audit.mjs over
+   the app views and every pmx-verify surface): each becomes ink on parchment. */
+/* the user's turn is PMConcept7's chat bubble under NieR: an ink block with paper words (it turns over with the mode,
+   like every chosen thing in NieR); what sits inside it reads in paper too */
+html[data-o55-nier="on"] .message-user .message-surface { background: var(--o55-nier-ink); border-color: var(--o55-nier-ink); color: var(--o55-nier-on-ink); }
+html[data-o55-nier="on"] .transcript[data-variant="16"] .message-user .message-surface { background: var(--o55-nier-ink); border-color: var(--o55-nier-ink); }
+html[data-o55-nier="on"] .message-user .message-surface :where(*) { color: inherit; --nx-ink: var(--o55-nier-on-ink); }
