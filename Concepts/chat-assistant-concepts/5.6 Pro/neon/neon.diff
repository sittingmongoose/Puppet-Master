+++ b/send-stop.css
@@ -0,0 +1,376 @@
+/* send-stop.css — the composer's Send / Stop control, "solid-living" (step SS, 2026-10-02; Jared's pick of three).
+ * OWNER: Send/Stop (step SS). Markup, one-shots and the cadence switch: send-stop.js. Loaded in CSS_LAST right after
+ * neon-icons.css (build.py), so it settles ties with composer.css and the neon grammar; it replaces the composer.css
+ * send block, the styles.css .send-button hover lift (that rule now skips .sendstop) and nier.css's send rules.
+ *
+ * The chip stays SOLID: accent for Send and Queue, danger for Stop. It is the one primary action and must be found
+ * without looking; all the craft is in the glyph. One <path> is the plane outline in Send and the rounded square in
+ * Stop (CSS `d` interpolates point by point), the plane's fold becomes the square's inner tube highlight, two more
+ * layers carry the lift-off (ghost) and the queued plane (back). Layers in the chip (.ss-face, clipped to its radius):
+ * the accent fill, .ss-flood (the danger disc that floods out from the centre for Stop and drains back when it ends),
+ * the top sheen (::before), the failure flash (::after), the glyph svg. Behind the chip: two radial backlights
+ * (the chip's ::before in the accent, .ss-bl in the danger tone) at element opacity.
+ *
+ * The hero (Send click into a run), in order: 0-320 ms the plane lifts off along its heading (clipped by the chip);
+ * 140-480 ms a fresh plane slides in; 240-540 ms it morphs into the square ON THE ACCENT; from 420 ms the red floods
+ * out from under the square (half way at ~470 ms, when the square has formed), so a plane never sits on red; the
+ * breathe starts at 800 ms. Retro steps from accent to danger in one step as the square lands (a stepped flood would
+ * split the chip green and red). Leaving Stop the red drains first (fast, never overshooting), then the square opens;
+ * Retro and NieR drain in one step 40 ms in, never at the drain's first instant: a run that ends and a queued message
+ * that sends itself flip the chip Stop -> Send -> Stop inside one task (turn-stream.js renders, then flushes the
+ * queue), and a step at the start would leave the chip on the accent until the flood's way back has run.
+ * The run: the square breathes ~1 px (scale .88) at the activity bar's 2.2 s working cadence while words arrive, and
+ * .92 at 3.2 s while the model thinks or a tool runs; the danger backlight breathes .30/.18 (.10/.06 on light themes),
+ * .30/.20 (.10/.067) in the waiting cadence. Final review (2026-10-03): at .95 and .30/.24 the 69 s of waiting in a long
+ * agent turn read as a still red button, not as running; the deeper slow pulse stays well under the flowing cadence.
+ * Both loops animate transform or opacity on a box (the svg root, the backlight's gradient), so they run on the
+ * compositor.
+ *
+ * Family grammar: tubes are strokes in the host ink (on-accent), the bloom is a halo stroke (.nx-h, dark themes
+ * only), the glow is a radial gradient at element opacity; no filter, no color-mix(), no stroke-dashoffset. Voices:
+ * --ss-ease and --ss-le are the neon voice tokens (Friendly overshoots, Glass glides, Retro steps, NieR steps); they
+ * change the easing only, never the timing or the order. Reduced motion (the media query, body.pm56-reduced,
+ * html[data-motion="reduced"]): end states only. NieR Mode: ink and parchment, no light, square corners, stepped.
+ */
+
+/* ------------------------------------------------------------------ tokens */
+body {
+  --ss-size: 24px; --ss-r: 8px;
+  /* backlights (element opacity of a plain-token radial gradient) */
+  --ss-glow-a: .46; --ss-glow-stop-a: .3; --ss-glow-w: 260%;
+  /* the glyph's bloom (halo stroke, on-accent) */
+  --ss-halo-a: .22; --ss-halo-w: 3.4px;
+  /* the solid chip's crafted edge: a top rim light, a contact shadow and a sheen (tokens, so NieR can drop them) */
+  --ss-rim: rgb(255 255 255 / .2); --ss-drop: rgb(0 0 0 / .42); --ss-sheen: rgb(255 255 255 / .1);
+  --ss-idle-ink: .7; --ss-stop-fill: .9;
+  --ss-out: cubic-bezier(.3, .15, .65, .45);        /* lift-off: moves at once, accelerates away */
+  --ss-shake: cubic-bezier(.3, 0, .3, 1);
+  --ss-drain: cubic-bezier(.2, .75, .25, 1);        /* the red leaves fast, before the plane takes shape */
+  --ss-drain-t: 300ms;                              /* the drain's length (Retro and NieR: one step at 40 ms) */
+  --ss-fo: 70ms;                                    /* the drain's last dot fades from here (the disc is under the square) */
+  --ss-flood-e: var(--nx-ease, cubic-bezier(.2, .75, .25, 1));
+  /* the glow loop's voice: a sine in-out for Basic. Not the loop token (.45, 0, .25, 1): on an opacity loop that
+     curve keeps Chrome 151 asking for a main frame every frame although the animation reports composited (VM trace:
+     360 main frames in 6 s vs ~60 with any other curve), so the backlight carries its own per-family token. */
+  --ss-gle: cubic-bezier(.37, 0, .63, 1);
+}
+/* light themes: no bloom on the glyph (a white halo on a coloured chip reads as a smudge) and a faint, tighter
+   backlight, so no accent or danger haze lies on the light field (G1) */
+body[data-theme$="-light"] {
+  --ss-glow-a: .1; --ss-glow-stop-a: .1; --ss-glow-w: 200%;
+  --ss-halo-a: 0;
+  --ss-rim: rgb(255 255 255 / .26); --ss-drop: rgb(20 20 60 / .2); --ss-sheen: rgb(255 255 255 / .12);
+  --ss-idle-ink: .76;
+}
+body[data-theme^="friendly"] { --ss-gle: cubic-bezier(.34, 1.4, .64, 1); }
+body[data-theme^="glass"] { --ss-drain: cubic-bezier(.4, 0, .1, 1); --ss-fo: 110ms; --ss-gle: cubic-bezier(.6, 0, .25, 1); }
+/* Retro's drain is one step at 40 ms (jump-end): at its first instant it still holds the red, so a Stop -> Send ->
+   Stop flip in one task finds the flood unchanged and Chrome drops the transition instead of reversing it from 0 */
+body[data-theme^="retro"] { --ss-out: steps(4, end); --ss-shake: steps(4, end); --ss-drain: steps(1, end); --ss-drain-t: 40ms; --ss-flood-e: steps(1, start); --ss-gle: steps(4, end); }
+
+/* ------------------------------------------------------------------ the chip */
+.send-button.sendstop {
+  position: relative; isolation: isolate;
+  width: var(--ss-size); height: var(--ss-size); flex: none; margin-left: auto; padding: 0;
+  border: 0; border-radius: var(--ss-r); background: transparent; box-shadow: none;
+  color: var(--on-accent); cursor: pointer; display: block;
+  --ss-ease: var(--nx-ease, cubic-bezier(.2, .75, .25, 1));
+  --ss-le: var(--nx-le, cubic-bezier(.45, 0, .25, 1));
+  /* the morph into Stop and the flood: --ss-md delays the morph (a Send click: after the fresh plane arrives), the
+     flood follows it by 180 ms; --ss-ld, a constant, starts the loop once both have landed (a re-render that drops a
+     one-shot never shifts a running loop's phase) */
+  --ss-ld: 800ms;
+  transition: transform 200ms var(--ease);
+}
+/* Two backlights behind the chip: ::before in the accent (Send, Queue) and .ss-bl in the danger tone (Stop). They
+   cross-fade by opacity; hover swells them with `scale`. Centred a little low, so they also do the old accent drop
+   shadow's job. The danger one is a wrapper (its opacity fades with the state, after the flood) around ::before (the
+   gradient, which the Stop loop breathes): a loop created while a transition of the SAME property runs on the same
+   element starts on the main thread and stays there (VM trace: a main frame every frame), so the fade and the loop
+   live on two elements and multiply. */
+.sendstop::before, .ss-bl {
+  content: ""; position: absolute; left: 50%; top: 58%; width: var(--ss-glow-w); height: var(--ss-glow-w); translate: -50% -50%;
+  border-radius: 50%; pointer-events: none; z-index: -1; opacity: 0;
+  transition: opacity 260ms ease-out, scale 260ms var(--ease);
+}
+.sendstop::before { background: radial-gradient(closest-side, var(--accent), transparent); }
+.ss-bl::before {
+  content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
+  background: radial-gradient(closest-side, var(--danger), transparent); opacity: var(--ss-glow-stop-a);
+}
+.sendstop[data-ss="ready"]::before, .sendstop[data-ss="queue"]::before { opacity: var(--ss-glow-a); }
+/* the red backlight comes up with the flood (its half-way point), never ahead of it; Retro steps on with it */
+.sendstop[data-ss="stop"] .ss-bl { opacity: 1; transition: opacity 300ms ease-out calc(var(--ss-md, 0ms) + 220ms), scale 260ms var(--ease); }
+body[data-theme^="retro"] .sendstop[data-ss="stop"] .ss-bl { transition: opacity 300ms steps(1, start) calc(var(--ss-md, 0ms) + 300ms), scale 260ms var(--ease); }
+
+/* pointer-events none on the face (and so the glyph): the button is the one hit target, so a glyph moving under a still
+   pointer fires no pointerover and re-arms no tip mid-hero (app.js drops the tip when the chip is pressed) */
+.ss-face {
+  position: absolute; inset: 0; border-radius: inherit; overflow: hidden; pointer-events: none;
+  background: var(--accent);
+  box-shadow: inset 0 1px 0 var(--ss-rim), 0 1px 2px var(--ss-drop);
+  transition: background-color 300ms ease-out, box-shadow 300ms ease-out;
+}
+/* The run's colour FLOODS the chip from its centre (a disc that scales up behind the glyph) instead of blending:
+   accent-to-danger blends pass through mud (green to red is brown in Retro), a flood has a clean edge and says "this
+   started here". Transform and opacity only. Leaving Stop the red drains back behind the square first; the drain's
+   curve has a long tail, so once the disc is under the square (--ss-fo, per drain curve) its last dot fades out in
+   60 ms, before the square's fill has thinned enough to show it inside the opening plane. */
+.ss-flood {
+  position: absolute; left: 50%; top: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px; border-radius: 50%;
+  background: var(--danger); scale: 0; opacity: 0; pointer-events: none;
+  transition: scale var(--ss-drain-t) var(--ss-drain) var(--ss-dd, 0ms), opacity 60ms linear calc(var(--ss-dd, 0ms) + var(--ss-fo));
+}
+.sendstop[data-ss="stop"] .ss-flood { scale: 1; opacity: 1; transition: scale 360ms var(--ss-flood-e) calc(var(--ss-md, 0ms) + 180ms), opacity 0ms; }
+/* Retro: one step from accent to danger the moment the stepped morph lands (it ends at --ss-md + 300 ms) */
+body[data-theme^="retro"] .sendstop[data-ss="stop"] .ss-flood { transition: scale 300ms var(--ss-flood-e) calc(var(--ss-md, 0ms) + 300ms), opacity 0ms; }
+/* a faint top sheen: the solid chip reads as a lit tile, not a flat sticker */
+.ss-face::before {
+  content: ""; position: absolute; inset: 0 0 50% 0; pointer-events: none; z-index: 1;
+  background: linear-gradient(var(--ss-sheen), transparent);
+}
+/* the failure flash (danger, over the fill and under the glyph, so the plane stays readable) */
+.ss-face::after { content: ""; position: absolute; inset: 0; background: var(--danger); opacity: 0; pointer-events: none; z-index: 1; }
+.sendstop[data-ss="full"] .ss-face { background: var(--surface-3); box-shadow: inset 0 0 0 1px var(--border-strong); }
+.sendstop[data-ss="full"] { color: var(--muted); cursor: not-allowed; }
+
+/* ------------------------------------------------------------------ the glyph */
+.ss-g {
+  position: absolute; left: 0; top: 0; z-index: 2; width: 100%; height: 100%; overflow: visible;
+  fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round;
+  transition: opacity 220ms ease-out;
+}
+.sendstop[data-ss="idle"] .ss-g { opacity: var(--ss-idle-ink); }
+.sendstop[data-ss="full"] .ss-g { opacity: .8; }
+/* every moving layer turns about the chip centre in chip pixels */
+.ss-g g { transform-box: view-box; transform-origin: 12px 12px; }
+
+/* the body: plane outline (Send) <-> rounded square (Stop) <-> the smaller front plane (Queue). Into Stop the morph
+   takes 300 ms (the hero's timing above, delayed by --ss-md); back out of it 380 ms from --ss-xd (90 ms: by then the
+   red has drained to a 2 px dot under the square, so the plane never takes shape on red; a Stop click: 200 ms). */
+.sendstop .ss-body {
+  d: path("M5.6 10.86 L17.2 6.8 Q17.2 6.8 17.2 6.8 L13.14 18.4 Q13.14 18.4 13.14 18.4 L10.82 13.18 Q10.82 13.18 10.82 13.18 L5.6 10.86 Q5.6 10.86 5.6 10.86 Z");
+  stroke-width: 1.35px; fill: currentColor; fill-opacity: 0;
+  transition: d 380ms var(--ss-ease) var(--ss-xd, 90ms), stroke-width 380ms var(--ss-ease) var(--ss-xd, 90ms),
