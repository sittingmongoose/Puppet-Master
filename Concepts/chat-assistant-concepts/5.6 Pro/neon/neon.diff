+
+.sendstop[data-ss="stop"] .ss-body {
+  d: path("M10.6 8.6 L13.4 8.6 Q15.4 8.6 15.4 10.6 L15.4 13.4 Q15.4 15.4 13.4 15.4 L10.6 15.4 Q8.6 15.4 8.6 13.4 L8.6 10.6 Q8.6 8.6 10.6 8.6 Z");
+  stroke-width: 1.6px; fill-opacity: var(--ss-stop-fill);
+  transition: d 300ms var(--ss-ease) var(--ss-md, 0ms), stroke-width 300ms var(--ss-ease) var(--ss-md, 0ms),
+    fill-opacity 300ms var(--ss-ease) var(--ss-md, 0ms);
+}
+.sendstop[data-ss="stop"] .ss-g .nx-h {
+  d: path("M10.6 8.6 L13.4 8.6 Q15.4 8.6 15.4 10.6 L15.4 13.4 Q15.4 15.4 13.4 15.4 L10.6 15.4 Q8.6 15.4 8.6 13.4 L8.6 10.6 Q8.6 8.6 10.6 8.6 Z");
