+  background: linear-gradient(currentColor, currentColor) left bottom / 5px 5px no-repeat, linear-gradient(currentColor, currentColor) right bottom / 5px 5px no-repeat,
+    linear-gradient(currentColor, currentColor) center calc(100% - 2px) / calc(100% - 12px) 1px no-repeat; }
+#o55nw-boot .o55nw-boot-head small { display: block; font: 500 9px/1.6 var(--font-mono); letter-spacing: .26em; opacity: .7; }
+#o55nw-boot .o55nw-boot-line { display: flex; align-items: baseline; gap: 10px; opacity: 0; animation: o55nw-boot-line 1ms step-end both; animation-delay: calc(90ms + var(--i) * 105ms); }
+#o55nw-boot .o55nw-boot-line > i { flex: 1; height: 1px; align-self: center; background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 6px); opacity: .45; }
+#o55nw-boot .o55nw-boot-line > b { font-weight: 600; opacity: 0; animation: o55nw-boot-line 1ms step-end both; animation-delay: calc(170ms + var(--i) * 105ms); }
+#o55nw-boot .o55nw-boot-meter { position: relative; height: 8px; margin-top: 14px; border: 1px solid currentColor; }
