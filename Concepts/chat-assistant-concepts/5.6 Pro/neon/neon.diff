+  animation: o55nw-boot-out 1100ms linear both; will-change: opacity; }
+#o55nw-boot::before { content: ""; position: absolute; inset: 0;
+  background-image: linear-gradient(rgba(var(--o55-nier-ink-rgb), .06) 1px, transparent 1px), linear-gradient(90deg, rgba(var(--o55-nier-ink-rgb), .06) 1px, transparent 1px);
+  background-size: 32px 32px; background-position: -1px -1px; }
+#o55nw-boot .o55nw-boot-log { position: absolute; left: 50%; top: 50%; width: 400px; margin: -92px 0 0 -200px; }
