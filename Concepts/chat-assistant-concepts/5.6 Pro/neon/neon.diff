+  transition: d 380ms var(--ss-ease) var(--ss-xd, 90ms), stroke-width 380ms var(--ss-ease) var(--ss-xd, 90ms), opacity 300ms ease-out var(--ss-xd, 90ms);
+}
+/* the bloom: a wider, faint copy of the body's own outline (dark themes) */
+.sendstop .ss-g .nx-h {
+  d: path("M5.6 10.86 L17.2 6.8 Q17.2 6.8 17.2 6.8 L13.14 18.4 Q13.14 18.4 13.14 18.4 L10.82 13.18 Q10.82 13.18 10.82 13.18 L5.6 10.86 Q5.6 10.86 5.6 10.86 Z");
+  stroke-width: var(--ss-halo-w); stroke-opacity: var(--ss-halo-a); vector-effect: none; visibility: visible;
+  transition: d 380ms var(--ss-ease) var(--ss-xd, 90ms), stroke-width 380ms var(--ss-ease) var(--ss-xd, 90ms), stroke-opacity 260ms ease-out;
