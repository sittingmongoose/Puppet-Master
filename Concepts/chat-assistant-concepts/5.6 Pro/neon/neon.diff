+.nx-bolt > svg .nx-h { animation: nx-bolt-halo 5200ms linear infinite; }
+.nx-bolt > svg .nx-p0 { animation: nx-bolt-0 5200ms linear infinite; }
+.nx-bolt > svg .nx-p1 { animation: nx-bolt-1 5200ms linear infinite; }
+.nx-bolt > svg .nx-p2 { animation: nx-bolt-2 5200ms linear infinite; }
+.nx-bolt > svg .nx-p3 { animation: nx-bolt-3 5200ms linear infinite; }
