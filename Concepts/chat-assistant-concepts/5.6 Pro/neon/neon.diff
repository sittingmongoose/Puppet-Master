+/* full cover, then the game's flicker off */
+@keyframes o55nw-boot-out { 0%, 70% { opacity: 1; } 76% { opacity: 0; } 82% { opacity: .8; } 88% { opacity: 0; } 93% { opacity: .35; } 100% { opacity: 0; } }
+
+/* ================================================================================ Unit readouts [readouts] */
