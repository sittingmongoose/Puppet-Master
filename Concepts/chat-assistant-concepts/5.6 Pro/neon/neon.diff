+    repeating-linear-gradient(90deg, rgba(var(--o55-nier-ink-rgb), .16) 0 5px, transparent 5px 7px) 1px 1px / 80px 5px no-repeat;
+  background-origin: border-box; }
+html[data-o55-nier-parts~="readouts"][data-o55nw-low] .status-bar > span.right::after {
+  background:
+    repeating-linear-gradient(90deg, var(--o55-nier-error) 0 5px, transparent 5px 7px) 1px 1px / max(0px, calc(var(--o55nw-hp, 0) * 7px - 2px)) 5px no-repeat,
+    repeating-linear-gradient(90deg, rgba(var(--o55-nier-ink-rgb), .16) 0 5px, transparent 5px 7px) 1px 1px / 80px 5px no-repeat; }
