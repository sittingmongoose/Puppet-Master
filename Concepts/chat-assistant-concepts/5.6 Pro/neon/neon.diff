@@ -0,0 +1,384 @@
+/* nier-parts.css — NieR Mode parts for the 5.6 Pro concept (PMConcept7's 29-part contract). OWNER: NieR Mode, steps
+ * N-A (2026-10-02: the Look parts square, cursor, headers, ground, brackets, diamonds, plus pointer and icons) and N-B
+ * (2026-10-02: the Motion parts reboot, slice, wipe, particles, sweep and the alert effects, and the Sound & voice parts
+ * voice and pod). The script half is nier-parts.js; the World parts are nier-world.css; the palette is nier.css.
+ *
+ * Every rule is scoped by html[data-o55-nier-parts~="<key>"], which nier.js writes only while a NieR theme is painted,
+ * so nothing here applies while NieR Mode is off, and each part goes away when its key is switched off. The shared
+ * layers keep PMConcept7's ids and look verbatim (#o55np-cursor, -reticle, -reboot, -wipe, -ground, -sweep, -pod;
+ * styles.d/14-nier-parts.css; #o55np-fx, the alert effects, is the concept's own), so the
+ * parts read the same in both apps; what is the concept's own is the selector lists (menus, pickers, thread rows,
+ * wand rows, sheets, dialogs, transcript cards, toasts). Colours are the palette's helper tokens only (the pointer
+ * images and the reboot cover's inks, which must exist as literals, are in nier.css's generated block).
+ * Motion rules (PMConcept7's): transform and opacity only, stepped; nothing animates a filter, clip-path, box-shadow
+ * or background; every motion is off under reduced motion (the media query, html[data-motion="reduced"] and the
+ * concept's body.pm56-reduced). Selector rules (tests/shell-selfcheck.cjs): one selector per class rather than a
+ * rightmost :is() list, no :has().
+ */
+
+/* ======================================================================================================== Look */
+
+/* ---- Square hairlines [square]: no rounded corner anywhere, 1px lines, square bullets and boxes ---- */
+html[data-o55-nier-parts~="square"] body {
+  --radius-sm: 0px; --radius: 0px;
+  --pmx-r-xs: 0px; --pmx-r-sm: 0px; --pmx-r-md: 0px; --pmx-r-card: 0px; --pmx-r-sheet: 0px;
+}
+html[data-o55-nier-parts~="square"] *, html[data-o55-nier-parts~="square"] *::before, html[data-o55-nier-parts~="square"] *::after { border-radius: 0 !important; }
+html[data-o55-nier-parts~="square"] ul { list-style-type: square; }
+html[data-o55-nier-parts~="square"] input[type="checkbox"] { accent-color: var(--o55-nier-ink); }
+html[data-o55-nier-parts~="square"] input[type="radio"] { accent-color: var(--o55-nier-ink); }
+
+/* ---- Menu cursor [cursor]: the hovered or chosen menu item, picker row, thread row or wand row is an ink bar with
+   paper text; one square cursor (#o55np-cursor, nier-parts.js) sits beside it and nudges in two steps ---- */
+html[data-o55-nier-parts~="cursor"] .menu-item:hover,
+html[data-o55-nier-parts~="cursor"] .menu-item.active,
+html[data-o55-nier-parts~="cursor"] .menu-item:focus-visible,
+html[data-o55-nier-parts~="cursor"] .thread-row:hover,
+html[data-o55-nier-parts~="cursor"] .thread-row.active,
+html[data-o55-nier-parts~="cursor"] .model-row:hover,
+html[data-o55-nier-parts~="cursor"] .model-row.active,
+html[data-o55-nier-parts~="cursor"] .effort-row:hover,
+html[data-o55-nier-parts~="cursor"] .effort-row.active,
