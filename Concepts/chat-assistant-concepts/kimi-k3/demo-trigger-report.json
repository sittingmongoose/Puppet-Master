  "contract": "DEMO_TRIGGER_CONTRACT.json (pm.chat_assistant_demo_trigger_contract.v2)",
  "family_coverage": {
   "history": "openHistory/closeHistory/pinHistory/togglePinnedCompact/unpinHistory + NEW historyPeek/historySwitchThread",
   "question": "triggerQuestionFlow/answerCurrent/skipCurrent/cancelFlow/submitFlow (incomplete-submit validation path) + lifecycle beats asserted by questionLifecycle",
   "goal": "goalStart/goalUpdate/goalPause/goalResume/goalReplan/goalBlocked/goalComplete/goalStop",
   "todo": "todoAdd/todoComplete/todoReopen + NEW todoBlock",
   "subagent": "subagentSpawn/subagentAdvance/subagentComplete/subagentFail + NEW subagentRetry /subagentStop",
   "activity": "advanceActivity over all 8 canonical kinds (seeded after correction B4)",
   "diff": "createDiff/updateDiff/diffOpen",
   "artifact": "artifactOpen/artifactClose/artifactSwitch/artifactLoading/artifactErrorRetry/artifactSetUpdated",
   "decision": "injectApproval/decideApproval(once|session|deny) + NEW decisionBranch",
   "thread": "threadRequestTo/threadAwait/threadSpawn/threadBranch/threadRestorePoint/threadRewind/redirectActive",
   "system": "injectPortConflict + NEW worktreeCollision; resetScenario",
