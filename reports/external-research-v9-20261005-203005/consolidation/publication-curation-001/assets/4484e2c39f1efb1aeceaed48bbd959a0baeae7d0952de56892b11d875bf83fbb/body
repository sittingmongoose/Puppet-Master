\"code\":\"axes=['z','y','x']; s=[0.5,0.2,0.1]; t=[1.5,-5.0,2.0]; i=[3.0,10.0,20.0]; p=[x*y+z for x,y,z in zip(i,s,t)]; back=[(x-z)/y for x,y,z in zip(p,s,t)]; wrong=[(x+z)*y for x,y,z in zip(i,s,t)]; assert p==[3.0,-3.0,4.0] and back==i and wrong==[2.25,1.0,2.2]; print({'physical':p,'inverse':back,'wrong_order':wrong})\",\"receipt\":{\"id\":\"exec-1bo0kzz7\",\"code_sha256\":\"19cfbaca9aae8ad1f2b85ee327122c3a75d63d7763da8407a8774d998dc6ce15\",\"data_sha256\":\"cb00f1297693ec5603dd9b372682be17440e330041141a5a48b2d9843ca0c13a\",\"stdout\":\"{'axes': ['z', 'y', 'x'], 'index': [3.0, 10.0, 20.0], 'scale_then_translation_physical': [3.0, -3.0, 4.0], 'inverse': [3.0, 10.0, 20.0], 'translation_then_scale_countercheck': [2.25, 1.0, 2.2]}\\n\",\"stderr\":\"\",\"exit_code\":0,\"elapsed_seconds\":0.353,\"limits\":{\"wall_seconds\":5,\"cpu_seconds\":3,\"memory_bytes\":268435456,\"network\":false,\"filesystem\":\"fresh empty isolated environment\"}},\"limit\":\"Arithmetic only; no parser, image, UI, format, or application tested.\"},{\"id\":\"W2\",\"status\":\"PROPOSED_UNEXECUTED\",\"purpose\":\"Lockfile/reader/format integration fixtures\",\"acceptance\":\"Exact tested OME-Zarr/OME-TIFF samples; metadata/axes/series; unsupported case preserves sources/project.\"},{\"id\":\"W3\",\"status\":\"PROPOSED_UNEXECUTED\",\"purpose\":\"Coordinate, annotation, mask and export round trip\",\"acceptance\":\"Axis orders/units/scope; compare reopen and CSV/JSON/NGFF mask; source bytes unchanged.\"},{\"id\":\"W4\",\"status\":\"PROPOSED_UNEXECUTED\",\"purpose\":\"3 GB bounded review\",\"acceptance\":\"Cold/warm latency, RSS, bytes read, chunk/cache/decode size, cancellation on 8-core/16-GB workstation; thresholds in proposal are unvalidated choices.\"},{\"id\":\"W5\",\"status\":\"PROPOSED_UNEXECUTED\",\"purpose\":\"Save recovery/relocation/shared storage\",\"acceptance\":\"Inject failures at generation/pointer writes; verify prior generation and matching/mismatching digests; test actual filesyst