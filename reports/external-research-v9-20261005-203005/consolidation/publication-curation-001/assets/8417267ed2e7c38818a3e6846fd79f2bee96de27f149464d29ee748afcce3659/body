import hashlib, json

def digest(value):
    payload = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()

def cell_fingerprint(cell_id, cells, dependencies, source_hashes, env, memo=None):
    if memo is None:
        memo = {}
    if cell_id in memo:
        return memo[cell_id]
    payload = {
        "cell_id": cell_id,
        "source": cells[cell_id],
        "depends_on": {d: cell_fingerprint(d, cells, dependencies, source_hashes, env, memo) for d in dependencies[cell_id]},
        "sources": source_hashes if cell_id == "load" else {},
        "environment": env,
    }
    memo[cell_id] = digest(payload)
    return memo[cell_id]

