check("crossfade_two_source_anchored_cues",
      len(cueA) == 1 and len(cueB) == 1, "cueA=%s cueB=%s" % (cueA, cueB))
check("crossfade_rows_overlap_same_interval",
      cueA[0][1] < cueB[0][2] and cueB[0][1] < cueA[0][2], "cueA=%s cueB=%s" % (cueA, cueB))

