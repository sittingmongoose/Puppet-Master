{"source": "public_captures/53a11a9837bb9cea30913bb13bc238b1cb5e67d50d9754bdd0d68727220ac411.body", "source_sha256": "53a11a9837bb9cea30913bb13bc238b1cb5e67d50d9754bdd0d68727220ac411", "lines": [{"line": 1, "text": "#include \"duckdb/execution/operator/csv_scanner/string_value_scanner.hpp\""}, {"line": 2, "text": ""}, {"line": 3, "text": "#include \"duckdb/common/operator/decimal_cast_operators.hpp\""}, {"line": 4, "text": "#include \"duckdb/common/operator/double_cast_operator.hpp\""}, {"line": 5, "text": "#include \"duckdb/common/operator/integer_cast_operator.hpp\""}, {"line": 6, "text": "#include \"duckdb/common/types/time.hpp\""}, {"line": 7, "text": "#include \"duckdb/execution/operator/csv_scanner/csv_casting.hpp\""}, {"line": 8, "text": "#include \"duckdb/execution/operator/csv_scanner/csv_file_scanner.hpp\""}, {"line": 9, "text": "#include \"duckdb/execution/operator/csv_scanner/skip_scanner.hpp\""}, {"line": 10, "text": "#include \"duckdb/function/cast/cast_function_set.hpp\""}, {"line": 11, "text": "#include \"duckdb/main/client_data.hpp\""}, {"line": 12, "text": "#include \"utf8proc_wrapper.hpp\""}, {"line": 13, "text": ""}, {"line": 14, "text": "#include <algorithm>"}, {"line": 15, "text": ""}, {"line": 16, "text": "namespace duckdb {"}, {"line": 17, "text": ""}, {"line": 18, "text": "StringValueResult::StringValueResult(CSVStates &states, CSVStateMachine &state_machine,"}, {"line": 19, "text": "                                     const shared_ptr<CSVBufferHandle> &buffer_handle, Allocator &buffer_allocator,"}, {"line": 20, "text": "                                     bool figure_out_new_line_p, idx_t buffer_position, CSVErrorHandler &error_hander_p,"}, {"line": 21, "text": "                                     CSVIterator &iterator_p, bool store_line_size_p,"}, {"line": 22, "text": "                                     shared_ptr<CSVFileScan> csv_file_scan_p, idx_t &lines_read_p, bool sniffing_p)"}, {"line": 23, "text": "    : ScannerResult(states, state_machine),"}, {"line": 24, "text": "      number_of_columns(NumericCast<uint32_t>(state_machine.dialect_options.num_cols)),"}, {"line": 25, "text": "      null_padding(state_machine.options.null_padding), ignore_errors(state_machine.options.ignore_errors.GetValue()),"}, {"line": 26, "text": "      figure_out_new_line(figure_out_new_line_p), error_handler(error_hander_p), iterator(iterator_p),"}, {"line": 27, "text": "      store_line_size(store_line_size_p), csv_file_scan(std::move(csv_file_scan_p)), lines_read(lines_read_p),"}, {"line": 28, "text": "      current_errors(state_machine.options.IgnoreErrors()), sniffing(sniffing_p) {"}, {"line": 29, "text": "\t// Vector information"}, {"line": 30, "text": "\tD_ASSERT(number_of_columns > 0);"}, {"line": 31, "text": "\tbuffer_handles[buffer_handle->buffer_idx] = buffer_handle;"}, {"line": 32, "text": "\t// Buffer Information"}, {"line": 33, "text": "\tbuffer_ptr = buffer_handle->Ptr();"}, {"line": 34, "text": "\tbuffer_size = buffer_handle->actual_size;"}, {"line": 35, "text": "\tlast_position = {buffer_handle->buffer_idx, buffer_position, buffer_size};"}, {"line": 36, "text": "\trequested_size = buffer_handle->requested_size;"}, {"line": 37, "text": "\tresult_size = figure_out_new_line ? 1 : STANDARD_VECTOR_SIZE;"}, {"line": 38, "text": ""}, {"line": 39, "text": "\t// Current Result information"}, {"line": 40, "text": "\tcurrent_line_position.begin = {iterator.pos.buffer_idx, iterator.pos.buffer_pos, buffer_handle->actual_size};"}, {"line": 41, "text": "\tcurrent_line_position.end = current_line_position.begin;"}, {"line": 42, "text": "\t// Fill out Parse Types"}, {"line": 43, "text": "\tvector<LogicalType> logical_types;"}, {"line": 44, "text": "\tparse_types = make_unsafe_uniq_array<ParseTypeInfo>(number_of_columns);"}, {"line": 45, "text": "\tLogicalType varchar_type = LogicalType::VARCHAR;"}, {"line": 46, "text": "\tif (!csv_file_scan) {"}, {"line": 47, "text": "\t\tfor (idx_t i = 0; i < number_of_columns; i++) {"}, {"line": 48, "text": "\t\t\tparse_types[i] = ParseTypeInfo(varchar_type, true);"}, {"line": 49, "text": "\t\t\tlogical_types.emplace_back(LogicalType::VARCHAR);"}, {"line": 50, "text": "\t\t\tstring name = \"Column_\" + to_string(i);"}, {"line": 51, "text": "\t\t\tnames.emplace_back(name);"}, {"line": 52, "text": "\t\t}"}, {"line": 53, "text": "\t} else {"}, {"line": 54, "text": "\t\tif (csv_file_scan->file_types.size() > number_of_columns) {"}, {"line": 55, "text": "\t\t\tthrow InvalidInputException("}, {"line": 56, "text": "\t\t\t    \"Mismatch between the number of columns (%d) in the CSV file and what is expected in the scanner (%d).\","}, {"line": 57, "text": "\t\t\t    number_of_columns, csv_file_scan->file_types.size());"}, {"line": 58, "text": "\t\t}"}, {"line": 59, "text": "\t\tfor (idx_t i = 0; i < csv_file_scan->file_types.size(); i++) {"}, {"line": 60, "text": "\t\t\tauto &type = csv_file_scan->file_types[i];"}, {"line": 61, "text": "\t\t\tif (StringValueScanner::CanDirectlyCast(type)) {"}, {"line": 62, "text": "\t\t\t\tparse_types[i] = ParseTypeInfo(type, true);"}, {"line": 63, "text": "\t\t\t\tlogical_types.emplace_back(type);"}, {"line": 64, "text": "\t\t\t} else {"}, {"line": 65, "text": "\t\t\t\tparse_types[i] = ParseTypeInfo(varchar_type, type.id() == LogicalTypeId::VARCHAR || type.IsNested());"}, {"line": 66, "text": "\t\t\t\tlogical_types.emplace_back(LogicalType::VARCHAR);"}, {"line": 67, "text": "\t\t\t}"}, {"line": 68, "text": "\t\t}"}, {"line": 69, "text": "\t\tnames = csv_file_scan->names;"}, {"line": 70, "text": "\t\tif (!csv_file_scan->projected_columns.empty()) {"}, {"line": 71, "text": "\t\t\tprojecting_columns = false;"}, {"line": 72, "text": "\t\t\tprojected_columns = make_unsafe_uniq_array<bool>(number_of_columns);"}, {"line": 73, "text": "\t\t\tfor (idx_t col_idx = 0; col_idx < number_of_columns; col_idx++) {"}, {"line": 74, "text": "\t\t\t\tif (csv_file_scan->projected_columns.find(col_idx) == csv_file_scan->projected_columns.end()) {"}, {"line": 75, "text": "\t\t\t\t\t// Column is not projected"}, {"line": 76, "text": "\t\t\t\t\tprojecting_columns = true;"}, {"line": 77, "text": "\t\t\t\t\tprojected_columns[col_idx] = false;"}, {"line": 78, "text": "\t\t\t\t} else {"}, {"line": 79, "text": "\t\t\t\t\tprojected_columns[col_idx] = true;"}, {"line": 80, "text": "\t\t\t\t}"}, {"line": 81, "text": "\t\t\t}"}, {"line": 82, "text": "\t\t}"}, {"line": 83, "text": "\t\tif (!projecting_columns) {"}, {"line": 84, "text": "\t\t\tfor (idx_t j = logical_types.size(); j < number_of_columns; j++) {"}, {"line": 85, "text": "\t\t\t\t// This can happen if we have sneaky null columns at the end that we wish to ignore"}, {"line": 86, "text": "\t\t\t\tparse_types[j] = ParseTypeInfo(varchar_type, true);"}, {"line": 87, "text": "\t\t\t\tlogical_types.emplace_back(LogicalType::VARCHAR);"}, {"line": 88, "text": "\t\t\t}"}, {"line": 89, "text": "\t\t}"}, {"line": 90, "text": "\t}"}, {"line": 91, "text": ""}, {"line": 92, "text": "\t// Initialize Parse Chunk"}, {"line": 93, "text": "\tparse_chunk.Initialize(buffer_allocator, logical_types, result_size);"}, {"line": 94, "text": "\tfor (auto &col : parse_chunk.data) {"}, {"line": 95, "text": "\t\tvector_ptr.push_back(FlatVector::GetData<string_t>(col));"}, {"line": 96, "text": "\t\tvalidity_mask.push_back(&FlatVector::Validity(col));"}, {"line": 97, "text": "\t}"}, {"line": 98, "text": ""}, {"line": 99, "text": "\t// Setup the NullStr information"}, {"line": 100, "text": "\tnull_str_count = state_machine.options.null_str.size();"}, {"line": 101, "text": "\tnull_str_ptr = make_unsafe_uniq_array<const char *>(null_str_count);"}, {"line": 102, "text": "\tnull_str_size = make_unsafe_uniq_array<idx_t>(null_str_count);"}, {"line": 103, "text": "\tfor (idx_t i = 0; i < null_str_count; i++) {"}, {"line": 104, "text": "\t\tnull_str_ptr[i] = state_machine.options.null_str[i].c_str();"}, {"line": 105, "text": "\t\tnull_str_size[i] = state_machine.options.null_str[i].size();"}, {"line": 106, "text": "\t}"}, {"line": 107, "text": "\tdate_format = state_machine.options.dialect_options.date_format.at(LogicalTypeId::DATE).GetValue();"}, {"line": 108, "text": "\ttimestamp_format = state_machine.options.dialect_options.date_format.at(LogicalTypeId::TIMESTAMP).GetValue();"}, {"line": 109, "text": "\tdecimal_separator = state_machine.options.decimal_separator[0];"}, {"line": 110, "text": ""}, {"line": 111, "text": "\tif (iterator.first_one) {"}, {"line": 112, "text": "\t\tlines_read +="}, {"line": 113, "text": "\t\t    state_machine.dialect_options.skip_rows.GetValue() + state_machine.dialect_options.header.GetValue();"}, {"line": 114, "text": "\t\tif (lines_read == 0) {"}, {"line": 115, "text": "\t\t\tSkipBOM();"}, {"line": 116, "text": "\t\t}"}, {"line": 117, "text": "\t}"}, {"line": 118, "text": "}"}, {"line": 119, "text": ""}, {"line": 120, "text": "StringValueResult::~StringValueResult() {"}, {"line": 121, "text": "\t// We have to insert the lines read by this scanner"}, {"line": 122, "text": "\terror_handler.Insert(iterator.GetBoundaryIdx(), lines_read);"}, {"line": 123, "text": "\tif (!iterator.done) {"}, {"line": 124, "text": "\t\t// Some operators, like Limit, might cause a future error to incorrectly report the wrong error line"}, {"line": 125, "text": "\t\t// Better to print nothing to print something wrong"}, {"line": 126, "text": "\t\terror_handler.DontPrintErrorLine();"}, {"line": 127, "text": "\t}"}, {"line": 128, "text": "}"}, {"line": 129, "text": ""}, {"line": 130, "text": "inline bool IsValueNull(const char *null_str_ptr, const char *value_ptr, const idx_t size) {"}, {"line": 131, "text": "\tfor (idx_t i = 0; i < size; i++) {"}, {"line": 132, "text": "\t\tif (null_str_ptr[i] != value_ptr[i]) {"}, {"line": 133, "text": "\t\t\treturn false;"}, {"line": 134, "text": "\t\t}"}, {"line": 135, "text": "\t}"}, {"line": 136, "text": "\treturn true;"}, {"line": 137, "text": "}"}, {"line": 138, "text": ""}, {"line": 139, "text": "bool StringValueResult::HandleTooManyColumnsError(const char *value_ptr, const idx_t size) {"}, {"line": 140, "text": "\tif (cur_col_id >= number_of_columns) {"}, {"line": 141, "text": "\t\tbool error = true;"}, {"line": 142, "text": "\t\tif (cur_col_id == number_of_columns && ((quoted && state_machine.options.allow_quoted_nulls) || !quoted)) {"}, {"line": 143, "text": "\t\t\t// we make an exception if the first over-value is null"}, {"line": 144, "text": "\t\t\tbool is_value_null = false;"}, {"line": 145, "text": "\t\t\tfor (idx_t i = 0; i < null_str_count; i++) {"}, {"line": 146, "text": "\t\t\t\tis_value_null = is_value_null || IsValueNull(null_str_ptr[i], value_ptr, size);"}, {"line": 147, "text": "\t\t\t}"}, {"line": 148, "text": "\t\t\terror = !is_value_null;"}, {"line": 149, "text": "\t\t}"}, {"line": 150, "text": "\t\tif (error) {"}, {"line": 151, "text": "\t\t\t// We error pointing to the current value error."}, {"line": 152, "text": "\t\t\tcurrent_errors.Insert(CSVErrorType::TOO_MANY_COLUMNS, cur_col_id, chunk_col_id, last_position);"}, {"line": 153, "text": "\t\t\tcur_col_id++;"}, {"line": 154, "text": "\t\t}"}, {"line": 155, "text": "\t\t// We had an error"}, {"line": 156, "text": "\t\treturn true;"}, {"line": 157, "text": "\t}"}, {"line": 158, "text": "\treturn false;"}, {"line": 159, "text": "}"}, {"line": 160, "text": "void StringValueResult::AddValueToVector(const char *value_ptr, const idx_t size, bool allocate) {"}, {"line": 161, "text": "\tif (HandleTooManyColumnsError(value_ptr, size)) {"}, {"line": 162, "text": "\t\treturn;"}, {"line": 163, "text": "\t}"}, {"line": 164, "text": "\tif (cur_col_id >= number_of_columns) {"}, {"line": 165, "text": "\t\tbool error = true;"}, {"line": 166, "text": "\t\tif (cur_col_id == number_of_columns && ((quoted && state_machine.options.allow_quoted_nulls) || !quoted)) {"}, {"line": 167, "text": "\t\t\t// we make an exception if the first over-value is null"}, {"line": 168, "text": "\t\t\tbool is_value_null = false;"}, {"line": 169, "text": "\t\t\tfor (idx_t i = 0; i < null_str_count; i++) {"}, {"line": 170, "text": "\t\t\t\tis_value_null = is_value_null || IsValueNull(null_str_ptr[i], value_ptr, size);"}, {"line": 171, "text": "\t\t\t}"}, {"line": 172, "text": "\t\t\terror = !is_value_null;"}, {"line": 173, "text": "\t\t}"}, {"line": 174, "text": "\t\tif (error) {"}, {"line": 175, "text": "\t\t\t// We error pointing to the current value error."}, {"line": 176, "text": "\t\t\tcurrent_errors.Insert(CSVErrorType::TOO_MANY_COLUMNS, cur_col_id, chunk_col_id, last_position);"}, {"line": 177, "text": "\t\t\tcur_col_id++;"}, {"line": 178, "text": "\t\t}"}, {"line": 179, "text": "\t\treturn;"}, {"line": 180, "text": "\t}"}, {"line": 181, "text": ""}, {"line": 182, "text": "\tif (projecting_columns) {"}, {"line": 183, "text": "\t\tif (!projected_columns[cur_col_id]) {"}, {"line": 184, "text": "\t\t\tcur_col_id++;"}, {"line": 185, "text": "\t\t\treturn;"}, {"line": 186, "text": "\t\t}"}, {"line": 187, "text": "\t}"}, {"line": 188, "text": "\tfor (idx_t i = 0; i < null_str_count; i++) {"}, {"line": 189, "text": "\t\tif (size == null_str_size[i]) {"}, {"line": 190, "text": "\t\t\tif (((quoted && state_machine.options.allow_quoted_nulls) || !quoted)) {"}, {"line": 191, "text": "\t\t\t\tif (IsValueNull(null_str_ptr[i], value_ptr, size)) {"}, {"line": 192, "text": "\t\t\t\t\tbool empty = false;"}, {"line": 193, "text": "\t\t\t\t\tif (chunk_col_id < state_machine.options.force_not_null.size()) {"}, {"line": 194, "text": "\t\t\t\t\t\tempty = state_machine.options.force_not_null[chunk_col_id];"}, {"line": 195, "text": "\t\t\t\t\t}"}, {"line": 196, "text": "\t\t\t\t\tif (empty) {"}, {"line": 197, "text": "\t\t\t\t\t\tif (parse_types[chunk_col_id].type_id != LogicalTypeId::VARCHAR) {"}, {"line": 198, "text": "\t\t\t\t\t\t\t// If it is not a varchar, empty values are not accepted, we must error."}, {"line": 199, "text": "\t\t\t\t\t\t\tcurrent_errors.Insert(CSVErrorType::CAST_ERROR, cur_col_id, chunk_col_id, last_position);"}, {"line": 200, "text": "\t\t\t\t\t\t}"}, {"line": 201, "text": "\t\t\t\t\t\tstatic_cast<string_t *>(vector_ptr[chunk_col_id])[number_of_rows] = string_t();"}, {"line": 202, "text": "\t\t\t\t\t} else {"}, {"line": 203, "text": "\t\t\t\t\t\tif (chunk_col_id == number_of_columns) {"}, {"line": 204, "text": "\t\t\t\t\t\t\t// We check for a weird case, where we ignore an extra value, if it is a null value"}, {"line": 205, "text": "\t\t\t\t\t\t\treturn;"}, {"line": 206, "text": "\t\t\t\t\t\t}"}, {"line": 207, "text": "\t\t\t\t\t\tvalidity_mask[chunk_col_id]->SetInvalid(number_of_rows);"}, {"line": 208, "text": "\t\t\t\t\t}"}, {"line": 209, "text": "\t\t\t\t\tcur_col_id++;"}, {"line": 210, "text": "\t\t\t\t\tchunk_col_id++;"}, {"line": 211, "text": "\t\t\t\t\treturn;"}, {"line": 212, "text": "\t\t\t\t}"}, {"line": 213, "text": "\t\t\t}"}, {"line": 214, "text": "\t\t}"}, {"line": 215, "text": "\t}"}, {"line": 216, "text": "\tbool success = true;"}, {"line": 217, "text": "\tswitch (parse_types[chunk_col_id].type_id) {"}, {"line": 218, "text": "\tcase LogicalTypeId::TINYINT:"}, {"line": 219, "text": "\t\tsuccess = TrySimpleIntegerCast(value_ptr, size, static_cast<int8_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 220, "text": "\t\t                               false);"}, {"line": 221, "text": "\t\tbreak;"}, {"line": 222, "text": "\tcase LogicalTypeId::SMALLINT:"}, {"line": 223, "text": "\t\tsuccess = TrySimpleIntegerCast(value_ptr, size,"}, {"line": 224, "text": "\t\t                               static_cast<int16_t *>(vector_ptr[chunk_col_id])[number_of_rows], false);"}, {"line": 225, "text": "\t\tbreak;"}, {"line": 226, "text": "\tcase LogicalTypeId::INTEGER:"}, {"line": 227, "text": "\t\tsuccess = TrySimpleIntegerCast(value_ptr, size,"}, {"line": 228, "text": "\t\t                               static_cast<int32_t *>(vector_ptr[chunk_col_id])[number_of_rows], false);"}, {"line": 229, "text": "\t\tbreak;"}, {"line": 230, "text": "\tcase LogicalTypeId::BIGINT:"}, {"line": 231, "text": "\t\tsuccess = TrySimpleIntegerCast(value_ptr, size,"}, {"line": 232, "text": "\t\t                               static_cast<int64_t *>(vector_ptr[chunk_col_id])[number_of_rows], false);"}, {"line": 233, "text": "\t\tbreak;"}, {"line": 234, "text": "\tcase LogicalTypeId::UTINYINT:"}, {"line": 235, "text": "\t\tsuccess = TrySimpleIntegerCast<uint8_t, false>("}, {"line": 236, "text": "\t\t    value_ptr, size, static_cast<uint8_t *>(vector_ptr[chunk_col_id])[number_of_rows], false);"}, {"line": 237, "text": "\t\tbreak;"}, {"line": 238, "text": "\tcase LogicalTypeId::USMALLINT:"}, {"line": 239, "text": "\t\tsuccess = TrySimpleIntegerCast<uint16_t, false>("}, {"line": 240, "text": "\t\t    value_ptr, size, static_cast<uint16_t *>(vector_ptr[chunk_col_id])[number_of_rows], false);"}, {"line": 241, "text": "\t\tbreak;"}, {"line": 242, "text": "\tcase LogicalTypeId::UINTEGER:"}, {"line": 243, "text": "\t\tsuccess = TrySimpleIntegerCast<uint32_t, false>("}, {"line": 244, "text": "\t\t    value_ptr, size, static_cast<uint32_t *>(vector_ptr[chunk_col_id])[number_of_rows], false);"}, {"line": 245, "text": "\t\tbreak;"}, {"line": 246, "text": "\tcase LogicalTypeId::UBIGINT:"}, {"line": 247, "text": "\t\tsuccess = TrySimpleIntegerCast<uint64_t, false>("}, {"line": 248, "text": "\t\t    value_ptr, size, static_cast<uint64_t *>(vector_ptr[chunk_col_id])[number_of_rows], false);"}, {"line": 249, "text": "\t\tbreak;"}, {"line": 250, "text": "\tcase LogicalTypeId::DOUBLE:"}, {"line": 251, "text": "\t\tsuccess ="}, {"line": 252, "text": "\t\t    TryDoubleCast<double>(value_ptr, size, static_cast<double *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 253, "text": "\t\t                          false, state_machine.options.decimal_separator[0]);"}, {"line": 254, "text": "\t\tbreak;"}, {"line": 255, "text": "\tcase LogicalTypeId::FLOAT:"}, {"line": 256, "text": "\t\tsuccess = TryDoubleCast<float>(value_ptr, size, static_cast<float *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 257, "text": "\t\t                               false, state_machine.options.decimal_separator[0]);"}, {"line": 258, "text": "\t\tbreak;"}, {"line": 259, "text": "\tcase LogicalTypeId::DATE: {"}, {"line": 260, "text": "\t\tif (!date_format.Empty()) {"}, {"line": 261, "text": "\t\t\tsuccess = date_format.TryParseDate(value_ptr, size,"}, {"line": 262, "text": "\t\t\t                                   static_cast<date_t *>(vector_ptr[chunk_col_id])[number_of_rows]);"}, {"line": 263, "text": "\t\t} else {"}, {"line": 264, "text": "\t\t\tidx_t pos;"}, {"line": 265, "text": "\t\t\tbool special;"}, {"line": 266, "text": "\t\t\tsuccess = Date::TryConvertDate("}, {"line": 267, "text": "\t\t\t    value_ptr, size, pos, static_cast<date_t *>(vector_ptr[chunk_col_id])[number_of_rows], special, false);"}, {"line": 268, "text": "\t\t}"}, {"line": 269, "text": "\t\tbreak;"}, {"line": 270, "text": "\t}"}, {"line": 271, "text": "\tcase LogicalTypeId::TIME: {"}, {"line": 272, "text": "\t\tidx_t pos;"}, {"line": 273, "text": "\t\tsuccess = Time::TryConvertTime(value_ptr, size, pos,"}, {"line": 274, "text": "\t\t                               static_cast<dtime_t *>(vector_ptr[chunk_col_id])[number_of_rows], false);"}, {"line": 275, "text": "\t\tbreak;"}, {"line": 276, "text": "\t}"}, {"line": 277, "text": "\tcase LogicalTypeId::TIMESTAMP: {"}, {"line": 278, "text": "\t\tif (!timestamp_format.Empty()) {"}, {"line": 279, "text": "\t\t\tsuccess = timestamp_format.TryParseTimestamp("}, {"line": 280, "text": "\t\t\t    value_ptr, size, static_cast<timestamp_t *>(vector_ptr[chunk_col_id])[number_of_rows]);"}, {"line": 281, "text": "\t\t} else {"}, {"line": 282, "text": "\t\t\tsuccess = Timestamp::TryConvertTimestamp("}, {"line": 283, "text": "\t\t\t              value_ptr, size, static_cast<timestamp_t *>(vector_ptr[chunk_col_id])[number_of_rows]) =="}, {"line": 284, "text": "\t\t\t          TimestampCastResult::SUCCESS;"}, {"line": 285, "text": "\t\t}"}, {"line": 286, "text": "\t\tbreak;"}, {"line": 287, "text": "\t}"}, {"line": 288, "text": "\tcase LogicalTypeId::DECIMAL: {"}, {"line": 289, "text": "\t\tif (decimal_separator == ',') {"}, {"line": 290, "text": "\t\t\tswitch (parse_types[chunk_col_id].internal_type) {"}, {"line": 291, "text": "\t\t\tcase PhysicalType::INT16:"}, {"line": 292, "text": "\t\t\t\tsuccess = TryDecimalStringCast<int16_t, ','>("}, {"line": 293, "text": "\t\t\t\t    value_ptr, size, static_cast<int16_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 294, "text": "\t\t\t\t    parse_types[chunk_col_id].width, parse_types[chunk_col_id].scale);"}, {"line": 295, "text": "\t\t\t\tbreak;"}, {"line": 296, "text": "\t\t\tcase PhysicalType::INT32:"}, {"line": 297, "text": "\t\t\t\tsuccess = TryDecimalStringCast<int32_t, ','>("}, {"line": 298, "text": "\t\t\t\t    value_ptr, size, static_cast<int32_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 299, "text": "\t\t\t\t    parse_types[chunk_col_id].width, parse_types[chunk_col_id].scale);"}, {"line": 300, "text": "\t\t\t\tbreak;"}, {"line": 301, "text": "\t\t\tcase PhysicalType::INT64:"}, {"line": 302, "text": "\t\t\t\tsuccess = TryDecimalStringCast<int64_t, ','>("}, {"line": 303, "text": "\t\t\t\t    value_ptr, size, static_cast<int64_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 304, "text": "\t\t\t\t    parse_types[chunk_col_id].width, parse_types[chunk_col_id].scale);"}, {"line": 305, "text": "\t\t\t\tbreak;"}, {"line": 306, "text": "\t\t\tcase PhysicalType::INT128:"}, {"line": 307, "text": "\t\t\t\tsuccess = TryDecimalStringCast<hugeint_t, ','>("}, {"line": 308, "text": "\t\t\t\t    value_ptr, size, static_cast<hugeint_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 309, "text": "\t\t\t\t    parse_types[chunk_col_id].width, parse_types[chunk_col_id].scale);"}, {"line": 310, "text": "\t\t\t\tbreak;"}, {"line": 311, "text": "\t\t\tdefault:"}, {"line": 312, "text": "\t\t\t\tthrow InternalException(\"Invalid Physical Type for Decimal Value. Physical Type: \" +"}, {"line": 313, "text": "\t\t\t\t                        TypeIdToString(parse_types[chunk_col_id].internal_type));"}, {"line": 314, "text": "\t\t\t}"}, {"line": 315, "text": ""}, {"line": 316, "text": "\t\t} else if (decimal_separator == '.') {"}, {"line": 317, "text": "\t\t\tswitch (parse_types[chunk_col_id].internal_type) {"}, {"line": 318, "text": "\t\t\tcase PhysicalType::INT16:"}, {"line": 319, "text": "\t\t\t\tsuccess = TryDecimalStringCast(value_ptr, size,"}, {"line": 320, "text": "\t\t\t\t                               static_cast<int16_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 321, "text": "\t\t\t\t                               parse_types[chunk_col_id].width, parse_types[chunk_col_id].scale);"}, {"line": 322, "text": "\t\t\t\tbreak;"}, {"line": 323, "text": "\t\t\tcase PhysicalType::INT32:"}, {"line": 324, "text": "\t\t\t\tsuccess = TryDecimalStringCast(value_ptr, size,"}, {"line": 325, "text": "\t\t\t\t                               static_cast<int32_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 326, "text": "\t\t\t\t                               parse_types[chunk_col_id].width, parse_types[chunk_col_id].scale);"}, {"line": 327, "text": "\t\t\t\tbreak;"}, {"line": 328, "text": "\t\t\tcase PhysicalType::INT64:"}, {"line": 329, "text": "\t\t\t\tsuccess = TryDecimalStringCast(value_ptr, size,"}, {"line": 330, "text": "\t\t\t\t                               static_cast<int64_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 331, "text": "\t\t\t\t                               parse_types[chunk_col_id].width, parse_types[chunk_col_id].scale);"}, {"line": 332, "text": "\t\t\t\tbreak;"}, {"line": 333, "text": "\t\t\tcase PhysicalType::INT128:"}, {"line": 334, "text": "\t\t\t\tsuccess = TryDecimalStringCast(value_ptr, size,"}, {"line": 335, "text": "\t\t\t\t                               static_cast<hugeint_t *>(vector_ptr[chunk_col_id])[number_of_rows],"}, {"line": 336, "text": "\t\t\t\t                               parse_types[chunk_col_id].width, parse_types[chunk_col_id].scale);"}, {"line": 337, "text": "\t\t\t\tbreak;"}, {"line": 338, "text": "\t\t\tdefault:"}, {"line": 339, "text": "\t\t\t\tthrow InternalException(\"Invalid Physical Type for Decimal Value. Physical Type: \" +"}, {"line": 340, "text": "\t\t\t\t                        TypeIdToString(parse_types[chunk_col_id].internal_type));"}, {"line": 341, "text": "\t\t\t}"}, {"line": 342, "text": "\t\t} else {"}, {"line": 343, "text": "\t\t\tthrow InvalidInputException(\"Decimals can only have ',' and '.' as decimal separators\");"}, {"line": 344, "text": "\t\t}"}, {"line": 345, "text": "\t\tbreak;"}, {"line": 346, "text": "\t}"}, {"line": 347, "text": "\tdefault: {"}, {"line": 348, "text": "\t\t// By default, we add a string"}, {"line": 349, "text": "\t\t// We only evaluate if a string is utf8 valid, if it's actually a varchar"}, {"line": 350, "text": "\t\tif (parse_types[chunk_col_id].validate_utf8 &&"}, {"line": 351, "text": "\t\t    !Utf8Proc::IsValid(value_ptr, UnsafeNumericCast<uint32_t>(size))) {"}, {"line": 352, "text": "\t\t\tbool force_error = !state_machine.options.ignore_errors.GetValue() && sniffing;"}, {"line": 353, "text": "\t\t\t// Invalid unicode, we must error"}, {"line": 354, "text": "\t\t\tif (force_error) {"}, {"line": 355, "text": "\t\t\t\tHandleUnicodeError(cur_col_id, last_position);"}, {"line": 356, "text": "\t\t\t}"}, {"line": 357, "text": "\t\t\t// If we got here, we are ingoring errors, hence we must ignore this line."}, {"line": 358, "text": "\t\t\tcurrent_errors.Insert(CSVErrorType::INVALID_UNICODE, cur_col_id, chunk_col_id, last_position);"}, {"line": 359, "text": "\t\t\tbreak;"}, {"line": 360, "text": "\t\t}"}, {"line": 361, "text": "\t\tif (allocate) {"}, {"line": 362, "text": "\t\t\t// If it's a value produced over multiple buffers, we must allocate"}, {"line": 363, "text": "\t\t\tstatic_cast<string_t *>(vector_ptr[chunk_col_id])[number_of_rows] = StringVector::AddStringOrBlob("}, {"line": 364, "text": "\t\t\t    parse_chunk.data[chunk_col_id], string_t(value_ptr, UnsafeNumericCast<uint32_t>(size)));"}, {"line": 365, "text": "\t\t} else {"}, {"line": 366, "text": "\t\t\tstatic_cast<string_t *>(vector_ptr[chunk_col_id])[number_of_rows] ="}, {"line": 367, "text": "\t\t\t    string_t(value_ptr, UnsafeNumericCast<uint32_t>(size));"}, {"line": 368, "text": "\t\t}"}, {"line": 369, "text": "\t\tbreak;"}, {"line": 370, "text": "\t}"}, {"line": 371, "text": "\t}"}, {"line": 372, "text": "\tif (!success) {"}, {"line": 373, "text": "\t\tcurrent_errors.Insert(CSVErrorType::CAST_ERROR, cur_col_id, chunk_col_id, last_position);"}, {"line": 374, "text": "\t\tif (!state_machine.options.IgnoreErrors()) {"}, {"line": 375, "text": "\t\t\t// We have to write the cast error message."}, {"line": 376, "text": "\t\t\tstd::ostringstream error;"}, {"line": 377, "text": "\t\t\t// Casting Error Message"}, {"line": 378, "text": "\t\t\terror << \"Could not convert string \\\"\" << std::string(value_ptr, size) << \"\\\" to \\'\""}, {"line": 379, "text": "\t\t\t      << LogicalTypeIdToString(parse_types[chunk_col_id].type_id) << \"\\'\";"}, {"line": 380, "text": "\t\t\tcurrent_errors.ModifyErrorMessageOfLastError(error.str());"}, {"line": 381, "text": "\t\t}"}, {"line": 382, "text": "\t}"}, {"line": 383, "text": "\tcur_col_id++;"}, {"line": 384, "text": "\tchunk_col_id++;"}, {"line": 385, "text": "}"}, {"line": 386, "text": ""}, {"line": 387, "text": "DataChunk &StringValueResult::ToChunk() {"}, {"line": 388, "text": "\tparse_chunk.SetCardinality(number_of_rows);"}, {"line": 389, "text": "\treturn parse_chunk;"}, {"line": 390, "text": "}"}, {"line": 391, "text": ""}, {"line": 392, "text": "void StringValueResult::Reset() {"}, {"line": 393, "text": "\tif (number_of_rows == 0) {"}, {"line": 394, "text": "\t\treturn;"}, {"line": 395, "text": "\t}"}, {"line": 396, "text": "\tnumber_of_rows = 0;"}, {"line": 397, "text": "\tcur_col_id = 0;"}, {"line": 398, "text": "\tchunk_col_id = 0;"}, {"line": 399, "text": "\tfor (auto &v : validity_mask) {"}, {"line": 400, "text": "\t\tv->SetAllValid(result_size);"}, {"line": 401, "text": "\t}"}, {"line": 402, "text": "\t// We keep a reference to the buffer from our current iteration if it already exists"}, {"line": 403, "text": "\tshared_ptr<CSVBufferHandle> cur_buffer;"}, {"line": 404, "text": "\tif (buffer_handles.find(iterator.GetBufferIdx()) != buffer_handles.end()) {"}, {"line": 405, "text": "\t\tcur_buffer = buffer_handles[iterator.GetBufferIdx()];"}, {"line": 406, "text": "\t}"}, {"line": 407, "text": "\tbuffer_handles.clear();"}, {"line": 408, "text": "\tif (cur_buffer) {"}, {"line": 409, "text": "\t\tbuffer_handles[cur_buffer->buffer_idx] = cur_buffer;"}, {"line": 410, "text": "\t}"}, {"line": 411, "text": "\tcurrent_errors.Reset();"}, {"line": 412, "text": "\tborked_rows.clear();"}, {"line": 413, "text": "}"}, {"line": 414, "text": ""}, {"line": 415, "text": "void StringValueResult::AddQuotedValue(StringValueResult &result, const idx_t buffer_pos) {"}, {"line": 416, "text": "\tif (result.escaped) {"}, {"line": 417, "text": "\t\tif (result.projecting_columns) {"}, {"line": 418, "text": "\t\t\tif (!result.projected_columns[result.cur_col_id]) {"}, {"line": 419, "text": "\t\t\t\tresult.cur_col_id++;"}, {"line": 420, "text": "\t\t\t\tresult.quoted = false;"}, {"line": 421, "text": "\t\t\t\tresult.escaped = false;"}, {"line": 422, "text": "\t\t\t\treturn;"}, {"line": 423, "text": "\t\t\t}"}, {"line": 424, "text": "\t\t}"}, {"line": 425, "text": "\t\tif (!result.HandleTooManyColumnsError(result.buffer_ptr + result.quoted_position + 1,"}, {"line": 426, "text": "\t\t                                      buffer_pos - result.quoted_position - 2)) {"}, {"line": 427, "text": "\t\t\t// If it's an escaped value we have to remove all the escapes, this is not really great"}, {"line": 428, "text": "\t\t\tauto value = StringValueScanner::RemoveEscape("}, {"line": 429, "text": "\t\t\t    result.buffer_ptr + result.quoted_position + 1, buffer_pos - result.quoted_position - 2,"}, {"line": 430, "text": "\t\t\t    result.state_machine.dialect_options.state_machine_options.escape.GetValue(),"}, {"line": 431, "text": "\t\t\t    result.parse_chunk.data[result.chunk_col_id]);"}, {"line": 432, "text": "\t\t\tresult.AddValueToVector(value.GetData(), value.GetSize());"}, {"line": 433, "text": "\t\t}"}, {"line": 434, "text": "\t} else {"}, {"line": 435, "text": "\t\tif (buffer_pos < result.last_position.buffer_pos + 2) {"}, {"line": 436, "text": "\t\t\t// empty value"}, {"line": 437, "text": "\t\t\tauto value = string_t();"}, {"line": 438, "text": "\t\t\tresult.AddValueToVector(value.GetData(), value.GetSize());"}, {"line": 439, "text": "\t\t} else {"}, {"line": 440, "text": "\t\t\tresult.AddValueToVector(result.buffer_ptr + result.quoted_position + 1,"}, {"line": 441, "text": "\t\t\t                        buffer_pos - result.quoted_position - 2);"}, {"line": 442, "text": "\t\t}"}, {"line": 443, "text": "\t}"}, {"line": 444, "text": "\tresult.quoted = false;"}, {"line": 445, "text": "\tresult.escaped = false;"}, {"line": 446, "text": "}"}, {"line": 447, "text": ""}, {"line": 448, "text": "void StringValueResult::AddValue(StringValueResult &result, const idx_t buffer_pos) {"}, {"line": 449, "text": "\tif (result.last_position.buffer_pos > buffer_pos) {"}, {"line": 450, "text": "\t\treturn;"}, {"line": 451, "text": "\t}"}, {"line": 452, "text": "\tif (result.quoted) {"}, {"line": 453, "text": "\t\tStringValueResult::AddQuotedValue(result, buffer_pos);"}, {"line": 454, "text": "\t} else {"}, {"line": 455, "text": "\t\tresult.AddValueToVector(result.buffer_ptr + result.last_position.buffer_pos,"}, {"line": 456, "text": "\t\t                        buffer_pos - result.last_position.buffer_pos);"}, {"line": 457, "text": "\t}"}, {"line": 458, "text": "\tresult.last_position.buffer_pos = buffer_pos + 1;"}, {"line": 459, "text": "}"}, {"line": 460, "text": ""}, {"line": 461, "text": "void StringValueResult::HandleUnicodeError(idx_t col_idx, LinePosition &error_position) {"}, {"line": 462, "text": ""}, {"line": 463, "text": "\tbool first_nl;"}, {"line": 464, "text": "\tauto borked_line = current_line_position.ReconstructCurrentLine(first_nl, buffer_handles);"}, {"line": 465, "text": "\tLinesPerBoundary lines_per_batch(iterator.GetBoundaryIdx(), lines_read);"}, {"line": 466, "text": "\tif (current_line_position.begin == error_position) {"}, {"line": 467, "text": "\t\tauto csv_error = CSVError::InvalidUTF8(state_machine.options, col_idx, lines_per_batch, borked_line,"}, {"line": 468, "text": "\t\t                                       current_line_position.begin.GetGlobalPosition(requested_size, first_nl),"}, {"line": 469, "text": "\t\t                                       error_position.GetGlobalPosition(requested_size, first_nl));"}, {"line": 470, "text": "\t\terror_handler.Error(csv_error, true);"}, {"line": 471, "text": "\t} else {"}, {"line": 472, "text": "\t\tauto csv_error = CSVError::InvalidUTF8(state_machine.options, col_idx, lines_per_batch, borked_line,"}, {"line": 473, "text": "\t\t                                       current_line_position.begin.GetGlobalPosition(requested_size, first_nl),"}, {"line": 474, "text": "\t\t                                       error_position.GetGlobalPosition(requested_size));"}, {"line": 475, "text": "\t\terror_handler.Error(csv_error, true);"}, {"line": 476, "text": "\t}"}, {"line": 477, "text": "}"}, {"line": 478, "text": ""}, {"line": 479, "text": "bool LineError::HandleErrors(StringValueResult &result) {"}, {"line": 480, "text": "\tif (ignore_errors && is_error_in_line && !result.figure_out_new_line) {"}, {"line": 481, "text": "\t\tresult.cur_col_id = 0;"}, {"line": 482, "text": "\t\tresult.chunk_col_id = 0;"}, {"line": 483, "text": "\t\tresult.number_of_rows--;"}, {"line": 484, "text": "\t\tReset();"}, {"line": 485, "text": "\t\treturn true;"}, {"line": 486, "text": "\t}"}, {"line": 487, "text": "\t// Reconstruct CSV Line"}, {"line": 488, "text": "\tfor (auto &cur_error : current_errors) {"}, {"line": 489, "text": "\t\tLinesPerBoundary lines_per_batch(result.iterator.GetBoundaryIdx(), result.lines_read);"}, {"line": 490, "text": "\t\tbool first_nl;"}, {"line": 491, "text": "\t\tauto borked_line = result.current_line_position.ReconstructCurrentLine(first_nl, result.buffer_handles);"}, {"line": 492, "text": "\t\tCSVError csv_error;"}, {"line": 493, "text": "\t\tauto col_idx = cur_error.col_idx;"}, {"line": 494, "text": "\t\tauto &line_pos = cur_error.error_position;"}, {"line": 495, "text": ""}, {"line": 496, "text": "\t\tswitch (cur_error.type) {"}, {"line": 497, "text": "\t\tcase CSVErrorType::TOO_MANY_COLUMNS:"}, {"line": 498, "text": "\t\tcase CSVErrorType::TOO_FEW_COLUMNS:"}, {"line": 499, "text": "\t\t\tif (result.current_line_position.begin == line_pos) {"}, {"line": 500, "text": "\t\t\t\tcsv_error = CSVError::IncorrectColumnAmountError("}, {"line": 501, "text": "\t\t\t\t    result.state_machine.options, col_idx, lines_per_batch, borked_line,"}, {"line": 502, "text": "\t\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 503, "text": "\t\t\t\t    line_pos.GetGlobalPosition(result.requested_size, first_nl));"}, {"line": 504, "text": "\t\t\t} else {"}, {"line": 505, "text": "\t\t\t\tcsv_error = CSVError::IncorrectColumnAmountError("}, {"line": 506, "text": "\t\t\t\t    result.state_machine.options, col_idx, lines_per_batch, borked_line,"}, {"line": 507, "text": "\t\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 508, "text": "\t\t\t\t    line_pos.GetGlobalPosition(result.requested_size));"}, {"line": 509, "text": "\t\t\t}"}, {"line": 510, "text": "\t\t\tbreak;"}, {"line": 511, "text": "\t\tcase CSVErrorType::INVALID_UNICODE: {"}, {"line": 512, "text": "\t\t\tif (result.current_line_position.begin == line_pos) {"}, {"line": 513, "text": "\t\t\t\tcsv_error = CSVError::InvalidUTF8("}, {"line": 514, "text": "\t\t\t\t    result.state_machine.options, col_idx, lines_per_batch, borked_line,"}, {"line": 515, "text": "\t\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 516, "text": "\t\t\t\t    line_pos.GetGlobalPosition(result.requested_size, first_nl));"}, {"line": 517, "text": "\t\t\t} else {"}, {"line": 518, "text": "\t\t\t\tcsv_error = CSVError::InvalidUTF8("}, {"line": 519, "text": "\t\t\t\t    result.state_machine.options, col_idx, lines_per_batch, borked_line,"}, {"line": 520, "text": "\t\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 521, "text": "\t\t\t\t    line_pos.GetGlobalPosition(result.requested_size));"}, {"line": 522, "text": "\t\t\t}"}, {"line": 523, "text": "\t\t\tbreak;"}, {"line": 524, "text": "\t\t}"}, {"line": 525, "text": "\t\tcase CSVErrorType::UNTERMINATED_QUOTES:"}, {"line": 526, "text": "\t\t\tif (result.current_line_position.begin == line_pos) {"}, {"line": 527, "text": "\t\t\t\tcsv_error = CSVError::UnterminatedQuotesError("}, {"line": 528, "text": "\t\t\t\t    result.state_machine.options, col_idx, lines_per_batch, borked_line,"}, {"line": 529, "text": "\t\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 530, "text": "\t\t\t\t    line_pos.GetGlobalPosition(result.requested_size, first_nl));"}, {"line": 531, "text": "\t\t\t} else {"}, {"line": 532, "text": "\t\t\t\tcsv_error = CSVError::UnterminatedQuotesError("}, {"line": 533, "text": "\t\t\t\t    result.state_machine.options, col_idx, lines_per_batch, borked_line,"}, {"line": 534, "text": "\t\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 535, "text": "\t\t\t\t    line_pos.GetGlobalPosition(result.requested_size));"}, {"line": 536, "text": "\t\t\t}"}, {"line": 537, "text": "\t\t\tbreak;"}, {"line": 538, "text": "\t\tcase CSVErrorType::CAST_ERROR:"}, {"line": 539, "text": "\t\t\tif (result.current_line_position.begin == line_pos) {"}, {"line": 540, "text": "\t\t\t\tcsv_error = CSVError::CastError("}, {"line": 541, "text": "\t\t\t\t    result.state_machine.options, result.names[cur_error.col_idx], cur_error.error_message,"}, {"line": 542, "text": "\t\t\t\t    cur_error.col_idx, borked_line, lines_per_batch,"}, {"line": 543, "text": "\t\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 544, "text": "\t\t\t\t    line_pos.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 545, "text": "\t\t\t\t    result.parse_types[cur_error.chunk_idx].type_id);"}, {"line": 546, "text": "\t\t\t} else {"}, {"line": 547, "text": "\t\t\t\tcsv_error = CSVError::CastError("}, {"line": 548, "text": "\t\t\t\t    result.state_machine.options, result.names[cur_error.col_idx], cur_error.error_message,"}, {"line": 549, "text": "\t\t\t\t    cur_error.col_idx, borked_line, lines_per_batch,"}, {"line": 550, "text": "\t\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl),"}, {"line": 551, "text": "\t\t\t\t    line_pos.GetGlobalPosition(result.requested_size), result.parse_types[cur_error.chunk_idx].type_id);"}, {"line": 552, "text": "\t\t\t}"}, {"line": 553, "text": "\t\t\tbreak;"}, {"line": 554, "text": "\t\tcase CSVErrorType::MAXIMUM_LINE_SIZE:"}, {"line": 555, "text": "\t\t\tcsv_error = CSVError::LineSizeError("}, {"line": 556, "text": "\t\t\t    result.state_machine.options, cur_error.current_line_size, lines_per_batch, borked_line,"}, {"line": 557, "text": "\t\t\t    result.current_line_position.begin.GetGlobalPosition(result.requested_size, first_nl));"}, {"line": 558, "text": "\t\t\tbreak;"}, {"line": 559, "text": "\t\tdefault:"}, {"line": 560, "text": "\t\t\tthrow InvalidInputException(\"CSV Error not allowed when inserting row\");"}, {"line": 561, "text": "\t\t}"}, {"line": 562, "text": "\t\tresult.error_handler.Error(csv_error);"}, {"line": 563, "text": "\t}"}, {"line": 564, "text": "\tif (is_error_in_line) {"}, {"line": 565, "text": "\t\tresult.borked_rows.insert(result.number_of_rows);"}, {"line": 566, "text": "\t\tresult.cur_col_id = 0;"}, {"line": 567, "text": "\t\tresult.chunk_col_id = 0;"}, {"line": 568, "text": "\t\tReset();"}, {"line": 569, "text": "\t\treturn true;"}, {"line": 570, "text": "\t}"}, {"line": 571, "text": "\treturn false;"}, {"line": 572, "text": "}"}, {"line": 573, "text": ""}, {"line": 574, "text": "void StringValueResult::QuotedNewLine(StringValueResult &result) {"}, {"line": 575, "text": "\tresult.quoted_new_line = true;"}, {"line": 576, "text": "}"}, {"line": 577, "text": ""}, {"line": 578, "text": "void StringValueResult::NullPaddingQuotedNewlineCheck() {"}, {"line": 579, "text": "\t// We do some checks for null_padding correctness"}, {"line": 580, "text": "\tif (state_machine.options.null_padding && iterator.IsBoundarySet() && quoted_new_line) {"}, {"line": 581, "text": "\t\t// If we have null_padding set, we found a quoted new line, we are scanning the file in parallel; We error."}, {"line": 582, "text": "\t\tLinesPerBoundary lines_per_batch(iterator.GetBoundaryIdx(), lines_read);"}, {"line": 583, "text": "\t\tauto csv_error = CSVError::NullPaddingFail(state_machine.options, lines_per_batch);"}, {"line": 584, "text": "\t\terror_handler.Error(csv_error);"}, {"line": 585, "text": "\t}"}, {"line": 586, "text": "}"}, {"line": 587, "text": ""}, {"line": 588, "text": "//! Reconstructs the current line to be used in error messages"}, {"line": 589, "text": "string FullLinePosition::ReconstructCurrentLine(bool &first_char_nl,"}, {"line": 590, "text": "                                                unordered_map<idx_t, shared_ptr<CSVBufferHandle>> &buffer_handles) {"}, {"line": 591, "text": "\tstring result;"}, {"line": 592, "text": "\tif (end.buffer_idx == begin.buffer_idx) {"}, {"line": 593, "text": "\t\tif (buffer_handles.find(end.buffer_idx) == buffer_handles.end()) {"}, {"line": 594, "text": "\t\t\tthrow InternalException(\"CSV Buffer is not available to reconstruct CSV Line, please open an issue with \""}, {"line": 595, "text": "\t\t\t                        \"your query and dataset.\");"}, {"line": 596, "text": "\t\t}"}, {"line": 597, "text": "\t\tauto buffer = buffer_handles[begin.buffer_idx]->Ptr();"}, {"line": 598, "text": "\t\tfirst_char_nl = buffer[begin.buffer_pos] == '\\n' || buffer[begin.buffer_pos] == '\\r';"}, {"line": 599, "text": "\t\tfor (idx_t i = begin.buffer_pos + first_char_nl; i < end.buffer_pos; i++) {"}, {"line": 600, "text": "\t\t\tresult += buffer[i];"}, {"line": 601, "text": "\t\t}"}, {"line": 602, "text": "\t} else {"}, {"line": 603, "text": "\t\tif (buffer_handles.find(begin.buffer_idx) == buffer_handles.end() ||"}, {"line": 604, "text": "\t\t    buffer_handles.find(end.buffer_idx) == buffer_handles.end()) {"}, {"line": 605, "text": "\t\t\tthrow InternalException(\"CSV Buffer is not available to reconstruct CSV Line, please open an issue with \""}, {"line": 606, "text": "\t\t\t                        \"your query and dataset.\");"}, {"line": 607, "text": "\t\t}"}, {"line": 608, "text": "\t\tauto first_buffer = buffer_handles[begin.buffer_idx]->Ptr();"}, {"line": 609, "text": "\t\tauto first_buffer_size = buffer_handles[begin.buffer_idx]->actual_size;"}, {"line": 610, "text": "\t\tauto second_buffer = buffer_handles[end.buffer_idx]->Ptr();"}, {"line": 611, "text": "\t\tfirst_char_nl = first_buffer[begin.buffer_pos] == '\\n' || first_buffer[begin.buffer_pos] == '\\r';"}, {"line": 612, "text": "\t\tfor (idx_t i = begin.buffer_pos + first_char_nl; i < first_buffer_size; i++) {"}, {"line": 613, "text": "\t\t\tresult += first_buffer[i];"}, {"line": 614, "text": "\t\t}"}, {"line": 615, "text": "\t\tfor (idx_t i = 0; i < end.buffer_pos; i++) {"}, {"line": 616, "text": "\t\t\tresult += second_buffer[i];"}, {"line": 617, "text": "\t\t}"}, {"line": 618, "text": "\t}"}, {"line": 619, "text": "\t// sanitize borked line"}, {"line": 620, "text": "\tstd::vector<char> char_array(result.begin(), result.end());"}, {"line": 621, "text": "\tchar_array.push_back('\\0'); // Null-terminate the character array"}, {"line": 622, "text": "\tUtf8Proc::MakeValid(&char_array[0], char_array.size());"}, {"line": 623, "text": "\tresult = {char_array.begin(), char_array.end() - 1};"}, {"line": 624, "text": "\treturn result;"}, {"line": 625, "text": "}"}, {"line": 626, "text": ""}, {"line": 627, "text": "bool StringValueResult::AddRowInternal() {"}, {"line": 628, "text": "\tLinePosition current_line_start = {iterator.pos.buffer_idx, iterator.pos.buffer_pos, buffer_size};"}, {"line": 629, "text": "\tidx_t current_line_size = current_line_start - current_line_position.end;"}, {"line": 630, "text": "\tif (store_line_size) {"}, {"line": 631, "text": "\t\terror_handler.NewMaxLineSize(current_line_size);"}, {"line": 632, "text": "\t}"}, {"line": 633, "text": "\tcurrent_line_position.begin = current_line_position.end;"}, {"line": 634, "text": "\tcurrent_line_position.end = current_line_start;"}, {"line": 635, "text": "\tif (current_line_size > state_machine.options.maximum_line_size) {"}, {"line": 636, "text": "\t\tcurrent_errors.Insert(CSVErrorType::MAXIMUM_LINE_SIZE, 1, chunk_col_id, last_position, current_line_size);"}, {"line": 637, "text": "\t}"}, {"line": 638, "text": "\tif (!state_machine.options.null_padding) {"}, {"line": 639, "text": "\t\tfor (idx_t col_idx = cur_col_id; col_idx < number_of_columns; col_idx++) {"}, {"line": 640, "text": "\t\t\tcurrent_errors.Insert(CSVErrorType::TOO_FEW_COLUMNS, col_idx - 1, chunk_col_id, last_position);"}, {"line": 641, "text": "\t\t}"}, {"line": 642, "text": "\t}"}, {"line": 643, "text": ""}, {"line": 644, "text": "\tif (current_errors.HandleErrors(*this)) {"}, {"line": 645, "text": "\t\tline_positions_per_row[number_of_rows] = current_line_position;"}, {"line": 646, "text": "\t\tnumber_of_rows++;"}, {"line": 647, "text": "\t\tif (number_of_rows >= result_size) {"}, {"line": 648, "text": "\t\t\t// We have a full chunk"}, {"line": 649, "text": "\t\t\treturn true;"}, {"line": 650, "text": "\t\t}"}, {"line": 651, "text": "\t\treturn false;"}, {"line": 652, "text": "\t}"}, {"line": 653, "text": "\tNullPaddingQuotedNewlineCheck();"}, {"line": 654, "text": "\tquoted_new_line = false;"}, {"line": 655, "text": "\t// We need to check if we are getting the correct number of columns here."}, {"line": 656, "text": "\t// If columns are correct, we add it, and that's it."}, {"line": 657, "text": "\tif (cur_col_id != number_of_columns) {"}, {"line": 658, "text": "\t\t// We have too few columns:"}, {"line": 659, "text": "\t\tif (null_padding) {"}, {"line": 660, "text": "\t\t\twhile (cur_col_id < number_of_columns) {"}, {"line": 661, "text": "\t\t\t\tbool empty = false;"}, {"line": 662, "text": "\t\t\t\tif (cur_col_id < state_machine.options.force_not_null.size()) {"}, {"line": 663, "text": "\t\t\t\t\tempty = state_machine.options.force_not_null[cur_col_id];"}, {"line": 664, "text": "\t\t\t\t}"}, {"line": 665, "text": "\t\t\t\tif (projecting_columns) {"}, {"line": 666, "text": "\t\t\t\t\tif (!projected_columns[cur_col_id]) {"}, {"line": 667, "text": "\t\t\t\t\t\tcur_col_id++;"}, {"line": 668, "text": "\t\t\t\t\t\tcontinue;"}, {"line": 669, "text": "\t\t\t\t\t}"}, {"line": 670, "text": "\t\t\t\t}"}, {"line": 671, "text": "\t\t\t\tif (empty) {"}, {"line": 672, "text": "\t\t\t\t\tstatic_cast<string_t *>(vector_ptr[chunk_col_id])[number_of_rows] = string_t();"}, {"line": 673, "text": "\t\t\t\t} else {"}, {"line": 674, "text": "\t\t\t\t\tvalidity_mask[chunk_col_id]->SetInvalid(number_of_rows);"}, {"line": 675, "text": "\t\t\t\t}"}, {"line": 676, "text": "\t\t\t\tcur_col_id++;"}, {"line": 677, "text": "\t\t\t\tchunk_col_id++;"}, {"line": 678, "text": "\t\t\t}"}, {"line": 679, "text": "\t\t} else {"}, {"line": 680, "text": "\t\t\t// If we are not null-padding this is an error"}, {"line": 681, "text": "\t\t\tif (!state_machine.options.IgnoreErrors()) {"}, {"line": 682, "text": "\t\t\t\tbool first_nl;"}, {"line": 683, "text": "\t\t\t\tauto borked_line = current_line_position.ReconstructCurrentLine(first_nl, buffer_handles);"}, {"line": 684, "text": "\t\t\t\tLinesPerBoundary lines_per_batch(iterator.GetBoundaryIdx(), lines_read);"}, {"line": 685, "text": "\t\t\t\tif (current_line_position.begin == last_position) {"}, {"line": 686, "text": "\t\t\t\t\tauto csv_error = CSVError::IncorrectColumnAmountError("}, {"line": 687, "text": "\t\t\t\t\t    state_machine.options, cur_col_id - 1, lines_per_batch, borked_line,"}, {"line": 688, "text": "\t\t\t\t\t    current_line_position.begin.GetGlobalPosition(requested_size, first_nl),"}, {"line": 689, "text": "\t\t\t\t\t    last_position.GetGlobalPosition(requested_size, first_nl));"}, {"line": 690, "text": "\t\t\t\t\terror_handler.Error(csv_error);"}, {"line": 691, "text": "\t\t\t\t} else {"}, {"line": 692, "text": "\t\t\t\t\tauto csv_error = CSVError::IncorrectColumnAmountError("}, {"line": 693, "text": "\t\t\t\t\t    state_machine.options, cur_col_id - 1, lines_per_batch, borked_line,"}, {"line": 694, "text": "\t\t\t\t\t    current_line_position.begin.GetGlobalPosition(requested_size, first_nl),"}, {"line": 695, "text": "\t\t\t\t\t    last_position.GetGlobalPosition(requested_size));"}, {"line": 696, "text": "\t\t\t\t\terror_handler.Error(csv_error);"}, {"line": 697, "text": "\t\t\t\t}"}, {"line": 698, "text": "\t\t\t}"}, {"line": 699, "text": "\t\t\t// If we are here we ignore_errors, so we delete this line"}, {"line": 700, "text": "\t\t\tnumber_of_rows--;"}, {"line": 701, "text": "\t\t}"}, {"line": 702, "text": "\t}"}, {"line": 703, "text": "\tline_positions_per_row[number_of_rows] = current_line_position;"}, {"line": 704, "text": "\tcur_col_id = 0;"}, {"line": 705, "text": "\tchunk_col_id = 0;"}, {"line": 706, "text": "\tnumber_of_rows++;"}, {"line": 707, "text": "\tif (number_of_rows >= result_size) {"}, {"line": 708, "text": "\t\t// We have a full chunk"}, {"line": 709, "text": "\t\treturn true;"}, {"line": 710, "text": "\t}"}, {"line": 711, "text": "\treturn false;"}, {"line": 712, "text": "}"}, {"line": 713, "text": ""}, {"line": 714, "text": "bool StringValueResult::AddRow(StringValueResult &result, const idx_t buffer_pos) {"}, {"line": 715, "text": "\tif (result.last_position.buffer_pos <= buffer_pos) {"}, {"line": 716, "text": "\t\t// We add the value"}, {"line": 717, "text": "\t\tif (result.quoted) {"}, {"line": 718, "text": "\t\t\tStringValueResult::AddQuotedValue(result, buffer_pos);"}, {"line": 719, "text": "\t\t} else {"}, {"line": 720, "text": "\t\t\tresult.AddValueToVector(result.buffer_ptr + result.last_position.buffer_pos,"}, {"line": 721, "text": "\t\t\t                        buffer_pos - result.last_position.buffer_pos);"}, {"line": 722, "text": "\t\t}"}, {"line": 723, "text": "\t\tif (result.state_machine.dialect_options.state_machine_options.new_line == NewLineIdentifier::CARRY_ON) {"}, {"line": 724, "text": "\t\t\tif (result.states.states[1] == CSVState::RECORD_SEPARATOR) {"}, {"line": 725, "text": "\t\t\t\t// Even though this is marked as a carry on, this is a hippie mixie"}, {"line": 726, "text": "\t\t\t\tresult.last_position.buffer_pos = buffer_pos + 1;"}, {"line": 727, "text": "\t\t\t} else {"}, {"line": 728, "text": "\t\t\t\tresult.last_position.buffer_pos = buffer_pos + 2;"}, {"line": 729, "text": "\t\t\t}"}, {"line": 730, "text": "\t\t} else {"}, {"line": 731, "text": "\t\t\tresult.last_position.buffer_pos = buffer_pos + 1;"}, {"line": 732, "text": "\t\t}"}, {"line": 733, "text": "\t}"}, {"line": 734, "text": ""}, {"line": 735, "text": "\t// We add the value"}, {"line": 736, "text": "\treturn result.AddRowInternal();"}, {"line": 737, "text": "}"}, {"line": 738, "text": ""}, {"line": 739, "text": "void StringValueResult::InvalidState(StringValueResult &result) {"}, {"line": 740, "text": "\tbool force_error = !result.state_machine.options.ignore_errors.GetValue() && result.sniffing;"}, {"line": 741, "text": "\t// Invalid unicode, we must error"}, {"line": 742, "text": "\tif (force_error) {"}, {"line": 743, "text": "\t\tresult.HandleUnicodeError(result.cur_col_id, result.last_position);"}, {"line": 744, "text": "\t}"}, {"line": 745, "text": "\tresult.current_errors.Insert(CSVErrorType::UNTERMINATED_QUOTES, result.cur_col_id, result.chunk_col_id,"}, {"line": 746, "text": "\t                             result.last_position);"}, {"line": 747, "text": "}"}, {"line": 748, "text": ""}, {"line": 749, "text": "bool StringValueResult::EmptyLine(StringValueResult &result, const idx_t buffer_pos) {"}, {"line": 750, "text": "\t// We care about empty lines if this is a single column csv file"}, {"line": 751, "text": "\tresult.last_position = {result.iterator.pos.buffer_idx, result.iterator.pos.buffer_pos + 1, result.buffer_size};"}, {"line": 752, "text": "\tif (result.states.IsCarriageReturn() &&"}, {"line": 753, "text": "\t    result.state_machine.dialect_options.state_machine_options.new_line == NewLineIdentifier::CARRY_ON) {"}, {"line": 754, "text": "\t\tresult.last_position.buffer_pos++;"}, {"line": 755, "text": "\t}"}, {"line": 756, "text": "\tif (result.number_of_columns == 1) {"}, {"line": 757, "text": "\t\tfor (idx_t i = 0; i < result.null_str_count; i++) {"}, {"line": 758, "text": "\t\t\tif (result.null_str_size[i] == 0) {"}, {"line": 759, "text": "\t\t\t\tbool empty = false;"}, {"line": 760, "text": "\t\t\t\tif (!result.state_machine.options.force_not_null.empty()) {"}, {"line": 761, "text": "\t\t\t\t\tempty = result.state_machine.options.force_not_null[0];"}, {"line": 762, "text": "\t\t\t\t}"}, {"line": 763, "text": "\t\t\t\tif (empty) {"}, {"line": 764, "text": "\t\t\t\t\tstatic_cast<string_t *>(result.vector_ptr[0])[result.number_of_rows] = string_t();"}, {"line": 765, "text": "\t\t\t\t} else {"}, {"line": 766, "text": "\t\t\t\t\tresult.validity_mask[0]->SetInvalid(result.number_of_rows);"}, {"line": 767, "text": "\t\t\t\t}"}, {"line": 768, "text": "\t\t\t\tresult.number_of_rows++;"}, {"line": 769, "text": "\t\t\t}"}, {"line": 770, "text": "\t\t}"}, {"line": 771, "text": "\t\tif (result.number_of_rows >= result.result_size) {"}, {"line": 772, "text": "\t\t\t// We have a full chunk"}, {"line": 773, "text": "\t\t\treturn true;"}, {"line": 774, "text": "\t\t}"}, {"line": 775, "text": "\t}"}, {"line": 776, "text": "\treturn false;"}, {"line": 777, "text": "}"}, {"line": 778, "text": ""}, {"line": 779, "text": "StringValueScanner::StringValueScanner(idx_t scanner_idx_p, const shared_ptr<CSVBufferManager> &buffer_manager,"}, {"line": 780, "text": "                                       const shared_ptr<CSVStateMachine> &state_machine,"}, {"line": 781, "text": "                                       const shared_ptr<CSVErrorHandler> &error_handler,"}, {"line": 782, "text": "                                       const shared_ptr<CSVFileScan> &csv_file_scan, bool sniffing,"}, {"line": 783, "text": "                                       CSVIterator boundary, bool figure_out_nl)"}, {"line": 784, "text": "    : BaseScanner(buffer_manager, state_machine, error_handler, sniffing, csv_file_scan, boundary),"}, {"line": 785, "text": "      scanner_idx(scanner_idx_p),"}, {"line": 786, "text": "      result(states, *state_machine, cur_buffer_handle, BufferAllocator::Get(buffer_manager->context), figure_out_nl,"}, {"line": 787, "text": "             iterator.pos.buffer_pos, *error_handler, iterator,"}, {"line": 788, "text": "             buffer_manager->context.client_data->debug_set_max_line_length, csv_file_scan, lines_read, sniffing) {"}, {"line": 789, "text": "}"}, {"line": 790, "text": ""}, {"line": 791, "text": "StringValueScanner::StringValueScanner(const shared_ptr<CSVBufferManager> &buffer_manager,"}, {"line": 792, "text": "                                       const shared_ptr<CSVStateMachine> &state_machine,"}, {"line": 793, "text": "                                       const shared_ptr<CSVErrorHandler> &error_handler, CSVIterator boundary)"}, {"line": 794, "text": "    : BaseScanner(buffer_manager, state_machine, error_handler, false, nullptr, boundary), scanner_idx(0),"}, {"line": 795, "text": "      result(states, *state_machine, cur_buffer_handle, Allocator::DefaultAllocator(), false, iterator.pos.buffer_pos,"}, {"line": 796, "text": "             *error_handler, iterator, buffer_manager->context.client_data->debug_set_max_line_length, csv_file_scan,"}, {"line": 797, "text": "             lines_read, sniffing) {"}, {"line": 798, "text": "}"}, {"line": 799, "text": ""}, {"line": 800, "text": "unique_ptr<StringValueScanner> StringValueScanner::GetCSVScanner(ClientContext &context, CSVReaderOptions &options) {"}, {"line": 801, "text": "\t// Its possible we might have to do some skipping first"}, {"line": 802, "text": "\tauto state_machine = make_shared_ptr<CSVStateMachine>(options, options.dialect_options.state_machine_options,"}, {"line": 803, "text": "\t                                                      CSVStateMachineCache::Get(context));"}, {"line": 804, "text": ""}, {"line": 805, "text": "\tstate_machine->dialect_options.num_cols = options.dialect_options.num_cols;"}, {"line": 806, "text": "\tstate_machine->dialect_options.header = options.dialect_options.header;"}, {"line": 807, "text": "\tauto buffer_manager = make_shared_ptr<CSVBufferManager>(context, options, options.file_path, 0);"}, {"line": 808, "text": "\tidx_t rows_to_skip = state_machine->options.GetSkipRows() + state_machine->options.GetHeader();"}, {"line": 809, "text": "\tauto it = BaseScanner::SkipCSVRows(buffer_manager, state_machine, rows_to_skip);"}, {"line": 810, "text": "\tauto scanner = make_uniq<StringValueScanner>(buffer_manager, state_machine, make_shared_ptr<CSVErrorHandler>(), it);"}, {"line": 811, "text": "\tscanner->csv_file_scan = make_shared_ptr<CSVFileScan>(context, options.file_path, options);"}, {"line": 812, "text": "\tscanner->csv_file_scan->InitializeProjection();"}, {"line": 813, "text": "\treturn scanner;"}, {"line": 814, "text": "}"}, {"line": 815, "text": ""}, {"line": 816, "text": "bool StringValueScanner::FinishedIterator() {"}, {"line": 817, "text": "\treturn iterator.done;"}, {"line": 818, "text": "}"}, {"line": 819, "text": ""}, {"line": 820, "text": "StringValueResult &StringValueScanner::ParseChunk() {"}, {"line": 821, "text": "\tresult.Reset();"}, {"line": 822, "text": "\tParseChunkInternal(result);"}, {"line": 823, "text": "\treturn result;"}, {"line": 824, "text": "}"}, {"line": 825, "text": ""}, {"line": 826, "text": "void StringValueScanner::Flush(DataChunk &insert_chunk) {"}, {"line": 827, "text": "\tauto &process_result = ParseChunk();"}, {"line": 828, "text": "\t// First Get Parsed Chunk"}, {"line": 829, "text": "\tauto &parse_chunk = process_result.ToChunk();"}, {"line": 830, "text": "\t// We have to check if we got to error"}, {"line": 831, "text": "\terror_handler->ErrorIfNeeded();"}, {"line": 832, "text": "\tif (parse_chunk.size() == 0) {"}, {"line": 833, "text": "\t\treturn;"}, {"line": 834, "text": "\t}"}, {"line": 835, "text": "\t// convert the columns in the parsed chunk to the types of the table"}, {"line": 836, "text": "\tinsert_chunk.SetCardinality(parse_chunk);"}, {"line": 837, "text": ""}, {"line": 838, "text": "\t// We keep track of the borked lines, in case we are ignoring errors"}, {"line": 839, "text": "\tD_ASSERT(csv_file_scan);"}, {"line": 840, "text": ""}, {"line": 841, "text": "\tauto &reader_data = csv_file_scan->reader_data;"}, {"line": 842, "text": "\t// Now Do the cast-aroo"}, {"line": 843, "text": "\tfor (idx_t c = 0; c < reader_data.column_ids.size(); c++) {"}, {"line": 844, "text": "\t\tidx_t col_idx = c;"}, {"line": 845, "text": "\t\tidx_t result_idx = reader_data.column_mapping[c];"}, {"line": 846, "text": "\t\tif (!csv_file_scan->projection_ids.empty()) {"}, {"line": 847, "text": "\t\t\tresult_idx = reader_data.column_mapping[csv_file_scan->projection_ids[c].second];"}, {"line": 848, "text": "\t\t}"}, {"line": 849, "text": "\t\tif (col_idx >= parse_chunk.ColumnCount()) {"}, {"line": 850, "text": "\t\t\tthrow InvalidInputException(\"Mismatch between the schema of different files\");"}, {"line": 851, "text": "\t\t}"}, {"line": 852, "text": "\t\tauto &parse_vector = parse_chunk.data[col_idx];"}, {"line": 853, "text": "\t\tauto &result_vector = insert_chunk.data[result_idx];"}, {"line": 854, "text": "\t\tauto &type = result_vector.GetType();"}, {"line": 855, "text": "\t\tauto &parse_type = parse_vector.GetType();"}, {"line": 856, "text": "\t\tif (type == LogicalType::VARCHAR || (type != LogicalType::VARCHAR && parse_type != LogicalType::VARCHAR)) {"}, {"line": 857, "text": "\t\t\t// reinterpret rather than reference"}, {"line": 858, "text": "\t\t\tresult_vector.Reinterpret(parse_vector);"}, {"line": 859, "text": "\t\t} else {"}, {"line": 860, "text": "\t\t\tstring error_message;"}, {"line": 861, "text": "\t\t\tidx_t line_error = 0;"}, {"line": 862, "text": "\t\t\tif (VectorOperations::TryCast(buffer_manager->context, parse_vector, result_vector, parse_chunk.size(),"}, {"line": 863, "text": "\t\t\t                              &error_message, false, true)) {"}, {"line": 864, "text": "\t\t\t\tcontinue;"}, {"line": 865, "text": "\t\t\t}"}, {"line": 866, "text": "\t\t\t// An error happened, to propagate it we need to figure out the exact line where the casting failed."}, {"line": 867, "text": "\t\t\tUnifiedVectorFormat inserted_column_data;"}, {"line": 868, "text": "\t\t\tresult_vector.ToUnifiedFormat(parse_chunk.size(), inserted_column_data);"}, {"line": 869, "text": "\t\t\tUnifiedVectorFormat parse_column_data;"}, {"line": 870, "text": "\t\t\tparse_vector.ToUnifiedFormat(parse_chunk.size(), parse_column_data);"}, {"line": 871, "text": ""}, {"line": 872, "text": "\t\t\tfor (; line_error < parse_chunk.size(); line_error++) {"}, {"line": 873, "text": "\t\t\t\tif (!inserted_column_data.validity.RowIsValid(line_error) &&"}, {"line": 874, "text": "\t\t\t\t    parse_column_data.validity.RowIsValid(line_error)) {"}, {"line": 875, "text": "\t\t\t\t\tbreak;"}, {"line": 876, "text": "\t\t\t\t}"}, {"line": 877, "text": "\t\t\t}"}, {"line": 878, "text": "\t\t\t{"}, {"line": 879, "text": "\t\t\t\tvector<Value> row;"}, {"line": 880, "text": ""}, {"line": 881, "text": "\t\t\t\tif (state_machine->options.ignore_errors.GetValue()) {"}, {"line": 882, "text": "\t\t\t\t\tfor (idx_t col = 0; col < parse_chunk.ColumnCount(); col++) {"}, {"line": 883, "text": "\t\t\t\t\t\trow.push_back(parse_chunk.GetValue(col, line_error));"}, {"line": 884, "text": "\t\t\t\t\t}"}, {"line": 885, "text": "\t\t\t\t}"}, {"line": 886, "text": "\t\t\t\tif (!state_machine->options.IgnoreErrors()) {"}, {"line": 887, "text": "\t\t\t\t\tLinesPerBoundary lines_per_batch(iterator.GetBoundaryIdx(),"}, {"line": 888, "text": "\t\t\t\t\t                                 lines_read - parse_chunk.size() + line_error);"}, {"line": 889, "text": "\t\t\t\t\tbool first_nl;"}, {"line": 890, "text": "\t\t\t\t\tauto borked_line = result.line_positions_per_row[line_error].ReconstructCurrentLine("}, {"line": 891, "text": "\t\t\t\t\t    first_nl, result.buffer_handles);"}, {"line": 892, "text": "\t\t\t\t\tstd::ostringstream error;"}, {"line": 893, "text": "\t\t\t\t\terror << \"Could not convert string \\\"\" << parse_vector.GetValue(line_error) << \"\\\" to \\'\""}, {"line": 894, "text": "\t\t\t\t\t      << LogicalTypeIdToString(type.id()) << \"\\'\";"}, {"line": 895, "text": "\t\t\t\t\tstring error_msg = error.str();"}, {"line": 896, "text": "\t\t\t\t\tauto csv_error = CSVError::CastError("}, {"line": 897, "text": "\t\t\t\t\t    state_machine->options, csv_file_scan->names[col_idx], error_msg, col_idx, borked_line,"}, {"line": 898, "text": "\t\t\t\t\t    lines_per_batch,"}, {"line": 899, "text": "\t\t\t\t\t    result.line_positions_per_row[line_error].begin.GetGlobalPosition(result.result_size, first_nl),"}, {"line": 900, "text": "\t\t\t\t\t    optional_idx::Invalid(), result_vector.GetType().id());"}, {"line": 901, "text": "\t\t\t\t\terror_handler->Error(csv_error);"}, {"line": 902, "text": "\t\t\t\t}"}, {"line": 903, "text": "\t\t\t}"}, {"line": 904, "text": "\t\t\tresult.borked_rows.insert(line_error++);"}, {"line": 905, "text": "\t\t\tD_ASSERT(state_machine->options.ignore_errors.GetValue());"}, {"line": 906, "text": "\t\t\t// We are ignoring errors. We must continue but ignoring borked rows"}, {"line": 907, "text": "\t\t\tfor (; line_error < parse_chunk.size(); line_error++) {"}, {"line": 908, "text": "\t\t\t\tif (!inserted_column_data.validity.RowIsValid(line_error) &&"}, {"line": 909, "text": "\t\t\t\t    parse_column_data.validity.RowIsValid(line_error)) {"}, {"line": 910, "text": "\t\t\t\t\tresult.borked_rows.insert(line_error);"}, {"line": 911, "text": "\t\t\t\t\tvector<Value> row;"}, {"line": 912, "text": "\t\t\t\t\tfor (idx_t col = 0; col < parse_chunk.ColumnCount(); col++) {"}, {"line": 913, "text": "\t\t\t\t\t\trow.push_back(parse_chunk.GetValue(col, line_error));"}, {"line": 914, "text": "\t\t\t\t\t}"}, {"line": 915, "text": "\t\t\t\t\tif (!state_machine->options.IgnoreErrors()) {"}, {"line": 916, "text": "\t\t\t\t\t\tLinesPerBoundary lines_per_batch(iterator.GetBoundaryIdx(),"}, {"line": 917, "text": "\t\t\t\t\t\t                                 lines_read - parse_chunk.size() + line_error);"}, {"line": 918, "text": "\t\t\t\t\t\tbool first_nl;"}, {"line": 919, "text": "\t\t\t\t\t\tauto borked_line = result.line_positions_per_row[line_error].ReconstructCurrentLine("}, {"line": 920, "text": "\t\t\t\t\t\t    first_nl, result.buffer_handles);"}, {"line": 921, "text": "\t\t\t\t\t\tstd::ostringstream error;"}, {"line": 922, "text": "\t\t\t\t\t\t// Casting Error Message"}, {"line": 923, "text": "\t\t\t\t\t\terror << \"Could not convert string \\\"\" << parse_vector.GetValue(line_error) << \"\\\" to \\'\""}, {"line": 924, "text": "\t\t\t\t\t\t      << LogicalTypeIdToString(type.id()) << \"\\'\";"}, {"line": 925, "text": "\t\t\t\t\t\tstring error_msg = error.str();"}, {"line": 926, "text": "\t\t\t\t\t\tauto csv_error ="}, {"line": 927, "text": "\t\t\t\t\t\t    CSVError::CastError(state_machine->options, csv_file_scan->names[col_idx], error_msg,"}, {"line": 928, "text": "\t\t\t\t\t\t                        col_idx, borked_line, lines_per_batch,"}, {"line": 929, "text": "\t\t\t\t\t\t                        result.line_positions_per_row[line_error].begin.GetGlobalPosition("}, {"line": 930, "text": "\t\t\t\t\t\t                            result.result_size, first_nl),"}, {"line": 931, "text": "\t\t\t\t\t\t                        optional_idx::Invalid(), result_vector.GetType().id());"}, {"line": 932, "text": "\t\t\t\t\t\terror_handler->Error(csv_error);"}, {"line": 933, "text": "\t\t\t\t\t}"}, {"line": 934, "text": "\t\t\t\t}"}, {"line": 935, "text": "\t\t\t}"}, {"line": 936, "text": "\t\t}"}, {"line": 937, "text": "\t}"}, {"line": 938, "text": "\tif (!result.borked_rows.empty()) {"}, {"line": 939, "text": "\t\t// We must remove the borked lines from our chunk"}, {"line": 940, "text": "\t\tSelectionVector succesful_rows(parse_chunk.size());"}, {"line": 941, "text": "\t\tidx_t sel_idx = 0;"}, {"line": 942, "text": "\t\tfor (idx_t row_idx = 0; row_idx < parse_chunk.size(); row_idx++) {"}, {"line": 943, "text": "\t\t\tif (result.borked_rows.find(row_idx) == result.borked_rows.end()) {"}, {"line": 944, "text": "\t\t\t\tsuccesful_rows.set_index(sel_idx++, row_idx);"}, {"line": 945, "text": "\t\t\t}"}, {"line": 946, "text": "\t\t}"}, {"line": 947, "text": "\t\t// Now we slice the result"}, {"line": 948, "text": "\t\tinsert_chunk.Slice(succesful_rows, sel_idx);"}, {"line": 949, "text": "\t}"}, {"line": 950, "text": "}"}, {"line": 951, "text": ""}, {"line": 952, "text": "void StringValueScanner::Initialize() {"}, {"line": 953, "text": "\tstates.Initialize();"}, {"line": 954, "text": "\tif (result.result_size != 1 && !(sniffing && state_machine->options.null_padding &&"}, {"line": 955, "text": "\t                                 !state_machine->options.dialect_options.skip_rows.IsSetByUser())) {"}, {"line": 956, "text": "\t\tSetStart();"}, {"line": 957, "text": "\t}"}, {"line": 958, "text": "\tresult.last_position = {iterator.pos.buffer_idx, iterator.pos.buffer_pos, cur_buffer_handle->actual_size};"}, {"line": 959, "text": "\tresult.current_line_position.begin = result.last_position;"}, {"line": 960, "text": ""}, {"line": 961, "text": "\tresult.current_line_position.end = result.current_line_position.begin;"}, {"line": 962, "text": "}"}, {"line": 963, "text": ""}, {"line": 964, "text": "void StringValueScanner::ProcessExtraRow() {"}, {"line": 965, "text": "\tresult.NullPaddingQuotedNewlineCheck();"}, {"line": 966, "text": "\tidx_t to_pos = cur_buffer_handle->actual_size;"}, {"line": 967, "text": "\twhile (iterator.pos.buffer_pos < to_pos) {"}, {"line": 968, "text": "\t\tstate_machine->Transition(states, buffer_handle_ptr[iterator.pos.buffer_pos]);"}, {"line": 969, "text": "\t\tswitch (states.states[1]) {"}, {"line": 970, "text": "\t\tcase CSVState::INVALID:"}, {"line": 971, "text": "\t\t\tresult.InvalidState(result);"}, {"line": 972, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 973, "text": "\t\t\treturn;"}, {"line": 974, "text": "\t\tcase CSVState::RECORD_SEPARATOR:"}, {"line": 975, "text": "\t\t\tif (states.states[0] == CSVState::RECORD_SEPARATOR) {"}, {"line": 976, "text": "\t\t\t\tresult.EmptyLine(result, iterator.pos.buffer_pos);"}, {"line": 977, "text": "\t\t\t\titerator.pos.buffer_pos++;"}, {"line": 978, "text": "\t\t\t\tlines_read++;"}, {"line": 979, "text": "\t\t\t\treturn;"}, {"line": 980, "text": "\t\t\t} else if (states.states[0] != CSVState::CARRIAGE_RETURN) {"}, {"line": 981, "text": "\t\t\t\tresult.AddRow(result, iterator.pos.buffer_pos);"}, {"line": 982, "text": "\t\t\t\titerator.pos.buffer_pos++;"}, {"line": 983, "text": "\t\t\t\tlines_read++;"}, {"line": 984, "text": "\t\t\t\treturn;"}, {"line": 985, "text": "\t\t\t}"}, {"line": 986, "text": "\t\t\tlines_read++;"}, {"line": 987, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 988, "text": "\t\t\tbreak;"}, {"line": 989, "text": "\t\tcase CSVState::CARRIAGE_RETURN:"}, {"line": 990, "text": "\t\t\tif (states.states[0] != CSVState::RECORD_SEPARATOR) {"}, {"line": 991, "text": "\t\t\t\tresult.AddRow(result, iterator.pos.buffer_pos);"}, {"line": 992, "text": "\t\t\t\titerator.pos.buffer_pos++;"}, {"line": 993, "text": "\t\t\t\tlines_read++;"}, {"line": 994, "text": "\t\t\t\treturn;"}, {"line": 995, "text": "\t\t\t} else {"}, {"line": 996, "text": "\t\t\t\tresult.EmptyLine(result, iterator.pos.buffer_pos);"}, {"line": 997, "text": "\t\t\t\titerator.pos.buffer_pos++;"}, {"line": 998, "text": "\t\t\t\tlines_read++;"}, {"line": 999, "text": "\t\t\t\treturn;"}, {"line": 1000, "text": "\t\t\t}"}, {"line": 1001, "text": "\t\tcase CSVState::DELIMITER:"}, {"line": 1002, "text": "\t\t\tresult.AddValue(result, iterator.pos.buffer_pos);"}, {"line": 1003, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 1004, "text": "\t\t\tbreak;"}, {"line": 1005, "text": "\t\tcase CSVState::QUOTED:"}, {"line": 1006, "text": "\t\t\tif (states.states[0] == CSVState::UNQUOTED) {"}, {"line": 1007, "text": "\t\t\t\tresult.SetEscaped(result);"}, {"line": 1008, "text": "\t\t\t}"}, {"line": 1009, "text": "\t\t\tresult.SetQuoted(result, iterator.pos.buffer_pos);"}, {"line": 1010, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 1011, "text": "\t\t\twhile (state_machine->transition_array"}, {"line": 1012, "text": "\t\t\t           .skip_quoted[static_cast<uint8_t>(buffer_handle_ptr[iterator.pos.buffer_pos])] &&"}, {"line": 1013, "text": "\t\t\t       iterator.pos.buffer_pos < to_pos - 1) {"}, {"line": 1014, "text": "\t\t\t\titerator.pos.buffer_pos++;"}, {"line": 1015, "text": "\t\t\t}"}, {"line": 1016, "text": "\t\t\tbreak;"}, {"line": 1017, "text": "\t\tcase CSVState::ESCAPE:"}, {"line": 1018, "text": "\t\t\tresult.SetEscaped(result);"}, {"line": 1019, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 1020, "text": "\t\t\tbreak;"}, {"line": 1021, "text": "\t\tcase CSVState::STANDARD:"}, {"line": 1022, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 1023, "text": "\t\t\twhile (state_machine->transition_array"}, {"line": 1024, "text": "\t\t\t           .skip_standard[static_cast<uint8_t>(buffer_handle_ptr[iterator.pos.buffer_pos])] &&"}, {"line": 1025, "text": "\t\t\t       iterator.pos.buffer_pos < to_pos - 1) {"}, {"line": 1026, "text": "\t\t\t\titerator.pos.buffer_pos++;"}, {"line": 1027, "text": "\t\t\t}"}, {"line": 1028, "text": "\t\t\tbreak;"}, {"line": 1029, "text": "\t\tcase CSVState::QUOTED_NEW_LINE:"}, {"line": 1030, "text": "\t\t\tresult.quoted_new_line = true;"}, {"line": 1031, "text": "\t\t\tresult.NullPaddingQuotedNewlineCheck();"}, {"line": 1032, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 1033, "text": "\t\t\tbreak;"}, {"line": 1034, "text": "\t\tdefault:"}, {"line": 1035, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 1036, "text": "\t\t\tbreak;"}, {"line": 1037, "text": "\t\t}"}, {"line": 1038, "text": "\t}"}, {"line": 1039, "text": "}"}, {"line": 1040, "text": ""}, {"line": 1041, "text": "string_t StringValueScanner::RemoveEscape(const char *str_ptr, idx_t end, char escape, Vector &vector) {"}, {"line": 1042, "text": "\t// Figure out the exact size"}, {"line": 1043, "text": "\tidx_t str_pos = 0;"}, {"line": 1044, "text": "\tbool just_escaped = false;"}, {"line": 1045, "text": "\tfor (idx_t cur_pos = 0; cur_pos < end; cur_pos++) {"}, {"line": 1046, "text": "\t\tif (str_ptr[cur_pos] == escape && !just_escaped) {"}, {"line": 1047, "text": "\t\t\tjust_escaped = true;"}, {"line": 1048, "text": "\t\t} else {"}, {"line": 1049, "text": "\t\t\tjust_escaped = false;"}, {"line": 1050, "text": "\t\t\tstr_pos++;"}, {"line": 1051, "text": "\t\t}"}, {"line": 1052, "text": "\t}"}, {"line": 1053, "text": ""}, {"line": 1054, "text": "\tauto removed_escapes = StringVector::EmptyString(vector, str_pos);"}, {"line": 1055, "text": "\tauto removed_escapes_ptr = removed_escapes.GetDataWriteable();"}, {"line": 1056, "text": "\t// Allocate string and copy it"}, {"line": 1057, "text": "\tstr_pos = 0;"}, {"line": 1058, "text": "\tjust_escaped = false;"}, {"line": 1059, "text": "\tfor (idx_t cur_pos = 0; cur_pos < end; cur_pos++) {"}, {"line": 1060, "text": "\t\tchar c = str_ptr[cur_pos];"}, {"line": 1061, "text": "\t\tif (c == escape && !just_escaped) {"}, {"line": 1062, "text": "\t\t\tjust_escaped = true;"}, {"line": 1063, "text": "\t\t} else {"}, {"line": 1064, "text": "\t\t\tjust_escaped = false;"}, {"line": 1065, "text": "\t\t\tremoved_escapes_ptr[str_pos++] = c;"}, {"line": 1066, "text": "\t\t}"}, {"line": 1067, "text": "\t}"}, {"line": 1068, "text": "\tremoved_escapes.Finalize();"}, {"line": 1069, "text": "\treturn removed_escapes;"}, {"line": 1070, "text": "}"}, {"line": 1071, "text": ""}, {"line": 1072, "text": "void StringValueScanner::ProcessOverbufferValue() {"}, {"line": 1073, "text": "\t// Process first string"}, {"line": 1074, "text": "\tstates.Initialize();"}, {"line": 1075, "text": "\tstring overbuffer_string;"}, {"line": 1076, "text": "\tauto previous_buffer = previous_buffer_handle->Ptr();"}, {"line": 1077, "text": "\tif (result.last_position.buffer_pos == previous_buffer_handle->actual_size) {"}, {"line": 1078, "text": "\t\tstate_machine->Transition(states, previous_buffer[result.last_position.buffer_pos - 1]);"}, {"line": 1079, "text": "\t}"}, {"line": 1080, "text": "\tidx_t j = 0;"}, {"line": 1081, "text": "\tresult.quoted = false;"}, {"line": 1082, "text": "\tfor (idx_t i = result.last_position.buffer_pos; i < previous_buffer_handle->actual_size; i++) {"}, {"line": 1083, "text": "\t\tstate_machine->Transition(states, previous_buffer[i]);"}, {"line": 1084, "text": "\t\tif (states.EmptyLine() || states.IsCurrentNewRow()) {"}, {"line": 1085, "text": "\t\t\tcontinue;"}, {"line": 1086, "text": "\t\t}"}, {"line": 1087, "text": "\t\tif (states.NewRow() || states.NewValue()) {"}, {"line": 1088, "text": "\t\t\tbreak;"}, {"line": 1089, "text": "\t\t} else {"}, {"line": 1090, "text": "\t\t\toverbuffer_string += previous_buffer[i];"}, {"line": 1091, "text": "\t\t}"}, {"line": 1092, "text": "\t\tif (states.IsQuoted()) {"}, {"line": 1093, "text": "\t\t\tresult.SetQuoted(result, j);"}, {"line": 1094, "text": "\t\t}"}, {"line": 1095, "text": "\t\tif (states.IsEscaped()) {"}, {"line": 1096, "text": "\t\t\tresult.escaped = true;"}, {"line": 1097, "text": "\t\t}"}, {"line": 1098, "text": "\t\tif (states.IsInvalid()) {"}, {"line": 1099, "text": "\t\t\tresult.InvalidState(result);"}, {"line": 1100, "text": "\t\t}"}, {"line": 1101, "text": "\t\tj++;"}, {"line": 1102, "text": "\t}"}, {"line": 1103, "text": "\tif (overbuffer_string.empty() &&"}, {"line": 1104, "text": "\t    state_machine->dialect_options.state_machine_options.new_line == NewLineIdentifier::CARRY_ON) {"}, {"line": 1105, "text": "\t\tif (buffer_handle_ptr[iterator.pos.buffer_pos] == '\\n') {"}, {"line": 1106, "text": "\t\t\titerator.pos.buffer_pos++;"}, {"line": 1107, "text": "\t\t}"}, {"line": 1108, "text": "\t}"}, {"line": 1109, "text": "\t// second buffer"}, {"line": 1110, "text": "\tfor (; iterator.pos.buffer_pos < cur_buffer_handle->actual_size; iterator.pos.buffer_pos++) {"}, {"line": 1111, "text": "\t\tstate_machine->Transition(states, buffer_handle_ptr[iterator.pos.buffer_pos]);"}, {"line": 1112, "text": "\t\tif (states.EmptyLine()) {"}, {"line": 1113, "text": "\t\t\tif (state_machine->dialect_options.num_cols == 1) {"}, {"line": 1114, "text": "\t\t\t\tbreak;"}, {"line": 1115, "text": "\t\t\t} else {"}, {"line": 1116, "text": "\t\t\t\tcontinue;"}, {"line": 1117, "text": "\t\t\t}"}, {"line": 1118, "text": "\t\t}"}, {"line": 1119, "text": "\t\tif (states.NewRow() || states.NewValue()) {"}, {"line": 1120, "text": "\t\t\tbreak;"}, {"line": 1121, "text": "\t\t} else {"}, {"line": 1122, "text": "\t\t\toverbuffer_string += buffer_handle_ptr[iterator.pos.buffer_pos];"}, {"line": 1123, "text": "\t\t}"}, {"line": 1124, "text": "\t\tif (states.IsQuoted()) {"}, {"line": 1125, "text": "\t\t\tresult.SetQuoted(result, j);"}, {"line": 1126, "text": "\t\t}"}, {"line": 1127, "text": "\t\tif (states.IsEscaped()) {"}, {"line": 1128, "text": "\t\t\tresult.escaped = true;"}, {"line": 1129, "text": "\t\t}"}, {"line": 1130, "text": "\t\tif (states.IsInvalid()) {"}, {"line": 1131, "text": "\t\t\tresult.InvalidState(result);"}, {"line": 1132, "text": "\t\t}"}, {"line": 1133, "text": "\t\tj++;"}, {"line": 1134, "text": "\t}"}, {"line": 1135, "text": "\tbool skip_value = false;"}, {"line": 1136, "text": "\tif (result.projecting_columns) {"}, {"line": 1137, "text": "\t\tif (!result.projected_columns[result.cur_col_id]) {"}, {"line": 1138, "text": "\t\t\tresult.cur_col_id++;"}, {"line": 1139, "text": "\t\t\tskip_value = true;"}, {"line": 1140, "text": "\t\t}"}, {"line": 1141, "text": "\t}"}, {"line": 1142, "text": "\tif (!skip_value) {"}, {"line": 1143, "text": "\t\tstring_t value;"}, {"line": 1144, "text": "\t\tif (result.quoted) {"}, {"line": 1145, "text": "\t\t\tvalue = string_t(overbuffer_string.c_str() + result.quoted_position,"}, {"line": 1146, "text": "\t\t\t                 UnsafeNumericCast<uint32_t>(overbuffer_string.size() - 1 - result.quoted_position));"}, {"line": 1147, "text": "\t\t\tif (result.escaped) {"}, {"line": 1148, "text": "\t\t\t\tconst auto str_ptr = static_cast<const char *>(overbuffer_string.c_str() + result.quoted_position);"}, {"line": 1149, "text": "\t\t\t\tvalue = StringValueScanner::RemoveEscape("}, {"line": 1150, "text": "\t\t\t\t    str_ptr, overbuffer_string.size() - 2,"}, {"line": 1151, "text": "\t\t\t\t    state_machine->dialect_options.state_machine_options.escape.GetValue(),"}, {"line": 1152, "text": "\t\t\t\t    result.parse_chunk.data[result.chunk_col_id]);"}, {"line": 1153, "text": "\t\t\t}"}, {"line": 1154, "text": "\t\t} else {"}, {"line": 1155, "text": "\t\t\tvalue = string_t(overbuffer_string.c_str(), UnsafeNumericCast<uint32_t>(overbuffer_string.size()));"}, {"line": 1156, "text": "\t\t}"}, {"line": 1157, "text": "\t\tif (states.EmptyLine() && state_machine->dialect_options.num_cols == 1) {"}, {"line": 1158, "text": "\t\t\tresult.EmptyLine(result, iterator.pos.buffer_pos);"}, {"line": 1159, "text": "\t\t} else if (!states.IsNotSet()) {"}, {"line": 1160, "text": "\t\t\tresult.AddValueToVector(value.GetData(), value.GetSize(), true);"}, {"line": 1161, "text": "\t\t}"}, {"line": 1162, "text": "\t} else {"}, {"line": 1163, "text": "\t\tif (states.EmptyLine() && state_machine->dialect_options.num_cols == 1) {"}, {"line": 1164, "text": "\t\t\tresult.EmptyLine(result, iterator.pos.buffer_pos);"}, {"line": 1165, "text": "\t\t}"}, {"line": 1166, "text": "\t}"}, {"line": 1167, "text": ""}, {"line": 1168, "text": "\tif (states.NewRow() && !states.IsNotSet()) {"}, {"line": 1169, "text": "\t\tresult.AddRowInternal();"}, {"line": 1170, "text": "\t\tlines_read++;"}, {"line": 1171, "text": "\t}"}, {"line": 1172, "text": ""}, {"line": 1173, "text": "\tif (iterator.pos.buffer_pos >= cur_buffer_handle->actual_size && cur_buffer_handle->is_last_buffer) {"}, {"line": 1174, "text": "\t\tresult.added_last_line = true;"}, {"line": 1175, "text": "\t}"}, {"line": 1176, "text": "\tif (states.IsCarriageReturn() &&"}, {"line": 1177, "text": "\t    state_machine->dialect_options.state_machine_options.new_line == NewLineIdentifier::CARRY_ON) {"}, {"line": 1178, "text": "\t\tresult.last_position = {iterator.pos.buffer_idx, ++iterator.pos.buffer_pos + 1, result.buffer_size};"}, {"line": 1179, "text": "\t} else {"}, {"line": 1180, "text": "\t\tresult.last_position = {iterator.pos.buffer_idx, ++iterator.pos.buffer_pos, result.buffer_size};"}, {"line": 1181, "text": "\t}"}, {"line": 1182, "text": "\t// Be sure to reset the quoted and escaped variables"}, {"line": 1183, "text": "\tresult.quoted = false;"}, {"line": 1184, "text": "\tresult.escaped = false;"}, {"line": 1185, "text": "}"}, {"line": 1186, "text": ""}, {"line": 1187, "text": "bool StringValueScanner::MoveToNextBuffer() {"}, {"line": 1188, "text": "\tif (iterator.pos.buffer_pos >= cur_buffer_handle->actual_size) {"}, {"line": 1189, "text": "\t\tprevious_buffer_handle = cur_buffer_handle;"}, {"line": 1190, "text": "\t\tcur_buffer_handle = buffer_manager->GetBuffer(++iterator.pos.buffer_idx);"}, {"line": 1191, "text": "\t\tif (!cur_buffer_handle) {"}, {"line": 1192, "text": "\t\t\titerator.pos.buffer_idx--;"}, {"line": 1193, "text": "\t\t\tbuffer_handle_ptr = nullptr;"}, {"line": 1194, "text": "\t\t\t// We do not care if it's a quoted new line on the last row of our file."}, {"line": 1195, "text": "\t\t\tresult.quoted_new_line = false;"}, {"line": 1196, "text": "\t\t\t// This means we reached the end of the file, we must add a last line if there is any to be added"}, {"line": 1197, "text": "\t\t\tif (states.EmptyLine() || states.NewRow() || result.added_last_line || states.IsCurrentNewRow() ||"}, {"line": 1198, "text": "\t\t\t    states.IsNotSet()) {"}, {"line": 1199, "text": "\t\t\t\tif (result.cur_col_id == result.number_of_columns) {"}, {"line": 1200, "text": "\t\t\t\t\tresult.number_of_rows++;"}, {"line": 1201, "text": "\t\t\t\t}"}, {"line": 1202, "text": "\t\t\t\tresult.cur_col_id = 0;"}, {"line": 1203, "text": "\t\t\t\tresult.chunk_col_id = 0;"}, {"line": 1204, "text": "\t\t\t\treturn false;"}, {"line": 1205, "text": "\t\t\t} else if (states.NewValue()) {"}, {"line": 1206, "text": "\t\t\t\t// we add the value"}, {"line": 1207, "text": "\t\t\t\tresult.AddValue(result, previous_buffer_handle->actual_size);"}, {"line": 1208, "text": "\t\t\t\t// And an extra empty value to represent what comes after the delimiter"}, {"line": 1209, "text": "\t\t\t\tresult.AddRow(result, previous_buffer_handle->actual_size);"}, {"line": 1210, "text": "\t\t\t\tlines_read++;"}, {"line": 1211, "text": "\t\t\t} else if (states.IsQuotedCurrent()) {"}, {"line": 1212, "text": "\t\t\t\t// Unterminated quote"}, {"line": 1213, "text": "\t\t\t\tLinePosition current_line_start = {iterator.pos.buffer_idx, iterator.pos.buffer_pos,"}, {"line": 1214, "text": "\t\t\t\t                                   result.buffer_size};"}, {"line": 1215, "text": "\t\t\t\tresult.current_line_position.begin = result.current_line_position.end;"}, {"line": 1216, "text": "\t\t\t\tresult.current_line_position.end = current_line_start;"}, {"line": 1217, "text": "\t\t\t\tresult.InvalidState(result);"}, {"line": 1218, "text": "\t\t\t} else {"}, {"line": 1219, "text": "\t\t\t\tresult.AddRow(result, previous_buffer_handle->actual_size);"}, {"line": 1220, "text": "\t\t\t\tlines_read++;"}, {"line": 1221, "text": "\t\t\t}"}, {"line": 1222, "text": "\t\t\treturn false;"}, {"line": 1223, "text": "\t\t}"}, {"line": 1224, "text": "\t\tresult.buffer_handles[cur_buffer_handle->buffer_idx] = cur_buffer_handle;"}, {"line": 1225, "text": ""}, {"line": 1226, "text": "\t\titerator.pos.buffer_pos = 0;"}, {"line": 1227, "text": "\t\tbuffer_handle_ptr = cur_buffer_handle->Ptr();"}, {"line": 1228, "text": "\t\t// Handle overbuffer value"}, {"line": 1229, "text": "\t\tProcessOverbufferValue();"}, {"line": 1230, "text": "\t\tresult.buffer_ptr = buffer_handle_ptr;"}, {"line": 1231, "text": "\t\tresult.buffer_size = cur_buffer_handle->actual_size;"}, {"line": 1232, "text": "\t\treturn true;"}, {"line": 1233, "text": "\t}"}, {"line": 1234, "text": "\treturn false;"}, {"line": 1235, "text": "}"}, {"line": 1236, "text": ""}, {"line": 1237, "text": "void StringValueResult::SkipBOM() {"}, {"line": 1238, "text": "\tif (buffer_size >= 3 && buffer_ptr[0] == '\\xEF' && buffer_ptr[1] == '\\xBB' && buffer_ptr[2] == '\\xBF' &&"}, {"line": 1239, "text": "\t    iterator.pos.buffer_pos == 0) {"}, {"line": 1240, "text": "\t\titerator.pos.buffer_pos = 3;"}, {"line": 1241, "text": "\t}"}, {"line": 1242, "text": "}"}, {"line": 1243, "text": ""}, {"line": 1244, "text": "void StringValueScanner::SkipUntilNewLine() {"}, {"line": 1245, "text": "\t// Now skip until next newline"}, {"line": 1246, "text": "\tif (state_machine->options.dialect_options.state_machine_options.new_line.GetValue() =="}, {"line": 1247, "text": "\t    NewLineIdentifier::CARRY_ON) {"}, {"line": 1248, "text": "\t\tbool carriage_return = false;"}, {"line": 1249, "text": "\t\tbool not_carriage_return = false;"}, {"line": 1250, "text": "\t\tfor (; iterator.pos.buffer_pos < cur_buffer_handle->actual_size; iterator.pos.buffer_pos++) {"}, {"line": 1251, "text": "\t\t\tif (buffer_handle_ptr[iterator.pos.buffer_pos] == '\\r') {"}, {"line": 1252, "text": "\t\t\t\tcarriage_return = true;"}, {"line": 1253, "text": "\t\t\t} else if (buffer_handle_ptr[iterator.pos.buffer_pos] != '\\n') {"}, {"line": 1254, "text": "\t\t\t\tnot_carriage_return = true;"}, {"line": 1255, "text": "\t\t\t}"}, {"line": 1256, "text": "\t\t\tif (buffer_handle_ptr[iterator.pos.buffer_pos] == '\\n') {"}, {"line": 1257, "text": "\t\t\t\tif (carriage_return || not_carriage_return) {"}, {"line": 1258, "text": "\t\t\t\t\titerator.pos.buffer_pos++;"}, {"line": 1259, "text": "\t\t\t\t\treturn;"}, {"line": 1260, "text": "\t\t\t\t}"}, {"line": 1261, "text": "\t\t\t}"}, {"line": 1262, "text": "\t\t}"}, {"line": 1263, "text": "\t} else {"}, {"line": 1264, "text": "\t\tfor (; iterator.pos.buffer_pos < cur_buffer_handle->actual_size; iterator.pos.buffer_pos++) {"}, {"line": 1265, "text": "\t\t\tif (buffer_handle_ptr[iterator.pos.buffer_pos] == '\\n' ||"}, {"line": 1266, "text": "\t\t\t    buffer_handle_ptr[iterator.pos.buffer_pos] == '\\r') {"}, {"line": 1267, "text": "\t\t\t\titerator.pos.buffer_pos++;"}, {"line": 1268, "text": "\t\t\t\treturn;"}, {"line": 1269, "text": "\t\t\t}"}, {"line": 1270, "text": "\t\t}"}, {"line": 1271, "text": "\t}"}, {"line": 1272, "text": "}"}, {"line": 1273, "text": ""}, {"line": 1274, "text": "bool StringValueScanner::CanDirectlyCast(const LogicalType &type) {"}, {"line": 1275, "text": ""}, {"line": 1276, "text": "\tswitch (type.id()) {"}, {"line": 1277, "text": "\tcase LogicalTypeId::TINYINT:"}, {"line": 1278, "text": "\tcase LogicalTypeId::SMALLINT:"}, {"line": 1279, "text": "\tcase LogicalTypeId::INTEGER:"}, {"line": 1280, "text": "\tcase LogicalTypeId::BIGINT:"}, {"line": 1281, "text": "\tcase LogicalTypeId::UTINYINT:"}, {"line": 1282, "text": "\tcase LogicalTypeId::USMALLINT:"}, {"line": 1283, "text": "\tcase LogicalTypeId::UINTEGER:"}, {"line": 1284, "text": "\tcase LogicalTypeId::UBIGINT:"}, {"line": 1285, "text": "\tcase LogicalTypeId::DOUBLE:"}, {"line": 1286, "text": "\tcase LogicalTypeId::FLOAT:"}, {"line": 1287, "text": "\tcase LogicalTypeId::DATE:"}, {"line": 1288, "text": "\tcase LogicalTypeId::TIMESTAMP:"}, {"line": 1289, "text": "\tcase LogicalTypeId::TIME:"}, {"line": 1290, "text": "\tcase LogicalTypeId::DECIMAL:"}, {"line": 1291, "text": "\tcase LogicalType::VARCHAR:"}, {"line": 1292, "text": "\t\treturn true;"}, {"line": 1293, "text": "\tdefault:"}, {"line": 1294, "text": "\t\treturn false;"}, {"line": 1295, "text": "\t}"}, {"line": 1296, "text": "}"}, {"line": 1297, "text": ""}, {"line": 1298, "text": "void StringValueScanner::SetStart() {"}, {"line": 1299, "text": "\tif (iterator.first_one) {"}, {"line": 1300, "text": "\t\tif (result.store_line_size) {"}, {"line": 1301, "text": "\t\t\tresult.error_handler.NewMaxLineSize(iterator.pos.buffer_pos);"}, {"line": 1302, "text": "\t\t}"}, {"line": 1303, "text": "\t\treturn;"}, {"line": 1304, "text": "\t}"}, {"line": 1305, "text": "\t// We have to look for a new line that fits our schema"}, {"line": 1306, "text": "\t// 1. We walk until the next new line"}, {"line": 1307, "text": "\tbool line_found;"}, {"line": 1308, "text": "\tunique_ptr<StringValueScanner> scan_finder;"}, {"line": 1309, "text": "\tdo {"}, {"line": 1310, "text": "\t\tSkipUntilNewLine();"}, {"line": 1311, "text": "\t\tif (state_machine->options.null_padding) {"}, {"line": 1312, "text": "\t\t\t// When Null Padding, we assume we start from the correct new-line"}, {"line": 1313, "text": "\t\t\treturn;"}, {"line": 1314, "text": "\t\t}"}, {"line": 1315, "text": "\t\tscan_finder ="}, {"line": 1316, "text": "\t\t    make_uniq<StringValueScanner>(0U, buffer_manager, state_machine, make_shared_ptr<CSVErrorHandler>(true),"}, {"line": 1317, "text": "\t\t                                  csv_file_scan, false, iterator, true);"}, {"line": 1318, "text": "\t\tauto &tuples = scan_finder->ParseChunk();"}, {"line": 1319, "text": "\t\tline_found = true;"}, {"line": 1320, "text": "\t\tif (tuples.number_of_rows != 1 ||"}, {"line": 1321, "text": "\t\t    (!tuples.borked_rows.empty() && !state_machine->options.ignore_errors.GetValue())) {"}, {"line": 1322, "text": "\t\t\tline_found = false;"}, {"line": 1323, "text": "\t\t\t// If no tuples were parsed, this is not the correct start, we need to skip until the next new line"}, {"line": 1324, "text": "\t\t\t// Or if columns don't match, this is not the correct start, we need to skip until the next new line"}, {"line": 1325, "text": "\t\t\tif (scan_finder->previous_buffer_handle) {"}, {"line": 1326, "text": "\t\t\t\tif (scan_finder->iterator.pos.buffer_pos >= scan_finder->previous_buffer_handle->actual_size &&"}, {"line": 1327, "text": "\t\t\t\t    scan_finder->previous_buffer_handle->is_last_buffer) {"}, {"line": 1328, "text": "\t\t\t\t\titerator.pos.buffer_idx = scan_finder->iterator.pos.buffer_idx;"}, {"line": 1329, "text": "\t\t\t\t\titerator.pos.buffer_pos = scan_finder->iterator.pos.buffer_pos;"}, {"line": 1330, "text": "\t\t\t\t\tresult.last_position = {iterator.pos.buffer_idx, iterator.pos.buffer_pos, result.buffer_size};"}, {"line": 1331, "text": "\t\t\t\t\titerator.done = scan_finder->iterator.done;"}, {"line": 1332, "text": "\t\t\t\t\treturn;"}, {"line": 1333, "text": "\t\t\t\t}"}, {"line": 1334, "text": "\t\t\t}"}, {"line": 1335, "text": "\t\t\tif (iterator.pos.buffer_pos == cur_buffer_handle->actual_size ||"}, {"line": 1336, "text": "\t\t\t    scan_finder->iterator.GetBufferIdx() > iterator.GetBufferIdx()) {"}, {"line": 1337, "text": "\t\t\t\t// If things go terribly wrong, we never loop indefinetly."}, {"line": 1338, "text": "\t\t\t\titerator.pos.buffer_idx = scan_finder->iterator.pos.buffer_idx;"}, {"line": 1339, "text": "\t\t\t\titerator.pos.buffer_pos = scan_finder->iterator.pos.buffer_pos;"}, {"line": 1340, "text": "\t\t\t\tresult.last_position = {iterator.pos.buffer_idx, iterator.pos.buffer_pos, result.buffer_size};"}, {"line": 1341, "text": "\t\t\t\titerator.done = scan_finder->iterator.done;"}, {"line": 1342, "text": "\t\t\t\treturn;"}, {"line": 1343, "text": "\t\t\t}"}, {"line": 1344, "text": "\t\t}"}, {"line": 1345, "text": "\t} while (!line_found);"}, {"line": 1346, "text": "\titerator.pos.buffer_idx = scan_finder->result.current_line_position.begin.buffer_idx;"}, {"line": 1347, "text": "\titerator.pos.buffer_pos = scan_finder->result.current_line_position.begin.buffer_pos;"}, {"line": 1348, "text": "\tresult.last_position = {iterator.pos.buffer_idx, iterator.pos.buffer_pos, result.buffer_size};"}, {"line": 1349, "text": "}"}, {"line": 1350, "text": ""}, {"line": 1351, "text": "void StringValueScanner::FinalizeChunkProcess() {"}, {"line": 1352, "text": "\tif (result.number_of_rows >= result.result_size || iterator.done) {"}, {"line": 1353, "text": "\t\t// We are done"}, {"line": 1354, "text": "\t\tif (!sniffing) {"}, {"line": 1355, "text": "\t\t\tif (csv_file_scan) {"}, {"line": 1356, "text": "\t\t\t\tcsv_file_scan->bytes_read += bytes_read;"}, {"line": 1357, "text": "\t\t\t\tbytes_read = 0;"}, {"line": 1358, "text": "\t\t\t}"}, {"line": 1359, "text": "\t\t}"}, {"line": 1360, "text": "\t\treturn;"}, {"line": 1361, "text": "\t}"}, {"line": 1362, "text": "\t// If we are not done we have two options."}, {"line": 1363, "text": "\t// 1) If a boundary is set."}, {"line": 1364, "text": "\tif (iterator.IsBoundarySet()) {"}, {"line": 1365, "text": "\t\tif (!result.current_errors.HasErrorType(CSVErrorType::UNTERMINATED_QUOTES)) {"}, {"line": 1366, "text": "\t\t\titerator.done = true;"}, {"line": 1367, "text": "\t\t}"}, {"line": 1368, "text": "\t\t// We read until the next line or until we have nothing else to read."}, {"line": 1369, "text": "\t\t// Move to next buffer"}, {"line": 1370, "text": "\t\tif (!cur_buffer_handle) {"}, {"line": 1371, "text": "\t\t\treturn;"}, {"line": 1372, "text": "\t\t}"}, {"line": 1373, "text": "\t\tbool moved = MoveToNextBuffer();"}, {"line": 1374, "text": "\t\tif (cur_buffer_handle) {"}, {"line": 1375, "text": "\t\t\tif (moved && result.cur_col_id < result.number_of_columns && result.cur_col_id > 0) {"}, {"line": 1376, "text": "\t\t\t\tProcessExtraRow();"}, {"line": 1377, "text": "\t\t\t} else if (!moved) {"}, {"line": 1378, "text": "\t\t\t\tProcessExtraRow();"}, {"line": 1379, "text": "\t\t\t}"}, {"line": 1380, "text": "\t\t\tif (cur_buffer_handle->is_last_buffer && iterator.pos.buffer_pos >= cur_buffer_handle->actual_size) {"}, {"line": 1381, "text": "\t\t\t\tMoveToNextBuffer();"}, {"line": 1382, "text": "\t\t\t}"}, {"line": 1383, "text": "\t\t} else {"}, {"line": 1384, "text": "\t\t\tresult.current_errors.HandleErrors(result);"}, {"line": 1385, "text": "\t\t}"}, {"line": 1386, "text": "\t\tif (!iterator.done) {"}, {"line": 1387, "text": "\t\t\tif (iterator.pos.buffer_pos >= iterator.GetEndPos() || iterator.pos.buffer_idx > iterator.GetBufferIdx() ||"}, {"line": 1388, "text": "\t\t\t    FinishedFile()) {"}, {"line": 1389, "text": "\t\t\t\titerator.done = true;"}, {"line": 1390, "text": "\t\t\t}"}, {"line": 1391, "text": "\t\t}"}, {"line": 1392, "text": "\t} else {"}, {"line": 1393, "text": "\t\t// 2) If a boundary is not set"}, {"line": 1394, "text": "\t\t// We read until the chunk is complete, or we have nothing else to read."}, {"line": 1395, "text": "\t\twhile (!FinishedFile() && result.number_of_rows < result.result_size) {"}, {"line": 1396, "text": "\t\t\tMoveToNextBuffer();"}, {"line": 1397, "text": "\t\t\tif (result.number_of_rows >= result.result_size) {"}, {"line": 1398, "text": "\t\t\t\treturn;"}, {"line": 1399, "text": "\t\t\t}"}, {"line": 1400, "text": "\t\t\tif (cur_buffer_handle) {"}, {"line": 1401, "text": "\t\t\t\tProcess(result);"}, {"line": 1402, "text": "\t\t\t}"}, {"line": 1403, "text": "\t\t}"}, {"line": 1404, "text": "\t\titerator.done = FinishedFile();"}, {"line": 1405, "text": "\t\tif (result.null_padding && result.number_of_rows < STANDARD_VECTOR_SIZE && result.chunk_col_id > 0) {"}, {"line": 1406, "text": "\t\t\twhile (result.chunk_col_id < result.parse_chunk.ColumnCount()) {"}, {"line": 1407, "text": "\t\t\t\tresult.validity_mask[result.chunk_col_id++]->SetInvalid(result.number_of_rows);"}, {"line": 1408, "text": "\t\t\t\tresult.cur_col_id++;"}, {"line": 1409, "text": "\t\t\t}"}, {"line": 1410, "text": "\t\t\tresult.number_of_rows++;"}, {"line": 1411, "text": "\t\t}"}, {"line": 1412, "text": "\t}"}, {"line": 1413, "text": "}"}, {"line": 1414, "text": "} // namespace duckdb"}]}
