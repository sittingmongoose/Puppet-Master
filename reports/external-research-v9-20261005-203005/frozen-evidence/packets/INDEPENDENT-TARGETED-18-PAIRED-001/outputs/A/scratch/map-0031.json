t src=\"../../_static/design-tabs.js?v=f930bc37\"></script>"}, {"line": 24, "text": "    <script src=\"../../_static/js/theme.js\"></script>"}, {"line": 25, "text": "    <script src=\"../../_static/js/versions.js\"></script>"}, {"line": 26, "text": "    <link rel=\"index\" title=\"Index\" href=\"../../genindex.html\" />"}, {"line": 27, "text": "    <link rel=\"search\" title=\"Search\" href=\"../../search.html\" />"}, {"line": 28, "text": "    <link rel=\"prev\" title=\"Styling QuPath\" href=\"styling.html\" /> "}, {"line": 29, "text": "<script async type=\"text/javascript\" src=\"/_/static/javascript/readthedocs-addons.js\"></script><meta name=\"readthedocs-project-slug\" content=\"qupath\" /><meta name=\"readthedocs-version-slug\" content=\"stable\" /><meta name=\"readthedocs-resolver-filename\" content=\"/docs/reference/projects_structure.html\" /><meta name=\"readthedocs-http-status\" content=\"200\" /></head>"}, {"line": 30, "text": ""}, {"line": 31, "text": "<body class=\"wy-body-for-nav\"> "}, {"line": 32, "text": "  <div class=\"wy-grid-for-nav\">"}, {"line": 33, "text": "    <nav data-toggle=\"wy-nav-shift\" class=\"wy-nav-side\">"}, {"line": 34, "text": "      <div class=\"wy-side-scroll\">"}, {"line": 35, "text": "        <div class=\"wy-side-nav-search\"  style=\"background: #343131\" >"}, {"line": 36, "text": ""}, {"line": 37, "text": "          "}, {"line": 38, "text": "          "}, {"line": 39, "text": "          <a href=\"../../index.html\" class=\"icon icon-home\">"}, {"line": 40, "text": "            QuPath"}, {"line": 41, "text": "              <img src=\"../../_static/qupath_128.png\" class=\"logo\" alt=\"Logo\"/>"}, {"line": 42, "text": "          </a>"}, {"line": 43, "text": "              <div class=\"switch-menus\">"}, {"line": 44, "text": "                <div class=\"version-switch\"></div>"}, {"line": 45, "text": "                <div class=\"language-switch\"></div>"}, {"line": 46, "text": "              </div>"}, {"line": 47, "text": "<div role=\"search\">"}, {"line": 48, "text": "  <form id=\"rtd-search-form\" class=\"wy-form\" action=\"../../search.html\" method=\"get\">"}, {"line": 49, "text": "    <input type=\"text\" name=\"q\" placeholder=\"Search docs\" aria-label=\"Search docs\" />"}, {"line": 50, "text": "    <input type=\"hidden\" name=\"check_keywords\" value=\"yes\" />"}, {"line": 51, "text": "    <input type=\"hidden\" name=\"area\" value=\"default\" />"}, {"line": 52, "text": "  </form>"}, {"line": 53, "text": "</div>"}, {"line": 54, "text": "        </div><div class=\"wy-menu wy-menu-vertical\" data-spy=\"affix\" role=\"navigation\" aria-label=\"Navigation menu\">"}, {"line": 55, "text": "              <ul class=\"current\">"}, {"line": 56, "text": "<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"../intro/index.html\">Introduction</a></li>"}, {"line": 57, "text": "<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"../starting/index.html\">Getting started</a></li>"}, {"line": 58, "text": "<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"../tutorials/index.html\">Tutorials</a></li>"}, {"line": 59, "text": "<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"../concepts/index.html\">Concepts</a></li>"}, {"line": 60, "text": "<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"../scripting/index.html\">Scripting</a></li>"}, {"line": 61, "text": "<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"../deep/index.html\">Deep learning</a></li>"}, {"line": 62, "text": "<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"../advanced/index.html\">Advanced</a></li>"}, {"line": 63, "text": "<li class=\"toctree-l1 current\"><a class=\"reference internal\" href=\"index.html\">Reference</a><ul class=\"current\">"}, {"line": 64, "text": "<li class=\"toctree-l2\"><a class=\"reference internal\" href=\"faqs.html\">FAQs</a></li>"}, {"line": 65, "text": "<li class=\"toctree-l2\"><a class=\"reference internal\" href=\"shortcuts.html\">Shortcuts</a></li>"}, {"line": 66, "text": "<li class=\"toctree-l2\"><a class=\"reference internal\" href=\"commands.html\">Commands</a></li>"}, {"line": 67, "text": "<li class=\"toctree-l2\"><a class=\"reference internal\" href=\"config.html\">Configuration</a></li>"}, {"line": 68, "text": "<li class=\"toctree-l2\"><a class=\"reference internal\" href=\"building.html\">Building from source</a></li>"}, {"line": 69, "text": "<li class=\"toctree-l2\"><a class=\"reference internal\" href=\"styling.html\">Styling QuPath</a></li>"}, {"line": 70, "text": "<li class=\"toctree-l2 current\"><a class=\"current reference internal\" href=\"#\">Project structure</a><ul>"}, {"line": 71, "text": "<li class=\"toctree-l3\"><a class=\"reference internal\" href=\"#the-project-qpproj-file\">The <em>project.qpproj</em> file</a></li>"}, {"line": 72, "text": "<li class=\"toctree-l3\"><a class=\"reference internal\" href=\"#the-data-directory\">The <em>data</em> directory</a></li>"}, {"line": 73, "text": "<li class=\"toctree-l3\"><a class=\"reference internal\" href=\"#the-scripts-directory\">The <em>scripts</em> directory</a></li>"}, {"line": 74, "text": "<li class=\"toctree-l3\"><a class=\"reference internal\" href=\"#the-classifiers-directory\">The <em>classifiers</em> directory</a></li>"}, {"line": 75, "text": "</ul>"}, {"line": 76, "text": "</li>"}, {"line": 77, "text": "</ul>"}, {"line": 78, "text": "</li>"}, {"line": 79, "text": "</ul>"}, {"line": 80, "text": ""}, {"line": 81, "text": "        </div>"}, {"line": 82, "text": "      </div>"}, {"line": 83, "text": "    </nav>"}, {"line": 84, "text": ""}, {"line": 85, "text": "    <section data-toggle=\"wy-nav-shift\" class=\"wy-nav-content-wrap\"><nav class=\"wy-nav-top\" aria-label=\"Mobile navigation menu\"  style=\"background: #343131\" >"}, {"line": 86, "text": "          <i data-toggle=\"wy-nav-top\" class=\"fa fa-bars\"></i>"}, {"line": 87, "text": "          <a href=\"../../index.html\">QuPath</a>"}, {"line": 88, "text": "      </nav>"}, {"line": 89, "text": ""}, {"line": 90, "text": "      <div class=\"wy-nav-content\">"}, {"line": 91, "text": "        <div class=\"rst-content\">"}, {"line": 92, "text": "          <div role=\"navigation\" aria-label=\"Page navigation\">"}, {"line": 93, "text": "  <ul class=\"wy-breadcrumbs\">"}, {"line": 94, "text": "      <li><a href=\"../../index.html\" class=\"icon icon-home\" aria-label=\"Home\"></a></li>"}, {"line": 95, "text": "          <li class=\"breadcrumb-item\"><a href=\"index.html\">Reference</a></li>"}, {"line": 96, "text": "      <li class=\"breadcrumb-item active\">Project structure</li>"}, {"line": 97, "text": "      <li class=\"wy-breadcrumbs-aside\">"}, {"line": 98, "text": "            <a href=\"../../_sources/docs/reference/projects_structure.md.txt\" rel=\"nofollow\"> View page source</a>"}, {"line": 99, "text": "      </li>"}, {"line": 100, "text": "  </ul>"}, {"line": 101, "text": "  <hr/>"}, {"line": 102, "text": "</div>"}, {"line": 103, "text": "          <div role=\"main\" class=\"document\" itemscope=\"itemscope\" itemtype=\"http://schema.org/Article\">"}, {"line": 104, "text": "           <div itemprop=\"articleBody\">"}, {"line": 105, "text": "             "}, {"line": 106, "text": "  <section class=\"tex2jax_ignore mathjax_ignore\" id=\"project-structure\">"}, {"line": 107, "text": "<h1>Project structure<a class=\"headerlink\" href=\"#project-structure\" title=\"Link to this heading\"></a></h1>"}, {"line": 108, "text": "<p>This section provides an overview of the contents of a <a class=\"reference internal\" href=\"../tutorials/projects.html\"><span class=\"doc\">project directory</span></a> within QuPath.</p>"}, {"line": 109, "text": "<div class=\"admonition note\">"}, {"line": 110, "text": "<p class=\"admonition-title\">Note</p>"}, {"line": 111, "text": "<p>Projects are actually represented by a Java interface."}, {"line": 112, "text": "This means they do not <em>have</em> to rely on the local filesystem, and could be implemented differently.</p>"}, {"line": 113, "text": "<p>However, here we focus on the ‘default’ project implementation within QuPath, which uses a specific folder.</p>"}, {"line": 114, "text": "</div>"}, {"line": 115, "text": "<section id=\"the-project-qpproj-file\">"}, {"line": 116, "text": "<h2>The <em>project.qpproj</em> file<a class=\"headerlink\" href=\"#the-project-qpproj-file\" title=\"Link to this heading\"></a></h2>"}, {"line": 117, "text": "<p>This provides a JSON representation of the images within the project.</p>"}, {"line": 118, "text": "<p>Each image is referred to as a <strong>project entry</strong>, and has</p>"}, {"line": 119, "text": "<ul class=\"simple\">"}, {"line": 120, "text": "<li><p>A <strong>serverBuilder</strong> to create the <code class=\"docutils literal notranslate\"><span class=\"pre\">ImageServer</span></code></p></li>"}, {"line": 121, "text": "<li><p>A unique <strong>entryID</strong></p></li>"}, {"line": 122, "text": "<li><p>A human-readable <strong>imageName</strong> used to help identify the image</p></li>"}, {"line": 123, "text": "<li><p>A <strong>randomizedName</strong>, which is a UUID that can be used to mask the image name if <em>Mask image names</em> is selected under <span class=\"menuselection\">Edit ‣ Preferences…</span></p></li>"}, {"line": 124, "text": "</ul>"}, {"line": 125, "text": "<p>The <em>serverBuilder</em> typically specifies an image reading library (e.g. OpenSlide, Bio-Formats) and URI representing the full path to the image."}, {"line": 126, "text": "It can also include additional instructions, e.g. that the image should be rotated or have custom metadata set.</p>"}, {"line": 127, "text": "<div class=\"admonition tip\">"}, {"line": 128, "text": "<p class=\"admonition-title\">Tip</p>"}, {"line": 129, "text": "<p>A <em>.qpproj</em> file can be opened and edited in a text editor - although this should be done with care, to avoid making the JSON invalid!</p>"}, {"line": 130, "text": "</div>"}, {"line": 131, "text": "<div class=\"admonition tip\">"}, {"line": 132, "text": "<p class=\"admonition-title\">Tip</p>"}, {"line": 133, "text": "<p>It is possible to duplicate the <em>project.qpproj</em> file, and have a copy within the same project directory that gives another view on the same data."}, {"line": 134, "text": "You can use any filename so long as the <em>.qpproj</em> extension is retained."}, {"line": 135, "text": "The file will define the image paths for the project, which do not need to be identical to those in the original <em>project.qpproj</em> file - although they should refer to the same images.</p>"}, {"line": 136, "text": "<p>If you open the project by dragging the folder onto QuPath, a drop-down list will be displayed from which you can choose which <em>.qpproj</em> file to use.</p>"}, {"line": 137, "text": "<p>This can be useful in two scenarios:</p>"}, {"line": 138, "text": "<ul class=\"simple\">"}, {"line": 139, "text": "<li><p>You are working on a shared drive, and want to work with the same project across multiple computers. The paths to the images might differ for each computer. You can set the image paths within each <em>.qpproj</em> file differently, and open the appropriate file for the computer currently in use.</p></li>"}, {"line": 140, "text": "<li><p>You wish to create a project that contains only a subset of all the images, while retaining the ability to access all images elsewhere. This could be useful, for example, if you want to separate out a training and test set of images.</p></li>"}, {"line": 141, "text": "</ul>"}, {"line": 142, "text": "</div>"}, {"line": 143, "text": "<div class=\"admonition warning\">"}, {"line": 144, "text": "<p class=\"admonition-title\">Warning</p>"}, {"line": 145, "text": "<p>If you do create duplicate <em>.qpproj</em> files as above, be cautious if you wish to add new images later - since this may inadvertently result in adding different images with the same IDs.</p>"}, {"line": 146, "text": "</div>"}, {"line": 147, "text": "</section>"}, {"line": 148, "text": "<section id=\"the-data-directory\">"}, {"line": 149, "text": "<h2>The <em>data</em> directory<a class=\"headerlink\" href=\"#the-data-directory\" title=\"Link to this heading\"></a></h2>"}, {"line": 150, "text": "<p>The <em>data</em> directory contains separate subdirectories for each <em>entry</em>, named according to the <em>entryID</em>.</p>"}, {"line": 151, "text": "<p>Each subdirectory may contain</p>"}, {"line": 152, "text": "<ul class=\"simple\">"}, {"line": 153, "text": "<li><p>A <strong>data.qpdata</strong> file containing the main saved data (including the object hierarchy) for the entry</p></li>"}, {"line": 154, "text": "<li><p>A <strong>thumbnail.jpg</strong> that is displayed under the <em>Project</em> tab through the user interface</p></li>"}, {"line": 155, "text": "<li><p>A <strong>summary.json</strong> file that contains some summary data</p></li>"}, {"line": 156, "text": "</ul>"}, {"line": 157, "text": "<p>The summary data should be written at the same time as <em>data.qpdata</em>, and provides a mechanism to preview the saved data for the entry without opening the entire (possibly-large) <em>data.qpdata</em> file.</p>"}, {"line": 158, "text": "</section>"}, {"line": 159, "text": "<section id=\"the-scripts-directory\">"}, {"line": 160, "text": "<h2>The <em>scripts</em> directory<a class=\"headerlink\" href=\"#the-scripts-directory\" title=\"Link to this heading\"></a></h2>"}, {"line": 161, "text": "<p>The optional <em>scripts</em> directory can contain Groovy scripts relevant to the project."}, {"line": 162, "text": "When the project is opened, these can be accessed directly via the <span class=\"menuselection\">Automate ‣ Project scripts…</span> menu.</p>"}, {"line": 163, "text": "</section>"}, {"line": 164, "text": "<section id=\"the-classifiers-directory\">"}, {"line": 165, "text": "<h2>The <em>classifiers</em> directory<a class=\"headerlink\" href=\"#the-classifiers-directory\" title=\"Link to this heading\"></a></h2>"}, {"line": 166, "text": "<p>The <em>classifiers</em> directory contains files related to classification within QuPath.</p>"}, {"line": 167, "text": "<ul class=\"simple\">"}, {"line": 168, "text": "<li><p>A <strong>classes.json</strong> file, which contains the default classifications available under the <span class=\"guilabel\">Annotations</span> tab (used when training classifiers)</p></li>"}, {"line": 169, "text": "<li><p>An optional <strong>pixel_classifiers</strong> subdirectory containing pixel classifiers relevant to the project</p></li>"}, {"line": 170, "text": "<li><p>An optional <strong>object_classifiers</strong> subdirectory containing object classifiers relevant to the project</p></li>"}, {"line": 171, "text": "</ul>"}, {"line": 172, "text": "</section>"}, {"line": 173, "text": "</section>"}, {"line": 174, "text": ""}, {"line": 175, "text": ""}, {"line": 176, "text": "           </div>"}, {"line": 177, "text": "          </div>"}, {"line": 178, "text": "          <footer><div class=\"rst-footer-buttons\" role=\"navigation\" aria-label=\"Footer\">"}, {"line": 179, "text": "        <a href=\"styling.html\" class=\"btn btn-neutral float-left\" title=\"Styling QuPath\" accesskey=\"p\" rel=\"prev\"><span class=\"fa fa-arrow-circle-left\" aria-hidden=\"true\"></span> Previous</a>"}, {"line": 180, "text": "    </div>"}, {"line": 181, "text": ""}, {"line": 182, "text": "  <hr/>"}, {"line": 183, "text": ""}, {"line": 184, "text": "  <div role=\"contentinfo\">"}, {"line": 185, "text": "    <p>&#169; Copyright 2019-2026, QuPath docs authors.</p>"}, {"line": 186, "text": "  </div>"}, {"line": 187, "text": ""}, {"line": 188, "text": "  Built with <a href=\"https://www.sphinx-doc.org/\">Sphinx</a> using a"}, {"line": 189, "text": "    <a href=\"https://github.com/readthedocs/sphinx_rtd_theme\">theme</a>"}, {"line": 190, "text": "    provided by <a href=\"https://readthedocs.org\">Read the Docs</a>."}, {"line": 191, "text": "   "}, {"line": 192, "text": ""}, {"line": 193, "text": "</footer>"}, {"line": 194, "text": "        </div>"}, {"line": 195, "text": "      </div>"}, {"line": 196, "text": "    </section>"}, {"line": 197, "text": "  </div>"}, {"line": 198, "text": "  <script>"}, {"line": 199, "text": "      jQuery(function () {"}, {"line": 200, "text": "          SphinxRtdTheme.Navigation.enable(true);"}, {"line": 201, "text": "      });"}, {"line": 202, "text": "  </script> "}, {"line": 203, "text": ""}, {"line": 204, "text": "</body>"}, {"line": 205, "text": "</html>"}]}
