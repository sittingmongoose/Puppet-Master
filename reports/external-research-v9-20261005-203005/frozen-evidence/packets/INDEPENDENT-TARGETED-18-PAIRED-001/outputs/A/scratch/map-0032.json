{"source": "inputs/source_context/0032.body", "source_sha256": "8772946a809a0db54f4854f200908f10bee758ea452e8df5efd955bc3b8e6e57", "lines": [{"line": 1, "text": ""}, {"line": 2, "text": "<!DOCTYPE html>"}, {"line": 3, "text": "<html lang=\"en-US\">"}, {"line": 4, "text": "<head>"}, {"line": 5, "text": "    <meta charset=\"utf-8\">"}, {"line": 6, "text": "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"}, {"line": 7, "text": ""}, {"line": 8, "text": "    <title>rename(2) - Linux manual page</title>"}, {"line": 9, "text": "    <link rel=\"stylesheet\" type=\"text/css\" href=\"../../../style.css\" title=\"style\" />"}, {"line": 10, "text": "    <link rel=\"stylesheet\" type=\"text/css\" href=\"../style.css\" title=\"style\" />"}, {"line": 11, "text": "</head>"}, {"line": 12, "text": ""}, {"line": 13, "text": "<body>"}, {"line": 14, "text": ""}, {"line": 15, "text": "<div class=\"page-top\"><a id=\"top_of_page\"></a></div>"}, {"line": 16, "text": "<!--%%%TOP_BAR%%%-->"}, {"line": 17, "text": "    <div class=\"nav-bar\">"}, {"line": 18, "text": "        <table class=\"nav-table\">"}, {"line": 19, "text": "            <tr>"}, {"line": 20, "text": "                <td class=\"nav-cell\">"}, {"line": 21, "text": "                    <p class=\"nav-text\">"}, {"line": 22, "text": "                        <a href=\"../../../index.html\">man7.org</a> &gt; Linux &gt; <a href=\"../index.html\">man-pages</a>"}, {"line": 23, "text": "                    </p>"}, {"line": 24, "text": "                </td>"}, {"line": 25, "text": "                <td class=\"training-cell\">"}, {"line": 26, "text": "                    <p class=\"training-text\"><a class=\"training-link\" href=\"http://man7.org/training/\">Linux/UNIX system programming training</a></p>"}, {"line": 27, "text": "                </td>"}, {"line": 28, "text": "            </tr>"}, {"line": 29, "text": "        </table>"}, {"line": 30, "text": "    </div>"}, {"line": 31, "text": ""}, {"line": 32, "text": "<hr class=\"nav-end\" />"}, {"line": 33, "text": ""}, {"line": 34, "text": "<!--%%%PAGE_START%%%-->"}, {"line": 35, "text": "<h1>rename(2) &mdash; Linux manual page</h1>"}, {"line": 36, "text": ""}, {"line": 37, "text": ""}, {"line": 38, "text": "<table class=\"sec-table\">"}, {"line": 39, "text": "<tr>"}, {"line": 40, "text": "    <td>"}, {"line": 41, "text": "        <p class=\"section-dir\">"}, {"line": 42, "text": "<a href=\"#NAME\">NAME</a> | <a href=\"#LIBRARY\">LIBRARY</a> | <a href=\"#SYNOPSIS\">SYNOPSIS</a> | <a href=\"#DESCRIPTION\">DESCRIPTION</a> | <a href=\"#RETURN_VALUE\">RETURN&nbsp;VALUE</a> | <a href=\"#ERRORS\">ERRORS</a> | <a href=\"#STANDARDS\">STANDARDS</a> | <a href=\"#HISTORY\">HISTORY</a> | <a href=\"#BUGS\">BUGS</a> | <a href=\"#SEE_ALSO\">SEE&nbsp;ALSO</a> | <a href=\"#COLOPHON\">COLOPHON</a>"}, {"line": 43, "text": "        </p>"}, {"line": 44, "text": "    </td>"}, {"line": 45, "text": "</tr>"}, {"line": 46, "text": "<tr>"}, {"line": 47, "text": "    <td class=\"search-box\">"}, {"line": 48, "text": "        <div class=\"man-search-box\">"}, {"line": 49, "text": ""}, {"line": 50, "text": "            <form method=\"get\" action=\"https://www.google.com/search\">"}, {"line": 51, "text": "                <fieldset class=\"man-search\">"}, {"line": 52, "text": "                    <input type=\"text\" name=\"q\" size=\"10\" maxlength=\"255\" value=\"\" />"}, {"line": 53, "text": "                    <input type=\"hidden\" name=\"sitesearch\" value=\"man7.org/linux/man-pages\" />"}, {"line": 54, "text": "                    <input type=\"submit\" name=\"sa\" value=\"Search online pages\" />"}, {"line": 55, "text": "                </fieldset>"}, {"line": 56, "text": "            </form>"}, {"line": 57, "text": ""}, {"line": 58, "text": "        </div>"}, {"line": 59, "text": "    </td>"}, {"line": 60, "text": "    <td> </td>"}, {"line": 61, "text": "</tr>"}, {"line": 62, "text": "</table>"}, {"line": 63, "text": ""}, {"line": 64, "text": "<!--%%%TEXT_START%%%-->"}, {"line": 65, "text": "<pre>"}, {"line": 66, "text": "<span class=\"headline\"><i>rename</i>(2)                  System Calls Manual                  <i>rename</i>(2)</span>"}, {"line": 67, "text": "</pre>"}, {"line": 68, "text": "<h2><a id=\"NAME\" href=\"#NAME\"></a>NAME  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 69, "text": "       rename, renameat, renameat2 - change the name or location of a"}, {"line": 70, "text": "       file"}, {"line": 71, "text": "</pre>"}, {"line": 72, "text": "<h2><a id=\"LIBRARY\" href=\"#LIBRARY\"></a>LIBRARY  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 73, "text": "       Standard C library (<i>libc</i>, <i>-lc</i>)"}, {"line": 74, "text": "</pre>"}, {"line": 75, "text": "<h2><a id=\"SYNOPSIS\" href=\"#SYNOPSIS\"></a>SYNOPSIS  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 76, "text": "       <b>#include &lt;stdio.h&gt;</b>"}, {"line": 77, "text": ""}, {"line": 78, "text": "       <b>int rename(const char *</b><i>oldpath</i><b>, const char *</b><i>newpath</i><b>);</b>"}, {"line": 79, "text": ""}, {"line": 80, "text": "       <b>#include &lt;fcntl.h&gt;           </b>/* Definition of <b>AT_* </b>constants */"}, {"line": 81, "text": "       <b>#include &lt;stdio.h&gt;</b>"}, {"line": 82, "text": ""}, {"line": 83, "text": "       <b>int renameat(int </b><i>olddirfd</i><b>, const char *</b><i>oldpath</i><b>,</b>"}, {"line": 84, "text": "                    <b>int </b><i>newdirfd</i><b>, const char *</b><i>newpath</i><b>);</b>"}, {"line": 85, "text": "       <b>int renameat2(int </b><i>olddirfd</i><b>, const char *</b><i>oldpath</i><b>,</b>"}, {"line": 86, "text": "                    <b>int </b><i>newdirfd</i><b>, const char *</b><i>newpath</i><b>, unsigned int </b><i>flags</i><b>);</b>"}, {"line": 87, "text": ""}, {"line": 88, "text": "   Feature Test Macro Requirements for glibc (see"}, {"line": 89, "text": "   <a href=\"../man7/feature_test_macros.7.html\">feature_test_macros(7)</a>):"}, {"line": 90, "text": ""}, {"line": 91, "text": "       <b>renameat</b>():"}, {"line": 92, "text": "           Since glibc 2.10:"}, {"line": 93, "text": "               _POSIX_C_SOURCE &gt;= 200809L"}, {"line": 94, "text": "           Before glibc 2.10:"}, {"line": 95, "text": "               _ATFILE_SOURCE"}, {"line": 96, "text": ""}, {"line": 97, "text": "       <b>renameat2</b>():"}, {"line": 98, "text": "           _GNU_SOURCE"}, {"line": 99, "text": "</pre>"}, {"line": 100, "text": "<h2><a id=\"DESCRIPTION\" href=\"#DESCRIPTION\"></a>DESCRIPTION  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 101, "text": "       <b>rename</b>() renames a file, moving it between directories if"}, {"line": 102, "text": "       required.  Any other hard links to the file (as created using"}, {"line": 103, "text": "       <a href=\"../man2/link.2.html\">link(2)</a>) are unaffected.  Open file descriptors for <i>oldpath</i> are"}, {"line": 104, "text": "       also unaffected."}, {"line": 105, "text": ""}, {"line": 106, "text": "       Various restrictions determine whether or not the rename operation"}, {"line": 107, "text": "       succeeds: see ERRORS below."}, {"line": 108, "text": ""}, {"line": 109, "text": "       If <i>newpath</i> already exists, it will be atomically replaced, so that"}, {"line": 110, "text": "       there is no point at which another process attempting to access"}, {"line": 111, "text": "       <i>newpath</i> will find it missing.  However, there will probably be a"}, {"line": 112, "text": "       window in which both <i>oldpath</i> and <i>newpath</i> refer to the file being"}, {"line": 113, "text": "       renamed."}, {"line": 114, "text": ""}, {"line": 115, "text": "       If <i>oldpath</i> and <i>newpath</i> are existing hard links referring to the"}, {"line": 116, "text": "       same file, then <b>rename</b>() does nothing, and returns a success"}, {"line": 117, "text": "       status."}, {"line": 118, "text": ""}, {"line": 119, "text": "       If <i>newpath</i> exists but the operation fails for some reason,"}, {"line": 120, "text": "       <b>rename</b>() guarantees to leave an instance of <i>newpath</i> in place."}, {"line": 121, "text": ""}, {"line": 122, "text": "       <i>oldpath</i> can specify a directory.  In this case, <i>newpath</i> must"}, {"line": 123, "text": "       either not exist, or it must specify an empty directory."}, {"line": 124, "text": ""}, {"line": 125, "text": "       If <i>oldpath</i> refers to a symbolic link, the link is renamed; if"}, {"line": 126, "text": "       <i>newpath</i> refers to a symbolic link, the link will be overwritten."}, {"line": 127, "text": ""}, {"line": 128, "text": "   <b>renameat()</b>"}, {"line": 129, "text": "       The <b>renameat</b>() system call operates in exactly the same way as"}, {"line": 130, "text": "       <b>rename</b>(), except for the differences described here."}, {"line": 131, "text": ""}, {"line": 132, "text": "       If the pathname given in <i>oldpath</i> is relative, then it is"}, {"line": 133, "text": "       interpreted relative to the directory referred to by the file"}, {"line": 134, "text": "       descriptor <i>olddirfd</i> (rather than relative to the current working"}, {"line": 135, "text": "       directory of the calling process, as is done by <b>rename</b>() for a"}, {"line": 136, "text": "       relative pathname)."}, {"line": 137, "text": ""}, {"line": 138, "text": "       If <i>oldpath</i> is relative and <i>olddirfd</i> is the special value <b>AT_FDCWD</b>,"}, {"line": 139, "text": "       then <i>oldpath</i> is interpreted relative to the current working"}, {"line": 140, "text": "       directory of the calling process (like <b>rename</b>())."}, {"line": 141, "text": ""}, {"line": 142, "text": "       If <i>oldpath</i> is absolute, then <i>olddirfd</i> is ignored."}, {"line": 143, "text": ""}, {"line": 144, "text": "       The interpretation of <i>newpath</i> is as for <i>oldpath</i>, except that a"}, {"line": 145, "text": "       relative pathname is interpreted relative to the directory"}, {"line": 146, "text": "       referred to by the file descriptor <i>newdirfd</i>."}, {"line": 147, "text": ""}, {"line": 148, "text": "       See <a href=\"../man2/openat.2.html\">openat(2)</a> for an explanation of the need for <b>renameat</b>()."}, {"line": 149, "text": ""}, {"line": 150, "text": "   <b>renameat2()</b>"}, {"line": 151, "text": "       <b>renameat2</b>() has an additional <i>flags</i> argument.  A <b>renameat2</b>() call"}, {"line": 152, "text": "       with a zero <i>flags</i> argument is equivalent to <b>renameat</b>()."}, {"line": 153, "text": ""}, {"line": 154, "text": "       The <i>flags</i> argument is a bit mask consisting of zero or more of the"}, {"line": 155, "text": "       following flags:"}, {"line": 156, "text": ""}, {"line": 157, "text": "       <b>RENAME_EXCHANGE</b>"}, {"line": 158, "text": "              Atomically exchange <i>oldpath</i> and <i>newpath</i>.  Both pathnames"}, {"line": 159, "text": "              must exist but may be of different types (e.g., one could"}, {"line": 160, "text": "              be a non-empty directory and the other a symbolic link)."}, {"line": 161, "text": ""}, {"line": 162, "text": "       <b>RENAME_NOREPLACE</b>"}, {"line": 163, "text": "              Don't overwrite <i>newpath</i> of the rename.  Return an error if"}, {"line": 164, "text": "              <i>newpath</i> already exists."}, {"line": 165, "text": ""}, {"line": 166, "text": "              <b>RENAME_NOREPLACE </b>can't be employed together with"}, {"line": 167, "text": "              <b>RENAME_EXCHANGE</b>."}, {"line": 168, "text": ""}, {"line": 169, "text": "              <b>RENAME_NOREPLACE </b>requires support from the underlying"}, {"line": 170, "text": "              filesystem.  Support for various filesystems was added as"}, {"line": 171, "text": "              follows:"}, {"line": 172, "text": ""}, {"line": 173, "text": "              •  ext4 (Linux 3.15);"}, {"line": 174, "text": ""}, {"line": 175, "text": "              •  btrfs, tmpfs, and cifs (Linux 3.17);"}, {"line": 176, "text": ""}, {"line": 177, "text": "              •  xfs (Linux 4.0);"}, {"line": 178, "text": ""}, {"line": 179, "text": "              •  Support for many other filesystems was added in Linux"}, {"line": 180, "text": "                 4.9, including ext2, minix, reiserfs, jfs, vfat, and"}, {"line": 181, "text": "                 bpf."}, {"line": 182, "text": ""}, {"line": 183, "text": "       <b>RENAME_WHITEOUT </b>(since Linux 3.18)"}, {"line": 184, "text": "              This operation makes sense only for overlay/union"}, {"line": 185, "text": "              filesystem implementations."}, {"line": 186, "text": ""}, {"line": 187, "text": "              Specifying <b>RENAME_WHITEOUT </b>creates a \"whiteout\" object at"}, {"line": 188, "text": "              the source of the rename at the same time as performing the"}, {"line": 189, "text": "              rename.  The whole operation is atomic, so that if the"}, {"line": 190, "text": "              rename succeeds then the whiteout will also have been"}, {"line": 191, "text": "              created."}, {"line": 192, "text": ""}, {"line": 193, "text": "              A \"whiteout\" is an object that has special meaning in"}, {"line": 194, "text": "              union/overlay filesystem constructs.  In these constructs,"}, {"line": 195, "text": "              multiple layers exist and only the top one is ever"}, {"line": 196, "text": "              modified.  A whiteout on an upper layer will effectively"}, {"line": 197, "text": "              hide a matching file in the lower layer, making it appear"}, {"line": 198, "text": "              as if the file didn't exist."}, {"line": 199, "text": ""}, {"line": 200, "text": "              When a file that exists on the lower layer is renamed, the"}, {"line": 201, "text": "              file is first copied up (if not already on the upper layer)"}, {"line": 202, "text": "              and then renamed on the upper, read-write layer.  At the"}, {"line": 203, "text": "              same time, the source file needs to be \"whiteouted\" (so"}, {"line": 204, "text": "              that the version of the source file in the lower layer is"}, {"line": 205, "text": "              rendered invisible).  The whole operation needs to be done"}, {"line": 206, "text": "              atomically."}, {"line": 207, "text": ""}, {"line": 208, "text": "              When not part of a union/overlay, the whiteout appears as a"}, {"line": 209, "text": "              character device with a {0,0} device number.  (Note that"}, {"line": 210, "text": "              other union/overlay implementations may employ different"}, {"line": 211, "text": "              methods for storing whiteout entries; specifically, BSD"}, {"line": 212, "text": "              union mount employs a separate inode type, <b>DT_WHT</b>, which,"}, {"line": 213, "text": "              while supported by some filesystems available in Linux,"}, {"line": 214, "text": "              such as CODA and XFS, is ignored by the kernel's whiteout"}, {"line": 215, "text": "              support code, as of Linux 4.19, at least.)"}, {"line": 216, "text": ""}, {"line": 217, "text": "              <b>RENAME_WHITEOUT </b>requires the same privileges as creating a"}, {"line": 218, "text": "              device node (i.e., the <b>CAP_MKNOD </b>capability)."}, {"line": 219, "text": ""}, {"line": 220, "text": "              <b>RENAME_WHITEOUT </b>can't be employed together with"}, {"line": 221, "text": "              <b>RENAME_EXCHANGE</b>."}, {"line": 222, "text": ""}, {"line": 223, "text": "              <b>RENAME_WHITEOUT </b>requires support from the underlying"}, {"line": 224, "text": "              filesystem.  Among the filesystems that support it are"}, {"line": 225, "text": "              tmpfs (since Linux 3.18), ext4 (since Linux 3.18), XFS"}, {"line": 226, "text": "              (since Linux 4.1), f2fs (since Linux 4.2), btrfs (since"}, {"line": 227, "text": "              Linux 4.7), and ubifs (since Linux 4.9)."}, {"line": 228, "text": "</pre>"}, {"line": 229, "text": "<h2><a id=\"RETURN_VALUE\" href=\"#RETURN_VALUE\"></a>RETURN VALUE  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 230, "text": "       On success, zero is returned.  On error, -1 is returned, and <i><a href=\"../man3/errno.3.html\">errno</a></i>"}, {"line": 231, "text": "       is set to indicate the error."}, {"line": 232, "text": "</pre>"}, {"line": 233, "text": "<h2><a id=\"ERRORS\" href=\"#ERRORS\"></a>ERRORS  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 234, "text": "       <b>EACCES </b>Write permission is denied for the directory containing"}, {"line": 235, "text": "              <i>oldpath</i> or <i>newpath</i>, or, search permission is denied for one"}, {"line": 236, "text": "              of the directories in the path prefix of <i>oldpath</i> or"}, {"line": 237, "text": "              <i>newpath</i>, or <i>oldpath</i> is a directory and does not allow write"}, {"line": 238, "text": "              permission (needed to update the <i>..</i>  entry).  (See also"}, {"line": 239, "text": "              <a href=\"../man7/path_resolution.7.html\">path_resolution(7)</a>.)"}, {"line": 240, "text": ""}, {"line": 241, "text": "       <b>EBUSY  </b>The rename fails because <i>oldpath</i> or <i>newpath</i> is a directory"}, {"line": 242, "text": "              that is in use by some process (perhaps as current working"}, {"line": 243, "text": "              directory, or as root directory, or because it was open for"}, {"line": 244, "text": "              reading) or is in use by the system (for example as a mount"}, {"line": 245, "text": "              point), while the system considers this an error.  (Note"}, {"line": 246, "text": "              that there is no requirement to return <b>EBUSY </b>in such cases—"}, {"line": 247, "text": "              there is nothing wrong with doing the rename anyway—but it"}, {"line": 248, "text": "              is allowed to return <b>EBUSY </b>if the system cannot otherwise"}, {"line": 249, "text": "              handle such situations.)"}, {"line": 250, "text": ""}, {"line": 251, "text": "       <b>EDQUOT </b>The user's quota of disk blocks on the filesystem has been"}, {"line": 252, "text": "              exhausted."}, {"line": 253, "text": ""}, {"line": 254, "text": "       <b>EFAULT </b><i>oldpath</i> or <i>newpath</i> points outside your accessible address"}, {"line": 255, "text": "              space."}, {"line": 256, "text": ""}, {"line": 257, "text": "       <b>EINVAL </b>The new pathname contained a path prefix of the old, or,"}, {"line": 258, "text": "              more generally, an attempt was made to make a directory a"}, {"line": 259, "text": "              subdirectory of itself."}, {"line": 260, "text": ""}, {"line": 261, "text": "       <b>EISDIR </b><i>newpath</i> is an existing directory, but <i>oldpath</i> is not a"}, {"line": 262, "text": "              directory."}, {"line": 263, "text": ""}, {"line": 264, "text": "       <b>ELOOP  </b>Too many symbolic links were encountered in resolving"}, {"line": 265, "text": "              <i>oldpath</i> or <i>newpath</i>."}, {"line": 266, "text": ""}, {"line": 267, "text": "       <b>EMLINK </b><i>oldpath</i> already has the maximum number of links to it, or"}, {"line": 268, "text": "              it was a directory and the directory containing <i>newpath</i> has"}, {"line": 269, "text": "              the maximum number of links."}, {"line": 270, "text": ""}, {"line": 271, "text": "       <b>ENAMETOOLONG</b>"}, {"line": 272, "text": "              <i>oldpath</i> or <i>newpath</i> was too long."}, {"line": 273, "text": ""}, {"line": 274, "text": "       <b>ENOENT </b>The link named by <i>oldpath</i> does not exist; or, a directory"}, {"line": 275, "text": "              component in <i>newpath</i> does not exist; or, <i>oldpath</i> or <i>newpath</i>"}, {"line": 276, "text": "              is an empty string."}, {"line": 277, "text": ""}, {"line": 278, "text": "       <b>ENOMEM </b>Insufficient kernel memory was available."}, {"line": 279, "text": ""}, {"line": 280, "text": "       <b>ENOSPC </b>The device containing the file has no room for the new"}, {"line": 281, "text": "              directory entry."}, {"line": 282, "text": ""}, {"line": 283, "text": "       <b>ENOTDIR</b>"}, {"line": 284, "text": "              A component used as a directory in <i>oldpath</i> or <i>newpath</i> is"}, {"line": 285, "text": "              not, in fact, a directory.  Or, <i>oldpath</i> is a directory, and"}, {"line": 286, "text": "              <i>newpath</i> exists but is not a directory."}, {"line": 287, "text": ""}, {"line": 288, "text": "       <b>ENOTEMPTY </b>or <b>EEXIST</b>"}, {"line": 289, "text": "              <i>newpath</i> is a nonempty directory, that is, contains entries"}, {"line": 290, "text": "              other than \".\" and \"..\"."}, {"line": 291, "text": ""}, {"line": 292, "text": "       <b>EPERM </b>or <b>EACCES</b>"}, {"line": 293, "text": "              The directory containing <i>oldpath</i> has the sticky bit"}, {"line": 294, "text": "              (<b>S_ISVTX</b>) set and the process's effective user ID is"}, {"line": 295, "text": "              neither the user ID of the file to be deleted nor that of"}, {"line": 296, "text": "              the directory containing it, and the process is not"}, {"line": 297, "text": "              privileged (Linux: does not have the <b>CAP_FOWNER</b>"}, {"line": 298, "text": "              capability); or <i>newpath</i> is an existing file and the"}, {"line": 299, "text": "              directory containing it has the sticky bit set and the"}, {"line": 300, "text": "              process's effective user ID is neither the user ID of the"}, {"line": 301, "text": "              file to be replaced nor that of the directory containing"}, {"line": 302, "text": "              it, and the process is not privileged (Linux: does not have"}, {"line": 303, "text": "              the <b>CAP_FOWNER </b>capability); or the filesystem containing"}, {"line": 304, "text": "              <i>oldpath</i> does not support renaming of the type requested."}, {"line": 305, "text": ""}, {"line": 306, "text": "       <b>EROFS  </b>The file is on a read-only filesystem."}, {"line": 307, "text": ""}, {"line": 308, "text": "       <b>EXDEV  </b><i>oldpath</i> and <i>newpath</i> are not on the same mounted filesystem."}, {"line": 309, "text": "              (Linux permits a filesystem to be mounted at multiple"}, {"line": 310, "text": "              points, but <b>rename</b>() does not work across different mount"}, {"line": 311, "text": "              points, even if the same filesystem is mounted on both.)"}, {"line": 312, "text": ""}, {"line": 313, "text": "       The following additional errors can occur for <b>renameat</b>() and"}, {"line": 314, "text": "       <b>renameat2</b>():"}, {"line": 315, "text": ""}, {"line": 316, "text": "       <b>EBADF  </b><i>oldpath</i> (<i>newpath</i>) is relative but <i>olddirfd</i> (<i>newdirfd</i>) is"}, {"line": 317, "text": "              not a valid file descriptor."}, {"line": 318, "text": ""}, {"line": 319, "text": "       <b>ENOTDIR</b>"}, {"line": 320, "text": "              <i>oldpath</i> is relative and <i>olddirfd</i> is a file descriptor"}, {"line": 321, "text": "              referring to a file other than a directory; or similar for"}, {"line": 322, "text": "              <i>newpath</i> and <i>newdirfd</i>"}, {"line": 323, "text": ""}, {"line": 324, "text": "       The following additional errors can occur for <b>renameat2</b>():"}, {"line": 325, "text": ""}, {"line": 326, "text": "       <b>EEXIST </b><i>flags</i> contains <b>RENAME_NOREPLACE </b>and <i>newpath</i> already exists."}, {"line": 327, "text": ""}, {"line": 328, "text": "       <b>EINVAL </b>An invalid flag was specified in <i>flags</i>."}, {"line": 329, "text": ""}, {"line": 330, "text": "       <b>EINVAL </b>Both <b>RENAME_NOREPLACE </b>and <b>RENAME_EXCHANGE </b>were specified in"}, {"line": 331, "text": "              <i>flags</i>."}, {"line": 332, "text": ""}, {"line": 333, "text": "       <b>EINVAL </b>Both <b>RENAME_WHITEOUT </b>and <b>RENAME_EXCHANGE </b>were specified in"}, {"line": 334, "text": "              <i>flags</i>."}, {"line": 335, "text": ""}, {"line": 336, "text": "       <b>EINVAL </b>The filesystem does not support one of the flags in <i>flags</i>."}, {"line": 337, "text": ""}, {"line": 338, "text": "       <b>ENOENT </b><i>flags</i> contains <b>RENAME_EXCHANGE </b>and <i>newpath</i> does not exist."}, {"line": 339, "text": ""}, {"line": 340, "text": "       <b>EPERM  RENAME_WHITEOUT </b>was specified in <i>flags</i>, but the caller does"}, {"line": 341, "text": "              not have the <b>CAP_MKNOD </b>capability."}, {"line": 342, "text": "</pre>"}, {"line": 343, "text": "<h2><a id=\"STANDARDS\" href=\"#STANDARDS\"></a>STANDARDS  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 344, "text": "       <b>rename</b>()"}, {"line": 345, "text": "              C11, POSIX.1-2024."}, {"line": 346, "text": ""}, {"line": 347, "text": "       <b>renameat</b>()"}, {"line": 348, "text": "              POSIX.1-2024."}, {"line": 349, "text": ""}, {"line": 350, "text": "       <b>renameat2</b>()"}, {"line": 351, "text": "              Linux."}, {"line": 352, "text": "</pre>"}, {"line": 353, "text": "<h2><a id=\"HISTORY\" href=\"#HISTORY\"></a>HISTORY  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 354, "text": "       <b>rename</b>()"}, {"line": 355, "text": "              C89, POSIX.1-2001, 4.3BSD."}, {"line": 356, "text": ""}, {"line": 357, "text": "       <b>renameat</b>()"}, {"line": 358, "text": "              POSIX.1-2008.  Linux 2.6.16, glibc 2.4."}, {"line": 359, "text": ""}, {"line": 360, "text": "       <b>renameat2</b>()"}, {"line": 361, "text": "              Linux 3.15, glibc 2.28."}, {"line": 362, "text": ""}, {"line": 363, "text": "   <b>glibc notes</b>"}, {"line": 364, "text": "       On older kernels where <b>renameat</b>() is unavailable, the glibc"}, {"line": 365, "text": "       wrapper function falls back to the use of <b>rename</b>().  When <i>oldpath</i>"}, {"line": 366, "text": "       and <i>newpath</i> are relative pathnames, glibc constructs pathnames"}, {"line": 367, "text": "       based on the symbolic links in <i>/proc/self/fd</i> that correspond to"}, {"line": 368, "text": "       the <i>olddirfd</i> and <i>newdirfd</i> arguments."}, {"line": 369, "text": "</pre>"}, {"line": 370, "text": "<h2><a id=\"BUGS\" href=\"#BUGS\"></a>BUGS  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 371, "text": "       On NFS filesystems, you can not assume that if the operation"}, {"line": 372, "text": "       failed, the file was not renamed.  If the server does the rename"}, {"line": 373, "text": "       operation and then crashes, the retransmitted RPC which will be"}, {"line": 374, "text": "       processed when the server is up again causes a failure.  The"}, {"line": 375, "text": "       application is expected to deal with this.  See <a href=\"../man2/link.2.html\">link(2)</a> for a"}, {"line": 376, "text": "       similar problem."}, {"line": 377, "text": "</pre>"}, {"line": 378, "text": "<h2><a id=\"SEE_ALSO\" href=\"#SEE_ALSO\"></a>SEE ALSO  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 379, "text": "       <a href=\"../man1/mv.1.html\">mv(1)</a>, <a href=\"../man1/rename.1.html\">rename(1)</a>, <a href=\"../man2/chmod.2.html\">chmod(2)</a>, <a href=\"../man2/link.2.html\">link(2)</a>, <a href=\"../man2/symlink.2.html\">symlink(2)</a>, <a href=\"../man2/unlink.2.html\">unlink(2)</a>,"}, {"line": 380, "text": "       <a href=\"../man7/path_resolution.7.html\">path_resolution(7)</a>, <a href=\"../man7/symlink.7.html\">symlink(7)</a>"}, {"line": 381, "text": "</pre>"}, {"line": 382, "text": "<h2><a id=\"COLOPHON\" href=\"#COLOPHON\"></a>COLOPHON  &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"#top_of_page\"><span class=\"top-link\">top</span></a></h2><pre>"}, {"line": 383, "text": "       This page is part of the <i>man-pages</i> (Linux kernel and C library"}, {"line": 384, "text": "       user-space interface documentation) project.  Information about"}, {"line": 385, "text": "       the project can be found at "}, {"line": 386, "text": "       ⟨<a href=\"https://www.kernel.org/doc/man-pages/\">https://www.kernel.org/doc/man-pages/</a>⟩.  If you have a bug report"}, {"line": 387, "text": "       for this manual page, see"}, {"line": 388, "text": "       ⟨<a href=\"https://git.kernel.org/pub/scm/docs/man-pages/man-pages.git/tree/CONTRIBUTING\">https://git.kernel.org/pub/scm/docs/man-pages/man-pages.git/tree/CONTRIBUTING</a>⟩."}, {"line": 389, "text": "       This page was obtained from the tarball man-pages-6.19.tar.gz"}, {"line": 390, "text": "       fetched from"}, {"line": 391, "text": "       ⟨<a href=\"https://mirrors.edge.kernel.org/pub/linux/docs/man-pages/\">https://mirrors.edge.kernel.org/pub/linux/docs/man-pages/</a>⟩ on"}, {"line": 392, "text": "       2026-09-09.  If you discover any rendering problems in this HTML"}, {"line": 393, "text": "       version of the page, or you believe there is a better or more up-"}, {"line": 394, "text": "       to-date source for the page, or you have corrections or"}, {"line": 395, "text": "       improvements to the information in this COLOPHON (which is <i>not</i>"}, {"line": 396, "text": "       part of the original manual page), send a mail to"}, {"line": 397, "text": "       man-pages@man7.org"}, {"line": 398, "text": ""}, {"line": 399, "text": "<span class=\"footline\">Linux man-pages 6.19            2026-02-08                      <i>rename</i>(2)</span>"}, {"line": 400, "text": "</pre>"}, {"line": 401, "text": ""}, {"line": 402, "text": "<hr class=\"end-man-text\" />"}, {"line": 403, "text": "<p>Pages that refer to this page:"}, {"line": 404, "text": "    <a href=\"../man1/exch.1.html\">exch(1)</a>,&nbsp;"}, {"line": 405, "text": "    <a href=\"../man1/mv.1.html\">mv(1)</a>,&nbsp;"}, {"line": 406, "text": "    <a href=\"../man2/F_GETDELEG.2const.html\">F_GETDELEG(2const)</a>,&nbsp;"}, {"line": 407, "text": "    <a href=\"../man2/F_NOTIFY.2const.html\">F_NOTIFY(2const)</a>,&nbsp;"}, {"line": 408, "text": "    <a href=\"../man2/io_uring_enter2.2.html\">io_uring_enter2(2)</a>,&nbsp;"}, {"line": 409, "text": "    <a href=\"../man2/io_uring_enter.2.html\">io_uring_enter(2)</a>,&nbsp;"}, {"line": 410, "text": "    <a href=\"../man2/link.2.html\">link(2)</a>,&nbsp;"}, {"line": 411, "text": "    <a href=\"../man2/open.2.html\">open(2)</a>,&nbsp;"}, {"line": 412, "text": "    <a href=\"../man2/rmdir.2.html\">rmdir(2)</a>,&nbsp;"}, {"line": 413, "text": "    <a href=\"../man2/symlink.2.html\">symlink(2)</a>,&nbsp;"}, {"line": 414, "text": "    <a href=\"../man2/syscalls.2.html\">syscalls(2)</a>,&nbsp;"}, {"line": 415, "text": "    <a href=\"../man2/unlink.2.html\">unlink(2)</a>,&nbsp;"}, {"line": 416, "text": "    <a href=\"../man3/io_uring_prep_rename.3.html\">io_uring_prep_rename(3)</a>,&nbsp;"}, {"line": 417, "text": "    <a href=\"../man3/io_uring_prep_renameat.3.html\">io_uring_prep_renameat(3)</a>,&nbsp;"}, {"line": 418, "text": "    <a href=\"../man3/remove.3.html\">remove(3)</a>,&nbsp;"}, {"line": 419, "text": "    <a href=\"../man7/cpuset.7.html\">cpuset(7)</a>,&nbsp;"}, {"line": 420, "text": "    <a href=\"../man7/inotify.7.html\">inotify(7)</a>,&nbsp;"}, {"line": 421, "text": "    <a href=\"../man7/signal-safety.7.html\">signal-safety(7)</a>,&nbsp;"}, {"line": 422, "text": "    <a href=\"../man7/symlink.7.html\">symlink(7)</a>,&nbsp;"}, {"line": 423, "text": "    <a href=\"../man8/lsof.8.html\">lsof(8)</a>,&nbsp;"}, {"line": 424, "text": "    <a href=\"../man8/mount.8.html\">mount(8)</a>"}, {"line": 425, "text": "</p>"}, {"line": 426, "text": "<hr/>"}, {"line": 427, "text": ""}, {"line": 428, "text": " "}, {"line": 429, "text": "<hr class=\"start-footer\" />"}, {"line": 430, "text": ""}, {"line": 431, "text": "<div class=\"footer\">"}, {"line": 432, "text": ""}, {"line": 433, "text": "<table class=\"colophon-table\">"}, {"line": 434, "text": "    <tr>"}, {"line": 435, "text": "    <td class=\"pub-info\">"}, {"line": 436, "text": "        <p>"}, {"line": 437, "text": "            HTML rendering created 2026-09-09"}, {"line": 438, "text": "            by <a href=\"https://man7.org/mtk/index.html\">Michael Kerrisk</a>,"}, {"line": 439, "text": "            author of"}, {"line": 440, "text": "            <a href=\"https://man7.org/tlpi/\"><em>The Linux Programming Interface</em></a>."}, {"line": 441, "text": "        </p>"}, {"line": 442, "text": "        <p>"}, {"line": 443, "text": "            For details of in-depth"}, {"line": 444, "text": "            <strong>Linux/UNIX system programming training courses</strong>"}, {"line": 445, "text": "            that I teach, look <a href=\"https://man7.org/training/\">here</a>."}, {"line": 446, "text": "        </p>"}, {"line": 447, "text": "        <p>"}, {"line": 448, "text": "            Hosting by <a href=\"https://www.jambit.com/index_en.html\">jambit GmbH</a>."}, {"line": 449, "text": "        </p>"}, {"line": 450, "text": "    </td>"}, {"line": 451, "text": "    <td class=\"colophon-divider\">"}, {"line": 452, "text": "    </td>"}, {"line": 453, "text": "    <td class=\"tlpi-cover\">"}, {"line": 454, "text": "        <a href=\"https://man7.org/tlpi/\"><img src=\"https://man7.org/tlpi/cover/TLPI-front-cover-vsmall.png\" alt=\"Cover of TLPI\" /></a>"}, {"line": 455, "text": "    </td>"}, {"line": 456, "text": "    </tr>"}, {"line": 457, "text": "</table>"}, {"line": 458, "text": ""}, {"line": 459, "text": "</div>"}, {"line": 460, "text": ""}, {"line": 461, "text": "<hr class=\"end-footer\" />"}, {"line": 462, "text": ""}, {"line": 463, "text": ""}, {"line": 464, "text": ""}, {"line": 465, "text": "<!--BEGIN-SITETRACKING-->"}, {"line": 466, "text": "<!-- SITETRACKING.man7.org_linux_man-pages -->"}, {"line": 467, "text": ""}, {"line": 468, "text": "<!-- Default Statcounter code for man7.org/linux/man-pages"}, {"line": 469, "text": "http://www.man7.org/linux/man-pages -->"}, {"line": 470, "text": "<script type=\"text/javascript\">"}, {"line": 471, "text": "var sc_project=7422636;"}, {"line": 472, "text": "var sc_invisible=1;"}, {"line": 473, "text": "var sc_security=\"9b6714ff\";"}, {"line": 474, "text": "</script>"}, {"line": 475, "text": "<script type=\"text/javascript\""}, {"line": 476, "text": "src=\"https://www.statcounter.com/counter/counter.js\""}, {"line": 477, "text": "async></script>"}, {"line": 478, "text": "<noscript><div class=\"statcounter\"><a title=\"Web Analytics"}, {"line": 479, "text": "Made Easy - StatCounter\" href=\"https://statcounter.com/\""}, {"line": 480, "text": "target=\"_blank\"><img class=\"statcounter\""}, {"line": 481, "text": "src=\"https://c.statcounter.com/7422636/0/9b6714ff/1/\""}, {"line": 482, "text": "alt=\"Web Analytics Made Easy -"}, {"line": 483, "text": "StatCounter\"></a></div></noscript>"}, {"line": 484, "text": "<!-- End of Statcounter Code -->"}, {"line": 485, "text": ""}, {"line": 486, "text": ""}, {"line": 487, "text": ""}, {"line": 488, "text": "<!-- Start of Google Analytics Code -->"}, {"line": 489, "text": ""}, {"line": 490, "text": "<script type=\"text/javascript\">"}, {"line": 491, "text": ""}, {"line": 492, "text": "  var _gaq = _gaq || [];"}, {"line": 493, "text": "  _gaq.push(['_setAccount', 'UA-9830363-8']);"}, {"line": 494, "text": "  _gaq.push(['_trackPageview']);"}, {"line": 495, "text": ""}, {"line": 496, "text": "  (function() {"}, {"line": 497, "text": "    var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;"}, {"line": 498, "text": "    ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';"}, {"line": 499, "text": "    var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);"}, {"line": 500, "text": "  })();"}, {"line": 501, "text": ""}, {"line": 502, "text": "</script>"}, {"line": 503, "text": ""}, {"line": 504, "text": "<!-- End of Google Analytics Code -->"}, {"line": 505, "text": ""}, {"line": 506, "text": "<!--END-SITETRACKING-->"}, {"line": 507, "text": ""}, {"line": 508, "text": "</body>"}, {"line": 509, "text": "</html>"}]}
