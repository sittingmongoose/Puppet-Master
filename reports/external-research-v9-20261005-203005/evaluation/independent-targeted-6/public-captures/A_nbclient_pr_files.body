[{"sha":"d4e540199ba74302763c4c54f578603a6297a0f9","filename":"nbclient/client.py","status":"modified","additions":10,"deletions":2,"changes":12,"blob_url":"https://github.com/jupyter/nbclient/blob/e2849e343d5072adf8a49f7a5e8bc4a7d35489b9/nbclient%2Fclient.py","raw_url":"https://github.com/jupyter/nbclient/raw/e2849e343d5072adf8a49f7a5e8bc4a7d35489b9/nbclient%2Fclient.py","contents_url":"https://api.github.com/repos/jupyter/nbclient/contents/nbclient%2Fclient.py?ref=e2849e343d5072adf8a49f7a5e8bc4a7d35489b9","patch":"@@ -768,10 +768,15 @@ async def _async_poll_for_reply(\n     ) -> dict[str, t.Any]:\n         msg: dict[str, t.Any]\n         assert self.kc is not None\n-        new_timeout: float | None = None\n         if timeout is not None:\n             deadline = monotonic() + timeout\n             new_timeout = float(timeout)\n+        else:\n+            # if we call shell_channel.get_msg with None timeout value, sometimes will\n+            # block current execution forever so need pass a timeout value, so we\n+            # need give a default value and reset the value when timeout value exhausted\n+            deadline = monotonic() + 5\n+            new_timeout = float(5)\n         error_on_timeout_execute_reply = None\n         while True:\n             try:\n@@ -800,7 +805,10 @@ async def _async_poll_for_reply(\n                         new_timeout = max(0, deadline - monotonic())\n             except Empty:\n                 # received no message, check if kernel is still alive\n-                assert timeout is not None\n+                if timeout is None:\n+                    deadline = monotonic() + 5\n+                    new_timeout = float(5)\n+                    continue\n                 task_poll_kernel_alive.cancel()\n                 await self._async_check_alive()\n                 error_on_timeout_execute_reply = await self._async_handle_timeout(timeout, cell)"}]