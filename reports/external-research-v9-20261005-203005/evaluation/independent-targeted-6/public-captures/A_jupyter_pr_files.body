[{"sha":"4b2f132c736b3f69bc0782553d26198aade6dfc2","filename":"jupyter_client/session.py","status":"modified","additions":15,"deletions":5,"changes":20,"blob_url":"https://github.com/jupyter/jupyter_client/blob/d20d0d7f9ab3b79ff328c0550cde3cbabc5b4426/jupyter_client%2Fsession.py","raw_url":"https://github.com/jupyter/jupyter_client/raw/d20d0d7f9ab3b79ff328c0550cde3cbabc5b4426/jupyter_client%2Fsession.py","contents_url":"https://api.github.com/repos/jupyter/jupyter_client/contents/jupyter_client%2Fsession.py?ref=d20d0d7f9ab3b79ff328c0550cde3cbabc5b4426","patch":"@@ -241,6 +241,11 @@ def utcnow() -> datetime:\n # -----------------------------------------------------------------------------\n \n \n+def _wake_async_socket(socket: zmq.asyncio.Socket) -> None:\n+    \"\"\"A send through the sync shadow can clear the edge-triggered FD; make pyzmq recheck it.\"\"\"\n+    socket.get(zmq.EVENTS)\n+\n+\n class SessionFactory(LoggingConfigurable):\n     \"\"\"The Base class for configurables that have a Session, Context, logger,\n     and IOLoop.\n@@ -816,9 +821,9 @@ def send(\n             # ZMQStreams and dummy sockets do not support tracking.\n             track = False\n \n-        if isinstance(stream, zmq.asyncio.Socket):\n-            assert stream is not None\n-            stream = zmq.Socket.shadow(stream.underlying)\n+        async_stream = stream if isinstance(stream, zmq.asyncio.Socket) else None\n+        if async_stream is not None:\n+            stream = zmq.Socket.shadow(async_stream.underlying)\n \n         if isinstance(msg_or_type, Message | dict):\n             # We got a Message or message dict, not a msg_type so don't\n@@ -868,6 +873,9 @@ def send(\n         else:\n             tracker = DONE\n \n+        if async_stream is not None:\n+            _wake_async_socket(async_stream)\n+\n         if self.debug:\n             pprint.pprint(msg)  # noqa\n             pprint.pprint(to_send)  # noqa\n@@ -911,8 +919,10 @@ def send_raw(\n         to_send.append(self.sign(msg_list[0:4]))\n         to_send.extend(msg_list)\n         if isinstance(stream, zmq.asyncio.Socket):\n-            stream = zmq.Socket.shadow(stream.underlying)\n-        stream.send_multipart(to_send, flags, copy=copy)\n+            zmq.Socket.shadow(stream.underlying).send_multipart(to_send, flags, copy=copy)\n+            _wake_async_socket(stream)\n+        else:\n+            stream.send_multipart(to_send, flags, copy=copy)\n \n     def recv(\n         self,"},{"sha":"122afd973046b0bd3632be9701188629b7377319","filename":"tests/test_session.py","status":"modified","additions":50,"deletions":0,"changes":50,"blob_url":"https://github.com/jupyter/jupyter_client/blob/d20d0d7f9ab3b79ff328c0550cde3cbabc5b4426/tests%2Ftest_session.py","raw_url":"https://github.com/jupyter/jupyter_client/raw/d20d0d7f9ab3b79ff328c0550cde3cbabc5b4426/tests%2Ftest_session.py","contents_url":"https://api.github.com/repos/jupyter/jupyter_client/contents/tests%2Ftest_session.py?ref=d20d0d7f9ab3b79ff328c0550cde3cbabc5b4426","patch":"@@ -2,10 +2,13 @@\n \n # Copyright (c) Jupyter Development Team.\n # Distributed under the terms of the Modified BSD License.\n+import asyncio\n import hmac\n import math\n import os\n import platform\n+import threading\n+import time\n import uuid\n import warnings\n from datetime import datetime\n@@ -505,6 +508,53 @@ async def test_send_raw(self, session):\n         B.close()\n         ctx.term()\n \n+    @pytest.mark.parametrize(\"method\", [\"send\", \"send_raw\"])\n+    async def test_send_wakes_pending_poll(self, session, method):\n+        \"\"\"A send on an asyncio socket must not hide a message that a pending poll waits for.\"\"\"\n+        timeout = 5.0\n+        ctx = zmq.asyncio.Context()\n+        sync_ctx = zmq.Context()\n+        server = sync_ctx.socket(zmq.ROUTER)\n+        port = server.bind_to_random_port(\"tcp://127.0.0.1\")\n+        client = ctx.socket(zmq.DEALER)\n+        client.connect(f\"tcp://127.0.0.1:{port}\")\n+\n+        replied = threading.Event()\n+\n+        def serve():\n+            ident, _ = server.recv_multipart()\n+            server.send_multipart([ident, b\"reply\"])\n+            replied.set()\n+            server.recv_multipart()\n+\n+        thread = threading.Thread(target=serve, daemon=True)\n+        thread.start()\n+        await client.send(b\"request\")\n+        poll = asyncio.ensure_future(client.poll(int(timeout * 1000)))\n+        await asyncio.sleep(0)\n+        # Block the event loop until the reply has arrived, then send (like a client that is busy).\n+        assert replied.wait(timeout)\n+        time.sleep(0.1)\n+\n+        msg = session.msg(\"comm_msg\", content={})\n+        start = time.monotonic()\n+        if method == \"send\":\n+            session.send(client, msg)\n+        else:\n+            msg_list = [\n+                session.pack(msg[part])\n+                for part in [\"header\", \"parent_header\", \"metadata\", \"content\"]\n+            ]\n+            session.send_raw(client, msg_list)\n+        assert await poll == zmq.POLLIN\n+        assert time.monotonic() - start < timeout / 2\n+\n+        thread.join(timeout)\n+        client.close(0)\n+        server.close(0)\n+        ctx.term()\n+        sync_ctx.term()\n+\n     def test_clone(self, session):\n         s = session\n         s._add_digest(\"initial\")"}]