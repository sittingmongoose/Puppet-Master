  "candidate_claim_locators": [
    {
      "claim": 1,
      "candidate_line": 5,
      "candidate_disposition": "SUPPORTED_CALENDAR_ONLY",
      "judgment": "PASS",
      "primary": [
        "P1:354-370",
        "P1:50-56"
      ],
      "analysis": "Persistent=true stores the last-trigger timestamp on disk, applies only when OnCalendar is configured, and requests catch-up at timer activation if at least one event was missed. RandomizedDelaySec still applies. Candidate preserves activation versus successful run/completion, avoids per-missed-day replay, and does not promise an exact start. The already-active target condition is covered independently under claim 3.",
      "conditions": [
        "systemd 257",
        "OnCalendar=daily",
        "Persistent=true",
        "timer activated after inactive interval",
        "effective random delay and target state remain relevant"
      ]
    },
    {
      "claim": 2,
      "candidate_line": 7,
      "candidate_disposition": "REJECTED",
      "judgment": "PASS",
      "primary": [
        "P1:115-186",
        "P1:354-370",
        "P1:374-394"
      ],
      "analysis": "Correctly rejects identical power-off persistence for OnUnitInactiveSec. Persistent has effect only with OnCalendar; a monotonic interval is distinct from realtime scheduling. WakeSystem can change suspend clock behavior and requires supported hardware/privileges, but cannot establish power-off catch-up. Candidate only invokes supported suspend wakeups, not a guarantee.",
      "conditions": [
        "systemd 257",
        "OnUnitInactiveSec=10min",
        "Persistent=true does not persist this monotonic schedule",
        "suspend distinct from powered off"
      ]
    },
    {
      "claim": 3,
      "candidate_line": 9,
      "candidate_disposition": "REJECTED",
      "judgment": "PASS",
      "primary": [
        "P1:50-56",
        "P3:209-219",
        "P3:332-337"
      ],
      "analysis": "Manual explicitly excludes restart/new instance when the target is already active. Candidate correctly preserves a possible later activation conditional on inactivity and the schedule. For a oneshot without RemainAfterExit, running is normally activating rather than literal active; this state distinction does not reverse the stated conditional or authorize parallel instances. RemainAfterExit=yes may leave a finished unit active; no value was supplied and candidate does not promise repeated runs.",
      "conditions": [
        "same target unit",
        "already-active target at elapse",
        "actual service/drop-ins unknown",
        "later activation conditional on inactivity"
      ]
    },
    {
      "claim": 4,
      "candidate_line": 11,
      "candidate_disposition": "SUPPORTED_WITH_BOUNDS",
      "judgment": "PASS",
      "primary": [
        "P1:229-289"
      ],
      "analysis": "AccuracySec defaults to 1min, defining an expiry window beginning at nominal elapse. Candidate preserves host-specific stable positioning and timer slack, and correctly separates RandomizedDelaySec default 0 and the order of random delay then coalescing. This is expiry accuracy, not a completion or dispatch-latency guarantee.",
      "conditions": [
        "systemd 257 defaults unless overridden",
        "minute time unit",
        "AccuracySec and RandomizedDelaySec distinct",
        "TimerSlackNSec also relevant"
      ]
    },
    {
      "claim": 5,
      "candidate_line": 13,
      "candidate_disposition": "SUPPORTED",
      "judgment": "PASS",
      "primary": [
        "P1:145-186"
      ],
      "analysis": "OnUnitInactiveSec is relative to last deactivation of the activated target unit, not timer activation, boot or midnight. Candidate retains the explicit ten-minute duration and accuracy/runtime qualification. It does not assert first activation or powered-off state survives. The immediate overdue-start exception documented for OnBootSec/OnStartupSec is not extended to this directive.",
      "conditions": [
        "systemd 257",
        "last target-unit deactivation exists",
        "10min plus relevant expiry accuracy",
        "monotonic clock may pause during suspend"
      ]
    },
    {
      "claim": 6,
      "candidate_line": 15,
      "candidate_disposition": "REJECTED",
      "judgment": "PASS_WITH_LIMITATIONS",
      "primary": [
        "P1:86-91",
        "P1:192-225",
        "P1:229-289",
        "P1:354-370",
        "P2:249-268",
        "P2:311-314",
        "P3:209-219",
        "P3:602-611"
      ],
      "analysis": "daily is midnight in the applicable timezone; calendar syntax/next-occurrence validation says nothing about successful cleanup completion. Default accuracy, activation after downtime, clock/ordering, and possible three-minute runtime defeat the alleged two-second guarantee. Candidate names missing case evidence and does not invent run results. It retains the literal 00:00:02 but also uses relative two-seconds-after-boot wording: minor deadline ambiguity, not a changed verdict.",
      "conditions": [
        "systemd 257",
        "daily wall-clock midnight",
        "timezone and clock synchronization unknown",
        "cleanup may take three minutes",
        "00:00:02 is not intrinsically boot+2s"
      ]
    }
  ],
