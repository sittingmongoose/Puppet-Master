.com/u/22458343?v=4","gravatar_id":"","url":"https://api.github.com/users/n8bot","html_url":"https://github.com/n8bot","followers_url":"https://api.github.com/users/n8bot/followers","following_url":"https://api.github.com/users/n8bot/following{/other_user}","gists_url":"https://api.github.com/users/n8bot/gists{/gist_id}","starred_url":"https://api.github.com/users/n8bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/n8bot/subscriptions","organizations_url":"https://api.github.com/users/n8bot/orgs","repos_url":"https://api.github.com/users/n8bot/repos","events_url":"https://api.github.com/users/n8bot/events{/privacy}","received_events_url":"https://api.github.com/users/n8bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-10-04T17:53:00Z","updated_at":"2022-10-04T17:53:17Z","body":"Would you be willing/able to attach the fusion .f3d file? It could help in discovering what might be leading to the issue on import. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/comments/1267354715/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/comments/1267363443","html_url":"https://github.com/prusa3d/PrusaSlicer/issues/8998#issuecomment-1267363443","issue_url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/8998","id":1267363443,"node_id":"IC_kwDOAybtDc5Lim5z","user":{"login":"henriksundeodegard","id":30589433,"node_id":"MDQ6VXNlcjMwNTg5NDMz","avatar_url":"https://avatars.githubusercontent.com/u/30589433?v=4","gravatar_id":"","url":"https://api.github.com/users/henriksundeodegard","html_url":"https://github.com/henriksundeodegard","followers_url":"https://api.github.com/users/henriksundeodegard/followers","following_url":"https://api.github.com/users/henriksundeodegard/following{/other_user}","gists_url":"https://api.github.com/users/henriksundeodegard/gists{/gist_id}","starred_url":"https://api.github.com/users/henriksundeodegard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/henriksundeodegard/subscriptions","organizations_url":"https://api.github.com/users/henriksundeodegard/orgs","repos_url":"https://api.github.com/users/henriksundeodegard/repos","events_url":"https://api.github.com/users/henriksundeodegard/events{/privacy}","received_events_url":"https://api.github.com/users/henriksundeodegard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-10-04T18:01:49Z","updated_at":"2022-10-04T18:03:15Z","body":"[Towel Paper Holder v65.zip - containing .f3d file](https://github.com/prusa3d/PrusaSlicer/files/9709491/Towel.Paper.Holder.v65.zip)\r\n\r\nAt this point I'll take all the help I can get. I made sure the hinge-features are the latest features on the history line.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/comments/1267363443/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/comments/1267796232","html_url":"https://github.com/prusa3d/PrusaSlicer/issues/8998#issuecomment-1267796232","issue_url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/8998","id":1267796232,"node_id":"IC_kwDOAybtDc5LkQkI","user":{"login":"n8bot","id":22458343,"node_id":"MDQ6VXNlcjIyNDU4MzQz","avatar_url":"https://avatars.githubusercontent.com/u/22458343?v=4","gravatar_id":"","url":"https://api.github.com/users/n8bot","html_url":"https://github.com/n8bot","followers_url":"https://api.github.com/users/n8bot/followers","following_url":"https://api.github.com/users/n8bot/following{/other_user}","gists_url":"https://api.github.com/users/n8bot/gists{/gist_id}","starred_url":"https://api.github.com/users/n8bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/n8bot/subscriptions","organizations_url":"https://api.github.com/users/n8bot/orgs","repos_url":"https://api.github.com/users/n8bot/repos","events_url":"https://api.github.com/users/n8bot/events{/privacy}","received_events_url":"https://api.github.com/users/n8bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-10-05T01:22:51Z","updated_at":"2022-10-05T01:23:12Z","body":"I just had a chance to confirm that the fusion file doesn't have any problems with it. The export to step from fusion can be reimported into fusion and there are no errors.\r\n\r\nWhen the step is brought into PrusaSlicer, the conical features and maybe others do not get imported. The importing of the step or the conversion to mesh seems to be the problem.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/comments/1267796232/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/comments/1267802168","html_url":"https://github.com/prusa3d/PrusaSlicer/issues/8998#issuecomment-1267802168","issue_url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/8998","id":1267802168,"node_id":"IC_kwDOAybtDc5LkSA4","user":{"login":"n8bot","id":22458343,"node_id":"MDQ6VXNlcjIyNDU4MzQz","avatar_url":"https://avatars.githubusercontent.com/u/22458343?v=4","gravatar_id":"","url":"https://api.github.com/users/n8bot","html_url":"https://github.com/n8bot","followers_url":"https://api.github.com/users/n8bot/followers","following_url":"https://api.github.com/users/n8bot/following{/other_user}","gists_url":"https://api.github.com/users/n8bot/gists{/gist_id}","starred_url":"https://api.github.com/users/n8bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/n8bot/subscriptions","organizations_url":"https://api.github.com/users/n8bot/orgs","repos_url":"https://api.github.com/users/n8bot/repos","events_url":"https://api.github.com/users/n8bot/events{/privacy}","received_events_url":"https://api.github.com/users/n8bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-10-05T01:33:31Z","updated_at":"2022-10-05T01:33:31Z","body":"To resolve your issue short-term, you can right-click the top-level component in Fusion 360, and select save as mesh. Save it as one file. Then, when you import the .3mf (or stl, whatever you choose) into prusaslicer, select YES when it asks you if you want to import as one object with parts.\r\n\r\nEnsure that you choose high-enough refinement options in Fusion 360 to get smooth curves. You might have to to custom, as \"High\" can still be a bit faceted for my liking.\r\n\r\n![image](https://user-images.githubusercontent.com/22458343/193960131-7ff0c6bc-ab78-44a7-8306-234a9098e7db.png)\r\n\r\n![image](https://user-images.githubusercontent.com/22458343/193960084-41a54828-b4bc-4c49-a8e3-ad652d03c752.png)\r\n\r\n![image](https://user-images.githubusercontent.com/22458343/193960434-2c927bf2-d985-42d1-a350-c88771ae856c.png)\r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/comments/1267802168/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/comments/1268213353","html_url":"https://github.com/prusa3d/PrusaSlicer/issues/8998#issuecomment-1268213353","issue_url":"https://api.github.com/repos/prusa3d/PrusaSlicer/issues/8998","id":1268213353,"node_id":"IC_kwDOAybtDc5Ll2Zp","user":{"login":"henriksundeodegard","id":30589433,"node_