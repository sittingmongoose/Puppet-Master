29,"node_id":"MDQ6VXNlcjMzODI5","avatar_url":"https://avatars.githubusercontent.com/u/33829?v=4","gravatar_id":"","url":"https://api.github.com/users/edsu","html_url":"https://github.com/edsu","followers_url":"https://api.github.com/users/edsu/followers","following_url":"https://api.github.com/users/edsu/following{/other_user}","gists_url":"https://api.github.com/users/edsu/gists{/gist_id}","starred_url":"https://api.github.com/users/edsu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/edsu/subscriptions","organizations_url":"https://api.github.com/users/edsu/orgs","repos_url":"https://api.github.com/users/edsu/repos","events_url":"https://api.github.com/users/edsu/events{/privacy}","received_events_url":"https://api.github.com/users/edsu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-01-21T00:01:28Z","updated_at":"2016-01-21T00:01:28Z","body":"Also what version of Python are you using?\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173407350/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173596711","html_url":"https://github.com/LibraryOfCongress/bagit-python/issues/51#issuecomment-173596711","issue_url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/51","id":173596711,"node_id":"MDEyOklzc3VlQ29tbWVudDE3MzU5NjcxMQ==","user":{"login":"tw4l","id":6758804,"node_id":"MDQ6VXNlcjY3NTg4MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/6758804?v=4","gravatar_id":"","url":"https://api.github.com/users/tw4l","html_url":"https://github.com/tw4l","followers_url":"https://api.github.com/users/tw4l/followers","following_url":"https://api.github.com/users/tw4l/following{/other_user}","gists_url":"https://api.github.com/users/tw4l/gists{/gist_id}","starred_url":"https://api.github.com/users/tw4l/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tw4l/subscriptions","organizations_url":"https://api.github.com/users/tw4l/orgs","repos_url":"https://api.github.com/users/tw4l/repos","events_url":"https://api.github.com/users/tw4l/events{/privacy}","received_events_url":"https://api.github.com/users/tw4l/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-01-21T14:59:13Z","updated_at":"2016-01-21T14:59:35Z","body":"**On the Mac (where validation worked fine):**  \n\n> 5232da61f988043e6b29c37d9b0e1ae4  data/VILLANURBS/SCAPE/2005/05_0929 VNU/05_0929 VNU/VNU_planta arriba/cerramientos/fachada vidrio/dibujos/06 1116 perfiliería 3D.dgn  \n\nVersion: Python 2.7.10  \n\n**On Archivematica server (where I ran into the issue):**  \n\n> 5232da61f988043e6b29c37d9b0e1ae4  data/VILLANURBS/SCAPE/2005/05_0929 VNU/05_0929 VNU/VNU_planta arriba/cerramientos/fachada vidrio/dibujos/06 1116 perfiliería 3D.dgn  \n\nVersion: Python 2.7.6\n\n---\n\nFile -i for both files shows \"text/plain; charset=us-ascii\" and JHOVE2 says they have UTF-8 character encoding.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173596711/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173670998","html_url":"https://github.com/LibraryOfCongress/bagit-python/issues/51#issuecomment-173670998","issue_url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/51","id":173670998,"node_id":"MDEyOklzc3VlQ29tbWVudDE3MzY3MDk5OA==","user":{"login":"edsu","id":33829,"node_id":"MDQ6VXNlcjMzODI5","avatar_url":"https://avatars.githubusercontent.com/u/33829?v=4","gravatar_id":"","url":"https://api.github.com/users/edsu","html_url":"https://github.com/edsu","followers_url":"https://api.github.com/users/edsu/followers","following_url":"https://api.github.com/users/edsu/following{/other_user}","gists_url":"https://api.github.com/users/edsu/gists{/gist_id}","starred_url":"https://api.github.com/users/edsu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/edsu/subscriptions","organizations_url":"https://api.github.com/users/edsu/orgs","repos_url":"https://api.github.com/users/edsu/repos","events_url":"https://api.github.com/users/edsu/events{/privacy}","received_events_url":"https://api.github.com/users/edsu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-01-21T18:46:47Z","updated_at":"2016-01-21T19:38:55Z","body":"Very strange. I created a test bag with that filename and it worked just fine on OS X and on Linux (after I copied it there).\n\nPerhaps you noticed this already, but If you look closely at the error snippet you provided, you can see something is going on with the way the unicode is being composed:\n\n```\n2016-01-20 09:34:43,303 - WARNING - data/VILLANURBS/SCAPE/2005/05_0929 VNU/05_0929 VNU/VNU_planta arriba/cerramientos/fachada vidrio/dibujos/06 1116 perfilieri ́a 3D.dgn exists in manifest but not found on filesystem\n\n2016-01-20 09:34:44,261 - WARNING - data/VILLANURBS/SCAPE/2005/05_0929 VNU/05_0929 VNU/VNU_planta arriba/cerramientos/fachada vidrio/dibujos/06 1116 perfiliería 3D.dgn exists on filesystem but is not in manifest\n```\n\nNote the difference between how this word appears in the manifest:\n\n```\nperfilierí\n```\n\nand how it appears coming back from the filesystem:\n\n```\nperfilieri ́ \n```\n\nYou can see in the latter í is decomposed into i ́. The [BagIt specification](https://tools.ietf.org/html/draft-kunze-bagit) indicates that UTF-8 should be used, but I don't think it is explicit about what normalization form to use...maybe bagit.py should assume NFD?\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173670998/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173677590","html_url":"https://github.com/LibraryOfCongress/bagit-python/issues/51#issuecomment-173677590","issue_url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/51","id":173677590,"node_id":"MDEyOklzc3VlQ29tbWVudDE3MzY3NzU5MA==","user":{"login":"edsu","id":33829,"node_id":"MDQ6VXNlcjMzODI5","avatar_url":"https://avatars.githubusercontent.com/u/33829?v=4","gravatar_id":"","url":"https://api.github.com/users/edsu","html_url":"https://github.com/edsu","followers_url":"https://api.github.com/users/edsu/followers","following_url":"https://api.github.com/users/edsu/following{/other_user}","gists_url":"https://api.github.com/users/edsu/gists{/gist_id}","starred_url":"https://api.github.com/users/edsu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/edsu/subscriptions","organizations_url":"https://api.github.com/users/edsu/orgs","repos_url":"https://api.github.com/users/edsu/repos","events_url":"https://api.github.com/users/edsu/events{/privacy}","received_events_url":"https://api.github.com/users/edsu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-01-21T19:12:25Z","updated_at":"2016-01-21T19:24:42Z","body":"I wonder if bagit.py should assume NFC normalization when reading from the manifest and the filesystem?\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173677590/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173688979","html_url":"https://github.com/LibraryOfCongress/bagit-python/issues/51#issuecomment-173688979","issue_url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/51","id":173688979,"node_id":"MDEyOklzc3VlQ29tbWVudDE3MzY4ODk3OQ==","user":{"login":"edsu","id":33829,"node_id":"MDQ6VXNlcjMzODI5","avatar_url":"https://avatars.githubusercontent.com/u/33829?v=4","gravatar_id":"","url":"https://api.github.com/users/edsu","html_url":"https://github.com/edsu","followers_url":"https://api.github.com/users/edsu/followers","following_url":"https://api.github.com/users/edsu/following{/other_user}","gists_url":"https://api.github.com/users/edsu/gists{/gist_id}","starred_url":"https://api.github.com/users/edsu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/edsu/subscriptions","organizations_url":"https://api.github.com/users/edsu/orgs","repos_url":"https://api.github.com/users/edsu/repos","events_url":"https://api.github.com/users/edsu/events{/privacy}","received_events_url":"https://api.github.com/users/edsu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-01-21T19:49:56Z","updated_at":"2016-01-21T19:49:56Z","body":"Ok, I've added [a unit test](https://github.com/edsu/bagit/blob/unicode-normalization/test.py#L283-L290) that seems to demonstrate the problem.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173688979/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173694437","html_url":"https://github.com/LibraryOfCongress/bagit-python/issues/51#issuecomment-173694437","issue_url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/51","id":173694437,"node_id":"MDEyOklzc3VlQ29tbWVudDE3MzY5NDQzNw==","user":{"login":"acdha","id":46565,"node_id":"MDQ6VXNlcjQ2NTY1","avatar_url":"https://avatars.githubusercontent.com/u/46565?v=4","gravatar_id":"","url":"https://api.github.com/users/acdha","html_url":"https://github.com/acdha","followers_url":"https://api.github.com/users/acdha/followers","following_url":"https://api.github.com/users/acdha/following{/other_user}","gists_url":"https://api.github.com/users/acdha/gists{/gist_id}","starred_url":"https://api.github.com/users/acdha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/acdha/subscriptions","organizations_url":"https://api.github.com/users/acdha/orgs","repos_url":"https://api.github.com/users/acdha/repos","events_url":"https://api.github.com/users/acdha/events{/privacy}","received_events_url":"https://api.github.com/users/acdha/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-01-21T20:11:26Z","updated_at":"2016-03-15T21:50:47Z","body":"Linux, OS X and Windows all differ on normalization and I believe at least on Linux it varies depending on filesystem. The best thing to do here is probably to add a function which we use for all of the filenames which uses an arbitrary normalization form for both sides (filesystem and tag file) to ensure that the comparisons are the same. I've used this for years on WDL:\n\n``` python\nunicodedata.normalize(\"NFC\", v)\n```\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/173694437/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/197048716","html_url":"https://github.com/LibraryOfCongress/bagit-python/issues/51#issuecomment-197048716","issue_url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/51","id":197048716,"node_id":"MDEyOklzc3VlQ29tbWVudDE5NzA0ODcxNg==","user":{"login":"acdha","id":46565,"node_id":"MDQ6VXNlcjQ2NTY1","avatar_url":"https://avatars.githubusercontent.com/u/46565?v=4","gravatar_id":"","url":"https://api.github.com/users/acdha","html_url":"https://github.com/acdha","followers_url":"https://api.github.com/users/acdha/followers","following_url":"https://api.github.com/users/acdha/following{/other_user}","gists_url":"https://api.github.com/users/acdha/gists{/gist_id}","starred_url":"https://api.github.com/users/acdha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/acdha/subscriptions","organizations_url":"https://api.github.com/users/acdha/orgs","repos_url":"https://api.github.com/users/acdha/repos","events_url":"https://api.github.com/users/acdha/events{/privacy}","received_events_url":"https://api.github.com/users/acdha/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-03-15T22:13:51Z","updated_at":"2016-03-15T22:13:51Z","body":"I just created https://github.com/LibraryOfCongress/bagit-python/pull/57 (which includes the work from #55) to apply NFD normalization when reading or writing a manifest.\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/197048716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/197074748","html_url":"https://github.com/LibraryOfCongress/bagit-python/issues/51#issuecomment-197074748","issue_url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/51","id":197074748,"node_id":"MDEyOklzc3VlQ29tbWVudDE5NzA3NDc0OA==","user":{"login":"acdha","id":46565,"node_id":"MDQ6VXNlcjQ2NTY1","avatar_url":"https://avatars.githubusercontent.com/u/46565?v=4","gravatar_id":"","url":"https://api.github.com/users/acdha","html_url":"https://github.com/acdha","followers_url":"https://api.github.com/users/acdha/followers","following_url":"https://api.github.com/users/acdha/following{/other_user}","gists_url":"https://api.github.com/users/acdha/gists{/gist_id}","starred_url":"https://api.github.com/users/acdha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/acdha/subscriptions","organizations_url":"https://api.github.com/users/acdha/orgs","repos_url":"https://api.github.com/users/acdha/repos","events_url":"https://api.github.com/users/acdha/events{/privacy}","received_events_url":"https://api.github.com/users/acdha/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-03-16T00:09:49Z","updated_at":"2016-03-16T00:09:49Z","body":"Looking at this more, I think this is going to be something of a hairball. OS X on HFS+ normalizes everything to NFD (not sure about NFS or SMB access by an OS X client). Windows (always) and Linux (apparently almost always) does not normalize at all, which means it's often possible to have files which differ only in normalization form even if that's terrible for usability.\n\nIf we're going to address this in BagIt, it will require some complicated test cases to handle all of the possibilities. It seems like we could make validation pass in many cases by doing something like using the filename as specified in the manifest and, if that does not exist, testing for the NFD form to see if it's been copied to an HFS+ filesystem. The more involved form would probably be something like reading the contents of the directory and seeing whether our set of “missing” files matches the set of “extra” files after normalization. The one I'm not sure we should support at all is the case where two files of different normalization exist – I think that would be a good candidate for a spec note and raising an exception.\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/LibraryOfCongress/bagit-python/issues/comments/197074748/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]