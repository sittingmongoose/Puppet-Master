  "material_findings": [
    {
      "id": "F1",
      "severity": "material",
      "axis": "consequential validation / oracle applicability",
      "title": "Reader-only setup is not sufficient for the promised incomplete PASSIVE checkpoint",
      "candidate_locator": {
        "path": "ER12_RUNTIME/runs/B-APPL-M-01/treatment/stages/role/verification.md",
        "lines": "74-77",
        "sha256": "893aced79598367c23ab35c8bb199f025d3d388be0b9929a2d10abf6e9ee90c3"
      },
      "candidate_text": "Hold a long read, run PASSIVE — expect incomplete checkpoint, no reset",
      "independent_primary_locators": [
        {
          "source_id": "P1-wal",
          "url": "https://www.sqlite.org/wal.html#concurrency",
          "section": "2.2 Concurrency: snapshot end mark and checkpoint boundary",
          "text_file": "ER12_RUNTIME/assessment/B-APPL-M-01/treatment-v1/evidence/P1-wal.txt",
          "text_lines": "133-140; 160-177",
          "raw_file": "ER12_RUNTIME/assessment/B-APPL-M-01/treatment-v1/evidence/P1-wal.html",
          "raw_sha256": "f3467b530b883d4a00574fe1a898b3d121ed72764ae28cf66941080ac0badb9e"
        },
        {
          "source_id": "P2-checkpoint-v2",
          "url": "https://www.sqlite.org/c3ref/wal_checkpoint_v2.html",
          "section": "PASSIVE completion can occur; FULL permits current-snapshot readers; RESTART adds reader clearance",
          "text_file": "ER12_RUNTIME/assessment/B-APPL-M-01/treatment-v1/evidence/P2-checkpoint-v2.txt",
          "text_lines": "33-58; 63-71",
          "raw_file": "ER12_RUNTIME/assessment/B-APPL-M-01/treatment-v1/evidence/P2-checkpoint-v2.html",
          "raw_sha256": "0b1d1ff100749da95b6db5032ad1f1b9dc93b531c864441b75507b85d91b7a0f"
        }
      ],
      "source_statement": "Readers keep a fixed snapshot end mark; checkpoint backfill stops at frames beyond that mark. PASSIVE may leave a checkpoint unfinished, but it can backfill all available frames. FULL can copy all frames while readers see the latest snapshot; RESTART adds a distinct wait so the WAL may restart.",
      "reviewer_inference": "A reader seeing the newest commit, with no later commits, can coexist with complete backfill. An empty/fully backfilled WAL is also a permitted state. Merely holding a reader therefore does not imply pnCkpt < pnLog. Lack of reset is distinct from incomplete backfill.",
      "consequence": "The first required acceptance check can reject a conforming target deployment or fail to exercise checkpoint starvation. Its deterministic incomplete-checkpoint oracle does not follow from its specified setup. This is a missing causal precondition, not a demand for execution or a detailed test harness.",
      "bounded_diagnostic": "Pin an actual reader snapshot, commit frames beyond its end mark from another connection, verify an incomplete PASSIVE backfill using the selected WAL database and frame outputs, then release the reader and check a successful TRUNCATE with other transactions quiescent.",
      "countervailing_candidate_support": "The claim-2 body at lines 23-24 correctly says continued writes. This finding preserves that supported body and concerns the acceptance criterion that omits the necessary write-after-snapshot setup.",
      "actual_execution": "No candidate local probe was executed; candidate source-map explicitly marks this as prospective. Reviewer also did not execute a target-version service probe."
    }
  ],
