  "claims": [
    {
      "id": "C1",
      "claim": "Cone-mode directory input includes the selected subtree recursively and immediate files of its ancestors, including the root; empty selection still includes root files.",
      "candidate": {
        "path": "ER12_RUNTIME/runs/B-FINAL-G-02/treatment/stages/role/final-section.md",
        "line": 5,
        "exact_text": "every file at any depth under `packages/editor/`; (b) every file immediately under `packages/`; and (c) every file in the toplevel directory."
      },
      "primary": [
        {
          "source_id": "P1-sparse-v2.43.0",
          "lines": [
            63,
