      "defects": [
        {
          "defect_id": "T-S01",
          "classification": "material incomplete governing source condition",
          "axes": [
            2,
            4
          ],
          "current_final": true,
          "locator": "reviser/final.md lines68-72 and122; investigator/source-map.json S04; reviser/source-map.json R05",
          "finding": "The proposed exact-frame/serialized-State crash recovery contract does not identify the native encoder limitation: State::encode persists only shared_heads and decode reinitializes live session fields. A stored native State is therefore not the exact generated-frame State the final requires on restart. No full-field serializer or unconditional restart epoch-reset boundary is named.",
          "primary_evidence": [
            "E13",
            "E14"
