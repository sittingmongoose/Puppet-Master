{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/non_executable_closure_evidence.schema.json",
  "title": "Puppet Master Non-Executable Implementation-Readiness Closure Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "updated_at_utc",
    "scope",
    "buildability_policy",
    "forbidden_artifact_counts",
    "closed_blocker_families",
    "remaining_blocker_families",
    "closure_records",
    "event_payload_contract_registry",
    "plancompile_artifact_payload_registry",
    "provider_stream_contract",
    "persistence_behavior_fixtures",
    "security_boundary_fixtures",
    "gui_wiring_contract",
    "behavioral_acceptance_contract",
    "structural_integrity_contract",
    "owner_routing_contract",
    "currentness_contract"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.implementation_readiness.non_executable_closure_evidence.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "const": "spec_schema_validator_fixture_only_no_runtime_artifact_emission"
    },
    "buildability_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildability_gate_passed_must_remain_false",
        "ordinary_product_worknodes_allowed",
        "ordinary_product_nodeseeds_allowed",
        "pnc019_executable_lifecycle_certification_required"
      ],
      "properties": {
        "buildability_gate_passed_must_remain_false": {
          "const": true
        },
        "ordinary_product_worknodes_allowed": {
          "const": false
        },
        "ordinary_product_nodeseeds_allowed": {
          "const": false
        },
        "pnc019_executable_lifecycle_certification_required": {
          "const": true
        }
      }
    },
    "forbidden_artifact_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worknodes",
        "nodeseeds",
        "candidates",
        "queues",
        "manifests",
        "implementation_files",
        "runtime_launches",
        "production_build_tasks"
      ],
      "properties": {
        "worknodes": { "const": 0 },
        "nodeseeds": { "const": 0 },
        "candidates": { "const": 0 },
        "queues": { "const": 0 },
        "manifests": { "const": 0 },
        "implementation_files": { "const": 0 },
        "runtime_launches": { "const": 0 },
        "production_build_tasks": { "const": 0 }
      }
    },
    "closed_blocker_families": {
      "$ref": "#/$defs/family_list"
    },
    "remaining_blocker_families": {
      "$ref": "#/$defs/family_list"
    },
    "closure_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/closure_record"
      }
    },
    "event_payload_contract_registry": {
      "type": "object"
    },
    "plancompile_artifact_payload_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact_payload"
      }
    },
    "provider_stream_contract": {
      "type": "object"
    },
    "persistence_behavior_fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "security_boundary_fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "gui_wiring_contract": {
      "type": "object"
    },
    "behavioral_acceptance_contract": {
      "type": "object"
    },
    "structural_integrity_contract": {
      "type": "object"
    },
    "owner_routing_contract": {
      "type": "object"
    },
    "currentness_contract": {
      "type": "object"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "family": {
      "type": "string",
      "enum": [
        "contract_materialization",
        "persistence_materialization",
        "gui_wiring",
        "security_boundary",
        "runtime_lifecycle",
        "provider_stream",
        "behavioral_acceptance",
        "structural_integrity",
        "owner_routing",
        "currentness",
        "clean_room_harness"
      ]
    },
    "family_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "closure_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_family",
        "status",
        "evidence_refs",
        "validator_refs",
        "remaining_boundary"
      ],
      "properties": {
        "blocker_family": {
          "$ref": "#/$defs/family"
        },
        "status": {
          "const": "closed_non_executable_spec_schema_fixture"
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_list"
        },
        "validator_refs": {
          "$ref": "#/$defs/string_list"
        },
        "remaining_boundary": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "artifact_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "payload_schema_id",
        "schema_ref",
        "owner_doc",
        "producer",
        "consumers",
        "negative_fixture"
      ],
      "properties": {
        "artifact_kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "payload_schema_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_doc": {
          "$ref": "#/$defs/non_empty_string"
        },
        "producer": {
          "$ref": "#/$defs/non_empty_string"
        },
        "consumers": {
          "$ref": "#/$defs/string_list"
        },
        "negative_fixture": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "kind",
        "given",
        "when",
        "then",
        "negative_case",
        "owner_refs"
      ],
      "properties": {
        "fixture_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "given": {
          "$ref": "#/$defs/non_empty_string"
        },
        "when": {
          "$ref": "#/$defs/non_empty_string"
        },
        "then": {
          "$ref": "#/$defs/non_empty_string"
        },
        "negative_case": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_refs": {
          "$ref": "#/$defs/string_list"
        }
      }
    }
  }
}
