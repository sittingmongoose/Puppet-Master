{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/storage_recovery_contracts/1.0.0/storage_recovery_contracts.schema.json",
  "title": "Puppet Master storage recovery contracts",
  "description": "Closed storage-owned migration preflight and journal-derived progress contracts. The x-puppet-master-assertions keyword is a mandatory local assertion vocabulary: a consumer that cannot enforce every listed arithmetic relation must fail preflight rather than accept the instance from structural validation alone.",
  "oneOf": [
    {
      "$ref": "#/$defs/migration_preflight_result"
    },
    {
      "$ref": "#/$defs/migration_progress_snapshot"
    },
    {
      "$ref": "#/$defs/migration_receipt"
    }
  ],
  "$defs": {
    "non_secret_ref": {
      "description": "Stable non-secret identity or artifact reference; never raw content, a credential, or an absolute local path.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$"
    },
    "nullable_non_secret_ref": {
      "oneOf": [
        {"$ref": "#/$defs/non_secret_ref"},
        {"type": "null"}
      ]
    },
    "data_loss_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "backup_boundary_ref", "affected_family_ids", "summary_ref"],
      "properties": {
        "class": {"enum": ["none", "post_backup_writes_will_be_lost", "unknown_due_corruption"]},
        "backup_boundary_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
        "affected_family_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "summary_ref": {"$ref": "#/$defs/nullable_non_secret_ref"}
      },
      "allOf": [
        {
          "if": {"properties": {"class": {"const": "none"}}, "required": ["class"]},
          "then": {
            "properties": {
              "backup_boundary_ref": {"type": "null"},
              "affected_family_ids": {"maxItems": 0},
              "summary_ref": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "backup_boundary_ref": {"$ref": "#/$defs/non_secret_ref"},
              "affected_family_ids": {"minItems": 1},
              "summary_ref": {"$ref": "#/$defs/non_secret_ref"}
            }
          }
        }
      ]
    },
    "migration_preflight_result": {
      "title": "MigrationPreflightResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason_code",
        "filesystem_ref",
        "free_bytes",
        "required_free_bytes",
        "backup_bytes",
        "staging_bytes",
        "reserve_bytes",
        "checked_at_utc"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "reason_code": {
          "enum": [
            null,
            "blocked_insufficient_space"
          ]
        },
        "filesystem_ref": {
          "description": "Non-secret stable filesystem identity; never an absolute path.",
          "$ref": "#/$defs/non_secret_ref"
        },
        "free_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "required_free_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "backup_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "staging_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "reserve_bytes": {
          "type": "integer",
          "minimum": 268435456
        },
        "checked_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "ready"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "reason_code": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "blocked"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "reason_code": {
                "const": "blocked_insufficient_space"
              }
            }
          }
        }
      ],
      "x-puppet-master-assertions": [
        {
          "id": "reserve_formula",
          "expression": "reserve_bytes == max(268435456, ceil(0.10 * (backup_bytes + staging_bytes)))"
        },
        {
          "id": "required_free_formula",
          "expression": "required_free_bytes == backup_bytes + staging_bytes + reserve_bytes"
        },
        {
          "id": "ready_space_pairing",
          "expression": "outcome != 'ready' or free_bytes >= required_free_bytes"
        },
        {
          "id": "blocked_space_pairing",
          "expression": "outcome != 'blocked' or free_bytes < required_free_bytes"
        }
      ]
    },
    "migration_progress_snapshot": {
      "title": "MigrationProgressSnapshot",
      "description": "A projection derived only from the matching durable storage migration journal; it is not a receipt and carries no inferred percentage or ETA.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "journal_ref",
        "phase",
        "stable_step_label",
        "completed_steps",
        "total_steps",
        "cancellable",
        "updated_at_utc"
      ],
      "properties": {
        "migration_id": {
          "type": "string",
          "minLength": 1
        },
        "journal_ref": {"$ref": "#/$defs/non_secret_ref"},
        "phase": {
          "enum": [
            "preflight",
            "backup_in_progress",
            "backup_verified",
            "applying",
            "pre_stamp_verified",
            "stamp_committed",
            "post_stamp_verifying",
            "committed",
            "restore_required",
            "restoring",
            "rolled_back",
            "blocked"
          ]
        },
        "stable_step_label": {
          "type": "string",
          "minLength": 1
        },
        "completed_steps": {
          "type": "integer",
          "minimum": 0
        },
        "total_steps": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_done": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_total": {
          "type": "integer",
          "minimum": 0
        },
        "cancellable": {
          "type": "boolean"
        },
        "preflight_result": {
          "$ref": "#/$defs/migration_preflight_result"
        },
        "backup_ref": {"$ref": "#/$defs/non_secret_ref"},
        "data_loss_risk": {"$ref": "#/$defs/data_loss_risk"},
        "updated_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "terminal_receipt_ref": {
          "description": "Reference to the one storage-registry pm.storage_value.migration_receipt.v1 receipt; never a peer progress receipt.",
          "$ref": "#/$defs/non_secret_ref"
        }
      },
      "dependentRequired": {
        "bytes_done": [
          "bytes_total"
        ],
        "bytes_total": [
          "bytes_done"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "preflight"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "cancellable": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "cancellable": {
                "const": false
              }
            },
            "required": [
              "preflight_result"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "committed",
                  "rolled_back"
                ]
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "required": [
              "terminal_receipt_ref"
            ],
            "properties": {
              "preflight_result": {
                "properties": {
                  "outcome": {
                    "const": "ready"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "blocked"
              },
              "preflight_result": {
                "properties": {
                  "outcome": {
                    "const": "blocked"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            },
            "required": [
              "phase",
              "preflight_result"
            ]
          },
          "then": {
            "not": {
              "required": [
                "terminal_receipt_ref"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "blocked"
              },
              "preflight_result": {
                "properties": {
                  "outcome": {
                    "const": "ready"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            },
            "required": [
              "phase",
              "preflight_result"
            ]
          },
          "then": {
            "required": [
              "terminal_receipt_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "preflight",
                  "backup_in_progress",
                  "backup_verified",
                  "applying",
                  "pre_stamp_verified",
                  "stamp_committed",
                  "post_stamp_verifying",
                  "restore_required",
                  "restoring"
                ]
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "not": {
              "required": [
                "terminal_receipt_ref"
              ]
            }
          }
        }
      ],
      "x-puppet-master-assertions": [
        {
          "id": "step_bounds",
          "expression": "0 <= completed_steps <= total_steps"
        },
        {
          "id": "byte_bounds_when_present",
          "expression": "bytes_done is absent or 0 <= bytes_done <= bytes_total"
        }
      ]
    },
    "migration_receipt": {
      "title": "MigrationReceipt",
      "description": "The sole terminal durable migration receipt. Progress remains journal-derived and is never substituted for this receipt.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "schema_version", "receipt_id", "migration_id", "from_version",
        "to_version", "schema_ids", "store_transitions", "family_transitions",
        "preflight_result", "backup_ref", "applied_steps", "verification_result",
        "rollback_available", "rollback_result", "data_loss_risk", "terminal_status",
        "started_at_utc", "completed_at_utc", "app_version", "journal_ref",
        "redaction_profile"
      ],
      "properties": {
        "schema_id": {"const": "pm.storage_value.migration_receipt.v1"},
        "schema_version": {"const": "1.0.0"},
        "receipt_id": {"type": "string", "minLength": 1},
        "migration_id": {"type": "string", "minLength": 1},
        "from_version": {"type": "string", "minLength": 1},
        "to_version": {"type": "string", "minLength": 1},
        "schema_ids": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "store_transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/migration_transition"}
        },
        "family_transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/migration_transition"}
        },
        "preflight_result": {"$ref": "#/$defs/migration_preflight_result"},
        "backup_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
        "applied_steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/migration_applied_step"}
        },
        "verification_result": {"$ref": "#/$defs/migration_verification_result"},
        "rollback_available": {"type": "boolean"},
        "rollback_result": {
          "oneOf": [
            {"$ref": "#/$defs/migration_rollback_result"},
            {"type": "null"}
          ]
        },
        "data_loss_risk": {"$ref": "#/$defs/data_loss_risk"},
        "terminal_status": {"enum": ["committed", "rolled_back", "blocked"]},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "app_version": {"type": "string", "minLength": 1},
        "journal_ref": {"$ref": "#/$defs/non_secret_ref"},
        "redaction_profile": {"enum": ["no_secrets", "redacted_refs_only"]}
      },
      "allOf": [
        {
          "if": {"properties": {"rollback_available": {"const": false}}, "required": ["rollback_available"]},
          "then": {"properties": {"rollback_result": {"type": "null"}}}
        },
        {
          "if": {"properties": {"terminal_status": {"const": "committed"}}, "required": ["terminal_status"]},
          "then": {
            "properties": {
              "preflight_result": {"properties": {"outcome": {"const": "ready"}}, "required": ["outcome"]},
              "backup_ref": {"$ref": "#/$defs/non_secret_ref"},
              "store_transitions": {"minItems": 1},
              "family_transitions": {"minItems": 1},
              "applied_steps": {"minItems": 1, "contains": {"properties": {"status": {"const": "verified"}}, "required": ["status"]}},
              "verification_result": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
              "rollback_result": {"type": "null"},
              "data_loss_risk": {"properties": {"class": {"const": "none"}}, "required": ["class"]}
            }
          }
        },
        {
          "if": {"properties": {"terminal_status": {"const": "rolled_back"}}, "required": ["terminal_status"]},
          "then": {
            "properties": {
              "preflight_result": {"properties": {"outcome": {"const": "ready"}}, "required": ["outcome"]},
              "backup_ref": {"$ref": "#/$defs/non_secret_ref"},
              "store_transitions": {"minItems": 1},
              "family_transitions": {"minItems": 1},
              "applied_steps": {"minItems": 1},
              "verification_result": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
              "rollback_available": {"const": true},
              "rollback_result": {"properties": {"outcome": {"const": "succeeded"}}, "required": ["outcome"]}
            }
          }
        },
        {
          "if": {"properties": {"terminal_status": {"const": "blocked"}}, "required": ["terminal_status"]},
          "then": {
            "properties": {
              "preflight_result": {"properties": {"outcome": {"const": "ready"}}, "required": ["outcome"]},
              "backup_ref": {"type": "null"},
              "store_transitions": {"maxItems": 0},
              "family_transitions": {"maxItems": 0},
              "applied_steps": {"maxItems": 0},
              "verification_result": {"properties": {"status": {"const": "not_run"}}, "required": ["status"]},
              "rollback_available": {"const": false},
              "rollback_result": {"type": "null"}
            }
          }
        }
      ]
    },
    "migration_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_or_family_id", "from_version", "to_version"],
      "properties": {
        "store_or_family_id": {"type": "string", "minLength": 1},
        "from_version": {"type": "string", "minLength": 1},
        "to_version": {"type": "string", "minLength": 1}
      }
    },
    "migration_applied_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "status", "evidence_ref"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["applied", "verified", "skipped_no_change", "rolled_back", "failed"]},
        "evidence_ref": {"$ref": "#/$defs/non_secret_ref"}
      }
    },
    "migration_verification_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail_refs"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_run"]},
        "detail_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/non_secret_ref"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["passed", "failed"]}}, "required": ["status"]},
          "then": {"properties": {"detail_refs": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "not_run"}}, "required": ["status"]},
          "then": {"properties": {"detail_refs": {"maxItems": 0}}}
        }
      ]
    },
    "migration_rollback_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "restore_ref", "verification_ref"],
      "properties": {
        "outcome": {"enum": ["succeeded", "failed"]},
        "restore_ref": {"$ref": "#/$defs/non_secret_ref"},
        "verification_ref": {"$ref": "#/$defs/non_secret_ref"}
      }
    }
  }
}
