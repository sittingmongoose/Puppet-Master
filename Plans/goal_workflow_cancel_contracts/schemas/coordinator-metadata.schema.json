        "codec_id": {
          "type": "string",
          "minLength": 1
        },
        "complete_value_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "CodecResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "codec_id",
        "codec_version",
        "actual_schema_id",
        "actual_schema_version",
        "original_resource_sha256",
        "original_registration_ref",
        "original_owner_ref",
        "original_owner_epoch"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "goal_json",
            "producer_jcs",
            "event_msgpack",
            "sir_result_jcs"
          ]
