          "type": "string",
          "minLength": 1
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "BeforeStopReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "operation_id",
        "source_profile",
        "source_audit",
        "binding_selection",
        "goal_argument_sha256",
        "native_argument_sha256",
        "exact_encoding_template_sha256",
        "complete_numeric_inventory_sha256",
