      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "project_id",
        "thread_id",
        "goal_id"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "physical_key",
        "schema_id",
        "schema_version",
        "codec_id",
        "complete_value_sha256"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_key": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
