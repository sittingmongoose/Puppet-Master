        "d06_result": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/Selection"
        },
        "d06_origin": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/Selection"
        },
        "d06_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "d06_disposition": {
          "enum": [
            "cancelled_from_nonterminal",
            "terminal_preserved"
          ]
        },
        "preserved_terminal_status": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "certified",
                "failed",
                "cancelled"
              ]
            }
          ]
        },
        "d05_result": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/Selection"
        },
        "d05_origin": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/Selection"
        },
        "goal_argument_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_argument_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_issuer": {
          "allOf": [
            {
              "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/Issuer"
            },
            {
              "properties": {
                "owner_method": {
                  "const": "owner.goal.workflow_cancel.settle_owner.v1"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "d06_disposition": {
                "const": "cancelled_from_nonterminal"
              }
            }
          },
          "then": {
            "properties": {
              "preserved_terminal_status": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "preserved_terminal_status": {
                "enum": [
                  "certified",
                  "failed",
                  "cancelled"
                ]
              }
            }
          }
        }
      ]
    },
