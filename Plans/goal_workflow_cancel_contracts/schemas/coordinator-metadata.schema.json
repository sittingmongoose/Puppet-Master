        "original_owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "original_owner_epoch": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_method",
        "original_owner_ref",
        "original_owner_epoch",
        "original_operation_id",
        "original_transaction_id",
        "original_permission_source",
        "original_causation_ref",
        "committed_at"
