        "original_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "original_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "original_permission_source": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/Selection"
