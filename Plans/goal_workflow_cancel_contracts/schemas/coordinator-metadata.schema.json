        "source_audit": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/Selection"
        },
        "binding_selection": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/Selection"
        },
        "goal_argument_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_argument_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exact_encoding_template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "complete_numeric_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "codec_resources": {
          "type": "array",
          "items": {
            "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/CodecResource"
          },
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "goal_json"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "producer_jcs"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "event_msgpack"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "sir_result_jcs"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
