      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_owners",
        "original_event_ready_progress",
        "original_producer",
        "actual_append_source"
      ],
      "properties": {
        "post_owners": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_goal_arguments.v1.schema.json#/$defs/PostOwnersEntry"
        },
        "original_event_ready_progress": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_assignment.v1.schema.json#/$defs/EventReadyProgress"
        },
        "original_producer": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_custody.v1.schema.json#/$defs/ProducerInput"
        },
        "actual_append_source": {
          "$ref": "https://puppetmaster.local/schemas/goal_execution_binding_custody/1.0.0/schema.json#/$defs/AppendSourceRead"
        }
      }
    },
    "LateAssignmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_owners",
        "original_event_ready_progress",
        "original_producer",
        "actual_append_source",
        "actual_late_reservation",
        "actual_storage_assigned_event",
        "complete_numeric_domains",
        "codec_resources"
      ],
      "properties": {
        "post_owners": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_goal_arguments.v1.schema.json#/$defs/PostOwnersEntry"
        },
        "original_event_ready_progress": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_assignment.v1.schema.json#/$defs/EventReadyProgress"
        },
        "original_producer": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_custody.v1.schema.json#/$defs/ProducerInput"
        },
        "actual_append_source": {
          "$ref": "https://puppetmaster.local/schemas/goal_execution_binding_custody/1.0.0/schema.json#/$defs/AppendSourceRead"
        },
        "actual_late_reservation": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/LateReservation"
        },
        "actual_storage_assigned_event": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_assignment.v1.schema.json#/$defs/TypedGoalEventRecord"
        },
        "complete_numeric_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://puppetmaster.local/schemas/goal_execution_binding_custody/1.0.0/schema.json#/$defs/NumericPathDomain"
          }
        },
        "codec_resources": {
          "type": "array",
          "items": {
            "$ref": "https://puppetmaster.local/schemas/goal_execution_binding_custody/1.0.0/schema.json#/$defs/CodecResource"
          },
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "goal_json"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "producer_jcs"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "event_msgpack"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "sir_result_jcs"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
