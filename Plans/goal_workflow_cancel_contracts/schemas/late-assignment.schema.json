      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "publication",
        "full_value_result",
        "original_custody",
        "original_assignment",
        "actual_current_append_source",
        "actual_source_frame",
        "actual_index_checkpoint",
        "actual_index_generation",
        "actual_index_frontier",
        "actual_index_read_token",
        "actual_index_row"
      ],
      "properties": {
        "event": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_assignment.v1.schema.json#/$defs/TypedGoalEventRecord"
        },
        "publication": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_custody.v1.schema.json#/$defs/OriginalPublication"
        },
        "full_value_result": {
          "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/full_value_result"
        },
        "original_custody": {
          "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/custody_v2"
        },
        "original_assignment": {
          "$ref": "https://puppetmaster.local/proposals/goal_workflow_cancel_coordinator_metadata.v1.schema.json#/$defs/StorageLateAssignmentAudit"
        },
        "actual_current_append_source": {
