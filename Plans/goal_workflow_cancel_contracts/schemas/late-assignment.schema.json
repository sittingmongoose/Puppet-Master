        },
        "actual_index_generation": {
          "$ref": "https://puppetmaster.local/schemas/storage_compaction_native_contracts/1.0.0/schema.json#/$defs/existing_index_root__generation"
        },
        "actual_index_frontier": {
          "$ref": "https://puppetmaster.local/schemas/storage_compaction_native_contracts/1.0.0/schema.json#/$defs/existing_index_root__frontier"
