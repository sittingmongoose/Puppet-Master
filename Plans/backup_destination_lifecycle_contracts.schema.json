{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/backup-destination-lifecycle/1.0.0/backup_destination_lifecycle_contracts.schema.json",
  "$defs": {
    "test_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode",
        "scratch_prefix_ref",
        "scratch_admission_ref"
      ],
      "properties": {
        "kind": {
          "const": "test"
        },
        "mode": {
          "enum": [
            "read_only",
            "approved_canary"
          ]
        },
        "scratch_prefix_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/nullable_non_secret_ref"
        },
        "scratch_admission_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/nullable_non_secret_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "approved_canary"
              }
            }
          },
          "then": {
            "properties": {
              "scratch_prefix_ref": {
                "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
              },
              "scratch_admission_ref": {
                "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
              }
            }
          },
          "else": {
            "properties": {
              "scratch_admission_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "remove_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "preview_ref",
        "delete_data"
      ],
      "properties": {
        "kind": {
          "const": "remove"
        },
        "preview_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "delete_data": {
          "const": false
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "authority",
        "operation_id",
        "before_destination_ref",
        "input"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup.destination_lifecycle.request.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "authority": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/backup_restore_command_request"
        },
        "operation_id": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "before_destination_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "input": {
          "oneOf": [
            {
              "$ref": "#/$defs/test_input"
            },
            {
              "$ref": "#/$defs/remove_input"
            }
          ]
        }
      },
      "allOf": [
        {
          "properties": {
            "authority": {
              "properties": {
                "command_id": {
                  "enum": [
                    "cmd.backup.destination.test",
                    "cmd.backup.destination.remove"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "authority": {
                "properties": {
                  "command_id": {
                    "const": "cmd.backup.destination.test"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/test_input"
              }
            }
          },
          "else": {
            "properties": {
              "input": {
                "$ref": "#/$defs/remove_input"
              }
            }
          }
        }
      ]
    },
    "destination": {
      "oneOf": [
        {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/backup_destination"
        },
        {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/backup_destination_v3"
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "backup_destination_id",
        "destination_generation"
      ],
      "properties": {
        "server_id": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "backup_destination_id": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "destination_generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scratch_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "admission_ref",
        "original_request_ref",
        "selection",
        "scratch_prefix_ref",
        "canary_object_ref",
        "authority_decision_refs",
        "issued_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup.destination_lifecycle.scratch_admission.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "admission_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "scratch_prefix_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "canary_object_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "authority_decision_refs": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/ref_list",
          "minItems": 1
        },
        "issued_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/timestamp"
        }
      }
    },
    "capability_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "declaration",
        "method",
        "outcome",
        "evidence_refs"
      ],
      "properties": {
        "capability": {
          "enum": [
            "list",
            "read",
            "write",
            "commit",
            "lock",
            "delete",
            "version",
            "object_lock",
            "archive_retrieval",
            "stream_read",
            "resume"
          ]
        },
        "declaration": {
          "enum": [
            "supported",
            "conditional",
            "unsupported",
            "not_run"
          ]
        },
        "method": {
          "enum": [
            "not_attempted",
            "read_only_probe",
            "canary_probe",
            "existing_evidence"
          ]
        },
        "outcome": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "unavailable",
            "unsupported"
          ]
        },
        "evidence_refs": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/ref_list"
        }
      }
    },
    "phase": {
      "enum": [
        "not_attempted",
        "known_not_applied",
        "known_applied",
        "unknown"
      ]
    },
    "canary_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scratch_admission_ref",
        "scratch_prefix_ref",
        "canary_object_ref",
        "create",
        "write",
        "delete",
        "cleanup",
        "cleanup_receipt_ref"
      ],
      "properties": {
        "scratch_admission_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "scratch_prefix_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "canary_object_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "create": {
          "$ref": "#/$defs/phase"
        },
        "write": {
          "$ref": "#/$defs/phase"
        },
        "delete": {
          "$ref": "#/$defs/phase"
        },
        "cleanup": {
          "enum": [
            "not_required",
            "completed",
            "required",
            "unknown"
          ]
        },
        "cleanup_receipt_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/nullable_non_secret_ref"
        }
      }
    },
    "cleanup_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "cleanup_receipt_ref",
        "original_request_ref",
        "selection",
        "scratch_admission_ref",
        "scratch_prefix_ref",
        "canary_object_ref",
        "outcome",
        "evidence_refs",
        "observed_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup.destination_lifecycle.cleanup_observation.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "cleanup_receipt_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "scratch_admission_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "scratch_prefix_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "canary_object_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "outcome": {
          "enum": [
            "completed",
            "required",
            "unknown"
          ]
        },
        "evidence_refs": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/ref_list"
        },
        "observed_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/timestamp"
        }
      }
    },
    "test_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_request_ref",
        "selection",
        "input",
        "before_destination_ref",
        "after_destination_ref",
        "capabilities",
        "canary",
        "observed_at_utc",
        "currentness_ref",
        "currentness_sha256"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup.destination_lifecycle.test_observation.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "input": {
          "$ref": "#/$defs/test_input"
        },
        "before_destination_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "after_destination_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_observation"
          }
        },
        "canary": {
          "oneOf": [
            {
              "$ref": "#/$defs/canary_effects"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/timestamp"
        },
        "currentness_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "currentness_sha256": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/sha256"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "record",
        "consequence",
        "reason_ref"
      ],
      "properties": {
        "record_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "record": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/backup_policy"
            },
            {
              "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/backup_repository_binding"
            }
          ]
        },
        "consequence": {
          "enum": [
            "unchanged",
            "blocking"
          ]
        },
        "reason_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        }
      }
    },
    "removal_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "preview_ref",
        "selection",
        "before_destination_ref",
        "currentness_ref",
        "currentness_sha256",
        "dependencies",
        "disposition",
        "delete_data",
        "reviewed_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup.destination_lifecycle.removal_preview.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "preview_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "before_destination_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "currentness_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "currentness_sha256": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/sha256"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "disposition": {
          "enum": [
            "ready",
            "blocked",
            "unavailable"
          ]
        },
        "delete_data": {
          "const": false
        },
        "reviewed_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/timestamp"
        }
      }
    },
    "registry_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_request_ref",
        "selection",
        "registry_revision",
        "membership",
        "destination_ref",
        "observed_at_utc",
        "currentness_ref",
        "currentness_sha256"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup.destination_lifecycle.registry_observation.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "registry_revision": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "membership": {
          "enum": [
            "present",
            "absent",
            "unknown"
          ]
        },
        "destination_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/nullable_non_secret_ref"
        },
        "observed_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/timestamp"
        },
        "currentness_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "currentness_sha256": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/sha256"
        }
      }
    },
    "remove_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_request_ref",
        "selection",
        "preview_ref",
        "before_registry_ref",
        "after_registry_ref",
        "dependency_refs",
        "external_data_effect",
        "credential_owner_effect",
        "observed_at_utc",
        "currentness_ref",
        "currentness_sha256"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup.destination_lifecycle.remove_observation.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "preview_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "before_registry_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "after_registry_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "dependency_refs": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/ref_list"
        },
        "external_data_effect": {
          "const": "unchanged"
        },
        "credential_owner_effect": {
          "const": "unchanged"
        },
        "observed_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/timestamp"
        },
        "currentness_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
        },
        "currentness_sha256": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/sha256"
        }
      }
    },
    "observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/test_observation"
        },
        {
          "$ref": "#/$defs/remove_observation"
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_request_ref",
        "operation_id",
        "command_id",
        "command_instance_id",
        "outcome",
        "effect_state",
        "observation_ref",
        "receipt_ref",
        "observable_work_ref",
        "error_ref",
        "reconciliation_ref",
        "currentness_ref",
        "currentness_sha256",
        "observed_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup.destination_lifecycle.result.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/non_secret_ref"
