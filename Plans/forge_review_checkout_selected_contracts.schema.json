{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/forge-review-checkout-selected/1.0.0/forge_review_checkout_selected_contracts.schema.json",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_review_id",
        "review_revision_ref",
        "repository_context_ref",
        "scm_backend",
        "placement",
        "checkout_preview_ref",
        "checkout_preview_digest",
        "expected_revision"
      ],
      "properties": {
        "provider_review_id": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "review_revision_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "repository_context_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "scm_backend": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/scm_backend"
        },
        "placement": {
          "enum": [
            "separate_workspace",
            "current_workspace"
          ]
        },
        "checkout_preview_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "checkout_preview_digest": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/sha256"
        },
        "expected_revision": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/git_revision"
            },
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/jujutsu_revision"
            }
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "authority",
        "selection"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.forge.review_checkout_selected.request.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "authority": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/command_request"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "allOf": [
        {
          "properties": {
            "authority": {
              "properties": {
                "command_id": {
                  "const": "cmd.forge.review.checkout"
                }
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_request_ref",
        "observation_ref",
        "owner_result",
        "error_projection_ref"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.forge.review_checkout_selected.result.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "observation_ref": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_result": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/command_result"
        },
        "error_projection_ref": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "properties": {
            "owner_result": {
              "properties": {
                "command_id": {
                  "const": "cmd.forge.review.checkout"
                }
              }
            }
          }
        }
      ]
    },
    "path_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "disposition"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "disposition": {
          "enum": [
            "preserved",
            "checked_out",
            "conflicted",
            "unknown"
          ]
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "state"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "state": {
          "enum": [
            "resolved",
            "unresolved",
            "unknown"
          ]
        }
      }
    },
    "dirty_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_snapshot_sha256",
        "after_snapshot_sha256",
        "preserved",
        "discarded_paths",
        "autostash_observed"
      ],
      "properties": {
        "before_snapshot_sha256": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/sha256"
        },
        "after_snapshot_sha256": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/sha256"
        },
        "preserved": {
          "type": "boolean"
        },
        "discarded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "autostash_observed": {
          "type": "boolean"
        }
      }
    },
    "preview": {
      "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/review_checkout_preview"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_request_ref",
        "command_instance_id",
        "operation_id",
        "selection",
        "provider",
        "repository_binding_ref",
        "target_ref",
        "provider_receipt_ref",
        "effect_state",
        "outcome",
        "reconciliation_ref",
        "observed_at_utc",
        "target_workspace_id",
        "target_workspace_kind",
        "scm_operation_receipt_ref",
        "dirty_state",
        "actual_effects",
        "conflicts"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.forge.review_checkout_selected.observation.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "command_instance_id": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "operation_id": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "provider": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/provider"
        },
        "repository_binding_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "target_ref": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_receipt_ref": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_state": {
          "enum": [
            "not_attempted",
            "known_not_applied",
            "known_applied",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "checked_out",
            "rejected",
            "cancelled",
            "unknown"
          ]
        },
        "reconciliation_ref": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/timestamp"
        },
        "target_workspace_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "target_workspace_kind": {
          "enum": [
            "git_worktree",
            "jujutsu_workspace"
          ]
        },
        "scm_operation_receipt_ref": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty_state": {
          "$ref": "#/$defs/dirty_state"
        },
        "actual_effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path_effect"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          }
        }
      }
    },
    "dispatch_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "identity",
        "request_ref",
        "dispatch_id",
        "dispatch_frame_id",
        "target_generation",
        "idempotency_key",
        "actor_ref",
        "permission_snapshot_ref",
        "accepted_at_utc",
        "arguments",
        "payload_sha256",
        "return_context"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.sir.forge_review_checkout_selected_dispatch.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "identity": {
          "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/IdentityEnvelope"
        },
        "request_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "dispatch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "dispatch_frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target_generation": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "permission_snapshot_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "accepted_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "arguments": {
          "$ref": "#/$defs/request"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "return_context": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/return_context"
            }
          ]
        }
      }
    },
    "delivery_return_context": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/return_context"
        }
      ]
    },
    "fixture_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "runtime_evidence",
        "request",
        "result",
        "original_binding_ref",
        "outcome_ref",
        "response_ref",
        "delivery_return_context",
        "records"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.forge.review_checkout_selected.fixture.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "runtime_evidence": {
          "const": false
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "original_binding_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "outcome_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "response_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "delivery_return_context": {
          "$ref": "#/$defs/delivery_return_context"
        },
        "records": {
          "type": "object"
        }
      }
    },
    "error_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "projection_id",
        "owner_error_ref",
        "original_request_ref",
        "identity",
        "ui_error",
        "return_context",
        "recorded_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.sir.forge_review_checkout_selected_error_projection.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "projection_id": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "owner_error_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "identity": {
          "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/IdentityEnvelope"
        },
        "ui_error": {
          "$ref": "https://puppetmaster.local/schemas/ui_command_response/2.0.0/ui_command_response.schema.json#/properties/error"
        },
        "return_context": {
          "$ref": "#/$defs/delivery_return_context"
        },
        "recorded_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/timestamp"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/preview"
    },
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/dispatch_binding"
    },
    {
      "$ref": "#/$defs/error_projection"
    },
    {
      "$ref": "#/$defs/fixture_case"
    }
  ]
}
