                    "null"
                  ],
                  "minLength": 1
                },
                "user_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "computer_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "profile_id": {
                  "type": "string",
