            "kind",
            "project_id",
            "user_id",
            "computer_id",
            "profile_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "project",
                "app"
              ]
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
