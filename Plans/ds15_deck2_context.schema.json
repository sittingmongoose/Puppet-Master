                  "thread_id",
                  "grant_ref"
                ],
                "properties": {
                  "thread_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$(?![\\s\\S])"
                  },
                  "grant_ref": {
