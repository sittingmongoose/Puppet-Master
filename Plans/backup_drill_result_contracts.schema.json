      "$ref": "https://puppetmaster.local/schemas/backup_snapshot_results/1.0.0/backup_snapshot_result_contracts.schema.json#/$defs/backup_snapshot_resolution"
    },
    "backup_drill_target_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_operation",
        "snapshot_selection",
        "isolated_destination_ref",
        "target_identity_ref",
        "server_id",
        "host_id",
        "environment_id",
        "project_id",
        "containment_ref",
        "target_generation",
        "lease_ref",
        "permission_decision_ref",
        "filesafe_decision_ref",
        "resource_admission_ref",
        "cost_network_admission_ref",
        "admitted_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.backup_restore_system.drill_target_admission.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_operation": {
          "$ref": "#/$defs/backup_operation_binding"
        },
        "snapshot_selection": {
          "$ref": "https://puppetmaster.local/schemas/backup_snapshot_results/1.0.0/backup_snapshot_result_contracts.schema.json#/$defs/selection"
        },
        "isolated_destination_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "target_identity_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "server_id": {
          "$ref": "#/$defs/stable_id"
        },
        "host_id": {
          "$ref": "#/$defs/stable_id"
        },
        "environment_id": {
          "$ref": "#/$defs/stable_id"
        },
        "project_id": {
          "$ref": "#/$defs/nullable_stable_id"
        },
        "containment_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "target_generation": {
          "type": "integer",
          "minimum": 0
        },
        "lease_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "permission_decision_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "filesafe_decision_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "resource_admission_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "cost_network_admission_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "admitted_at_utc": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "description": "RestoreCoordinator internal output from actual topology, Permissions, FileSafe and resource/cost/network owners. Nonpersisted output, not transferable authority. Lease/generation and containment are rechecked under owner fence at each effect. No host path or caller isolation boolean proves safety."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_family_ids",
        "path_selection",
        "selected_path_refs",
        "evidence_refs"
      ],
      "properties": {
        "selected_family_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/family_id"}
        },
        "path_selection": {
          "enum": [
            "none",
            "all_paths_in_selected_families",
            "selected_paths"
          ]
        },
        "selected_path_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "evidence_refs": {
          "$ref": "#/$defs/ref_list"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "phase",
        "target_identity_ref",
        "outcome",
        "artifact_refs",
        "evidence_refs",
        "failure_refs"
      ],
      "properties": {
        "effect_id": {
          "$ref": "#/$defs/stable_id"
        },
        "phase": {
          "enum": [
            "staging",
            "isolated_verification",
            "cleanup"
