        },
        "evidence_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "failure_refs": {
          "$ref": "#/$defs/ref_list"
        }
      }
    },
    "backup_drill_verification_receipt_v2": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/schemas/backup_restore_system/2.0.0/backup_restore_system_contracts.schema.json#/$defs/receipt_common"
        },
        {
          "type": "object",
          "required": [
            "schema_id",
            "original_operation",
            "source_resolution",
            "target_admission",
            "requested_coverage",
            "attempted_coverage",
            "achieved_coverage",
            "verification_status",
            "operation_status",
            "effects",
            "native_source_closure_refs",
            "jj_verification_receipt_ref",
            "rebuild_retained_operation_proof_refs",
            "cleanup_status",
            "cleanup_evidence_refs",
            "residual_artifact_refs",
            "recovery_ref"
          ],
          "properties": {
            "schema_id": {
              "const": "pm.backup_restore_system.backup_verification_receipt.drill.v2"
            },
            "schema_version": {
              "const": "2.0.0"
            },
            "command_id": {
              "const": "cmd.backup.test_restore"
            },
            "original_operation": {
              "allOf": [
                {
                  "$ref": "#/$defs/backup_operation_binding"
                },
                {
                  "properties": {
                    "command_id": {
                      "const": "cmd.backup.test_restore"
                    }
                  }
                }
              ]
            },
            "source_resolution": {
              "$ref": "#/$defs/backup_snapshot_resolution"
            },
            "target_admission": {
              "anyOf": [
                {
                  "$ref": "#/$defs/backup_drill_target_admission"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested_coverage": {
              "$ref": "#/$defs/backup_drill_coverage"
            },
            "attempted_coverage": {
              "$ref": "#/$defs/coverage"
            },
            "achieved_coverage": {
              "$ref": "#/$defs/coverage"
            },
            "verification_status": {
              "enum": [
                "passed",
                "failed",
                "cancelled",
                "not_run"
              ]
            },
            "operation_status": {
              "enum": [
                "completed",
                "failed",
                "cancelled",
                "recovery_required"
              ]
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/effect"
              }
            },
            "native_source_closure_refs": {
              "$ref": "#/$defs/ref_list"
            },
            "jj_verification_receipt_ref": {
              "$ref": "#/$defs/nullable_non_secret_ref"
            },
            "rebuild_retained_operation_proof_refs": {
              "$ref": "#/$defs/ref_list"
            },
            "cleanup_status": {
              "enum": [
                "not_needed",
                "completed",
                "failed",
                "pending",
                "outcome_unknown"
              ]
            },
            "cleanup_evidence_refs": {
              "$ref": "#/$defs/ref_list"
            },
            "residual_artifact_refs": {
              "$ref": "#/$defs/ref_list"
            },
            "recovery_ref": {
              "$ref": "#/$defs/nullable_non_secret_ref"
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "Isolated-drill branch of the existing BackupVerificationReceipt family, distinct runtime ID from ordinary v2 verify. No live activation, restored hook execution, fifth RestoreRun mode or synthetic RestoreRun/Preview records. Actual native closure relevance and authenticity are checked by existing owners; unproducible mandatory proof prevents pass."
    },
    "jj_verification_context": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "restore_run_ref",
            "restore_preview_ref"
          ],
          "properties": {
            "kind": {
              "const": "live_restore"
            },
            "restore_run_ref": {
              "$ref": "https://puppetmaster.local/schemas/jujutsu-integration/1.0.0/jujutsu_integration_contracts.schema.json#/$defs/backup_jj_restore_verification_receipt/properties/restore_run_ref"
            },
            "restore_preview_ref": {
              "$ref": "https://puppetmaster.local/schemas/jujutsu-integration/1.0.0/jujutsu_integration_contracts.schema.json#/$defs/backup_jj_restore_verification_receipt/properties/restore_preview_ref"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "original_operation",
            "source_resolution",
            "target_admission"
          ],
          "properties": {
            "kind": {
              "const": "isolated_drill"
            },
            "original_operation": {
              "allOf": [
                {
                  "$ref": "#/$defs/backup_operation_binding"
                },
                {
                  "properties": {
                    "command_id": {
                      "const": "cmd.backup.test_restore"
                    }
                  }
                }
              ]
            },
            "source_resolution": {
              "$ref": "#/$defs/backup_snapshot_resolution"
            },
            "target_admission": {
              "$ref": "#/$defs/backup_drill_target_admission"
            }
          }
        }
      ]
    },
