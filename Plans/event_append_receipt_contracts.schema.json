        },
        "segment_name": {
          "type": "string",
          "minLength": 1
        },
        "durable_start_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "durable_end_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "manifest_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "group_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
