    "restore_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "storage_instance_id",
        "restore_occurrence_id",
        "restore_journal_ref",
        "restore_journal_sha256",
        "recovery_epoch",
        "restored_boundary_sha256",
        "publication_id",
        "members"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "restore_occurrence_id": {
          "type": "string",
          "minLength": 1
        },
        "restore_journal_ref": {
          "type": "string",
          "minLength": 1
        },
        "restore_journal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recovery_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "restored_boundary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/restore_admitted_member"
          }
        }
      }
    },
