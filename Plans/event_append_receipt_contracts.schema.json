{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0",
  "title": "First append receipt contracts",
  "$defs": {
    "AppendReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence_id",
        "segment_generation",
        "segment_name",
        "byte_offset",
        "commit_group_id",
        "durability_class",
        "durable_end_offset",
        "durability_state",
        "manifest_generation",
        "acknowledged_at_utc"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "segment_generation": {
          "type": "integer",
          "minimum": 0
        },
        "segment_name": {
          "type": "string",
          "minLength": 1
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "commit_group_id": {
          "type": "string",
          "minLength": 1
        },
        "durability_class": {
          "enum": [
            "ordinary",
            "barrier"
          ]
        },
        "durable_end_offset": {
          "type": "integer",
          "minimum": 0
        },
        "durability_state": {
          "const": "synced"
        },
        "manifest_generation": {
          "type": "integer",
          "minimum": 0
        },
        "acknowledged_at_utc": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence_id",
        "byte_offset",
        "frame_length",
        "frame_sha256"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "frame_length": {
          "type": "integer",
          "minimum": 48,
          "maximum": 18446744073709551615
        },
        "frame_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "active_durable_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "storage_instance_id",
        "commit_group_id",
        "durability_class",
        "segment_generation",
        "segment_name",
        "durable_start_offset",
        "durable_end_offset",
        "manifest_generation",
        "members",
        "group_digest",
        "restore_admission"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "commit_group_id": {
          "type": "string",
          "minLength": 1
        },
        "durability_class": {
          "enum": [
            "ordinary",
            "barrier"
          ]
        },
        "segment_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "segment_name": {
          "type": "string",
          "minLength": 1
        },
        "durable_start_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "durable_end_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "manifest_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "group_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "restore_admission": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/restore_admission"
            }
          ]
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "event_id",
        "scope_partition",
        "event_type",
        "idempotency_key",
        "producer_semantic_digest",
        "group_digest",
        "first_append_receipt",
        "redaction_profile",
        "original_segment_ref"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.event_append_receipt_custody.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_partition": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "producer_semantic_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "group_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "first_append_receipt": {
          "$ref": "#/$defs/AppendReceipt"
        },
        "redaction_profile": {
          "const": "no_secrets"
        },
        "original_segment_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "restore_admitted_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "scope_partition",
        "event_type",
        "idempotency_key",
        "producer_semantic_digest",
        "owner_id",
        "owner_operation_id",
        "owner_operation_sha256"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_partition": {
          "type": "string",
          "minLength": 1
