        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "producer_semantic_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "owner_id": {
          "type": "string",
