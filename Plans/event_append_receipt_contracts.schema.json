    "custody_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "event_id",
        "scope_partition",
        "event_type",
        "idempotency_key",
        "producer_semantic_digest",
        "group_digest",
        "first_append_receipt",
        "redaction_profile",
        "original_segment_ref",
        "original_event_value_commitment"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.event_append_receipt_custody.v2"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "storage_instance_id": {
          "type": "string",
