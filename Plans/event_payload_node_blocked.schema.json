{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event_payloads/node_blocked/1.0.0",
  "title": "node.blocked prepared payload contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "replan_generation": {
      "type": "integer",
      "minimum": 0
    },
    "blocked_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "blocked_reason_code": {
      "enum": [
        "permission_denied",
        "auth_required",
        "user_declined",
        "headless_ask_denied",
        "filesafe_blocked",
        "external_side_effect_blocked",
        "network_blocked_by_policy",
        "host_unreachable",
        "host_untrusted",
        "replan_required",
        "waiting_approval",
        "clarification_blocked",
        "worktree_conflict",
        "dirty_worktree",
        "plugin_hook_blocked",
        "validation_blocked",
        "remediation_ceiling_exceeded"
      ]
    },
    "allowed_action_ids": {
      "type": "array",
      "items": {
        "enum": [
          "approve",
          "decline",
          "retry_now",
          "resume_after_prerequisite",
          "restore_safe_point_then_retry",
          "start_fresh_attempt",
          "replan",
          "skip_node",
          "abort_run",
          "open_details"
        ]
      },
      "uniqueItems": true
    },
    "preserved_local_work": {
      "type": "boolean"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "detail_ref": {
      "type": "string",
      "minLength": 1
    },
    "failure_class": {
      "enum": [
        "provider_transient",
        "structured_output_invalid",
        "verification_failed",
        "reviewer_findings",
        "auth_expired",
        "storage_io",
        "quota_exceeded",
        "rate_limited",
        "graph_integrity"
      ]
    },
    "timeout_class": {
      "enum": [
        "hard_execution_timeout",
        "inactivity_timeout",
        "polling_timeout",
        "reconnect_timeout",
        "user_visible_wait_timer_expiry"
      ]
    },
    "wait_state_class": {
      "enum": [
        "environment_wait_timer",
        "approval_wait",
        "queue_wait",
        "long_governance_wait",
        "scheduled_workflow_observation_gap",
        "future_timestamp_wait"
      ]
    },
    "auth_realm": {
      "type": "string",
      "minLength": 1
    },
    "missing_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_safe_point_restore": {
      "type": "boolean"
    },
    "safe_point_id": {
      "type": "string",
      "minLength": 1
    },
    "anchor_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "event_sequence",
    "ts",
    "run_id",
    "thread_id",
    "node_id",
    "replan_generation",
    "blocked_sequence",
    "blocked_reason_code",
    "allowed_action_ids",
    "preserved_local_work"
  ]
}
