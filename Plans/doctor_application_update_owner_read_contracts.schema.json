          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "failure_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        }
      },
      "description": "One owner result for the one read, carrying the union of both occurrences' dimensions with each field's own owner source, observation and bounded evidence refs. Query completion is not health and a schema-valid digest is not owner evidence."
    },
