              "available_update",
              "restart_requirement",
              "protocol"
            ]
          }
        },
        "expected_descriptor_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expected_owner_generation": {
          "$ref": "#/$defs/generation"
        },
        "expected_cache_generation": {
          "$ref": "#/$defs/generation"
        },
        "expected_state_revision": {
          "$ref": "#/$defs/generation"
        },
        "expected_policy_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "submitted_conditional_validator": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "read_admission_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "governor_admission_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "observable_work_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "redaction_profile_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "read_only": {
          "const": true
        },
        "requested_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "deadline_utc": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "description": "Read-only request for the one application-update fact. Serialized caller values are requests to compare, never proof of authority; the request carries no command id and cannot dispatch cmd.update.app.check, download, install/restart or rollback."
    },
