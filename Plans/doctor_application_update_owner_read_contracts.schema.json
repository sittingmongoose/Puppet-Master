        "record_kind": {
          "const": "ApplicationUpdateOwnerReadRequest"
        },
        "owner_read_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "fact_key": {
          "const": "application_update"
        },
        "scope": {
          "$ref": "#/$defs/application_check_scope"
        },
        "target": {
          "$ref": "#/$defs/application_update_owner_target"
        },
        "member_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/member_binding"
          }
        },
        "requested_fields": {
