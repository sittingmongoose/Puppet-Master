      "$anchor": "application_update_owner_read_result",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "record_kind",
        "result_id",
        "owner_read_ref",
        "fact_key",
        "scope",
        "target",
        "member_bindings",
        "status",
        "observed_owner_generation",
        "observed_cache_generation",
