          "$ref": "#/$defs/safe_ref"
        }
      }
    },
    "application_update_owner_read_pair": {
      "$anchor": "application_update_owner_read_pair",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "record_kind",
        "fact_key",
        "owner_read_ref",
        "observable_work_ref",
        "descriptor_ref",
        "descriptor_check_id",
        "descriptor_revision",
        "request_schema_ref",
