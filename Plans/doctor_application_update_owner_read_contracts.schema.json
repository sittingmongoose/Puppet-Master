        },
        "schema_version": {
          "const": "1.0.0"
        },
        "record_kind": {
          "const": "ApplicationUpdateOwnerReadResult"
        },
        "result_id": {
          "$ref": "#/$defs/safe_ref"
        },
        "owner_read_ref": {
          "$ref": "#/$defs/safe_ref"
        },
