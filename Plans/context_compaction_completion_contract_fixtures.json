  "required_native_oracles": [
    {
      "oracle_id": "COMPACT-COMMIT-01",
      "given": "current fence, validated useful candidate, durable prepared bundle, successful barrier",
      "required_result": "one completion; bundle visible together; old transcript unchanged",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-RETRY-01",
      "given": "lost append acknowledgement, same logical operation",
      "required_result": "reconcile adopted/committed bytes; original result; no helper rerun or duplicate event",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-PRECOMMIT-01",
      "given": "helper failure, stale candidate, cancellation, no gain, soft-defer or append/dedupe outage",
      "required_result": "no completion, no active-head change; visible typed existing outcome",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-IDENTITY-01",
      "given": "wrong project/thread/receipt/operation or stale topology/lease/generation",
      "required_result": "reject before append; no head or checkpoint advance",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-CUSTODY-01",
      "given": "raw content/credential in any payload/envelope/ref or receipt points to another operation",
      "required_result": "reject before durable append; no content-bearing audit record",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-CRASH-01",
      "given": "crash before marker, after segment sync, after manifest barrier, or before redb projection",
      "required_result": "reconcile verified marker authority; never partial publication, speculative retry or rollback of a durable commit",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-BUNDLE-01",
      "given": "required current-head bundle corrupt or missing",
      "required_result": "disclose and fence mutation; no invented summary or silent prior-head fallback",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-HISTORICAL-01",
      "given": "legitimately expired superseded receipt; newer head valid",
      "required_result": "typed unavailable audit detail; preserve newer head and continuation",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-REPLAY-01",
      "given": "live/replay overlap and concurrent transcript/tool reducer",
      "required_result": "one activity ref; serialize/CAS shared row; atomic effect/checkpoint; full-detail barrier before whole-row publication",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-COVERAGE-01",
      "given": "unknown frame, gap, stale survivor proof, epoch mismatch, overflow or invalid snapshot",
      "required_result": "no unsafe checkpoint/current-state advance; typed resnapshot/degraded path",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-DELETE-01",
      "given": "logical delete/purge races commit, replay or restored snapshot",
      "required_result": "delete fence; no normal search/detail visibility, thread/head/content reconstruction or permanent content retention",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-SEARCH-01",
      "given": "successful compaction with retained transcript followed by agent history query",
      "required_result": "retained transcript remains searchable through existing authority; no completion subscription required",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-WITHDRAW-01",
      "given": "otherwise valid future payload version or governed family withdrawal",
      "required_result": "preserve audit bytes; stop incompatible read/write/advance; require compatible owner migration",
      "execution_status": "UNPROVEN"
    },
    {
      "oracle_id": "COMPACT-RETENTION-01",
      "given": "audit aging, thread deletion or pressure; detail window eviction",
      "required_result": "event retained indefinitely; derived ref may evict/rebuild; no audit TTL or silent eviction",
      "execution_status": "UNPROVEN"
    }
  ]
