{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/sound-asset-delete-actions/1.0.0/sound_asset_delete_action_contracts.schema.json",
  "title": "Puppet Master Sound asset delete typed action companion",
  "description": "Closed static typed request/result/error/availability/currentness/effect companion for exactly cmd.sound.asset.delete (UCC-103, CV-298, CV-333, PS-124, SP-222, F3-405, WM-039, ATS-016, FileSafe). It is technical specification only: shape validity, a schema-valid boolean, a copied ref, a hash equality or fixture self-consistency authenticates no issuer, dispatcher, permission, handler, receipt writer or physical custody. Handler status stays specified and the Touch row stays partial.",
  "x-owner-ref": "Plans/UI_Command_Catalog.md#UCC-103",
  "x-owner-units": [
    "Plans/Contracts_V0.md#CV-298",
    "Plans/Contracts_V0.md#CV-333",
    "Plans/UI_Command_Catalog.md#UCC-103",
    "Plans/Permissions_System.md#PS-124",
    "Plans/storage-plan.md#SP-222",
    "Plans/FinalGUISpec.md#F3-405",
    "Plans/Wiring_Matrix.md#WM-039",
    "Plans/Automated_Testing_System.md#ATS-016",
    "Plans/Shared_Integration_Runtime.md#SIR-042",
    "Plans/FileSafe.md"
  ],
  "x-action-scope": [
    "cmd.sound.asset.delete"
  ],
  "x-negative-constraints": [
    "No new command, command alias, EventRecord, storage key, TTL, retention schedule or numerical default is introduced.",
    "Built-in asset delete is unavailable: direct invocation refuses without mutation and never silently becomes hide or disable; separately disclosed hide/disable stays distinct.",
    "User and imported assets keep soft-delete with reference safety and restoration; a soft delete never hard-deletes managed audio content.",
    "Unresolved delete outcomes (unavailable, failed, effect_unknown) are not observed no-effect states: effect, retention, safety and restoration facts stay null (unknown) and an asserted value, including false, is refused by the companion gate.",
    "No persistent domain event is admitted; expected event types stay empty and no alert state is mutated.",
    "A schema-valid boolean, a copied ref or a matching hash never authenticates an owner issuer, dispatcher or receipt writer."
  ],
  "oneOf": [
    {"$ref": "#/$defs/delete_request"},
    {"$ref": "#/$defs/delete_original"},
    {"$ref": "#/$defs/sound_asset_record"},
    {"$ref": "#/$defs/delete_result"},
    {"$ref": "#/$defs/availability_projection"},
    {"$ref": "#/$defs/action_error"},
    {"$ref": "#/$defs/delete_effect_binding"}
  ],
  "$defs": {
    "action_id": {
      "description": "Exact action-qualified closure; no other command, alias or sound-family member is admitted by this companion.",
      "enum": ["cmd.sound.asset.delete"]
    },
    "digest": {
      "description": "Bare lowercase SHA-256 hex, the form the existing Full Thread Sha256 contract and the owner digests use.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utc": {
      "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/UtcTimestamp"
    },
    "non_secret_ref": {
      "description": "Secret-free reference grammar owned by the shared runtime command contracts.",
      "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_secret_ref"
    },
    "identity_envelope": {
      "description": "Actual existing Full Thread IdentityEnvelope; no local identity is invented for this companion.",
      "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/IdentityEnvelope"
    },
    "central_error_code": {
      "description": "The exact closed central UICommandError code enumeration, reused by reference instead of restated.",
      "$ref": "https://puppetmaster.local/schemas/ui_command_response/2.0.0/ui_command_response.schema.json#/$defs/UICommandError/properties/code"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "asset_scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "global"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "project_ref"],
          "properties": {
            "kind": {"const": "project"},
            "project_ref": {"$ref": "#/$defs/non_secret_ref"}
          }
        }
      ]
    },
    "sound_source_kind": {
      "description": "SP-222 sound manifest source_kind vocabulary, reused from the accepted Notifications/Sounds companion instead of restated.",
      "$ref": "https://puppetmaster.local/schemas/notifications-sound-actions/1.0.0/notifications_sound_action_contracts.schema.json#/$defs/sound_source_kind"
    },
    "disabled_reason": {
      "description": "Closed disabled-reason subset for the delete route: unavailable or protected asset, policy, permission, handler. No rate vocabulary is introduced for this local action.",
      "enum": [
        "unavailable_asset",
        "policy_refused",
        "permission_denied",
        "handler_unavailable"
      ]
    },
    "delete_permission_basis": {
      "description": "PS-124/UCC-103/SP-222 admission facts recorded by the Sound asset owner: explicit user action, asset presence, soft-delete class (built-ins are protected, never soft-deletable) and asset mutation authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_action",
        "asset_present",
        "asset_soft_deletable",
        "asset_mutation_authority"
      ],
      "properties": {
        "explicit_action": {"const": true},
        "asset_present": {"type": "boolean"},
        "asset_soft_deletable": {"type": "boolean"},
        "asset_mutation_authority": {"type": "boolean"}
      }
    },
    "delete_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "command_id",
        "handler_id",
        "original_request_ref",
        "command_instance_id",
        "dispatch_id",
        "caller_ref",
        "sir_dispatch_ref",
        "dispatcher_ref",
        "scope",
        "asset_ref",
        "source_kind",
        "asset_generation",
        "expected_target_generation",
        "explicit_action",
        "selection_gesture_ref",
        "permission_admission_ref",
        "asset_mutation",
        "idempotency_key",
        "secret_refs_only"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.delete_request.v1"},
        "command_id": {"const": "cmd.sound.asset.delete"},
        "handler_id": {"const": "handlers::sound::asset_delete"},
        "original_request_ref": {"$ref": "#/$defs/non_secret_ref"},
        "command_instance_id": {"$ref": "#/$defs/non_secret_ref"},
        "dispatch_id": {"$ref": "#/$defs/non_secret_ref"},
        "caller_ref": {"$ref": "#/$defs/non_secret_ref"},
        "sir_dispatch_ref": {"$ref": "#/$defs/non_secret_ref"},
        "dispatcher_ref": {"$ref": "#/$defs/non_secret_ref"},
        "scope": {"$ref": "#/$defs/asset_scope"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_kind": {"$ref": "#/$defs/sound_source_kind"},
        "asset_generation": {"$ref": "#/$defs/generation"},
        "expected_target_generation": {"$ref": "#/$defs/generation"},
        "explicit_action": {"const": true},
        "selection_gesture_ref": {"$ref": "#/$defs/non_secret_ref"},
        "permission_admission_ref": {"$ref": "#/$defs/non_secret_ref"},
        "asset_mutation": {"const": true},
        "idempotency_key": {"$ref": "#/$defs/non_secret_ref"},
        "secret_refs_only": {"const": true}
      }
    },
    "delete_original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "command_id",
        "request_ref",
        "command_instance_id",
        "dispatch_id",
        "caller_ref",
        "scope",
        "asset_ref",
        "source_kind",
        "asset_generation",
        "target_generation",
        "asset_record_ref",
        "permission_basis",
        "selection_gesture_ref",
        "idempotency_key",
        "payload_sha256",
        "arguments_sha256",
        "admitted_at"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.delete_original.v1"},
        "record_kind": {"const": "sound_asset_delete_original"},
        "command_id": {"const": "cmd.sound.asset.delete"},
        "request_ref": {"$ref": "#/$defs/non_secret_ref"},
        "command_instance_id": {"$ref": "#/$defs/non_secret_ref"},
        "dispatch_id": {"$ref": "#/$defs/non_secret_ref"},
        "caller_ref": {"$ref": "#/$defs/non_secret_ref"},
        "scope": {"$ref": "#/$defs/asset_scope"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_kind": {"$ref": "#/$defs/sound_source_kind"},
        "asset_generation": {"$ref": "#/$defs/generation"},
        "target_generation": {"$ref": "#/$defs/generation"},
        "asset_record_ref": {"$ref": "#/$defs/non_secret_ref"},
        "permission_basis": {"$ref": "#/$defs/delete_permission_basis"},
        "selection_gesture_ref": {"$ref": "#/$defs/non_secret_ref"},
        "idempotency_key": {"$ref": "#/$defs/non_secret_ref"},
        "payload_sha256": {"$ref": "#/$defs/digest"},
        "arguments_sha256": {"$ref": "#/$defs/digest"},
        "admitted_at": {"$ref": "#/$defs/utc"}
      }
    },
    "sound_asset_record": {
      "description": "SP-222 sound asset manifest subset used by the delete joins: identity, source class, protected/soft-delete class, separately disclosed hide/disable state, retained managed content and content hash. No storage family, key or retention schedule is admitted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "scope",
        "asset_ref",
        "source_kind",
        "display_name",
        "protected",
        "soft_deletable",
        "disabled_or_hidden",
        "managed_content_ref",
        "content_sha256",
        "generation"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.sound_asset_record.v1"},
        "record_kind": {"const": "sound_asset"},
        "scope": {"$ref": "#/$defs/asset_scope"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_kind": {"$ref": "#/$defs/sound_source_kind"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "protected": {"type": "boolean"},
        "soft_deletable": {"type": "boolean"},
        "disabled_or_hidden": {"type": "boolean"},
        "managed_content_ref": {"$ref": "#/$defs/non_secret_ref"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "generation": {"$ref": "#/$defs/generation"}
      }
    },
    "delete_result": {
      "description": "Actual Sound-owner delete outcome. soft_deleted is the only owner-confirmed mutating outcome and keeps restoration, reference safety and retained managed content; refused_builtin is the verified built-in refusal without any mutation and never a hide or disable translation; unavailable, failed and effect_unknown are unresolved labels with no owner-observed effect, so their effect, retention, safety and restoration facts stay null (unknown) instead of asserting that no mutation or absence of restoration was verified.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "command_id",
        "command_instance_id",
        "dispatch_id",
        "original_request_ref",
        "sir_dispatch_ref",
        "dispatcher_ref",
        "asset_ref",
        "source_kind",
        "asset_generation",
        "target_generation",
        "outcome",
        "asset_mutated",
        "translated_to_hide_or_disable",
        "managed_content_retained",
        "reference_safe",
        "restoration_available",
        "restoration_ref",
        "substituted_asset_ref",
        "receipt_ref",
        "persisted_event_refs",
        "alert_state_mutated",
        "secret_refs_only",
        "observed_at"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.delete_result.v1"},
        "record_kind": {"const": "sound_asset_delete_result"},
        "command_id": {"const": "cmd.sound.asset.delete"},
        "command_instance_id": {"$ref": "#/$defs/non_secret_ref"},
        "dispatch_id": {"$ref": "#/$defs/non_secret_ref"},
        "original_request_ref": {"$ref": "#/$defs/non_secret_ref"},
        "sir_dispatch_ref": {"$ref": "#/$defs/non_secret_ref"},
        "dispatcher_ref": {"$ref": "#/$defs/non_secret_ref"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_kind": {"$ref": "#/$defs/sound_source_kind"},
        "asset_generation": {"$ref": "#/$defs/generation"},
        "target_generation": {"$ref": "#/$defs/generation"},
        "outcome": {
          "enum": [
            "soft_deleted",
            "refused_builtin",
            "unavailable",
            "failed",
            "effect_unknown"
          ]
        },
        "asset_mutated": {"type": ["boolean", "null"]},
        "translated_to_hide_or_disable": {"const": false},
        "managed_content_retained": {"type": ["boolean", "null"]},
        "reference_safe": {"type": ["boolean", "null"]},
        "restoration_available": {"type": ["boolean", "null"]},
        "restoration_ref": {
          "oneOf": [
            {"$ref": "#/$defs/non_secret_ref"},
            {"type": "null"}
          ]
        },
        "substituted_asset_ref": {"const": null},
        "receipt_ref": {"$ref": "#/$defs/non_secret_ref"},
        "persisted_event_refs": {
          "description": "Expected event types stay empty; the delete outcome admits no persistent domain event.",
          "type": "array",
          "maxItems": 0,
          "items": {"$ref": "#/$defs/non_secret_ref"}
        },
        "alert_state_mutated": {"const": false},
        "secret_refs_only": {"const": true},
        "observed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "availability_projection": {
      "description": "Action-qualified projected availability and currentness read from the existing production state selectors.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "availability_selector",
        "disabled_reason_selector",
        "availability",
        "disabled_reason",
        "currentness",
        "evaluated_at"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.availability.v1"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "availability_selector": {"const": "state.commands.sound_asset_delete.availability"},
        "disabled_reason_selector": {"const": "state.commands.sound_asset_delete.disabled_reason"},
        "availability": {"enum": ["available", "unavailable", "disabled"]},
        "disabled_reason": {
          "oneOf": [
            {"$ref": "#/$defs/disabled_reason"},
            {"type": "null"}
          ]
        },
        "currentness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_generation", "observed_generation", "stale"],
          "properties": {
            "target_generation": {"$ref": "#/$defs/generation"},
            "observed_generation": {"$ref": "#/$defs/generation"},
            "stale": {"type": "boolean"}
          }
        },
        "evaluated_at": {"$ref": "#/$defs/utc"}
      },
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "available"}}},
          "then": {"properties": {"disabled_reason": {"type": "null"}}}
        },
        {
          "if": {"properties": {"availability": {"enum": ["unavailable", "disabled"]}}},
          "then": {"properties": {"disabled_reason": {"$ref": "#/$defs/disabled_reason"}}}
        }
      ]
    },
    "action_error": {
      "description": "Action-qualified error projection over the unchanged closed central UICommandError grammar; no new error code is introduced.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "action_id", "phase", "code", "reason", "offending_field", "availability_reason"],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.action_error.v1"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "phase": {"enum": ["pre_dispatch", "post_dispatch", "execution"]},
        "code": {"$ref": "#/$defs/central_error_code"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512},
        "offending_field": {
          "oneOf": [
            {"type": "string", "maxLength": 160},
            {"type": "null"}
          ]
        },
        "availability_reason": {
          "oneOf": [
            {"$ref": "#/$defs/disabled_reason"},
            {"type": "null"}
          ]
        }
      }
    },
    "delete_effect_binding": {
      "description": "Exact existing-owner effect values for cmd.sound.asset.delete as declared by the current production-intent row: a receipt-only soft-delete/refusal outcome with no event, no external send, no alert-state mutation and no Runtime Artifacts projection owner (RAP-039 covers destination-test and asset-export evidence only).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "effect_kind",
        "receipt_or_event_refs",
        "expected_event_types",
        "receipt_kind",
        "external_send_rule",
        "alert_state_mutation_authorized",
        "projection_owner_ref"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.effect_binding.v1"},
        "action_id": {"const": "cmd.sound.asset.delete"},
        "effect_kind": {"const": "receipt"},
        "receipt_or_event_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"const": "cmd.sound.asset.delete.dispatch_receipt"}
        },
        "expected_event_types": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "receipt_kind": {"const": "owner_soft_delete_receipt"},
        "external_send_rule": {"const": "never"},
        "alert_state_mutation_authorized": {"const": false},
        "projection_owner_ref": {"const": null}
      }
    }
  }
}
