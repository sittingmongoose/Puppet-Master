{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pm.goal_run.run_history_projection.all_writers_v8.v1",
 "$comment": "SP-3102 / GRS-3101: closed stored values of the mandatory run-history projection branch for genuine fresh pm.executor.workflow_source.all_writers.v8 births (PNC-019 lane rv8b, 2026-11-14). Derived, never backed up (DL-270), RP-PROJECTION-3GEN. index_read_token is the SP-278 nine-field durable token (DL-076), copied from Plans/event_record_index_checkpoint.schema.json#/$defs/read_token with redb_snapshot_id removed; no stored value holds redb_snapshot_id. Every member is copied from the verified original row or its original custody; nothing is derived from current native state. The value grants no action, resume, replan, cancellation or Goal authority.",
 "oneOf": [
  {
   "$ref": "#/$defs/run_row"
  },
  {
   "$ref": "#/$defs/checkpoint"
  }
 ],
 "$defs": {
  "durable_read_token": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "storage_instance_id",
    "checkpoint_key",
    "checkpoint_ref",
    "generation_id",
    "generation_anchor_sha256",
    "frontier_revision",
    "frontier_sha256",
    "index_dataset_name",
    "source_selection"
   ],
   "properties": {
    "storage_instance_id": {
     "type": "string",
     "format": "uuid"
    },
    "checkpoint_key": {
     "type": "string",
     "minLength": 1
    },
    "checkpoint_ref": {
     "type": "string",
     "minLength": 1
    },
    "generation_id": {
     "type": "string",
     "pattern": "^eig_[0-9a-f]{64}$"
    },
    "generation_anchor_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "frontier_revision": {
     "type": "integer",
     "minimum": 0,
     "maximum": 18446744073709551615
    },
    "frontier_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "index_dataset_name": {
     "type": "string",
     "minLength": 1
    },
    "source_selection": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "storage_instance_id",
      "current_ref",
      "current_bytes_sha256",
      "selected_segment_generation",
      "manifest_ref",
      "manifest_bytes_sha256",
      "manifest_generation",
      "recovery_epoch",
      "manifest_survivor_prefix_sha256",
      "retained_inventory_sha256",
      "durable_watermarks_sha256",
      "excluded_ranges_sha256",
      "retired_inputs_sha256"
     ],
     "properties": {
      "storage_instance_id": {
       "type": "string",
       "format": "uuid"
      },
      "current_ref": {
       "const": "storage/seglog/CURRENT"
      },
      "current_bytes_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "selected_segment_generation": {
       "type": "integer",
       "minimum": 0,
       "maximum": 18446744073709551615
      },
      "manifest_ref": {
       "const": "storage/seglog/manifest.v1.msgpack"
      },
      "manifest_bytes_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "manifest_generation": {
       "type": "integer",
       "minimum": 0,
       "maximum": 18446744073709551615
      },
      "recovery_epoch": {
       "type": "integer",
       "minimum": 0,
       "maximum": 18446744073709551615
      },
      "manifest_survivor_prefix_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "retained_inventory_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "durable_watermarks_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "excluded_ranges_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "retired_inputs_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     }
    }
   }
  },
  "last_replan": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "event_id",
    "replan_generation",
    "previous_workgraph_ref",
    "new_workgraph_ref",
    "next_action",
    "affected_worknode_refs_sha256",
    "disposition_refs_sha256",
    "graph_patch_id",
    "applied_graph_patch_record_id"
   ],
   "properties": {
    "event_id": {
     "type": "string",
     "minLength": 1
    },
    "replan_generation": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4294967295
    },
    "previous_workgraph_ref": {
     "type": "string",
     "minLength": 1
    },
    "new_workgraph_ref": {
     "type": "string",
     "minLength": 1
    },
    "next_action": {
     "enum": [
      "continue_running",
      "repair",
      "remain_blocked",
      "stop",
      "begin_verification"
     ]
    },
    "affected_worknode_refs_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "disposition_refs_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "graph_patch_id": {
     "type": "string",
     "minLength": 1
    },
    "applied_graph_patch_record_id": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "run_row": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema_id",
    "schema_version",
    "storage_instance_id",
    "project_id",
    "goal_id",
    "goal_run_id",
    "birth_profile",
    "installed_contract_digest",
    "lifecycle_status",
    "projected_run_status",
    "projected_goal_run_revision",
    "projected_graph_generation",
    "current_workgraph_ref",
    "last_supported_event_id",
    "last_supported_sequence_id",
    "last_replan",
    "generation_id"
   ],
   "properties": {
    "schema_id": {
     "const": "pm.storage_value.goal_run_history_v8_row.v1"
    },
    "schema_version": {
     "const": "1.0.0"
    },
    "storage_instance_id": {
     "type": "string",
     "format": "uuid"
    },
    "project_id": {
     "type": "string",
     "minLength": 1
    },
    "goal_id": {
     "type": "string",
     "minLength": 1
    },
    "goal_run_id": {
     "type": "string",
     "minLength": 1
    },
    "birth_profile": {
     "const": "pm.executor.workflow_source.all_writers.v8"
    },
    "installed_contract_digest": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "lifecycle_status": {
     "enum": [
      "started",
      "replanned",
      "certified",
      "cancelled"
     ]
    },
    "projected_run_status": {
     "enum": [
      "running",
      "repairing",
      "blocked",
      "stopped",
      "verifying",
      "certified",
      "cancelled"
     ]
    },
    "projected_goal_run_revision": {
     "type": "integer",
     "minimum": 1
    },
    "projected_graph_generation": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4294967295
    },
    "current_workgraph_ref": {
     "type": "string",
     "minLength": 1
    },
    "last_supported_event_id": {
     "type": "string",
     "minLength": 1
    },
    "last_supported_sequence_id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 18446744073709551615
    },
    "last_replan": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/last_replan"
      }
     ]
    },
    "generation_id": {
     "type": "string",
     "pattern": "^grh8_[0-9a-f]{64}$"
    }
   }
  },
  "checkpoint": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema_id",
    "schema_version",
    "storage_instance_id",
    "project_id",
    "generation_id",
    "generation_anchor_sha256",
    "processed_through_sequence_id",
    "index_read_token",
    "row_set_sha256"
   ],
   "properties": {
    "schema_id": {
     "const": "pm.storage_value.goal_run_history_v8_checkpoint.v1"
    },
    "schema_version": {
     "const": "1.0.0"
    },
    "storage_instance_id": {
     "type": "string",
     "format": "uuid"
    },
    "project_id": {
     "type": "string",
     "minLength": 1
    },
    "generation_id": {
     "type": "string",
     "pattern": "^grh8_[0-9a-f]{64}$"
    },
    "generation_anchor_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "processed_through_sequence_id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 18446744073709551615
    },
    "index_read_token": {
     "$ref": "#/$defs/durable_read_token"
    },
    "row_set_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  }
 }
}
