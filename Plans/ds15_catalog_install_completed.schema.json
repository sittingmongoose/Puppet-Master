{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.ds15.catalog_install_completed.payload.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "item_type",
    "item_id",
    "version",
    "operation_id",
    "owner_ref",
    "outcome_ref",
    "installation_ref",
    "phase"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "project_id",
        "user_id",
        "computer_id",
        "profile_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "project",
            "app"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "computer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "project"
              }
            }
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "app"
              }
            }
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "item_type": {
      "enum": [
        "command",
        "skill",
        "plugin",
        "hook",
        "theme",
        "mcp_config"
      ]
    },
    "phase": {
      "const": "completed"
    },
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "outcome_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": [
        "null",
        "string"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "installation_ref": {
      "type": [
        "null",
        "string"
      ],
      "minLength": 1,
      "maxLength": 256
    }
  }
}
