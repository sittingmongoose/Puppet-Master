{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/storage_value/mcp_server_lifecycle_record/1.0.0/mcp_server_lifecycle_record.schema.json",
  "title": "McpServerLifecycleRecord",
  "description": "MCP-owned component lifecycle record. The independent component axes must not collapse into one connected Boolean.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "server_id",
    "runtime_generation",
    "config_epoch",
    "auth_epoch",
    "connection_epoch",
    "catalog_generation",
    "provider_id",
    "runtime_subject_id",
    "configured",
    "auth",
    "transport",
    "catalog",
    "subscription",
    "tool_projection",
    "health",
    "config_ref",
    "credential_profile_ref",
    "lease_ref",
    "breaker_state",
    "next_allowed_at_utc",
    "catalog_schema_sha256",
    "subscription_rollback_ref",
    "currentness_ref",
    "reason_code",
    "observed_at_utc"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.shared_runtime.mcp_server_lifecycle_record.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "server_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "runtime_generation": {
      "type": "integer",
      "minimum": 0
    },
    "config_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "auth_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "connection_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "catalog_generation": {
      "type": "integer",
      "minimum": 0
    },
    "provider_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "runtime_subject_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "configured": {
      "enum": [
        "absent",
        "disabled",
        "enabled"
      ]
    },
    "auth": {
      "enum": [
        "not_required",
        "required",
        "pending",
        "authenticated",
        "expired",
        "failed"
      ]
    },
    "transport": {
      "enum": [
        "idle",
        "connecting",
        "connected",
        "backoff",
        "failed"
      ]
    },
    "catalog": {
      "enum": [
        "absent",
        "fresh",
        "stale_refreshing",
        "failed"
      ]
    },
    "subscription": {
      "enum": [
        "none",
        "subscribing",
        "active",
        "rolling_back",
        "failed"
      ]
    },
    "tool_projection": {
      "enum": [
        "deferred",
        "materialized",
        "blocked",
        "stale"
      ]
    },
    "health": {
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "unhealthy"
      ]
    },
    "config_ref": {
      "$ref": "#/$defs/nullable_non_secret_ref"
    },
    "credential_profile_ref": {
      "$ref": "#/$defs/nullable_non_secret_ref"
    },
    "lease_ref": {
      "$ref": "#/$defs/nullable_non_secret_ref"
    },
    "breaker_state": {
      "enum": [
        "closed",
        "open",
        "half_open"
      ]
    },
    "next_allowed_at_utc": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "catalog_schema_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "subscription_rollback_ref": {
      "$ref": "#/$defs/nullable_non_secret_ref"
    },
    "currentness_ref": {
      "$ref": "#/$defs/non_secret_ref"
    },
    "reason_code": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "observed_at_utc": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subscription": {
            "const": "active"
          }
        },
        "required": [
          "subscription"
        ]
      },
      "then": {
        "properties": {
          "transport": {
            "const": "connected"
          },
          "subscription_rollback_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "breaker_state": {
            "const": "open"
          }
        },
        "required": [
          "breaker_state"
        ]
      },
      "then": {
        "properties": {
          "next_allowed_at_utc": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_secret_ref": {
      "description": "Stable non-secret reference. Raw credentials, tokens, auth values, credential paths, file contents, and provider-visible bytes are forbidden.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$"
    },
    "nullable_non_empty_string": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_empty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_non_secret_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_secret_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_timestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
