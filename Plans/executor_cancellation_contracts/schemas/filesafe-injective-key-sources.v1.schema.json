{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json",
  "$comment": "New private original-owner source contracts; not installed. Original FileSafe value schemas remain byte-logically exact. No arbitrary JSON source or universal effect-owner adapter.",
  "$defs": {
    "OriginalRestoreTransaction": {
      "$ref": "https://puppetmaster.local/proposals/executor_filesafe_original/safe_point_restore_transaction.schema.json"
    },
    "OriginalSafePointRecord": {
      "$ref": "https://puppetmaster.local/proposals/executor_filesafe_original/safe_point_record.schema.json"
    },
    "OriginalPermissionSnapshot": {
      "$ref": "https://puppetmaster.local/schemas/storage_value/permission_snapshot_record/1.0.0/permission_snapshot_record.schema.json"
    },
    "FileSafeInvocation": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/executor_workflow_source_closure.v2.schema.json#/$defs/DispatchInvocation"
        },
        {
          "properties": {
            "role": {
              "const": "filesafe"
            }
          }
        }
      ]
    },
    "SourceSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "family_id",
        "schema_id",
        "schema_version",
        "physical_key",
        "physical_sha256",
        "codec"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "physical_key": {
          "type": "string",
          "minLength": 1
        },
        "physical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "codec": {
          "const": "messagepack_canonical"
        }
      }
    },
    "JournalSelector": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/SourceSelector"
        },
        {
          "properties": {
            "family_id": {
              "const": "safe_point_restore_transaction"
            },
            "schema_id": {
              "const": "pm.storage_value.safe_point_restore_transaction.v1"
            },
            "schema_version": {
              "const": "1.0.0"
            }
          }
        }
      ]
    },
    "SafePointSelector": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/SourceSelector"
        },
        {
          "properties": {
            "family_id": {
              "const": "safe_point_record"
            },
            "schema_id": {
              "const": "pm.storage_value.safe_point_record.v1"
            },
            "schema_version": {
              "const": "1.0.0"
            }
          }
        }
      ]
    },
    "PermissionSelector": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/SourceSelector"
        },
        {
          "properties": {
            "family_id": {
              "const": "permission_snapshot_record"
            },
            "schema_id": {
              "const": "pm.storage_value.permission_snapshot_record.v1"
            },
            "schema_version": {
              "const": "1.0.0"
            }
          }
        }
      ]
    },
    "BindingSelector": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/SourceSelector"
        },
        {
          "properties": {
            "family_id": {
              "const": "executor_filesafe_invocation_binding"
            },
            "schema_id": {
              "const": "pm.storage_value.executor_filesafe_invocation_binding.v2"
            },
            "schema_version": {
              "const": "2.0.0"
            }
          }
        }
      ]
    },
    "HeadSelector": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/SourceSelector"
        },
        {
          "properties": {
            "family_id": {
              "const": "executor_filesafe_journal_head"
            },
            "schema_id": {
              "const": "pm.storage_value.executor_filesafe_journal_head.v2"
            },
            "schema_version": {
              "const": "2.0.0"
            }
          }
        }
      ]
    },
    "OriginSelector": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/SourceSelector"
        },
        {
          "properties": {
            "family_id": {
              "const": "executor_filesafe_journal_origin"
            },
            "schema_id": {
              "const": "pm.storage_value.executor_filesafe_journal_origin.v2"
            },
            "schema_version": {
              "const": "2.0.0"
            }
          }
        }
      ]
    },
    "JournalIssueCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "storage_instance_id",
        "family_id",
        "schema_id",
        "schema_version",
        "physical_key",
        "issued_physical_sha256",
        "codec"
      ],
      "properties": {
        "kind": {
          "const": "historical_issued_value_commitment"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "const": "safe_point_restore_transaction"
        },
        "schema_id": {
          "const": "pm.storage_value.safe_point_restore_transaction.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "physical_key": {
          "type": "string",
          "minLength": 1
        },
        "issued_physical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "codec": {
          "const": "messagepack_canonical"
        }
      }
    },
    "OriginalRestorePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "run_id",
        "node_id",
        "blocked_sequence",
        "attempt_id",
        "safe_point_id",
        "repo_id",
        "worktree_id",
        "baseline_target"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "blocked_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "safe_point_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "worktree_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_target": {
          "const": "safe_point"
        }
      }
    },
    "FileSafeInvocationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "invocation",
        "original_dispatch_admission",
        "original_dispatch_origin",
        "original_command_id",
        "original_command_source",
        "original_canonical_payload",
        "restore_transaction_id",
        "original_filesafe_operation_id",
        "original_admission_transaction_id",
        "original_filesafe_owner_ref",
        "original_filesafe_owner_epoch",
        "execution_host_ref",
        "source_location_ref",
        "profile",
        "admitted_at_utc",
        "redaction_profile"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.executor_filesafe_invocation_binding.v2"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/FileSafeInvocation"
        },
        "original_dispatch_admission": {
          "$ref": "https://puppetmaster.local/proposals/executor_workflow_source_closure.v2.schema.json#/$defs/Selector"
        },
        "original_dispatch_origin": {
          "$ref": "https://puppetmaster.local/proposals/executor_workflow_source_closure.v2.schema.json#/$defs/Selector"
        },
        "original_command_id": {
          "const": "cmd.runtime.restore_safe_point_then_retry"
        },
        "original_command_source": {
          "$ref": "https://puppetmaster.local/proposals/executor_workflow_source_closure.v2.schema.json#/$defs/Selector"
        },
        "original_canonical_payload": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginalRestorePayload"
        },
        "restore_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "original_filesafe_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "original_admission_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "original_filesafe_owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "original_filesafe_owner_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "execution_host_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_location_ref": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "const": "local_safe_point_exact_replace_v1"
        },
        "admitted_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "redaction_profile": {
          "const": "redacted_refs_only"
        }
      }
    },
    "FileSafeJournalHead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "project_id",
        "restore_transaction_id",
        "binding",
        "revision",
        "journal",
        "origin"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.executor_filesafe_journal_head.v2"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "restore_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/BindingSelector"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "journal": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/JournalSelector"
        },
        "origin": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginSelector"
        }
      }
    },
    "FileSafeJournalOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "project_id",
        "restore_transaction_id",
        "binding",
        "revision",
        "prior_journal_commitment",
        "prior_origin",
        "issued_journal_commitment",
        "original_write_operation_id",
        "original_write_transaction_id",
        "original_owner_ref",
        "original_owner_epoch",
        "write_kind",
        "original_equality",
        "resolved_original_result",
        "terminal_core_sha256",
        "journal_link_fields",
        "issued_at_utc",
        "redaction_profile"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.executor_filesafe_journal_origin.v2"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "restore_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/BindingSelector"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "prior_journal_commitment": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/JournalIssueCommitment"
            },
            {
              "type": "null"
            }
          ]
        },
        "prior_origin": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_journal_commitment": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/JournalIssueCommitment"
        },
        "original_write_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "original_write_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "original_owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "original_owner_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "write_kind": {
          "enum": [
            "prepare",
            "apply_progress",
            "target_verification",
            "commit_target",
            "rollback_progress",
            "rollback_verification",
            "commit_rollback",
            "recovery_required",
            "original_result_link"
          ]
        },
        "original_equality": {
          "enum": [
            "not_a_resolved_equality",
            "target_proven",
            "pre_restore_proven",
            "already_target_zero_mutation"
          ]
        },
        "resolved_original_result": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal_core_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "journal_link_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "updated_at_utc",
            "result_event_ref"
          ],
          "properties": {
            "updated_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "result_event_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "issued_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "redaction_profile": {
          "const": "redacted_refs_only"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "prior_journal_commitment": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "prior_origin": {
                "type": "null"
              },
              "revision": {
                "const": 1
              }
            }
          },
          "else": {
            "properties": {
              "prior_origin": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "JournalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "value"
      ],
      "properties": {
        "selector": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/JournalSelector"
        },
        "value": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginalRestoreTransaction"
        }
      }
    },
    "SafePointValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "value"
      ],
      "properties": {
        "selector": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/SafePointSelector"
        },
        "value": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginalSafePointRecord"
        }
      }
    },
    "PermissionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "value"
      ],
      "properties": {
        "selector": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/PermissionSelector"
        },
        "value": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginalPermissionSnapshot"
        }
      }
    },
    "BindingValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "value"
      ],
      "properties": {
        "selector": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/BindingSelector"
        },
        "value": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/FileSafeInvocationBinding"
        }
      }
    },
    "HeadValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "value"
      ],
      "properties": {
        "selector": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/HeadSelector"
        },
        "value": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/FileSafeJournalHead"
        }
      }
    },
    "OriginValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "value"
      ],
      "properties": {
        "selector": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginSelector"
        },
        "value": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/FileSafeJournalOrigin"
        }
      }
    },
    "NativeWriterMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer_id",
        "owner_ref",
        "owner_epoch",
        "original_operation_id",
        "invocation_id",
        "mutation_lease_ref",
        "capability_state"
      ],
      "properties": {
        "writer_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "owner_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "original_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "mutation_lease_ref": {
          "type": "string",
          "minLength": 1
        },
        "capability_state": {
          "enum": [
            "active_original_reconciliation",
            "fenced_recovery",
            "revoked_terminal"
          ]
        }
      }
    },
    "CurrentFileSafeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "native_root_ref",
        "root_generation",
        "execution_host_ref",
        "source_location_ref",
        "filesafe_owner_ref",
        "filesafe_owner_epoch",
        "storage_owner_ref",
        "storage_owner_epoch",
        "read_operation_id",
        "read_transaction_id",
        "current_permission_decision",
        "writer_members",
        "writer_membership_revision",
        "original_mutation_lease_ref",
        "capability_disposition",
        "owner_registration_ref",
        "codec_registration_ref",
        "current_retention_source_ref",
        "current_hold_source_ref",
        "current_backup_restore_source_ref",
        "current_deletion_source_ref",
        "read_at_utc"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "native_root_ref": {
          "type": "string",
          "minLength": 1
        },
        "root_generation": {
          "type": "integer",
          "minimum": 0
        },
        "execution_host_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_location_ref": {
          "type": "string",
          "minLength": 1
        },
        "filesafe_owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "filesafe_owner_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "storage_owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "storage_owner_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "read_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "read_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "current_permission_decision": {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/PermissionValue"
        },
        "writer_members": {
          "type": "array",
          "items": {
            "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/NativeWriterMember"
          },
          "minItems": 0
        },
        "writer_membership_revision": {
          "type": "integer",
          "minimum": 0
        },
        "original_mutation_lease_ref": {
          "type": "string",
          "minLength": 1
        },
        "capability_disposition": {
          "enum": [
