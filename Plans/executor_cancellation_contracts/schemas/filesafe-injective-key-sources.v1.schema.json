    "ResolvedFileSafeSources": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/executor_filesafe_injective_key_sources.v1.schema.json#/$defs/OriginalFileSafeSources"
        },
        {
          "properties": {
            "original_resolution_origin": {
              "not": {
                "type": "null"
              },
              "properties": {
                "value": {
                  "properties": {
                    "terminal_core_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            },
            "origin": {
              "properties": {
                "value": {
                  "properties": {
                    "terminal_core_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            },
            "current_boundary": {
              "properties": {
                "capability_disposition": {
                  "const": "quiescent_terminal"
                },
                "writer_members": {
                  "items": {
                    "properties": {
                      "capability_state": {
                        "const": "revoked_terminal"
                      }
                    }
                  }
                }
              }
            }
          },
          "oneOf": [
            {
              "properties": {
                "journal": {
                  "properties": {
                    "value": {
                      "properties": {
                        "phase": {
                          "const": "committed"
                        },
                        "restore_outcome": {
                          "enum": [
                            "restored_clean",
                            "restore_skipped"
                          ]
                        },
                        "post_restore_state_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "journal": {
                  "properties": {
                    "value": {
                      "properties": {
                        "phase": {
                          "const": "rolled_back"
                        },
                        "restore_outcome": {
                          "enum": [
                            "restore_failed"
                          ]
                        },
                        "post_restore_state_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
