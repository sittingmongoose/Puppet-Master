{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "safe_point_id",
    "run_id",
    "node_id",
    "attempt_id",
    "replan_generation",
    "worktree_path",
    "baseline_ref",
    "snapshot_format_version",
    "content_scope_version",
    "snapshot_manifest_ref",
    "snapshot_manifest_sha256",
    "content_state_sha256",
    "entry_count",
    "total_bytes",
    "capture_status",
    "created_at_utc",
    "created_by_actor_ref",
    "hold_refs",
    "restore_eligible",
    "redaction_profile"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.storage_value.safe_point_record.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "safe_point_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "worktree_path": {
      "type": "string",
      "minLength": 1
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_format_version": {
      "type": "string",
      "minLength": 1
    },
    "content_scope_version": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "capture_status": {
      "type": "string",
      "minLength": 1
    },
    "created_by_actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "replan_generation": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "hold_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "restore_eligible": {
      "type": "boolean"
    },
    "redaction_profile": {
      "enum": [
        "no_secrets",
        "redacted_refs_only"
      ]
    },
    "repo_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "HEAD_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "index_state_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_hold_released_at_utc": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
