{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "pm.storage.seglog_manifest.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "storage_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "recovery_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "selection_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection_entry"
      },
      "minItems": 1,
      "maxItems": 2
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "storage_instance_id",
    "manifest_generation",
    "recovery_epoch",
    "selection_entries"
  ],
  "$defs": {
    "existing_receipt_contracts__active_durable_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "storage_instance_id",
        "commit_group_id",
        "durability_class",
        "segment_generation",
        "segment_name",
        "durable_start_offset",
        "durable_end_offset",
        "manifest_generation",
        "members",
        "group_digest",
        "restore_admission"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "commit_group_id": {
          "type": "string",
          "minLength": 1
        },
        "durability_class": {
          "enum": [
            "ordinary",
            "barrier"
          ]
        },
        "segment_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "segment_name": {
          "type": "string",
          "minLength": 1
        },
        "durable_start_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "durable_end_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "manifest_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/existing_receipt_contracts__member"
          }
        },
        "group_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "restore_admission": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/existing_receipt_contracts__restore_admission"
            }
          ]
        }
      }
    },
    "existing_receipt_contracts__member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence_id",
        "byte_offset",
        "frame_length",
        "frame_sha256"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "frame_length": {
          "type": "integer",
          "minimum": 48,
          "maximum": 18446744073709551615
        },
        "frame_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "existing_receipt_contracts__restore_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "storage_instance_id",
        "restore_occurrence_id",
        "restore_journal_ref",
        "restore_journal_sha256",
        "recovery_epoch",
        "restored_boundary_sha256",
        "publication_id",
        "members"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "restore_occurrence_id": {
          "type": "string",
          "minLength": 1
        },
        "restore_journal_ref": {
          "type": "string",
          "minLength": 1
        },
        "restore_journal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recovery_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "restored_boundary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/existing_receipt_contracts__restore_admitted_member"
          }
        }
      }
    },
    "existing_receipt_contracts__restore_admitted_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "scope_partition",
        "event_type",
        "idempotency_key",
        "producer_semantic_digest",
        "owner_id",
        "owner_operation_id",
        "owner_operation_sha256"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_partition": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "producer_semantic_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_operation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "last_sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "reason": {
          "enum": [
            "allocator_lease_abandoned",
            "corruption_loss",
            "retention_compaction"
          ]
        },
        "manifest_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "manifest_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "first_sequence_id",
        "last_sequence_id",
        "reason",
        "manifest_evidence_ref",
        "manifest_evidence_sha256"
      ]
    },
    "namespace_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physical_segment_id": {
          "$ref": "#/$defs/physical_segment_id"
        },
        "original_segment_ref": {
          "type": "string",
          "minLength": 1
        },
        "original_segment_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "original_segment_name": {
          "$ref": "#/$defs/segment_name"
        },
        "current_segment_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "current_segment_name": {
          "$ref": "#/$defs/segment_name"
        },
        "namespace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "original_namespace_effect_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "physical_segment_id",
        "original_segment_ref",
        "original_segment_generation",
        "original_segment_name",
        "current_segment_generation",
        "current_segment_name",
        "namespace_revision",
        "original_namespace_effect_ref"
      ]
    },
    "physical_segment_id": {
      "type": "string",
      "pattern": "^pm\\.storage\\.segment_object\\.v1:[0-9a-f]{64}$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physical_segment_id": {
          "$ref": "#/$defs/physical_segment_id"
        },
        "segment_ref": {
          "type": "string",
          "minLength": 1
        },
        "segment_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "segment_name": {
          "$ref": "#/$defs/segment_name"
        },
        "namespace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "state": {
          "enum": [
            "active",
            "closed",
            "sealed_degraded"
          ]
        },
        "selection_role": {
          "enum": [
            "original_selected",
            "compacted_output",
            "unchanged_carrier",
            "target_active"
          ]
        },
        "origin_operation_ref": {
          "type": "string",
          "minLength": 1
        },
        "frame_profile": {
          "const": "pm.seglog_frame_v2.first_profile.v1"
        },
        "source_durable_end_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source_durable_bytes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retained_event_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "first_sequence_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          ]
        },
        "last_sequence_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          ]
        }
      },
      "required": [
        "physical_segment_id",
        "segment_ref",
        "segment_generation",
        "segment_name",
        "namespace_revision",
        "state",
        "selection_role",
        "origin_operation_ref",
        "frame_profile",
        "source_durable_end_offset",
        "source_durable_bytes_sha256",
        "retained_event_count",
        "first_sequence_id",
        "last_sequence_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "retained_event_count": {
                "const": 0
              }
            },
            "required": [
              "retained_event_count"
            ]
          },
          "then": {
            "properties": {
              "first_sequence_id": {
                "type": "null"
              },
              "last_sequence_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "first_sequence_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "last_sequence_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          }
        }
      ]
    },
    "segment_name": {
      "type": "string",
      "pattern": "^seg-[0-9]{6,20}-[0-9]{20}(?:-[0-9]{20}\\.seglog|\\.active|\\.opening)$"
    },
    "selection_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection_id": {
          "$ref": "#/$defs/selection_id"
        },
        "selected_segment_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source_generation_ref": {
          "type": "string",
          "minLength": 1
        },
        "birth_operation_ref": {
          "type": "string",
          "minLength": 1
        },
        "entry_kind": {
          "enum": [
            "live",
            "staged_prefix",
            "sealed_target"
          ]
        },
        "active_segment_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "retained_inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          },
          "minItems": 0
        },
        "namespace_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace_binding"
          },
          "minItems": 0
        },
        "durable_watermarks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "physical_segment_id": {
                "$ref": "#/$defs/physical_segment_id"
              },
              "durable_end_offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            },
            "required": [
              "physical_segment_id",
              "durable_end_offset"
            ]
          },
          "minItems": 0
        },
        "excluded_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          },
          "minItems": 0
        },
        "retired_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "physical_segment_id": {
                "$ref": "#/$defs/physical_segment_id"
              },
              "original_segment_ref": {
                "type": "string",
                "minLength": 1
              },
              "retirement_effect_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "physical_segment_id",
              "original_segment_ref",
              "retirement_effect_ref"
            ]
          },
          "minItems": 0
        },
        "survivor_prefix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "active_durable_group": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/existing_receipt_contracts__active_durable_group"
            }
          ]
        },
        "sequence_authority": {
          "$ref": "#/$defs/sequence_authority"
        }
      },
      "required": [
        "selection_id",
        "selected_segment_generation",
        "source_generation_ref",
        "birth_operation_ref",
        "entry_kind",
        "active_segment_ref",
        "retained_inventory",
        "namespace_bindings",
        "durable_watermarks",
        "excluded_ranges",
        "retired_inputs",
        "survivor_prefix_sha256",
        "active_durable_group",
        "sequence_authority"
      ]
    },
    "selection_id": {
      "type": "string",
      "pattern": "^pm\\.storage\\.selection\\.v1:[0-9a-f]{64}$"
    },
    "sequence_authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lease_id": {
          "type": "string",
          "minLength": 1
        },
        "lease_first_sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "lease_last_sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "highest_allocated_sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "last_issued_sequence_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          ]
        },
        "allocator_control_ref": {
          "type": "string",
          "minLength": 1
        },
        "allocator_control_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "lease_id",
        "lease_first_sequence_id",
        "lease_last_sequence_id",
        "highest_allocated_sequence_id",
        "last_issued_sequence_id",
        "allocator_control_ref",
        "allocator_control_sha256"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
