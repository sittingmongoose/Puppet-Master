    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "scope_partition",
        "project_id",
        "goal_id",
        "goal_run_id"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope_partition": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "PayloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blake3",
        "byte_size",
        "media_type"
      ],
      "properties": {
        "blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "const": "application/msgpack"
        }
      }
    },
    "StoredPart": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inline",
            "payload_ref"
          ],
          "properties": {
            "inline": {
              "type": "object"
            },
            "payload_ref": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inline",
            "payload_ref"
          ],
          "properties": {
            "inline": {
              "type": "null"
            },
            "payload_ref": {
              "$ref": "#/$defs/PayloadRef"
            }
          }
        }
      ]
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "schema_id",
        "schema_version",
        "physical_sha256"
