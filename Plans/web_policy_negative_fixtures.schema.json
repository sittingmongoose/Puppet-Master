{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.web_policy_negative_fixtures.schema.v1",
  "title": "Puppet Master Web Policy Negative Fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "purpose",
    "egress_assertions",
    "permission_scope_assertions",
    "run_mode_assertions",
    "crawl_policy_assertions",
    "redaction_assertions",
    "negative_cases"
  ],
  "properties": {
    "schema_id": {"type": "string", "const": "pm.web_policy_negative_fixtures.v1"},
    "purpose": {"type": "string", "minLength": 1},
    "egress_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/EgressAssertion"}
    },
    "permission_scope_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/PermissionScopeAssertion"}
    },
    "run_mode_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/RunModeAssertion"}
    },
    "crawl_policy_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/CrawlPolicyAssertion"}
    },
    "redaction_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/RedactionAssertion"}
    },
    "negative_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/NegativeCase"}
    }
  },
  "$defs": {
    "EgressAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "input_url", "expected_host_class", "expected_decision", "expected_reason"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "input_url": {"type": "string", "minLength": 1},
        "expected_host_class": {"type": "string", "enum": ["public", "localhost", "private_or_metadata", "file_scheme"]},
        "resolved_ip": {"type": "string"},
        "expected_resolved_host_class": {"type": "string", "enum": ["public", "localhost", "private_or_metadata"]},
        "dns_rebind_detected": {"type": "boolean"},
        "redirect_target_url": {"type": "string"},
        "expected_redirect_host_class": {"type": "string", "enum": ["public", "localhost", "private_or_metadata", "file_scheme"]},
        "expected_redirect_decision": {"type": "string", "enum": ["allow", "ask", "deny"]},
        "expected_decision": {"type": "string", "enum": ["allow", "ask", "deny"]},
        "expected_reason": {"type": "string", "minLength": 1}
      }
    },
    "PermissionScopeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "tool_id", "expected_scope"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "tool_id": {"type": "string", "enum": ["websearch", "webfetch", "webextract", "webresearch", "webcrawl", "webmap"]},
        "input_text": {"type": "string"},
        "input_url": {"type": "string"},
        "root_url": {"type": "string"},
        "expected_scope": {"type": "string", "minLength": 1}
      }
    },
    "RunModeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "run_mode", "network_policy", "tool_id", "expected_decision", "must_show_card"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "run_mode": {"type": "string", "enum": ["ask", "plan", "regular", "yolo"]},
        "effective_overlay": {"type": "string", "enum": ["none", "ask", "plan", "deep_plan", "debug", "interview", "brainstorm", "crew"]},
        "normalized_runtime_mode": {"type": "string", "enum": ["ask", "plan", "regular", "yolo"]},
        "network_policy": {"type": "string", "enum": ["ask", "deny"]},
        "tool_id": {"type": "string", "enum": ["websearch", "webfetch", "webextract", "webresearch", "webcrawl", "webmap"]},
        "expected_decision": {"type": "string", "enum": ["ask", "deny"]},
        "expected_reason": {"type": "string"},
        "must_show_card": {"type": "boolean"}
      }
    },
    "CrawlPolicyAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "tool_id", "root_url", "expected_decision", "expected_reason"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "tool_id": {"type": "string", "enum": ["webcrawl", "webmap"]},
        "root_url": {"type": "string", "minLength": 1},
        "respect_robots": {"type": "boolean"},
        "robots_allowed": {"type": "boolean"},
        "requested_max_pages": {"type": "integer", "minimum": 0},
        "policy_fanout_limit": {"type": "integer", "minimum": 0},
        "requested_max_depth": {"type": "integer", "minimum": 0},
        "policy_max_depth": {"type": "integer", "minimum": 0},
        "expected_decision": {"type": "string", "enum": ["deny", "partial_or_denied"]},
        "expected_reason": {"type": "string", "enum": ["robots_denied", "fanout_capped", "depth_capped"]}
      }
    },
    "RedactionAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "surface", "expected_error"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "enum": ["url_query", "browser_artifact"]},
        "input_url": {"type": "string"},
        "expected_redacted_url": {"type": "string"},
        "forbidden_tokens": {"type": "array", "items": {"type": "string"}},
        "artifact_kind": {"type": "string", "enum": ["browser_screenshot", "browser_pdf", "console", "network"]},
        "redaction_status": {"type": ["string", "null"], "enum": ["not_needed", "applied", "blocked", "failed", null]},
        "expected_error": {"type": "string", "minLength": 1}
      }
    },
    "NegativeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "surface"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "input_kind": {"type": "string"},
        "must_reject": {"type": "array", "items": {"type": "string"}},
        "expected_error": {"type": "string"},
        "input_url": {"type": "string"},
        "expected_decision": {"type": "string"},
        "expected_reason": {"type": "string"},
        "run_mode": {"type": "string"},
        "network_policy": {"type": "string"},
        "tool_id": {"type": "string"},
        "must_show_card": {"type": "boolean"},
        "input_text": {"type": "string"},
        "expected_scope": {"type": "string"},
        "forbidden_scope": {"type": "string"},
        "root_url": {"type": "string"},
        "respect_robots": {"type": "boolean"},
        "max_pages": {"type": "integer"},
        "max_depth": {"type": "integer"},
        "must_record_evidence": {"type": "boolean"},
        "cache_state": {"type": "string"},
        "must_require": {"type": "array", "items": {"type": "string"}},
        "must_equal": {"type": "object"},
        "requested_runtime": {"type": "string"},
        "runtime_state": {"type": "string"},
        "must_not": {"type": "array", "items": {"type": "string"}},
        "evidence_kind": {"type": "string"},
        "snippet_only": {"type": "boolean"},
        "invocation_source": {"type": "string"},
        "must_require_one_of": {"type": "array", "items": {"type": "string"}},
        "forbidden_tokens": {"type": "array", "items": {"type": "string"}},
        "artifact_kind": {"type": "string"},
        "redaction_status": {"type": ["string", "null"]}
      }
    }
  }
}
