{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.runtime_artifact.tool_llm_trace.schema.v1",
  "title": "Runtime Artifact tool_llm_trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "artifact_id",
    "artifact_type",
    "project_id",
    "run_id",
    "attempt_id",
    "created_at_utc",
    "projection_freshness",
    "projection_health",
    "retention_class",
    "routing_refs",
    "type_payload"
  ],
  "$defs": {
    "refString": {
      "type": "string",
      "minLength": 1
    },
    "stringOrNull": {
      "type": [
        "string",
        "null"
      ]
    },
    "boolOrNull": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.runtime_artifact.tool_llm_trace.schema.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "const": "tool_llm_trace"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "provider_attempt_ref": {
      "type": "string"
    },
    "usage_event_ref": {
      "type": "string"
    },
    "usage_record_id": {
      "type": "string"
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer_ref": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "detail_ref": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "source_surface": {
      "type": "string"
    },
    "projection_freshness": {
      "type": "string"
    },
    "projection_health": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "routing_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_ref",
        "trace_kind",
        "tool_call_id",
        "provider_attempt_ref",
        "usage_event_ref",
        "usage_record_id",
        "lifecycle",
        "raw_payload",
        "settlement",
        "retry",
        "refs",
        "flags"
      ],
      "anyOf": [
        {
          "required": [
            "llm_call_id"
          ]
        },
        {
          "required": [
            "stream_id"
          ]
        }
      ],
      "properties": {
        "trace_ref": {
          "$ref": "#/$defs/refString"
        },
        "trace_kind": {
          "type": "string",
          "enum": [
            "llm_call",
            "tool_call",
            "stream",
            "retry",
            "escalation",
            "unknown"
          ]
        },
        "tool_call_id": {
          "$ref": "#/$defs/stringOrNull"
        },
        "llm_call_id": {
          "$ref": "#/$defs/stringOrNull"
        },
        "stream_id": {
          "$ref": "#/$defs/stringOrNull"
        },
        "provider_attempt_ref": {
          "$ref": "#/$defs/stringOrNull"
        },
        "usage_event_ref": {
          "$ref": "#/$defs/stringOrNull"
        },
        "usage_record_id": {
          "$ref": "#/$defs/stringOrNull"
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at_utc",
            "partial_at_utc",
            "final_at_utc",
            "error_at_utc",
            "abort_at_utc",
            "stream_state"
          ],
          "properties": {
            "started_at_utc": {
              "$ref": "#/$defs/stringOrNull"
            },
            "partial_at_utc": {
              "$ref": "#/$defs/stringOrNull"
            },
            "final_at_utc": {
              "$ref": "#/$defs/stringOrNull"
            },
            "error_at_utc": {
              "$ref": "#/$defs/stringOrNull"
            },
            "abort_at_utc": {
              "$ref": "#/$defs/stringOrNull"
            },
            "stream_state": {
              "type": "string",
              "enum": [
                "started",
                "partial",
                "final",
                "error",
                "aborted",
                "unknown"
              ]
            },
            "partial_reason": {
              "$ref": "#/$defs/stringOrNull"
            },
            "stop_reason": {
              "$ref": "#/$defs/stringOrNull"
            }
          }
        },
        "raw_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_payload_ref",
            "redaction_status",
            "provider_payload_hash"
          ],
          "properties": {
            "raw_payload_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "redaction_status": {
              "type": "string",
              "enum": [
                "redacted",
                "not_required",
                "pending",
                "unknown"
              ]
            },
            "provider_payload_hash": {
              "$ref": "#/$defs/stringOrNull"
            }
          }
        },
        "settlement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "settlement_status",
            "usage_event_ref",
            "usage_record_id",
            "usage_artifact_ref"
          ],
          "properties": {
            "settlement_status": {
              "type": "string",
              "enum": [
                "observed",
                "streaming_partial",
                "settled",
                "adjusted",
                "failed",
                "unknown"
              ]
            },
            "usage_event_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "usage_record_id": {
              "$ref": "#/$defs/stringOrNull"
            },
            "usage_artifact_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "quota_artifact_ref": {
              "$ref": "#/$defs/stringOrNull"
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "parent_trace_ref",
            "dedupe_key"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "enum": [
                "none",
                "retry_of",
                "escalation_of",
                "resume_of",
                "unknown"
              ]
            },
            "parent_trace_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "dedupe_key": {
              "$ref": "#/$defs/stringOrNull"
            }
          }
        },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_attempt_ref",
            "usage_event_ref",
            "usage_record_id",
            "raw_payload_ref"
          ],
          "properties": {
            "provider_attempt_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "usage_event_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "usage_record_id": {
              "$ref": "#/$defs/stringOrNull"
            },
            "raw_payload_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "receipt_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "quota_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usage_observed",
            "quota_observed",
            "redacted"
          ],
          "properties": {
            "usage_observed": {
              "$ref": "#/$defs/boolOrNull"
            },
            "quota_observed": {
              "$ref": "#/$defs/boolOrNull"
            },
            "redacted": {
              "type": "boolean"
            },
            "provider_reported": {
              "$ref": "#/$defs/boolOrNull",
              "description": "Signal flag only. Source authority for Usage display joins through usage_record_id or usage_artifact_ref and must use source_class/source_confidence/source_authority."
            },
            "cli_reported": {
              "$ref": "#/$defs/boolOrNull",
              "description": "Signal flag only. Source authority for Usage display joins through usage_record_id or usage_artifact_ref and must use source_class/source_confidence/source_authority."
            }
          }
        }
      }
    }
  }
}
