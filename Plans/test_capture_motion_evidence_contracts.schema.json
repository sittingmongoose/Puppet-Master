    "capture_command_request": {
      "title": "CaptureCommandRequest",
      "$anchor": "CaptureCommandRequest",
      "description": "Owner-DRY request envelope for the exact eight TestCaptureService commands and two artifact derivation/provenance commands assigned to this contract lane. Existing session/playback/export commands remain compatible consumers and are not duplicated here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "record_kind", "command_id", "command_instance_id", "lineage", "actor_ref", "permission_snapshot_ref", "idempotency_key", "expected_currentness_ref", "expected_currentness_sha256", "source_surface", "return_route_ref"],
      "properties": {
        "schema_id": {"const": "pm.test_capture.command_request.v1"},
        "record_kind": {"const": "capture_command_request"},
        "command_id": {"$ref": "#/$defs/capture_command_id"},
        "command_instance_id": {"$ref": "#/$defs/id"},
        "lineage": {"$ref": "#/$defs/lineage"},
        "actor_ref": {"$ref": "#/$defs/non_secret_ref"},
        "permission_snapshot_ref": {"$ref": "#/$defs/non_secret_ref"},
        "idempotency_key": {"$ref": "#/$defs/id"},
        "expected_currentness_ref": {"$ref": "#/$defs/non_secret_ref"},
        "expected_currentness_sha256": {"$ref": "#/$defs/sha256"},
        "source_surface": {"enum": ["testing", "runtime_artifacts", "browser", "settings", "command_palette", "api", "automation"]},
        "return_route_ref": {"$ref": "#/$defs/non_secret_ref"},
        "capture_session_id": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/capture_target"},
        "expected_target_currentness_ref": {"$ref": "#/$defs/non_secret_ref"},
        "expected_target_currentness_sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"$ref": "#/$defs/capture_mode"},
        "target_policy": {"$ref": "#/$defs/capture_target_policy"},
        "requested_engine": {"enum": ["native_browser_capture", "native_window_capture", "device_bridge", "remote_stream_adapter", "external_project_adapter", "frame_sequence_import"]},
        "capture_policy_ref": {"$ref": "#/$defs/non_secret_ref"},
        "runtime_resource_permit_ref": {"$ref": "#/$defs/non_secret_ref"},
        "bookmark_monotonic_ns": {"type": "integer", "minimum": 0},
        "bookmark_label_ref": {"$ref": "#/$defs/non_secret_ref"},
        "raw_capture_id": {"$ref": "#/$defs/id"},
        "raw_capture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "clip_start_monotonic_ns": {"type": "integer", "minimum": 0},
        "clip_end_monotonic_ns": {"type": "integer", "minimum": 0},
        "derivation_manifest_ref": {"$ref": "#/$defs/non_secret_ref"},
        "privacy_review_ref": {"$ref": "#/$defs/non_secret_ref"},
        "confirmation_receipt_ref": {"$ref": "#/$defs/non_secret_ref"},
        "provenance_subject_ref": {"$ref": "#/$defs/non_secret_ref"},
        "candidate_capture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "allOf": [
        {"if": {"properties": {"command_id": {"const": "cmd.testing.capture.start"}}}, "then": {"required": ["target", "expected_target_currentness_ref", "expected_target_currentness_sha256", "mode", "target_policy", "requested_engine", "capture_policy_ref", "runtime_resource_permit_ref"]}},
        {"if": {"properties": {"command_id": {"enum": ["cmd.testing.capture.pause", "cmd.testing.capture.resume", "cmd.testing.capture.stop", "cmd.testing.capture.health.inspect"]}}}, "then": {"required": ["capture_session_id"]}},
        {"if": {"properties": {"command_id": {"const": "cmd.testing.capture.bookmark"}}}, "then": {"required": ["capture_session_id", "bookmark_monotonic_ns", "bookmark_label_ref"]}},
        {"if": {"properties": {"command_id": {"const": "cmd.testing.capture.save_clip"}}}, "then": {"required": ["capture_session_id", "raw_capture_id", "clip_start_monotonic_ns", "clip_end_monotonic_ns", "derivation_manifest_ref", "privacy_review_ref"]}},
        {"if": {"properties": {"command_id": {"const": "cmd.testing.capture.target.update"}}}, "then": {"required": ["capture_session_id", "target", "expected_target_currentness_ref", "expected_target_currentness_sha256"]}},
        {"if": {"properties": {"command_id": {"const": "cmd.artifacts.create_demonstration_video"}}}, "then": {"required": ["raw_capture_ids", "derivation_manifest_ref", "privacy_review_ref", "confirmation_receipt_ref"]}},
        {"if": {"properties": {"command_id": {"const": "cmd.artifacts.inspect_capture_provenance"}}}, "then": {"required": ["provenance_subject_ref", "candidate_capture_ids"]}}
      ]
    },
    "capture_command_result": {
      "title": "CaptureCommandResult",
      "$anchor": "CaptureCommandResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "record_kind", "command_id", "command_instance_id", "outcome", "capture_session_ref", "artifact_refs", "receipt_refs", "observable_work_ref", "currentness_ref", "currentness_sha256", "disabled_reason", "error_ref", "replayed"],
      "properties": {
        "schema_id": {"const": "pm.test_capture.command_result.v1"},
        "record_kind": {"const": "capture_command_result"},
        "command_id": {"$ref": "#/$defs/capture_command_id"},
        "command_instance_id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["accepted", "completed", "disabled", "rejected", "cancelled", "no_change"]},
        "capture_session_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
        "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/non_secret_ref"}},
        "receipt_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/non_secret_ref"}},
        "observable_work_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
        "currentness_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
        "currentness_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "disabled_reason": {"oneOf": [{"$ref": "#/$defs/capture_command_disabled_reason"}, {"type": "null"}]},
        "error_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
        "replayed": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"enum": ["accepted", "completed", "no_change"]}}}, "then": {"properties": {"currentness_ref": {"$ref": "#/$defs/non_secret_ref"}, "currentness_sha256": {"$ref": "#/$defs/sha256"}, "disabled_reason": {"type": "null"}, "error_ref": {"type": "null"}}}},
        {"if": {"properties": {"outcome": {"const": "completed"}}}, "then": {"properties": {"receipt_refs": {"minItems": 1}}}},
        {"if": {"properties": {"outcome": {"const": "disabled"}}}, "then": {"properties": {"disabled_reason": {"$ref": "#/$defs/capture_command_disabled_reason"}, "error_ref": {"$ref": "#/$defs/non_secret_ref"}}}},
        {"if": {"properties": {"outcome": {"const": "rejected"}}}, "then": {"properties": {"error_ref": {"$ref": "#/$defs/non_secret_ref"}}}}
      ]
    },
    "capture_command_error": {
      "title": "CaptureCommandError",
      "$anchor": "CaptureCommandError",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "record_kind", "command_id", "command_instance_id", "error_code", "message_code", "retriable", "currentness_ref", "target_ref", "capture_session_ref", "safe_next_action_ref", "redaction_profile"],
      "properties": {
        "schema_id": {"const": "pm.test_capture.command_error.v1"},
        "record_kind": {"const": "capture_command_error"},
        "command_id": {"$ref": "#/$defs/capture_command_id"},
        "command_instance_id": {"$ref": "#/$defs/id"},
        "error_code": {"enum": ["invalid_request", "permission_denied", "stale_currentness", "target_unavailable", "protected_auth_target_forbidden", "playwright_runtime_forbidden", "capture_session_not_found", "source_capture_not_found", "privacy_review_required", "resource_permit_unavailable", "command_not_registered", "native_handler_absent", "production_wiring_absent", "owner_unavailable", "cancelled"]},
        "message_code": {"$ref": "#/$defs/id"},
        "retriable": {"type": "boolean"},
        "currentness_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
        "target_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
        "capture_session_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
        "safe_next_action_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
        "redaction_profile": {"const": "no_secrets_no_protected_auth_content_no_absolute_paths"}
      }
    },
    "capture_command_availability": {
      "title": "CaptureCommandAvailability",
      "$anchor": "CaptureCommandAvailability",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "record_kind", "command_id", "subject_ref", "availability", "currentness_ref", "currentness_sha256", "disabled_reason", "missing_requirement_refs", "safe_next_action_ref"],
      "properties": {
        "schema_id": {"const": "pm.test_capture.command_availability.v1"},
        "record_kind": {"const": "capture_command_availability"},
        "command_id": {"$ref": "#/$defs/capture_command_id"},
        "subject_ref": {"$ref": "#/$defs/non_secret_ref"},
        "availability": {"enum": ["available", "disabled"]},
        "currentness_ref": {"$ref": "#/$defs/non_secret_ref"},
        "currentness_sha256": {"$ref": "#/$defs/sha256"},
        "disabled_reason": {"oneOf": [{"$ref": "#/$defs/capture_command_disabled_reason"}, {"type": "null"}]},
        "missing_requirement_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/non_secret_ref"}},
        "safe_next_action_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "available"}}}, "then": {"properties": {"disabled_reason": {"type": "null"}, "missing_requirement_refs": {"maxItems": 0}, "safe_next_action_ref": {"type": "null"}}}},
        {"if": {"properties": {"availability": {"const": "disabled"}}}, "then": {"properties": {"disabled_reason": {"$ref": "#/$defs/capture_command_disabled_reason"}, "missing_requirement_refs": {"minItems": 1}, "safe_next_action_ref": {"$ref": "#/$defs/non_secret_ref"}}}}
      ]
    }
  }
}
