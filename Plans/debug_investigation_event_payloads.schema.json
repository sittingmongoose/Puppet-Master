      "properties": {
        "instrumentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
