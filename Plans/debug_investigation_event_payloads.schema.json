        "operation_id",
        "target_ref",
        "previous_owner_ref",
        "owner_ref",
        "proof_ref",
        "recovery_ref",
        "linked_work_ref",
        "remaining_obligation_refs",
        "whole_lane_never_needed_undoing",
        "no_leftovers",
        "removal_verified",
        "retry_authorized",
        "previous_attempt_failed",
        "handoff_approved",
        "durable_fix_approved",
        "owner_accepted",
        "handoff_pending",
        "invasive",
        "restore_receipt_verified",
        "permission_verified",
        "overlap_present",
        "target_leftovers_present",
        "target_leftovers_promoted",
        "retry_count_before",
        "retry_count_after",
        "attempt_number",
        "transition_kind",
        "handoff_kind",
        "handoff_committed"
      ],
      "properties": {
        "instrumentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "previous_owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "proof_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "linked_work_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "remaining_obligation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "whole_lane_never_needed_undoing": {
          "type": "boolean"
        },
        "no_leftovers": {
          "type": "boolean"
        },
        "removal_verified": {
          "type": "boolean"
        },
        "retry_authorized": {
          "type": "boolean"
        },
        "previous_attempt_failed": {
          "type": "boolean"
        },
        "handoff_approved": {
          "type": "boolean"
        },
        "durable_fix_approved": {
          "type": "boolean"
        },
        "owner_accepted": {
          "type": "boolean"
        },
        "handoff_pending": {
          "type": "boolean"
        },
        "invasive": {
          "type": "boolean"
        },
        "restore_receipt_verified": {
          "type": "boolean"
        },
        "permission_verified": {
          "type": "boolean"
        },
        "overlap_present": {
          "type": "boolean"
        },
        "target_leftovers_present": {
          "type": "boolean"
        },
        "target_leftovers_promoted": {
          "type": "boolean"
        },
        "retry_count_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "retry_count_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "transition_kind": {
          "enum": [
            "installation_succeeded",
            "collection_started",
            "collection_paused_or_finished",
            "ended_never_needed",
            "leftovers_require_cleanup",
            "inspection_never_needed",
            "removal_succeeded",
            "removal_failed",
            "retry_begins",
            "retry_outcome_succeeded",
            "retry_outcome_failed",
            "responsibility_handoff",
            "receiving_owner_begins",
            "receiving_owner_cannot_retry",
            "replacement_never_needed"
          ]
        },
        "handoff_kind": {
          "enum": [
            "none",
            "replacement",
            "durable_fix"
          ]
        },
        "handoff_committed": {
          "type": "boolean"
        }
      }
    },
    "state_changed": {
      "$id": "pm.debug_investigation.state_changed.schema.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "investigation_id",
        "operation_id",
        "previous_state",
        "previous_phase",
        "phase",
        "state"
      ],
      "properties": {
        "investigation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attention_required_reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stop_reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "budget_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "blocked_reason_code": {
