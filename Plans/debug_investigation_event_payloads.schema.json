          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "previous_state": {
          "enum": [
            "active",
            "redacted",
