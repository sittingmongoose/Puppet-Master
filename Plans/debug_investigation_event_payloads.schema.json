          "maxLength": 256
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "item_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_surface": {
          "type": "string",
