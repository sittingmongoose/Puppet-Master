      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "investigation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bundle_id": {
          "type": "string",
