    "instrumentation_state_changed": {
      "$id": "pm.debug_investigation.instrumentation_state_changed.schema.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigation_id",
        "operation_id",
        "instrumentation_id",
        "scope_kind",
        "reason_code",
        "detail_ref",
        "schema_version",
        "previous_state",
        "state",
        "previous_rollback_state",
        "rollback_state"
      ],
      "properties": {
        "investigation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "instrumentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope_kind": {
          "enum": [
            "env_config_activation",
            "ephemeral_tool_install",
            "wrapper_launcher",
            "temporary_source_patch",
            "debugger_or_profiler_attach"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "detail_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "previous_state": {
          "enum": [
            "planned",
            "active",
            "collecting",
            "cleanup_pending",
            "cleanup_failed",
            "cleaned"
          ]
        },
        "state": {
          "enum": [
            "planned",
            "active",
            "collecting",
            "cleanup_pending",
            "cleanup_failed",
            "cleaned"
          ]
        },
        "previous_rollback_state": {
          "enum": [
            "not_needed",
            "pending",
            "succeeded",
            "failed",
            "superseded"
          ]
        },
        "rollback_state": {
          "enum": [
            "not_needed",
            "pending",
            "succeeded",
            "failed",
            "superseded"
          ]
        }
      }
    },
    "started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "investigation_id",
        "operation_id",
        "project_id",
        "initiator_surface",
        "target_kind",
        "target_locator_summary",
        "requested_mode_overlay",
        "effective_mode_overlay",
        "runtime_mode"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "investigation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "initiator_surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_kind": {
          "enum": [
            "dev_session",
            "browser_target",
            "dap_session",
            "agent_session",
            "imported_bundle"
          ]
        },
        "target_locator_summary": {
          "type": "string",
          "maxLength": 2048
        },
        "requested_mode_overlay": {
          "enum": [
            "none",
            "plan",
            "deep_plan",
            "debug",
            "interview",
            "brainstorm",
            "crew"
          ],
          "$comment": "Closed by Plans/assistant-chat-design.md 'Canonical enum closure' (requested_mode_overlay/effective_mode_overlay)."
        },
        "effective_mode_overlay": {
          "enum": [
            "none",
            "plan",
            "deep_plan",
            "debug",
            "interview",
            "brainstorm",
            "crew"
          ],
          "$comment": "Closed by Plans/assistant-chat-design.md 'Canonical enum closure' (requested_mode_overlay/effective_mode_overlay)."
        },
        "runtime_mode": {
          "enum": [
            "ask",
            "plan",
            "regular",
            "yolo"
          ]
        }
      },
      "allOf": [
        {
          "$comment": "Chat 1.0B: selected Debug persists debug/debug.",
          "if": {
            "properties": {
              "requested_mode_overlay": {
                "enum": [
                  "debug"
                ]
              }
            },
            "required": [
              "requested_mode_overlay"
            ]
          },
          "then": {
            "properties": {
              "effective_mode_overlay": {
                "const": "debug"
              }
            }
          }
        },
        {
          "$comment": "Chat 1.0B/1.0C: Debug uses regular or explicit-opt-in yolo, never ask/plan.",
          "if": {
            "properties": {
              "effective_mode_overlay": {
                "enum": [
                  "debug"
                ]
              }
            },
            "required": [
              "effective_mode_overlay"
            ]
          },
          "then": {
            "properties": {
              "requested_mode_overlay": {
                "const": "debug"
              },
              "runtime_mode": {
                "enum": [
                  "regular",
                  "yolo"
                ]
              }
            }
          }
        },
        {
          "$comment": "Chat 1.0A/1.0C and 29.1: effective Plan/Deep Plan is read-only runtime plan. Approval handoff is a separate owner gate; no universal overlay clearing/equality.",
          "if": {
            "properties": {
              "effective_mode_overlay": {
                "enum": [
                  "plan",
                  "deep_plan"
                ]
              }
            },
            "required": [
              "effective_mode_overlay"
            ]
          },
          "then": {
            "properties": {
              "runtime_mode": {
                "const": "plan"
              }
            }
          }
        }
      ],
      "$id": "pm.debug_investigation.started.schema.v1"
    },
    "target_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "investigation_id",
        "operation_id",
        "target_kind",
        "target_bindings",
        "binding_state"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "investigation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_kind": {
          "enum": [
            "dev_session",
            "browser_target",
            "dap_session",
            "agent_session",
            "imported_bundle"
          ]
        },
        "target_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner_ref",
            "target_ref",
            "binding_revision",
            "source_sha256"
          ],
          "properties": {
            "owner_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "target_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "binding_revision": {
              "type": "integer",
              "minimum": 0
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        },
        "binding_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "$id": "pm.debug_investigation.target_bound.schema.v1"
    },
    "verification_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "investigation_id",
        "operation_id",
        "verification_strength",
        "verification_summary"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "investigation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verification_strength": {
          "enum": [
            "none",
            "weak",
            "strong"
          ]
        },
        "verification_summary": {
          "type": "string",
          "maxLength": 2048
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 256
        }
      },
      "$id": "pm.debug_investigation.verification_recorded.schema.v1"
    },
    "instrumentation_change_detail": {
      "$id": "pm.debug_investigation.instrumentation_change_detail.schema.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
