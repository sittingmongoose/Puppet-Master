{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/home_workspace_layout/1.0.0/home_workspace_layout.schema.json",
  "title": "Puppet Master Home Workspace Layout V1",
  "description": "Project/workspace-scoped presentation layout. It stores stable surface references only and never owns editor buffers, terminal sessions, PTYs, browser sessions, chat messages, or Dashboard widget layout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "workspace_tab_id",
    "layout_revision",
    "surfaces",
    "saved_at_utc",
    "validation",
    "migration"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.home_workspace_layout.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_tab_id": {
      "type": "string",
      "minLength": 1
    },
    "layout_revision": {
      "type": "integer",
      "minimum": 0
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "saved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    }
  },
  "$defs": {
    "host": {
      "type": "string",
      "enum": [
        "home_main",
        "dock_left",
        "dock_right",
        "dock_top",
        "dock_bottom",
        "floating"
      ]
    },
    "surface_kind": {
      "type": "string",
      "enum": [
        "editor_panel",
        "dashboard",
        "chat",
        "terminal_section"
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_instance_id",
        "surface_kind",
        "domain_ref",
        "host",
        "slot_index",
        "split_path",
        "size",
        "visible",
        "collapsed",
        "floating_bounds",
        "last_docked_host",
        "last_docked_slot_index",
        "last_focus_seq"
      ],
      "properties": {
        "surface_instance_id": {
          "type": "string",
          "pattern": "^(editor_panel_[1-4]|dashboard|chat|terminal_section:[A-Za-z0-9._:-]+)$"
        },
        "surface_kind": {
          "$ref": "#/$defs/surface_kind"
        },
        "domain_ref": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "editor_panel_id": {
              "type": "string",
              "enum": [
                "editor_panel_1",
                "editor_panel_2",
                "editor_panel_3",
                "editor_panel_4"
              ]
            },
            "editor_group_id": {
              "type": "string",
              "minLength": 1
            },
            "worktree_id": {
              "type": "string",
              "minLength": 1
            },
            "browser_session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "browser_active": {
              "type": "boolean"
            },
            "dashboard_surface_id": {
              "const": "dashboard"
            },
            "chat_surface_id": {
              "const": "chat"
            },
            "terminal_section_id": {
              "type": "string",
              "minLength": 1
            },
            "terminal_workgroup_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "pane_ids": {
              "type": "string"
            },
            "terminal_session_ids": {
              "type": "string"
            }
          }
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "slot_index": {
          "type": "integer",
          "minimum": 0
        },
        "split_path": {
          "type": "string",
          "pattern": "^root(?:/[0-9]+)*$"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "visible": {
          "type": "boolean"
        },
        "collapsed": {
          "type": "boolean"
        },
        "floating_bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/bounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_docked_host": {
          "$ref": "#/$defs/host"
        },
        "last_docked_slot_index": {
          "type": "integer",
          "minimum": 0
        },
        "last_focus_seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "surface_kind": {
                "const": "editor_panel"
              }
            }
          },
          "then": {
            "properties": {
              "domain_ref": {
                "required": [
                  "editor_panel_id",
                  "editor_group_id",
                  "worktree_id",
                  "browser_session_id",
                  "browser_active"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "surface_kind": {
                "const": "dashboard"
              }
            }
          },
          "then": {
            "properties": {
              "domain_ref": {
                "required": [
                  "dashboard_surface_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "surface_kind": {
                "const": "chat"
              }
            }
          },
          "then": {
            "properties": {
              "domain_ref": {
                "required": [
                  "chat_surface_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "surface_kind": {
                "const": "terminal_section"
              }
            }
          },
          "then": {
            "properties": {
              "domain_ref": {
                "required": [
                  "terminal_section_id",
                  "terminal_workgroup_id",
                  "pane_ids",
                  "terminal_session_ids"
                ]
              }
            }
          }
        }
      ]
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_px",
        "flex_weight",
        "min_width_px",
        "min_height_px"
      ],
      "properties": {
        "basis_px": {
          "type": "number",
          "minimum": 0
        },
        "flex_weight": {
          "type": "number",
          "minimum": 0
        },
        "min_width_px": {
          "type": "number",
          "minimum": 1
        },
        "min_height_px": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "max_editor_panels",
        "max_terminal_sections",
        "max_visible_terminal_panes",
        "fallback_host",
        "safe_offscreen_fallback",
        "last_validation_errors"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "migrated",
            "recovered_defaults",
            "invalid_rejected"
          ]
        },
        "max_editor_panels": {
          "const": 4
        },
        "max_terminal_sections": {
          "const": 4
        },
        "max_visible_terminal_panes": {
          "const": 4
        },
        "fallback_host": {
          "$ref": "#/$defs/host"
        },
        "safe_offscreen_fallback": {
          "type": "boolean",
          "const": true
        },
        "last_validation_errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_schema_version",
        "migrated_at_utc",
        "source_key",
        "disposition"
      ],
      "properties": {
        "from_schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "migrated_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "source_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "current",
            "copy_forward",
            "defaults_after_corruption",
            "safe_offscreen_recovery"
          ]
        }
      }
    }
  }
}
