{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event-authority-w3g/goal_resumed/1.0.0/schema.json",
  "title": "goal.resumed prepared payload selectors; no admission",
  "$defs": {
    "ProjectPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "event_type",
        "owner_operation_id",
        "scope",
        "source_record_ref",
        "source_record_sha256",
        "source_schema_id",
        "source_schema_version",
        "source_receipt_ref",
        "goal_id",
        "thread_id",
        "expected_revision",
        "goal_revision",
        "before_currentness_hash",
        "currentness_hash",
        "user_stop_epoch",
        "active_run_ref",
        "body_receipt_ref",
        "before_state",
        "after_state",
        "resume_authority_ref",
        "blocker_clearance_ref"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.event_payload.goal.resumed.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "event_type": {
          "const": "goal.resumed"
        },
        "owner_operation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/WorkflowScopeV2"
            },
            {
              "properties": {
                "scope_kind": {
                  "const": "project"
                }
              }
            }
          ]
        },
        "source_record_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_record_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_schema_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_schema_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "goal_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "goal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "before_currentness_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "currentness_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "user_stop_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "active_run_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "before_state": {
          "type": "string",
          "enum": [
            "paused",
            "blocked"
          ]
        },
        "after_state": {
          "const": "active"
        },
        "resume_authority_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "blocker_clearance_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApplicationPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "event_type",
        "owner_operation_id",
        "scope",
        "source_record_ref",
        "source_record_sha256",
        "source_schema_id",
        "source_schema_version",
        "source_receipt_ref",
        "goal_id",
        "thread_id",
        "expected_revision",
        "goal_revision",
        "before_currentness_hash",
        "currentness_hash",
        "user_stop_epoch",
        "active_run_ref",
        "body_receipt_ref",
        "before_state",
        "after_state",
        "resume_authority_ref",
        "blocker_clearance_ref"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.event_payload.goal.resumed.application.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "event_type": {
          "const": "goal.resumed"
        },
        "owner_operation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/WorkflowScopeV2"
            },
            {
              "properties": {
                "scope_kind": {
                  "const": "application"
                }
              }
            }
          ]
        },
        "source_record_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_record_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_schema_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_schema_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "goal_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "goal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "before_currentness_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "currentness_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "user_stop_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "active_run_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "before_state": {
          "type": "string",
          "enum": [
            "paused",
            "blocked"
          ]
        },
        "after_state": {
          "const": "active"
        },
        "resume_authority_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "blocker_clearance_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ProjectPayloadV1"
    },
    {
      "$ref": "#/$defs/ApplicationPayloadV1"
    }
  ]
}
