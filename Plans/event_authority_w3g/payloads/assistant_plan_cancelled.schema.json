{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event-authority-w3g/assistant_plan_cancelled/1.0.0/schema.json",
  "title": "assistant_plan.cancelled prepared payload selectors; no admission",
  "$defs": {
    "ProjectPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "event_type",
        "owner_operation_id",
        "scope",
        "source_record_ref",
        "source_record_sha256",
        "source_schema_id",
        "source_schema_version",
        "source_receipt_ref",
        "assistant_plan_id",
        "thread_id",
        "plan_version",
        "plan_hash",
        "aggregate_revision",
        "currentness_hash",
        "plan_run_id",
        "cancel_receipt_ref",
        "control_state",
        "plan_run_epoch"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.event_payload.assistant_plan.cancelled.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "event_type": {
          "const": "assistant_plan.cancelled"
        },
        "owner_operation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/WorkflowScopeV2"
            },
            {
              "properties": {
                "scope_kind": {
                  "const": "project"
                }
              }
            }
          ]
        },
        "source_record_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_record_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_schema_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_schema_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "source_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "assistant_plan_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "plan_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "aggregate_revision": {
          "type": "integer",
          "minimum": 1
        },
        "currentness_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "control_state": {
          "const": "canceled"
        },
        "plan_run_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApplicationPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "event_type",
        "owner_operation_id",
        "scope",
        "source_record_ref",
        "source_record_sha256",
        "source_schema_id",
        "source_schema_version",
        "source_receipt_ref",
        "assistant_plan_id",
        "thread_id",
        "plan_version",
        "plan_hash",
        "aggregate_revision",
        "currentness_hash",
        "plan_run_id",
        "cancel_receipt_ref",
        "control_state",
        "plan_run_epoch"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.event_payload.assistant_plan.cancelled.application.v1"
        },
