{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/storage_value/permission_snapshot_record/1.0.0/permission_snapshot_record.schema.json",
  "title": "PermissionSnapshotRecord",
  "description": "Permissions-owned immutable attempt evidence materialized here for the shared-runtime join. It is never reconstructed from current Settings, safe points, restore points, or projections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "snapshot_id",
    "attempt_id",
    "node_id",
    "run_id",
    "blocked_sequence",
    "captured_at_utc",
    "approval_scope_key",
    "approval_target_ref",
    "requested_account_binding",
    "effective_account_binding",
    "account_switch_event_ref",
    "permission_decision_context",
    "actor_surface_context",
    "runtime_identity_context",
    "resolved_permissions",
    "source_event_ref",
    "redaction_profile",
    "integrity_sha256",
    "integrity_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.storage_value.permission_snapshot_record.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "snapshot_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "attempt_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "node_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "run_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "blocked_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "captured_at_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "approval_scope_key": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "approval_target_ref": {
      "$ref": "#/$defs/nullable_non_secret_ref"
    },
    "requested_account_binding": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "effective_account_binding": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "account_switch_event_ref": {
      "$ref": "#/$defs/nullable_non_secret_ref"
    },
    "permission_decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_context_ref",
        "mode_override",
        "preflight_snapshot_ref",
        "policy_source_ref"
      ],
      "properties": {
        "decision_context_ref": {
          "$ref": "#/$defs/nullable_non_secret_ref"
        },
        "mode_override": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "preflight_snapshot_ref": {
          "$ref": "#/$defs/nullable_non_secret_ref"
        },
        "policy_source_ref": {
          "$ref": "#/$defs/nullable_non_secret_ref"
        }
      }
    },
    "actor_surface_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_kind",
        "execution_role",
        "surface_id",
        "surface_route",
        "project_id",
        "thread_id",
        "run_id"
      ],
      "properties": {
        "actor_kind": {
          "enum": [
            "assistant",
            "interviewer",
            "builder",
            "orchestrator",
            "subagent",
            "user",
            "system"
          ]
        },
        "execution_role": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "surface_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "surface_route": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "project_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "thread_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "run_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        }
      }
    },
    "runtime_identity_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_platform",
        "effective_platform",
        "provider_family_id",
        "requested_runtime_identity",
        "effective_runtime_identity",
        "host_ref",
        "transport_host_ref",
        "upstream_provider_ref",
        "repo_id",
        "worktree_id"
      ],
      "properties": {
        "requested_platform": {
          "$ref": "#/$defs/non_empty_string"
        },
        "effective_platform": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider_family_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "requested_runtime_identity": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "effective_runtime_identity": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "host_ref": {
          "$ref": "#/$defs/nullable_non_secret_ref"
        },
        "transport_host_ref": {
          "$ref": "#/$defs/nullable_non_secret_ref"
        },
        "upstream_provider_ref": {
          "$ref": "#/$defs/nullable_non_secret_ref"
        },
        "repo_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "worktree_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        }
      }
    },
    "resolved_permissions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requested_permission_state",
          "effective_permission_state",
          "downgrade_reason",
          "resolution",
          "source",
          "effective_value"
        ],
        "properties": {
          "requested_permission_state": {
            "enum": [
              "allow",
              "deny",
              "ask",
              "unset"
            ]
          },
          "effective_permission_state": {
            "enum": [
              "allow",
              "deny",
              "ask"
            ]
          },
          "downgrade_reason": {
            "$ref": "#/$defs/nullable_non_empty_string"
          },
          "resolution": {
            "enum": [
              "allow",
              "deny",
              "ask"
            ]
          },
          "source": {
            "enum": [
              "preset",
              "project",
              "user_override",
              "session"
            ]
          },
          "effective_value": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "resolution": {
                  "const": "allow"
                }
              },
              "required": [
                "resolution"
              ]
            },
            "then": {
              "properties": {
                "effective_permission_state": {
                  "const": "allow"
                },
                "effective_value": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "resolution": {
                  "enum": [
                    "deny",
                    "ask"
                  ]
                }
              },
              "required": [
                "resolution"
              ]
            },
            "then": {
              "properties": {
                "effective_value": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "source_event_ref": {
      "$ref": "#/$defs/non_secret_ref"
    },
    "redaction_profile": {
      "$ref": "#/$defs/non_empty_string"
    },
    "integrity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "integrity_ref": {
      "$ref": "#/$defs/non_secret_ref"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_secret_ref": {
      "description": "Stable non-secret reference. Raw credentials, tokens, auth values, credential paths, file contents, and provider-visible bytes are forbidden.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$"
    },
    "nullable_non_empty_string": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_empty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_non_secret_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_secret_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
