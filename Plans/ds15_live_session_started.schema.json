      "minLength": 1,
      "maxLength": 256
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "live_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
