        "desktop",
        "ios",
        "android"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pid": {
