              "anyOf": [
                {
                  "const": "pm.restore_point.immutable_capture_sha256.v1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "owner_verification_id": {
              "type": "string",
              "minLength": 1
            },
            "verified_capture_relation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_store_generation_id": {
              "type": "string",
              "minLength": 1
            },
            "source_admission_receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "verified_native_immutable_capture"
                  }
                }
              },
              "then": {
                "properties": {
                  "native_recipe_id": {
                    "const": "pm.restore_point.immutable_capture_sha256.v1"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "verified_supported_historical"
                  }
                }
              },
              "then": {
                "properties": {
                  "native_recipe_id": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "creation_event": {
