            ],
            "properties": {
              "ref_kind": {
                "enum": [
                  "descendant_branch",
                  "application",
                  "preserve",
                  "legal_hold",
                  "in_flight_application",
                  "source_lineage",
                  "live_ref",
                  "backup",
                  "rollback",
                  "recovery_anchor",
                  "maintenance"
                ]
              },
