        "terminal_event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "event_type",
            "payload_schema_id",
            "payload_sha256",
            "producer_semantic_sha256",
            "original_record_hash",
            "original_frame_sha256",
            "original_sequence_id",
            "original_manifest_generation",
            "original_recovery_epoch",
            "original_segment_generation",
            "original_segment_name",
            "original_byte_offset",
            "original_durable_end_offset"
          ],
          "properties": {
            "event_id": {
              "type": "string",
              "minLength": 1
            },
            "event_type": {
              "enum": [
                "restore_point.expired",
                "restore_point.deleted",
                "restore_point.corrupt"
              ]
            },
            "payload_schema_id": {
              "type": "string",
              "minLength": 1
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "producer_semantic_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "original_record_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "original_frame_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "original_sequence_id": {
              "type": "integer",
              "minimum": 0
            },
            "original_manifest_generation": {
              "type": "integer",
              "minimum": 0
            },
            "original_recovery_epoch": {
              "type": "integer",
              "minimum": 0
