        "retention_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "policy_version",
            "expiry_action"
          ],
          "properties": {
            "policy_id": {
              "const": "RP-RESTOREPOINT-90D-AFTER-RELEASE"
            },
            "policy_version": {
              "const": "1.0.0"
            },
            "expiry_action": {
              "const": "retain_hash_summary"
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection_kind",
            "reference_release",
            "evaluated_at_utc",
            "logical_point_count_before",
            "eligible_point_set_sha256",
            "selected_oldest_eligible_rank"
          ],
          "properties": {
            "selection_kind": {
              "enum": [
                "reference_release_ttl",
                "oldest_eligible_count_pressure"
              ]
            },
            "reference_release": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "closure_kind",
                "owner_authority_id",
                "release_id",
                "released_at_utc",
                "closed_ref_set_sha256",
                "release_fact_sha256"
              ],
              "properties": {
                "closure_kind": {
                  "const": "owner_verified_reference_release"
                },
                "owner_authority_id": {
                  "type": "string",
                  "minLength": 1
                },
                "release_id": {
                  "type": "string",
                  "minLength": 1
                },
                "released_at_utc": {
                  "type": "string",
                  "format": "date-time",
                  "minLength": 1
                },
                "closed_ref_set_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "release_fact_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "evaluated_at_utc": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "logical_point_count_before": {
              "type": "integer",
              "minimum": 0
            },
            "eligible_point_set_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selected_oldest_eligible_rank": {
              "anyOf": [
                {
                  "const": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "selection_kind": {
                    "const": "oldest_eligible_count_pressure"
                  }
                }
              },
              "then": {
                "properties": {
                  "logical_point_count_before": {
                    "type": "integer",
                    "minimum": 2049
                  },
                  "selected_oldest_eligible_rank": {
                    "const": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "selection_kind": {
                    "const": "reference_release_ttl"
                  }
                }
              },
              "then": {
                "properties": {
                  "selected_oldest_eligible_rank": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "hold_evaluations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_kind",
              "owner_authority_id",
              "evaluated_revision_sha256",
              "enumeration_complete",
              "active_blocker_count",
              "released_ref_count",
              "released_ref_set_sha256",
              "release_fact_set_sha256",
