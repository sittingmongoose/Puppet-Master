          "pattern": "^[0-9a-f]{64}$"
        },
        "retired_custody": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family_id",
              "canonical_key",
              "value_schema_id",
              "value_schema_version",
              "canonical_encoding",
              "value_bytes_sha256",
              "disposition"
            ],
            "properties": {
              "family_id": {
                "enum": [
                  "restore_point_record",
                  "restore_point_creation_commit",
                  "restore_point_deletion_commit"
                ]
              },
              "canonical_key": {
                "type": "string",
                "minLength": 1
              },
              "value_schema_id": {
                "type": "string",
                "minLength": 1
              },
              "value_schema_version": {
                "type": "string",
                "minLength": 1
              },
              "canonical_encoding": {
                "type": "string",
                "minLength": 1
              },
              "value_bytes_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "disposition": {
                "const": "removed_in_summary_transaction"
              }
            }
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "retirement_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "retirement_actor_ref": {
          "type": "string",
          "minLength": 1
        },
        "owner_gate_revision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "summary_committed_at_utc": {
          "type": "string",
          "format": "date-time",
          "minLength": 1
        },
        "source_manifest_generation_at_commit": {
          "type": "integer",
          "minimum": 0
        },
        "source_recovery_epoch_at_commit": {
          "type": "integer",
          "minimum": 0
        },
        "redaction_profile": {
          "const": "no_secrets"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal_status": {
                "const": "expired"
              }
            }
          },
          "then": {
            "properties": {
              "terminal_event": {
                "properties": {
                  "event_type": {
                    "const": "restore_point.expired"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "terminal_status": {
                "const": "deleted"
              }
            }
          },
          "then": {
            "properties": {
              "terminal_event": {
                "properties": {
                  "event_type": {
                    "const": "restore_point.deleted"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "terminal_status": {
                "const": "corrupt"
              }
            }
          },
          "then": {
            "properties": {
              "terminal_event": {
                "properties": {
                  "event_type": {
                    "const": "restore_point.corrupt"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
