              "enumeration_complete": {
                "const": true
              },
              "active_blocker_count": {
                "const": 0
              },
              "released_ref_count": {
                "type": "integer",
                "minimum": 0
              },
              "released_ref_set_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "release_fact_set_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evaluated_at_utc": {
                "type": "string",
                "format": "date-time",
                "minLength": 1
              }
            }
          },
          "minItems": 11,
          "maxItems": 11
        },
        "creation_companion_required": {
          "type": "boolean"
        },
        "deletion_companion_required": {
          "type": "boolean"
