      "oneOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/CertifiedMetadata"
        },
        {
          "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/StartedMetadata"
        },
        {
          "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/CancelledMetadata"
        }
      ]
    },
    "Event": {
      "oneOf": [
        {
          "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/CertifiedEvent"
        },
        {
          "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/StartedEvent"
        },
        {
          "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/CancelledEvent"
        }
      ]
    },
    "PayloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blake3",
        "byte_size",
        "media_type"
      ],
      "properties": {
        "blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "const": "application/msgpack"
        }
      }
    },
    "EventIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "scope",
        "event_id",
        "event_type",
        "sequence_id",
        "idempotency_key"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "scope": {
          "$ref": "https://puppetmaster.local/proposals/goal_run_started_cancelled_certified_consumer.v1.schema.json#/$defs/ScopeRequest/properties/scope"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "enum": [
            "goal_run.started",
            "goal_run.cancelled",
            "goal_run.certified"
          ]
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "record"
          ],
          "properties": {
            "kind": {
              "const": "inline"
            },
            "record": {
              "$ref": "https://puppetmaster.local/proposals/goal_run_started_cancelled_certified_consumer.v1.schema.json#/$defs/Projection"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "metadata",
            "event_ref"
          ],
          "properties": {
            "kind": {
              "const": "event_reference"
            },
            "metadata": {
              "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/Metadata"
            },
            "event_ref": {
              "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/PayloadRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "metadata_ref",
            "event_ref"
          ],
          "properties": {
            "kind": {
              "const": "record_reference"
            },
            "metadata_ref": {
              "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/PayloadRef"
            },
            "event_ref": {
              "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/PayloadRef"
            }
          }
        }
      ]
    },
    "StorageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "physical_key",
        "dataset_name",
        "event_identity",
        "original_event_value_commitment",
        "content"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.goal_run_projection.started_cancelled_certified.reference.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "physical_key": {
          "type": "string",
          "minLength": 1
        },
        "dataset_name": {
          "type": "string",
          "minLength": 1
        },
        "event_identity": {
          "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/EventIdentity"
        },
        "original_event_value_commitment": {
          "$ref": "https://puppetmaster.local/proposals/goal_run_started_cancelled_certified_consumer.v1.schema.json#/$defs/CertifiedProjection/properties/original_event_value_commitment"
        },
        "content": {
          "$ref": "https://puppetmaster.local/proposals/dg_int_certified_reference.v1.schema.json#/$defs/Content"
        }
      }
    },
    "Generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "state",
        "anchor_sha256",
        "seed_hex",
        "profile",
        "scope",
        "source_token_at_birth",
        "dataset_name",
        "frontier_revision",
        "prior_frontier_sha256",
        "frontier_sha256",
        "processed",
        "last_transaction_id",
        "activated_at_utc",
        "retired_at_utc",
        "first_prepared_at_utc",
        "successor_generation_id",
        "hold_refs",
        "profile_digest"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "pattern": "^grsccg_[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "staged",
            "current",
            "retired"
          ]
        },
        "anchor_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "const": "goal_run_started_cancelled_certified_projector.reference.v1"
        },
        "scope": {
          "$ref": "https://puppetmaster.local/proposals/goal_run_started_cancelled_certified_consumer.v1.schema.json#/$defs/Generation/properties/scope"
        },
        "source_token_at_birth": {
          "$ref": "https://puppetmaster.local/proposals/goal_run_started_cancelled_certified_consumer.v1.schema.json#/$defs/Generation/properties/source_token_at_birth"
        },
        "dataset_name": {
          "type": "string",
          "minLength": 1
        },
        "frontier_revision": {
          "type": "integer",
          "minimum": 0
        },
        "prior_frontier_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "frontier_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "processed": {
          "$ref": "https://puppetmaster.local/proposals/goal_run_started_cancelled_certified_consumer.v1.schema.json#/$defs/Generation/properties/processed"
        },
        "last_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "activated_at_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retired_at_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_prepared_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "successor_generation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^grsccg_[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hold_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
