          "minLength": 1,
          "maxLength": 256
        },
        "return_context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "ComputerUseStopResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "status",
        "released_controller_ref",
        "stop_evidence",
        "return_context_ref"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "stopped",
            "already_stopped",
            "refused"
          ]
        },
        "released_controller_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_evidence": {
          "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/OwnerEvidenceRefV1"
        },
        "return_context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
