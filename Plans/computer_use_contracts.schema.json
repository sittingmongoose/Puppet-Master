    "ComputerUseSessionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "scope",
        "thread_id",
        "execution_host_id",
        "desktop_session_ref",
        "allowed_app_ids",
        "tool_namespace_receipt",
        "controller_lease_ref",
        "controller_generation",
        "task_authority",
        "screen_provider_disclosure_ref",
        "permission_evidence",
        "stopped"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope": {
          "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/WorkflowScopeV2"
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "execution_host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "desktop_session_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "allowed_app_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "tool_namespace_receipt": {
          "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/OwnerEvidenceRefV1"
        },
        "controller_lease_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "controller_generation": {
          "type": "integer",
          "minimum": 0
        },
        "task_authority": {
          "$ref": "https://puppetmaster.local/schemas/automation_authority_contracts/1.0.0/automation_authority_contracts.schema.json#/$defs/authority_evidence"
        },
        "screen_provider_disclosure_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permission_evidence": {
          "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/OwnerEvidenceRefV1"
        },
        "stopped": {
          "type": "boolean"
        }
      }
    },
    "ComputerUseActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "action_id",
        "app_id",
        "target_ref",
        "target_sha256",
        "controller_generation",
        "idempotency_key"
      ],
      "properties": {
        "session": {
          "$ref": "https://puppetmaster.local/schemas/computer_use_contracts/1.0.0/computer_use_contracts.schema.json#/$defs/ComputerUseSessionContext"
