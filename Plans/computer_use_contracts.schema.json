        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controller_generation": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "ComputerUseActionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "action_id",
        "status",
        "transient_scrubbed_frame_ref",
        "bounded_audit_ref",
        "reason",
        "raw_frame_retained"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "done",
            "refused",
            "stopped",
            "unsupported"
          ]
        },
        "transient_scrubbed_frame_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "bounded_audit_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "enum": [
            null,
            "protected_auth",
            "secret_prompt",
            "wrong_app",
            "wrong_host",
            "stale_controller",
            "namespace_unavailable",
            "disclosure_missing"
          ]
        },
        "raw_frame_retained": {
          "const": false
        }
      }
    },
    "ComputerUseStopRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "session_id",
        "execution_host_id",
        "controller_generation",
        "idempotency_key",
        "return_context_ref"
      ],
      "properties": {
        "command_id": {
          "const": "cmd.computer_use.stop"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "execution_host_id": {
          "type": "string",
