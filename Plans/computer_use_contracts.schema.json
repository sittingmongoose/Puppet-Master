        "status": {
          "enum": [
            "succeeded",
            "refused",
            "unavailable",
            "cancelled",
            "failed",
            "unknown_effect"
          ]
        },
        "effect_state": {
          "enum": [
            "not_started",
            "performed",
            "unknown"
          ]
        },
        "original_operation_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "original_result_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_result_evidence": {
          "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/OwnerEvidenceRefV1"
        },
        "transient_scrubbed_frame_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_frame_retained": {
          "const": false
        },
        "protected_surface_captured": {
          "const": false
        },
        "return_context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "enum": [
            null,
            "protected_auth",
            "secret_prompt",
            "wrong_app",
            "wrong_host",
            "stale_controller",
            "namespace_unavailable",
            "disclosure_missing",
            "stopped",
            "handler_unavailable",
            "unknown_effect",
            "native_failed"
          ]
        },
        "frame_expires_at_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "effect_state": {
                "const": "performed"
              },
              "original_operation_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "original_result_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reason": {
                "const": null
              },
              "transient_scrubbed_frame_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "frame_expires_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "refused",
                  "unavailable",
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "effect_state": {
                "const": "not_started"
              },
              "transient_scrubbed_frame_ref": {
                "type": "null"
              },
              "reason": {
                "type": "string"
              },
              "frame_expires_at_utc": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown_effect"
              }
            }
          },
          "then": {
            "properties": {
              "effect_state": {
                "const": "unknown"
              },
              "original_operation_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reason": {
                "const": "unknown_effect"
              },
              "transient_scrubbed_frame_ref": {
                "type": "null"
              },
              "frame_expires_at_utc": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
