{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.runtime_artifact.implementation_plan.schema.v1",
  "title": "Runtime Artifact implementation_plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "artifact_id",
    "artifact_type",
    "project_id",
    "run_id",
    "attempt_id",
    "created_at_utc",
    "projection_freshness",
    "projection_health",
    "retention_class",
    "routing_refs",
    "type_payload"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.runtime_artifact.implementation_plan.schema.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "const": "implementation_plan"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "provider_attempt_ref": {
      "type": "string"
    },
    "usage_event_ref": {
      "type": "string"
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer_ref": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "detail_ref": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "source_surface": {
      "type": "string"
    },
    "projection_freshness": {
      "type": "string"
    },
    "projection_health": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "routing_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_ref"
      ],
      "properties": {
        "plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "description",
              "status",
              "depends_on"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed",
                  "blocked",
                  "cancelled"
                ]
              },
              "depends_on": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "implementation_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "validation_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "validation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_plan_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contains_raw_secrets": {
          "const": false
        }
      }
    }
  }
}
