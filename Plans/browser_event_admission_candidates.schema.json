{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.browser_event_admission_candidates.schema.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "base_commit",
    "event_set_sha256",
    "scope",
    "status",
    "global_event_authority_closed",
    "runtime_enabled",
    "rows"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.browser_event_admission_candidates.v1"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "event_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "requires_row_local_admission_evidence"
    },
    "global_event_authority_closed": {
      "const": false
    },
    "runtime_enabled": {
      "const": false
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "payload_schema_id",
          "payload_schema_pointer",
          "semantic_owner_ref",
          "payload_owner_ref",
          "producer_role",
          "consumer_roles",
          "semantic_checks",
          "source_ref",
          "source_section",
          "runtime_producer_conformance",
          "registration_disposition",
          "retention_policy_proposal"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "payload_schema_id": {
            "type": "string",
            "minLength": 1
          },
          "payload_schema_pointer": {
            "type": "string",
            "minLength": 1
          },
          "semantic_owner_ref": {
            "type": "string",
            "minLength": 1
          },
          "payload_owner_ref": {
            "type": "string",
            "minLength": 1
          },
          "producer_role": {
            "type": "string",
            "minLength": 1
          },
          "consumer_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "semantic_checks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "action_sets_disjoint",
                "completion_has_no_unknown_effects",
                "delta_base_distinct",
                "destination_host_matches",
                "holder_changes",
                "host_changes",
                "lease_epoch_advances",
                "page_generation_advances",
                "strategy_changes",
                "unknown_effects_fail_closed",
                "workspace_revision_advances"
              ]
            }
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_section": {
            "type": "string",
            "minLength": 1
          },
          "runtime_producer_conformance": {
            "const": "not_run"
          },
          "registration_disposition": {
            "const": "proposed_requires_admission"
          },
          "retention_policy_proposal": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
