{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event_record/3.0.0/event_record.schema.json",
  "title": "Puppet Master EventRecord 3.0.0 inline/reference successor",
  "description": "Governed DL-270 successor. 1.0.0 and 2.0.0 readers keep their exact schemas. CV-332 and SP-273 explicitly adopt this representation; payload meaning and registry membership are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "scope_kind",
    "event_id",
    "event_type",
    "project_id",
    "thread_id",
    "run_id",
    "node_id",
    "attempt_id",
    "actor_ref",
    "requested_account_ref",
    "effective_account_ref",
    "occurred_at_utc",
    "observed_at_utc",
    "persisted_at_utc",
    "sequence_id",
    "producer_sequence_id",
    "correlation_id",
    "causation_event_id",
    "parent_event_id",
    "idempotency_key",
    "payload_schema_id",
    "payload",
    "payload_ref",
    "redaction_profile",
    "replay_policy",
    "migration"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.event.v0"
    },
    "schema_version": {
      "type": "string",
      "const": "3.0.0"
    },
    "scope_kind": {
      "type": "string",
      "enum": [
        "application",
        "project"
      ]
    },
    "event_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "project_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "thread_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "run_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "node_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "attempt_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "actor_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "requested_account_ref": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "effective_account_ref": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "occurred_at_utc": {
      "$ref": "#/$defs/date_time_string"
    },
    "observed_at_utc": {
      "$ref": "#/$defs/date_time_string"
    },
    "persisted_at_utc": {
      "$ref": "#/$defs/date_time_string"
    },
    "sequence_id": {
      "type": "integer",
      "minimum": 0
    },
    "producer_sequence_id": {
      "$ref": "#/$defs/nullable_non_negative_integer"
    },
    "correlation_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "causation_event_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "parent_event_id": {
      "$ref": "#/$defs/nullable_non_empty_string"
    },
    "idempotency_key": {
      "$ref": "#/$defs/non_empty_string"
    },
    "payload_schema_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "payload_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/payload_store_ref"
        }
      ]
    },
    "redaction_profile": {
      "type": "string",
      "enum": [
        "no_secrets",
        "redacted",
        "secret_refs_only"
      ]
    },
    "replay_policy": {
      "type": "string",
      "enum": [
        "append_once",
        "dedupe_by_event_id",
        "dedupe_by_idempotency_key",
        "projector_replay_only"
      ]
    },
    "migration": {
      "$ref": "#/$defs/migration"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope_kind": {
            "const": "application"
          }
        },
        "required": [
          "scope_kind"
        ]
      },
      "then": {
        "properties": {
          "project_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope_kind": {
            "const": "project"
          }
        },
        "required": [
          "scope_kind"
        ]
      },
      "then": {
        "properties": {
          "project_id": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_non_empty_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/non_empty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_non_negative_integer": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "date_time_string": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrated_from_schema_id",
        "migrated_from_schema_version",
        "migration_id",
        "compatibility_event_type"
      ],
      "properties": {
        "migrated_from_schema_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "migrated_from_schema_version": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "migration_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "compatibility_event_type": {
          "$ref": "#/$defs/nullable_non_empty_string"
        }
      }
    },
    "event_record_1_0_0_compatibility_reader": {
      "description": "Frozen compatibility reader shape for persisted pm.event.v0 version 1.0.0 values. New writers must not emit this shape.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "event_id",
        "event_type",
        "project_id",
        "thread_id",
        "run_id",
        "node_id",
        "attempt_id",
        "actor_ref",
        "requested_account_ref",
        "effective_account_ref",
        "occurred_at_utc",
        "observed_at_utc",
        "persisted_at_utc",
        "sequence_id",
        "producer_sequence_id",
        "correlation_id",
        "causation_event_id",
        "parent_event_id",
        "idempotency_key",
        "payload_schema_id",
        "payload",
        "payload_ref",
        "redaction_profile",
        "replay_policy",
        "migration"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "pm.event.v0"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "project_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "thread_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "run_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "node_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "attempt_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "actor_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "requested_account_ref": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "effective_account_ref": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "occurred_at_utc": {
          "$ref": "#/$defs/date_time_string"
        },
        "observed_at_utc": {
          "$ref": "#/$defs/date_time_string"
        },
        "persisted_at_utc": {
          "$ref": "#/$defs/date_time_string"
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "producer_sequence_id": {
          "$ref": "#/$defs/nullable_non_negative_integer"
        },
        "correlation_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "causation_event_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "parent_event_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "idempotency_key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "payload_schema_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "payload_ref": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "redaction_profile": {
          "type": "string",
          "enum": [
            "no_secrets",
            "redacted",
            "secret_refs_only"
          ]
        },
        "replay_policy": {
          "type": "string",
          "enum": [
            "append_once",
            "dedupe_by_event_id",
            "dedupe_by_idempotency_key",
            "projector_replay_only"
          ]
        },
        "migration": {
          "$ref": "#/$defs/migration"
        }
      }
    },
    "payload_store_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blake3_id",
        "byte_size",
        "media_type"
      ],
      "properties": {
        "blake3_id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 16385
        },
        "media_type": {
          "const": "application/msgpack"
        }
      }
    },
    "event_record_2_0_0_compatibility_reader": {
      "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json"
    }
  },
  "oneOf": [
    {
      "properties": {
        "payload": {
          "type": "object"
        },
        "payload_ref": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "payload": {
          "type": "null"
        },
        "payload_ref": {
          "$ref": "#/$defs/payload_store_ref"
        }
      }
    }
  ],
  "$comment": "Resolved body passes the registered payload schema and family invariants before use. Size is exact canonical MessagePack body bytes, inclusive 16384 inline. BLAKE3 is over uncompressed canonical body bytes. Reference custody and pack-before-ack durability: SP-337. No inline base64 body."
}
