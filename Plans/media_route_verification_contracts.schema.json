{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/media_route_verification/1.0.0/media_route_verification_contracts.schema.json",
  "title": "Generated media route verification and input settlement contracts",
  "$defs": {
    "NonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "ProbeableOutputMode": {
      "enum": ["image", "video", "audio"]
    },
    "MediaRouteVerifyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "media_output_mode", "expected_capability_snapshot_ref", "idempotency_key"],
      "properties": {
        "route_id": {"$ref": "#/$defs/NonemptyString"},
        "media_output_mode": {"$ref": "#/$defs/ProbeableOutputMode"},
        "expected_capability_snapshot_ref": {"$ref": "#/$defs/NonemptyString"},
        "idempotency_key": {"$ref": "#/$defs/NonemptyString"}
      }
    },
    "MediaRouteVerifyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "media_output_mode", "result", "probe_result_refs"],
      "properties": {
        "route_id": {"$ref": "#/$defs/NonemptyString"},
        "media_output_mode": {"$ref": "#/$defs/ProbeableOutputMode"},
        "result": {"enum": ["passed", "failed", "inconclusive"]},
        "probe_result_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/NonemptyString"},
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "if": {
        "properties": {"media_output_mode": {"enum": ["image", "video"]}}
      },
      "then": {
        "properties": {"probe_result_refs": {"maxItems": 1}}
      }
    },
    "NullableRef": {
      "anyOf": [{"$ref": "#/$defs/NonemptyString"}, {"type": "null"}]
    },
    "InputArtifactRef": {
      "type": "string",
      "pattern": "^artifact://.+$"
    },
    "InputRejectionReason": {
      "enum": [
        "input_mode_unsupported", "mime_unsupported", "input_too_large", "artifact_missing",
        "redaction_blocked", "caption_permission_denied", "caption_low_confidence", "caption_failed"
      ]
    },
    "InputDeliveryEvidence": {
      "type": "object",
      "description": "Evidence for the exact request, selected route and model, prepared payload and input represented by this entry.",
      "additionalProperties": false,
      "required": ["kind", "record_ref"],
      "properties": {
        "kind": {"enum": ["model_received", "no_model_delivery"]},
        "record_ref": {"$ref": "#/$defs/NonemptyString"}
      }
    },
    "MultimodalInputDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_ref", "source_surface", "media_type", "mime", "byte_size", "redaction_state",
        "redacted_input_ref", "model_modality_support", "reason_code", "caption_artifact_ref",
        "caption_confidence", "payload_mode", "disposition", "delivery_evidence"
      ],
      "properties": {
        "input_ref": {"$ref": "#/$defs/InputArtifactRef"},
        "source_surface": {"enum": ["file_attachment", "clipboard_paste", "screenshot_capture", "existing_artifact"]},
        "media_type": {"enum": ["image", "mask", "reference_image", "audio", "video", "other", null]},
        "mime": {"type": ["string", "null"]},
        "byte_size": {"type": ["integer", "null"], "minimum": 0},
        "redaction_state": {"enum": ["not_required", "redacted", "withheld", null]},
        "redacted_input_ref": {"$ref": "#/$defs/NullableRef"},
        "model_modality_support": {"enum": ["supported", "unsupported", null]},
        "reason_code": {"anyOf": [{"$ref": "#/$defs/InputRejectionReason"}, {"type": "null"}]},
        "caption_artifact_ref": {"$ref": "#/$defs/NullableRef"},
        "caption_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "payload_mode": {"enum": ["native", "caption", null]},
        "disposition": {"enum": ["native", "caption", "not_delivered", "delivery_unknown", "not_sent", "rejected", "not_evaluated"]},
        "delivery_evidence": {"anyOf": [{"$ref": "#/$defs/InputDeliveryEvidence"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "native"}}},
          "then": {"properties": {"payload_mode": {"const": "native"}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "caption"}}},
          "then": {"properties": {"payload_mode": {"const": "caption"}}}
        },
        {
          "if": {"properties": {"disposition": {"enum": ["native", "caption", "not_delivered"]}}},
          "then": {"properties": {"delivery_evidence": {"type": "object"}}},
          "else": {"properties": {"delivery_evidence": {"type": "null"}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "not_delivered"}}},
          "then": {"properties": {"delivery_evidence": {"properties": {"kind": {"const": "no_model_delivery"}}}}},
          "else": {"properties": {"delivery_evidence": {"properties": {"kind": {"const": "model_received"}}}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "rejected"}}},
          "then": {"properties": {
            "reason_code": {"$ref": "#/$defs/InputRejectionReason"},
            "caption_artifact_ref": {"type": "null"},
            "payload_mode": {"type": "null"}
          }},
          "else": {"properties": {"reason_code": {"type": "null"}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "not_evaluated"}}},
          "then": {"properties": {
            "media_type": {"type": "null"},
            "mime": {"type": "null"},
            "byte_size": {"type": "null"},
            "redaction_state": {"type": "null"},
            "redacted_input_ref": {"type": "null"},
            "model_modality_support": {"type": "null"},
            "caption_artifact_ref": {"type": "null"}
          }}
        },
        {
          "if": {"properties": {"payload_mode": {"enum": ["native", "caption"]}}},
          "then": {"properties": {"redaction_state": {"enum": ["not_required", "redacted"]}}}
        },
        {
          "if": {"properties": {"redaction_state": {"const": "redacted"}}},
          "then": {"properties": {"redacted_input_ref": {"$ref": "#/$defs/NonemptyString"}}},
          "else": {"properties": {"redacted_input_ref": {"type": "null"}}}
        },
        {
          "if": {"properties": {"payload_mode": {"const": "native"}}},
          "then": {"properties": {"model_modality_support": {"const": "supported"}}}
        },
        {
          "if": {"properties": {"payload_mode": {"const": "caption"}}},
          "then": {"properties": {"caption_artifact_ref": {"$ref": "#/$defs/NonemptyString"}}}
        },
        {
          "if": {"properties": {"caption_artifact_ref": {"type": "string"}}},
          "then": {"properties": {"caption_confidence": {"type": "number"}, "payload_mode": {"enum": ["caption", null]}}},
          "else": {"properties": {"caption_confidence": {"type": "null"}}}
        }
      ]
    },
    "MultimodalInputSettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settlement_id", "request_id", "requested_route_id", "selected_route_id", "input_artifact_refs",
        "accepted_input_modes", "rejected_input_refs", "rejection_reason_codes", "fallback_caption_route",
        "original_retained", "provider_payload_shape", "settlement_state", "input_dispositions",
        "provider_payload_ref", "created_at_utc", "schema_version"
      ],
      "properties": {
        "settlement_id": {"$ref": "#/$defs/NonemptyString"},
        "request_id": {"$ref": "#/$defs/NonemptyString"},
        "requested_route_id": {"$ref": "#/$defs/NullableRef"},
        "selected_route_id": {"$ref": "#/$defs/NullableRef"},
        "input_artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/InputArtifactRef"}},
        "accepted_input_modes": {"type": "array", "items": {"enum": ["text", "image", "mask", "reference_image", "audio", "video"]}},
        "rejected_input_refs": {"type": "array", "items": {"$ref": "#/$defs/InputArtifactRef"}},
        "rejection_reason_codes": {"type": "array", "items": {"$ref": "#/$defs/InputRejectionReason"}},
        "fallback_caption_policy_id": {"$ref": "#/$defs/NullableRef"},
        "fallback_caption_route": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["provider_id", "model_id"],
          "properties": {
            "provider_id": {"$ref": "#/$defs/NonemptyString"},
            "model_id": {"$ref": "#/$defs/NonemptyString"}
          }
        },
        "original_retained": {"type": "boolean"},
        "provider_payload_shape": {"enum": ["none", "native_media", "caption_text", "mixed"]},
        "settlement_state": {"enum": ["settled_native", "settled_with_captions", "settled_delivery_incomplete", "failed"]},
        "input_dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/MultimodalInputDisposition"}},
        "provider_payload_ref": {"$ref": "#/$defs/NullableRef"},
        "created_at_utc": {"type": "string", "format": "date-time"},
        "schema_version": {"const": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"provider_payload_shape": {"const": "none"}}},
          "then": {"properties": {
            "provider_payload_ref": {"type": "null"},
            "input_dispositions": {"items": {"properties": {"payload_mode": {"type": "null"}}}}
          }},
          "else": {"properties": {
            "provider_payload_ref": {"$ref": "#/$defs/NonemptyString"},
            "input_dispositions": {"items": {"properties": {"payload_mode": {"enum": ["native", "caption"]}}}}
          }}
        },
        {
          "if": {"properties": {"provider_payload_shape": {"const": "native_media"}}},
          "then": {"properties": {"input_dispositions": {"items": {"properties": {"payload_mode": {"const": "native"}}}}}}
        },
        {
          "if": {"properties": {"provider_payload_shape": {"const": "caption_text"}}},
          "then": {"properties": {"input_dispositions": {"items": {"properties": {"payload_mode": {"const": "caption"}}}}}}
        },
        {
          "if": {"properties": {"provider_payload_shape": {"const": "mixed"}}},
          "then": {"properties": {"input_dispositions": {"allOf": [
            {"contains": {"properties": {"payload_mode": {"const": "native"}}}},
            {"contains": {"properties": {"payload_mode": {"const": "caption"}}}}
          ]}}}
        },
        {
          "if": {"properties": {"settlement_state": {"const": "failed"}}},
          "then": {"properties": {
            "input_dispositions": {"items": {"properties": {"disposition": {"enum": ["not_sent", "rejected", "not_evaluated"]}}}}
          }},
          "else": {"properties": {
            "selected_route_id": {"$ref": "#/$defs/NonemptyString"},
            "provider_payload_shape": {"enum": ["native_media", "caption_text", "mixed"]},
            "rejected_input_refs": {"maxItems": 0},
            "rejection_reason_codes": {"maxItems": 0},
            "input_dispositions": {"items": {"properties": {"disposition": {"enum": ["native", "caption", "not_delivered", "delivery_unknown"]}}}}
          }}
        },
        {
          "if": {"properties": {"selected_route_id": {"type": "null"}}},
          "then": {"properties": {
            "provider_payload_shape": {"const": "none"},
            "accepted_input_modes": {"maxItems": 0},
            "rejected_input_refs": {"maxItems": 0},
            "rejection_reason_codes": {"maxItems": 0},
            "fallback_caption_route": {"type": "null"},
            "original_retained": {"const": true},
            "input_dispositions": {"items": {"properties": {"disposition": {"const": "not_evaluated"}}}}
          }},
          "else": {"properties": {
            "input_dispositions": {"items": {"properties": {"disposition": {"not": {"const": "not_evaluated"}}}}}
          }}
        },
        {
          "if": {"properties": {"settlement_state": {"const": "settled_native"}}},
          "then": {"properties": {"input_dispositions": {"items": {"properties": {"disposition": {"const": "native"}}}}}}
        },
        {
          "if": {"properties": {"settlement_state": {"const": "settled_with_captions"}}},
          "then": {"properties": {"input_dispositions": {
            "items": {"properties": {"disposition": {"enum": ["native", "caption"]}}},
            "contains": {"properties": {"disposition": {"const": "caption"}}}
          }}}
        },
        {
          "if": {"properties": {"settlement_state": {"const": "settled_delivery_incomplete"}}},
          "then": {"properties": {"input_dispositions": {
            "contains": {"properties": {"disposition": {"enum": ["not_delivered", "delivery_unknown"]}}}
          }}}
        }
      ]
    }
  }
}
