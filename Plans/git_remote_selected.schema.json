          ],
          "properties": {
            "state": {
              "enum": [
                "absent",
                "known",
                "unknown"
              ]
            },
            "object_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "known"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "object_id": {
                    "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
                  }
