    "fetch_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "preview_id",
        "original_request_ref",
        "command_id",
        "command_instance_id",
        "operation_id",
        "repository_context_ref",
        "expected_revision",
        "selection",
        "remote_operation_target_ref",
        "remote_refs",
        "evidence_refs",
        "issued_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.source_control.git_fetch_preview.v1"
