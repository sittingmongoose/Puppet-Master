{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/git-remote-selected/1.0.0/git_remote_selected.schema.json",
  "title": "Public Git remote adapter selected operands for exactly cmd.git.fetch and cmd.git.push; static value joins admit no native effect",
  "description": "Closed selected-operand/result/error companion for the two existing registered public Git remote commands. The Git adapter keeps its own command identity and its declared sole planned handlers::git::fetch / handlers::git::push, and it composes the existing Source Control owners: RemoteOperationTarget, ExternalEffectReconciliation, effective operation capability, writer/credential leases, native toolchain identity, operation receipt and the ordinary-Git publication preview/observation values under the existing target preview_ref. No second publication-preview owner, no inferred refspec or default force, no neutral source_control command-result widening, no aliasing to cmd.source_control.remote.fetch / remote.publish and no native availability change follow from this companion. Static shape and fixture equality authenticate no dispatcher, issuer, permission, lease, effect, receipt writer or physical custody.",
  "$defs": {
    "head_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "object_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "absent",
            "known",
            "unknown"
          ]
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "object_id": {
                "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
              }
            }
          },
          "else": {
            "properties": {
              "object_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "force_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "force_requested",
        "expected_head_ref",
        "lease_ref",
        "dangerous_action_policy_ref"
      ],
      "properties": {
        "force_requested": {
          "type": "boolean"
        },
        "expected_head_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "dangerous_action_policy_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "force_requested": {
                "const": false
              }
            },
            "required": [
              "force_requested"
            ]
          },
          "then": {
            "properties": {
              "expected_head_ref": {
                "type": "null"
              },
              "lease_ref": {
                "type": "null"
              },
              "dangerous_action_policy_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "lease_ref": {
                "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
              }
            }
          }
        }
      ]
    },
    "fetch_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "remote_id",
        "fetch_url",
        "refs",
        "remote_selection_generation",
        "transport",
        "host_identity"
      ],
      "properties": {
        "kind": {
          "const": "fetch"
        },
        "remote_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "fetch_url": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remote_selection_generation": {
          "type": "integer",
          "minimum": 0
        },
        "transport": {
          "enum": [
            "https",
            "ssh",
            "local"
          ]
        },
        "host_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "push_expected_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "ref_name",
        "expected_oid"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "ref_name": {
          "type": "string",
          "minLength": 1
        },
        "expected_oid": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "push_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "remote_target_ref",
        "reconciliation_ref",
        "target_selection_generation",
        "expected_remote_heads",
        "selected_force_target_id",
        "force_guard"
      ],
      "properties": {
        "kind": {
          "const": "push"
        },
        "remote_target_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "reconciliation_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "target_selection_generation": {
          "type": "integer",
          "minimum": 0
        },
        "expected_remote_heads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "ref_name",
              "expected_oid"
            ],
            "properties": {
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "ref_name": {
                "type": "string",
                "minLength": 1
              },
              "expected_oid": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "selected_force_target_id": {
          "description": "Explicit target_id of the sole selected force-guard carrier, or null when force is not requested. Never inferred from an opaque head or lease reference.",
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "force_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "force_requested",
            "expected_head_ref",
            "lease_ref",
            "dangerous_action_policy_ref"
          ],
          "properties": {
            "force_requested": {
              "type": "boolean"
            },
            "expected_head_ref": {
              "oneOf": [
                {
                  "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lease_ref": {
              "oneOf": [
                {
                  "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dangerous_action_policy_ref": {
              "oneOf": [
                {
                  "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "force_requested": {
                    "const": false
                  }
                },
                "required": [
                  "force_requested"
                ]
              },
              "then": {
                "properties": {
                  "expected_head_ref": {
                    "type": "null"
                  },
                  "lease_ref": {
                    "type": "null"
                  },
                  "dangerous_action_policy_ref": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "lease_ref": {
                    "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"force_guard": {"properties": {"force_requested": {"const": true}}, "required": ["force_requested"]}},
            "required": ["force_guard"]
          },
          "then": {"properties": {"selected_force_target_id": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"selected_force_target_id": {"type": "null"}}}
        }
      ]
    },
    "selection": {
      "oneOf": [
        {
          "$ref": "#/$defs/fetch_selection"
        },
        {
          "$ref": "#/$defs/push_selection"
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "command_id",
        "command_instance_id",
        "operation_id",
        "idempotency_key",
        "repository_context_ref",
        "expected_revision",
        "writer_lease_ref",
        "credential_lease_ref",
        "permission_snapshot_ref",
        "file_safe_decision_ref",
        "selection",
        "target_binding_ref",
        "return_context",
        "requested_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.source_control.git_remote_selected.request.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "command_id": {
          "enum": [
            "cmd.git.fetch",
            "cmd.git.push"
          ]
        },
        "command_instance_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_empty_string"
        },
        "operation_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "idempotency_key": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "repository_context_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "expected_revision": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/git_revision"
        },
        "writer_lease_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "credential_lease_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "permission_snapshot_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "file_safe_decision_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "oneOf": [
            {
              "$ref": "#/$defs/fetch_selection"
            },
            {
              "$ref": "#/$defs/push_selection"
            }
          ]
        },
        "target_binding_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "return_context": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/return_context"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command_id": {
                "const": "cmd.git.fetch"
              }
            },
            "required": [
              "command_id"
            ]
          },
          "then": {
            "properties": {
              "selection": {
                "$ref": "#/$defs/fetch_selection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_id": {
                "const": "cmd.git.push"
              }
            },
            "required": [
              "command_id"
            ]
          },
          "then": {
            "properties": {
              "selection": {
                "$ref": "#/$defs/push_selection"
              }
            }
          }
        }
      ]
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "binding_id",
        "command_id",
        "command_instance_id",
        "operation_id",
        "repository_context_ref",
        "expected_revision",
        "selection",
        "remote_operation_target_ref",
        "publication_reconciliation_ref",
        "capability_ref",
        "credential_lease_ref",
        "writer_lease_ref",
        "native_toolchain_ref",
        "preview_refs",
        "issued_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.source_control.git_remote_target_binding.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "enum": [
            "cmd.git.fetch",
            "cmd.git.push"
          ]
        },
        "command_instance_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_empty_string"
        },
        "operation_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "repository_context_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "expected_revision": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/git_revision"
        },
        "selection": {
          "oneOf": [
            {
              "$ref": "#/$defs/fetch_selection"
            },
            {
              "$ref": "#/$defs/push_selection"
            }
          ]
        },
        "remote_operation_target_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "publication_reconciliation_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "capability_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "credential_lease_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "writer_lease_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "native_toolchain_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "preview_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
          }
        },
        "issued_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command_id": {
                "const": "cmd.git.push"
              }
            },
            "required": [
              "command_id"
            ]
          },
          "then": {
            "properties": {
              "publication_reconciliation_ref": {
                "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
              },
              "preview_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_id": {
                "const": "cmd.git.fetch"
              }
            },
            "required": [
              "command_id"
            ]
          },
          "then": {
            "properties": {
              "publication_reconciliation_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "fetch_ref_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_name",
        "remote_head",
        "local_head",
        "already_local"
      ],
      "properties": {
        "ref_name": {
          "type": "string",
          "minLength": 1
        },
        "remote_head": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "object_id"
          ],
          "properties": {
            "state": {
              "enum": [
                "absent",
                "known",
                "unknown"
              ]
            },
            "object_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "known"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "object_id": {
                    "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
                  }
                }
              },
