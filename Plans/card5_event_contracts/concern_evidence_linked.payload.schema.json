      "pattern": "^pmref:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._/-]*$(?![\\s\\S])"
    },
    "action_ref": {
      "type": "string",
      "pattern": "^pmref:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._/-]*$(?![\\s\\S])"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.card5.concern_evidence_linked.payload.v2",
  "description": "Closed family-specific payload/decoded historical view. No event admission. Original historical bytes are never rewritten."
