    "capability_ensure_result_v2": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "result_type",
        "command_id",
        "operation_id",
        "command_instance_id",
        "outcome",
        "observable_work_id",
        "current_revision_or_epoch",
        "projection_ref",
        "receipt_refs",
        "artifact_refs",
        "disabled_reason",
        "error",
        "recovery_actions",
        "replayed",
        "original_operation_id",
        "terminal_owner_result_ref",
        "command_outcome_ref",
        "subject_ref",
        "request",
        "operation_record",
        "waiter_ref",
        "readiness_ref",
        "settlement_ref",
        "work_record"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.shared_runtime.capability_ensure_result.v2"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "result_type": {
          "const": "CapabilityEnsureResult"
        },
        "command_id": {
          "const": "cmd.capability.ensure"
        },
        "operation_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_empty_string"
        },
        "command_instance_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_empty_string"
        },
        "command_outcome_ref": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_secret_ref"
        },
        "outcome": {
          "enum": [
            "accepted",
            "succeeded",
            "no_change",
            "blocked",
            "failed",
            "cancelled",
            "recovery_required"
          ]
        },
        "observable_work_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "current_revision_or_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "projection_ref": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_secret_ref"
        },
        "receipt_refs": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/ref_list"
        },
        "artifact_refs": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/ref_list"
        },
        "disabled_reason": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/disabled_reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/command_error"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        },
        "replayed": {
          "type": "boolean"
        },
        "original_operation_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "terminal_owner_result_ref": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_secret_ref"
        },
        "subject_ref": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
        },
        "request": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/capability_bound_reference"
        },
        "operation_record": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/capability_bound_reference"
        },
        "waiter_ref": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
        },
        "readiness_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "settlement_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "work_record": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/capability_bound_reference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "replayed": {
                "const": true
              }
            },
            "required": [
              "replayed"
            ]
          },
          "then": {
            "properties": {
              "original_operation_id": {
                "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "blocked",
                  "failed",
                  "recovery_required"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "disabled_reason": {
                    "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/disabled_reason"
                  }
                }
              },
              {
                "properties": {
                  "error": {
                    "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/command_error"
                  }
                }
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
