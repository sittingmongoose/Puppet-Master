        "captured_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/timestamp"
        },
        "expires_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/timestamp"
        }
      }
    },
    "origin_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "demand",
        "waiter",
        "permission",
        "readiness",
        "currentness",
        "settlement"
      ],
      "properties": {
        "request": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/capability_bound_reference"
        },
