        "idempotency": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/command_idempotency"
        },
        "project_id": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_home_server_id": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_host_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_empty_string"
        },
        "execution_environment_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_empty_string"
        },
        "source_location_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "topology_generation": {
          "type": "integer",
          "minimum": 0
        },
        "actor_ref": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_secret_ref"
        },
        "permission_snapshot_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "goal_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "plan_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "run_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "thread_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "agent_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "crew_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "deadline_utc": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_timestamp"
        },
        "recovery_of_operation_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/nullable_non_empty_string"
        },
        "capability_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_empty_string"
        },
        "provisioning_mode": {
          "enum": [
            "Off",
            "Auto",
            "On"
          ]
        },
        "requirement_ref": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_secret_ref"
        },
        "origin_operation_id": {
          "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_empty_string"
        },
        "scope_kind": {
          "enum": [
            "application",
            "project"
          ]
        },
        "server_id": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
        },
        "named_plan_id": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "demand": {
          "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/capability_bound_reference"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope_kind": {
                "const": "application"
              }
            },
            "required": [
              "scope_kind"
            ]
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "null"
              },
              "project_home_server_id": {
                "type": "null"
              },
              "named_plan_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope_kind": {
                "const": "project"
              }
            },
            "required": [
              "scope_kind"
            ]
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "project_home_server_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope_kind": {
                "const": "application"
              }
            }
          },
          "then": {
            "properties": {
              "permission_snapshot_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
