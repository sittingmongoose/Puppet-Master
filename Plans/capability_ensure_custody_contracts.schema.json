        "currentness": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/capability_origin_currentness"
            },
            {
              "type": "null"
            }
          ]
        },
        "settlement": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/capability_provisioning_continuation_contracts.schema.json#/$defs/capability_continuation_settlement"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "capability_ensure_request_v2": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "command_id",
        "command_instance_id",
        "idempotency",
        "project_id",
        "project_home_server_id",
        "execution_host_id",
        "execution_environment_id",
        "source_location_id",
        "topology_generation",
        "actor_ref",
        "permission_snapshot_ref",
        "goal_id",
        "plan_id",
        "run_id",
        "thread_id",
        "agent_id",
        "crew_id",
        "deadline_utc",
        "recovery_of_operation_id",
        "capability_id",
        "provisioning_mode",
        "requirement_ref",
        "origin_operation_id",
        "scope_kind",
        "server_id",
        "named_plan_id",
        "demand"
      ],
      "properties": {
