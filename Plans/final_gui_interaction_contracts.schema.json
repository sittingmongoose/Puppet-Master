        "pointer_stationary_ms": {"const": 1100},
        "pointer_radius_px": {"const": 5},
        "focus_dwell_ms": {"const": 1000},
        "departure_grace_ms": {"const": 160},
        "standard_entrance_ms": {"const": 240},
        "retro_entrance_ms": {"const": 140},
        "retro_scales": {"const": false},
