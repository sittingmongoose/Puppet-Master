      "properties": {
        "contract_kind": {"const": "onboarding_motion"},
        "plan_unit_ref": {"const": "F3-520"},
        "setup_model": {"const": "reversible_staged_setup_plan"},
        "stage_count": {"const": 9},
        "stages": {
          "type": "array",
          "prefixItems": [
            {"const": "welcome"},
            {"const": "path"},
            {"const": "project"},
            {"const": "source"},
            {"const": "places"},
            {"const": "access"},
            {"const": "review"},
            {"const": "preparing"},
            {"const": "ready"}
          ],
          "items": false,
          "minItems": 9,
          "maxItems": 9
        },
        "journey_mode": {"const": "dynamic_path_with_reversible_visited_stages"},
        "connect_existing_stage_count": {"const": 6},
        "connect_existing_stages": {
          "type": "array",
          "prefixItems": [
            {"const": "welcome"},
            {"const": "path"},
            {"const": "access"},
            {"const": "review"},
            {"const": "preparing"},
            {"const": "ready"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "connect_existing_skips": {
          "type": "array",
          "prefixItems": [{"const": "project"}, {"const": "source"}, {"const": "places"}],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "reverse_back_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_label", "traversal", "available_before_apply", "preserves_queued_selections"],
          "properties": {
            "action_label": {"const": "Back"},
            "traversal": {"const": "previous_visited_stage"},
            "available_before_apply": {"const": true},
            "preserves_queued_selections": {"const": true}
          }
        },
        "navigation_before_apply": {"const": "back_and_forward_reversible"},
        "selection_effect": {"const": "queue_only_until_apply"},
        "first_choice_stage": {"const": "path"},
        "first_choice_options": {
          "type": "array",
          "prefixItems": [{"const": "start_new_setup"}, {"const": "connect_existing_puppet_master"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "independent_roles": {
          "type": "array",
          "prefixItems": [{"const": "Server"}, {"const": "Storage"}, {"const": "Client"}],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "roles_visible": {"const": true},
        "role_choice_stage": {"const": "places"},
        "theme_choice_stage": {"const": "welcome"},
        "theme_choice_timing": {"const": "early_before_project_and_infrastructure"},
        "theme_picker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["themes", "presentation", "bounded"],
          "properties": {
            "themes": {"$ref": "#/$defs/theme_order"},
            "presentation": {"const": "modal"},
            "bounded": {"const": true}
          }
        },
        "safe_history": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_history_required", "source_control_backends", "git_role", "jujutsu_role", "filesafe_role", "filesafe_is_source_control_backend", "forge_role", "forge_optional", "forge_does_not_replace_local_history"],
          "properties": {
            "local_history_required": {"const": true},
            "source_control_backends": {
              "type": "array",
              "prefixItems": [{"const": "Git"}, {"const": "Jujutsu"}],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "git_role": {"const": "local_source_control_backend"},
            "jujutsu_role": {"const": "local_source_control_backend"},
            "filesafe_role": {"const": "independent_local_recovery_history"},
            "filesafe_is_source_control_backend": {"const": false},
            "forge_role": {"const": "optional_remote_collaboration"},
            "forge_optional": {"const": true},
            "forge_does_not_replace_local_history": {"const": true}
          }
        },
        "remote_access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recommended_options", "remote_link_label", "remote_link_placement"],
          "properties": {
            "recommended_options": {
              "type": "array",
              "prefixItems": [{"const": "Tailscale_or_Headscale"}, {"const": "existing_VPN"}, {"const": "reverse_proxy"}],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "remote_link_label": {"const": "Remote Link"},
            "remote_link_placement": {"const": "more_options"}
          }
        },
        "review_apply": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_stage", "apply_progress_stage", "review_required", "back_available_before_apply", "apply_is_user_initiated", "apply_executes_queued_actions", "ready_requires_apply_settlement"],
          "properties": {
            "review_stage": {"const": "review"},
            "apply_progress_stage": {"const": "preparing"},
            "review_required": {"const": true},
            "back_available_before_apply": {"const": true},
            "apply_is_user_initiated": {"const": true},
            "apply_executes_queued_actions": {"const": true},
            "ready_requires_apply_settlement": {"const": true}
          }
        },
        "owner_action_identity": {"const": "canonical_owner_command_or_typed_local_ui_action"},
        "owner_projection_only": {"const": true},
        "private_owner_mutations": {"const": false},
        "synthetic_onboarding_commands": {"const": false},
        "max_prominent_choices": {"const": 2},
        "dominant_primary_actions": {"const": 1},
        "hero_ms": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"const": 1200}, "max": {"const": 1500}}},
        "step_transition_ms": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"const": 420}, "max": {"const": 560}}},
        "stagger_ms": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"const": 60}, "max": {"const": 80}}},
        "microinteraction_ms": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"const": 120}, "max": {"const": 220}}},
        "success_ms": {"const": 700},
        "interruptible": {"const": true},
        "input_blocking": {"const": false},
        "reduced_motion": {"const": "immediate_or_short_opacity"}
      }
    },
    "guided_tour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_kind", "plan_unit_ref", "application_surface", "first_surface", "scenes", "actions", "watch_contract", "options_label", "options_actions", "planning_contract", "chat_contract", "top_controls", "reduced_motion_owner", "tour_reduced_motion_toggle", "skip_restores", "finish_layout", "fabricated_success", "protected_auth_content"],
      "properties": {
        "contract_kind": {"const": "guided_tour"},
        "plan_unit_ref": {"const": "F3-521"},
        "application_surface": {"const": "mounted_real_application"},
        "first_surface": {"const": "Usage"},
        "scenes": {
          "type": "array",
          "prefixItems": [{"const": "usage"}, {"const": "planning_wizard"}, {"const": "chat_teacher"}],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "actions": {
          "type": "array",
          "prefixItems": [
            {"const": "ui.guided_tour.start"},
            {"const": "ui.guided_tour.next"},
            {"const": "ui.guided_tour.back"},
            {"const": "ui.guided_tour.pause"},
            {"const": "ui.guided_tour.resume"},
            {"const": "ui.guided_tour.skip"},
            {"const": "ui.guided_tour.focus_route"},
            {"const": "ui.guided_tour.toggle_eli5"},
            {"const": "ui.guided_tour.finish"},
            {"const": "ui.guided_tour.replay"}
          ],
          "items": false,
          "minItems": 10,
          "maxItems": 10
        },
        "watch_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "placement", "behavior"],
          "properties": {
            "label": {"const": "Watch"},
            "placement": {"const": "same_card"},
            "behavior": {"const": "hide_and_return_to_same_card"}
          }
        },
        "options_label": {"const": "Options"},
        "options_actions": {
          "type": "array",
          "prefixItems": [{"const": "Try"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "planning_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "progression"],
          "properties": {
            "surface": {"const": "mounted_real_planning_wizard"},
            "progression": {"const": "intent_progression"}
          }
        },
        "chat_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["placement", "progression"],
          "properties": {
            "placement": {"const": "far_right"},
            "progression": {
              "type": "array",
              "prefixItems": [
                {"const": "guide_selector"},
                {"const": "Teacher"},
                {"const": "real_composer_send"},
                {"const": "deterministic_local_reply"}
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        "top_controls": {
          "type": "array",
          "prefixItems": [{"const": "ELI5"}, {"const": "Pause"}, {"const": "Skip"}],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "reduced_motion_owner": {"const": "Settings"},
        "tour_reduced_motion_toggle": {"const": false},
        "skip_restores": {
          "type": "array",
          "prefixItems": [{"const": "pre_tour_layout"}, {"const": "pre_tour_placeholder"}, {"const": "pre_tour_focus"}],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "finish_layout": {"const": "Chat_far_right"},
        "fabricated_success": {"const": false},
        "protected_auth_content": {"const": false}
      }
    },
    "doctor_workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_kind", "plan_unit_ref", "host_geometry_ref", "cached_first", "lazy_details", "scoped_rechecks", "freshness_and_confidence", "requested_effective_split", "owner_routed_remediation", "private_mutations"],
      "properties": {
