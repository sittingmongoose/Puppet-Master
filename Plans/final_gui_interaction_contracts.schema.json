{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/final_gui_interaction_contracts.schema.json",
  "title": "Final GUI reconciled interaction presentation contracts",
  "description": "Strict static presentation contracts for K3 Settings/Doctor, Product Onboarding, Guided Tour, PMHoverTag, and evidence separation. Validation is not runtime or native Slint proof.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "contracts"],
  "properties": {
    "schema_id": {"const": "pm.final_gui_interaction_contracts.v1"},
    "schema_version": {"const": "1.0.0"},
    "contracts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/k3_geometry"},
          {"$ref": "#/$defs/onboarding_motion"},
          {"$ref": "#/$defs/guided_tour"},
          {"$ref": "#/$defs/doctor_workspace"},
          {"$ref": "#/$defs/hover_tag"},
          {"$ref": "#/$defs/evidence_boundary"},
          {"$ref": "#/$defs/provider_recovery_connector_presentation"},
          {"$ref": "#/$defs/source_control_forge_depth_presentation"}
        ]
      },
      "allOf": [
        {"contains": {"properties": {"contract_kind": {"const": "k3_geometry"}}, "required": ["contract_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"contract_kind": {"const": "onboarding_motion"}}, "required": ["contract_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"contract_kind": {"const": "guided_tour"}}, "required": ["contract_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"contract_kind": {"const": "doctor_workspace"}}, "required": ["contract_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"contract_kind": {"const": "hover_tag"}}, "required": ["contract_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"contract_kind": {"const": "evidence_boundary"}}, "required": ["contract_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"contract_kind": {"const": "provider_recovery_connector_presentation"}}, "required": ["contract_kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"contract_kind": {"const": "source_control_forge_depth_presentation"}}, "required": ["contract_kind"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "theme_order": {
      "type": "array",
      "prefixItems": [
        {"const": "Basic Dark"},
        {"const": "Basic Light"},
        {"const": "Friendly Dark"},
        {"const": "Friendly Light"},
        {"const": "Glass Dark"},
        {"const": "Glass Light"},
        {"const": "Retro Dark"},
        {"const": "Retro Light"}
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    },
    "k3_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_kind", "plan_unit_ref", "rail_px", "topbar_px", "page_index_px", "details_px", "body_max_px", "continuous_regions", "themes", "workspace_tabs", "responsive_widths_px", "owner_projection_only", "new_back_or_breadcrumb"],
      "properties": {
        "contract_kind": {"const": "k3_geometry"},
        "plan_unit_ref": {"const": "F3-519"},
        "rail_px": {"const": 250},
        "topbar_px": {"const": 62},
        "page_index_px": {"const": 168},
        "details_px": {"const": 350},
        "body_max_px": {"const": 1040},
        "continuous_regions": {
          "type": "array",
          "prefixItems": [{"const": "document"}, {"const": "index"}, {"const": "details"}, {"const": "manager"}],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "themes": {"$ref": "#/$defs/theme_order"},
        "workspace_tabs": {"const": true},
        "responsive_widths_px": {
          "type": "array",
          "prefixItems": [{"const": 1180}, {"const": 960}, {"const": 720}, {"const": 320}],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "owner_projection_only": {"const": true},
        "new_back_or_breadcrumb": {"const": false}
      }
    },
    "onboarding_motion": {
      "type": "object",
      "additionalProperties": false,
