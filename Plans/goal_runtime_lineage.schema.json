{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/goal_runtime_lineage/1.0.0/goal_runtime_lineage.schema.json",
  "title": "Puppet Master durable Goal runtime lineage",
  "description": "Pre-build durable Goal, Plan, thread, agent, owner-epoch, route, and server-continuation identity. It does not create WorkNodes or implement Goal execution.",
  "$ref": "#/$defs/goal_runtime_lineage_record",
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "nullable_non_empty_string": {
      "oneOf": [
        {"$ref": "#/$defs/non_empty_string"},
        {"type": "null"}
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "nullable_timestamp": {
      "oneOf": [
        {"$ref": "#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "non_secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$"
    },
    "nullable_non_secret_ref": {
      "oneOf": [
        {"$ref": "#/$defs/non_secret_ref"},
        {"type": "null"}
      ]
    },
    "thread_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "parent_thread_id", "branch_basis_ref", "thread_generation", "state"],
      "properties": {
        "thread_id": {"$ref": "#/$defs/non_empty_string"},
        "parent_thread_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "branch_basis_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
        "thread_generation": {"type": "integer", "minimum": 0},
        "state": {"enum": ["active", "background", "awaiting_user", "completed", "cancelled", "failed", "archived"]}
      }
    },
    "agent_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "parent_agent_id", "thread_id", "owner_epoch", "assignment_ref", "state"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/non_empty_string"},
        "parent_agent_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "thread_id": {"$ref": "#/$defs/non_empty_string"},
        "owner_epoch": {"type": "integer", "minimum": 0},
        "assignment_ref": {"$ref": "#/$defs/non_secret_ref"},
        "state": {"enum": ["assigned", "active", "awaiting", "completed", "cancelled", "failed", "orphaned_recovery_required"]}
      }
    },
    "goal_runtime_lineage_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "project_id",
        "goal_id",
        "root_goal_id",
        "parent_goal_id",
        "plan_id",
        "plan_version",
        "lineage_epoch",
        "owner_id",
        "owner_epoch",
        "requested_route_ref",
        "effective_route_ref",
        "route_binding_reason_ref",
        "project_home_server_id",
        "server_claim_epoch",
        "server_continuation_state",
        "continuation_checkpoint_ref",
        "primary_thread_id",
        "threads",
        "agents",
        "state",
        "currentness_ref",
        "created_at_utc",
        "updated_at_utc",
        "terminal_at_utc"
      ],
      "properties": {
        "schema_id": {"const": "pm.storage_value.goal_runtime_lineage_record.v1"},
        "schema_version": {"const": "1.0.0"},
        "project_id": {"$ref": "#/$defs/non_empty_string"},
        "goal_id": {"$ref": "#/$defs/non_empty_string"},
        "root_goal_id": {"$ref": "#/$defs/non_empty_string"},
        "parent_goal_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "plan_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "plan_version": {"type": ["integer", "null"], "minimum": 0},
        "lineage_epoch": {"type": "integer", "minimum": 0},
        "owner_id": {"$ref": "#/$defs/non_empty_string"},
        "owner_epoch": {"type": "integer", "minimum": 0},
        "requested_route_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
        "effective_route_ref": {"$ref": "#/$defs/non_secret_ref"},
        "route_binding_reason_ref": {"$ref": "#/$defs/non_secret_ref"},
        "project_home_server_id": {"$ref": "#/$defs/non_empty_string"},
        "server_claim_epoch": {"type": "integer", "minimum": 0},
        "server_continuation_state": {"enum": ["claimed", "continuing", "awaiting_reconnect", "reconciling", "completed", "failed_closed"]},
        "continuation_checkpoint_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
        "primary_thread_id": {"$ref": "#/$defs/non_empty_string"},
        "threads": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/thread_lineage"}},
        "agents": {"type": "array", "items": {"$ref": "#/$defs/agent_lineage"}},
        "state": {"enum": ["created", "active", "awaiting_user", "paused", "cancelling", "completed", "failed", "cancelled", "recovery_required"]},
        "currentness_ref": {"$ref": "#/$defs/non_secret_ref"},
        "created_at_utc": {"$ref": "#/$defs/timestamp"},
        "updated_at_utc": {"$ref": "#/$defs/timestamp"},
        "terminal_at_utc": {"$ref": "#/$defs/nullable_timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"enum": ["completed", "failed", "cancelled", "recovery_required"]}}, "required": ["state"]},
          "then": {"properties": {"terminal_at_utc": {"$ref": "#/$defs/timestamp"}}},
          "else": {"properties": {"terminal_at_utc": {"type": "null"}}}
        },
        {
          "if": {"properties": {"server_continuation_state": {"enum": ["continuing", "awaiting_reconnect", "reconciling"]}}, "required": ["server_continuation_state"]},
          "then": {"properties": {"continuation_checkpoint_ref": {"$ref": "#/$defs/non_secret_ref"}}}
        }
      ]
    },
    "goal_runtime_lineage_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "previous", "current"],
      "properties": {
        "schema_id": {"const": "pm.goal_runtime_lineage_transition.v1"},
        "schema_version": {"const": "1.0.0"},
        "previous": {"$ref": "#/$defs/goal_runtime_lineage_record"},
        "current": {"$ref": "#/$defs/goal_runtime_lineage_record"}
      }
    }
  }
}
