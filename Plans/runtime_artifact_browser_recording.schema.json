{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.runtime_artifact.browser_recording.schema.v1",
  "title": "Runtime Artifact browser_recording",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "artifact_id",
    "artifact_type",
    "project_id",
    "run_id",
    "attempt_id",
    "created_at_utc",
    "projection_freshness",
    "projection_health",
    "retention_class",
    "routing_refs",
    "type_payload"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.runtime_artifact.browser_recording.schema.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "const": "browser_recording"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "provider_attempt_ref": {
      "type": "string"
    },
    "usage_event_ref": {
      "type": "string"
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer_ref": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "detail_ref": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "source_surface": {
      "type": "string"
    },
    "projection_freshness": {
      "type": "string"
    },
    "projection_health": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "routing_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type_payload": {
      "$ref": "#/$defs/BrowserRecordingPayload"
    }
  },
  "$defs": {
    "InvocationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "invocation_source": {
                "enum": [
                  "agent_initiated",
                  "goal",
                  "prd",
                  "planning_wizard",
                  "subagent"
                ]
              }
            },
            "required": [
              "invocation_source"
            ]
          },
          "then": {
            "required": [
              "agent_reason"
            ]
          }
        }
      ],
      "required": [
        "invocation_source"
      ],
      "properties": {
        "invocation_source": {
          "type": "string",
          "enum": [
            "slash",
            "palette",
            "nl_user",
            "agent_initiated",
            "goal",
            "prd",
            "planning_wizard",
            "subagent"
          ]
        },
        "agent_reason": {
          "type": "string",
          "minLength": 1
        },
        "source_user_message_id": {
          "type": "string"
        },
        "source_goal_id": {
          "type": "string"
        },
        "source_subagent_id": {
          "type": "string"
        },
        "source_prd_id": {
          "type": "string"
        },
        "source_planning_run_id": {
          "type": "string"
        }
      }
    },
    "BrowserActionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type"
      ],
      "properties": {
        "action_type": {
          "type": "string",
          "enum": [
            "navigate",
            "back",
            "reload",
            "refresh",
            "observe",
            "find",
            "detail",
            "snapshot",
            "screenshot",
            "pdf",
            "console",
            "network",
            "open_tab",
            "select_tab",
            "close_tab",
            "click",
            "scroll",
            "type",
            "fill_form",
            "select_option",
            "hover",
            "drag",
            "press_key",
            "upload_file",
            "handle_dialog",
            "wait_for",
            "verify_text",
            "verify_element",
            "verify_value",
            "set_viewport"
          ]
        },
        "input_action_label": {
          "type": "string",
          "enum": [
            "navigate",
            "back",
            "reload",
            "refresh",
            "observe",
            "find",
            "detail",
            "snapshot",
            "screenshot",
            "PDF",
            "pdf",
            "console",
            "network",
            "open_tab",
            "select_tab",
            "close_tab",
            "click",
            "scroll",
            "type",
            "fill form",
            "fill_form",
            "select option",
            "select_option",
            "hover",
            "drag",
            "press key",
            "press_key",
            "file upload",
            "upload_file",
            "dialog handle",
            "handle_dialog",
            "wait",
            "wait_for",
            "verify visible text",
            "verify text",
            "verify_text",
            "verify element",
            "verify_element",
            "verify value",
            "verify_value",
            "set_viewport"
          ]
        },
        "url": {
          "type": "string"
        },
        "tab_id": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "locator_ref": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "form_values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "option_value": {
          "type": "string"
        },
        "file_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dialog_action": {
          "type": "string",
          "enum": [
            "accept",
            "dismiss"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "verification_expected": {
          "type": "string"
        },
        "verification_ref": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "BrowserActionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_session_id",
        "action",
        "invocation",
        "success",
        "created_at_utc",
        "redaction_status"
      ],
      "properties": {
        "browser_session_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/BrowserActionInput"
        },
        "invocation": {
          "$ref": "#/$defs/InvocationProvenance"
        },
        "success": {
          "type": "boolean"
        },
        "page_representation": {
          "$ref": "#/$defs/PageRepresentation"
        },
        "page_representation_ref": {
          "type": "string"
        },
        "screenshot_artifact_ref": {
          "type": "string"
        },
        "pdf_artifact_ref": {
          "type": "string"
        },
        "console_ref": {
          "type": "string"
        },
        "network_ref": {
          "type": "string"
        },
        "redaction_status": {
          "type": "string",
          "enum": [
            "not_needed",
            "applied",
            "blocked",
            "failed"
          ]
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error_code": {
          "type": "string"
        },
        "created_at_utc": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "PageRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "prompt_injection_detected": {
                "const": true
              }
            },
            "required": [
              "prompt_injection_detected"
            ]
          },
          "then": {
            "required": [
              "prompt_injection_chips",
              "visible_card_ref"
            ]
          }
        }
      ],
      "required": [
        "page_representation_id",
        "url",
        "detail_level",
        "observed_at_utc"
      ],
      "properties": {
        "page_representation_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "detail_level": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "full"
          ]
        },
        "observe_ref": {
          "type": "string"
        },
        "find_results_ref": {
          "type": "string"
        },
        "detail_ref": {
          "type": "string"
        },
        "accessibility_tree_ref": {
          "type": "string"
        },
        "layout_bounds_ref": {
          "type": "string"
        },
        "form_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "iframe_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "console_ref": {
          "type": "string"
        },
        "network_ref": {
          "type": "string"
        },
        "screenshot_artifact_ref": {
          "type": "string"
        },
        "pdf_artifact_ref": {
          "type": "string"
        },
        "prompt_injection_detected": {
          "type": "boolean"
        },
        "prompt_injection_chips": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "visible_card_ref": {
          "type": "string"
        },
        "observed_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "redaction_profile_id": {
          "type": "string"
        }
      }
    },
    "BrowserRecordingPayload": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "runtime_unavailable"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "runtime_state"
            ],
            "properties": {
              "runtime_state": {
                "properties": {
                  "runtime_state": {
                    "const": "runtime_unavailable"
                  }
                },
                "required": [
                  "runtime_state"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "open_watch_state": {
                "const": "fallback_open_external"
              }
            },
            "required": [
              "open_watch_state"
            ]
          },
          "then": {
            "required": [
              "fallback_route_ref"
            ]
          }
        }
      ],
      "required": [
        "browser_session_id",
        "invocation",
        "session_class",
        "session_security_class",
        "session_epoch",
        "state",
        "show_when_possible",
        "open_watch_state",
        "recording_ref",
        "runtime_state",
        "actions",
        "artifact_refs",
        "redaction_profile_id"
      ],
      "properties": {
        "browser_session_id": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "$ref": "#/$defs/InvocationProvenance"
        },
        "session_class": {
          "type": "string",
          "enum": [
            "site_reader",
            "research_session",
            "testing",
            "user_visible_browser"
          ]
        },
        "session_security_class": {
          "type": "string",
          "const": "ordinary"
        },
        "session_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "collapsed",
            "detached",
            "background",
            "closed",
            "runtime_unavailable"
          ]
        },
        "show_when_possible": {
          "type": "boolean"
        },
        "open_watch_state": {
          "type": "string",
          "enum": [
            "open_available",
            "watch_available",
            "fallback_open_external",
            "background_only",
            "unavailable"
          ]
        },
        "fallback_route_ref": {
          "type": "string"
        },
        "recording_ref": {
          "type": "string",
          "minLength": 1
        },
        "page_representation_ref": {
          "type": "string"
        },
        "runtime_state": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "runtime_state": {
                    "const": "runtime_unavailable"
                  }
                },
                "required": [
                  "runtime_state"
                ]
              },
              "then": {
                "required": [
                  "disabled_reason_code",
                  "remediation_action_ids"
                ]
              }
            }
          ],
          "required": [
            "runtime_state",
            "requested_runtime",
            "effective_runtime"
          ],
          "properties": {
            "runtime_state": {
              "type": "string",
              "enum": [
                "available",
                "degraded",
                "runtime_unavailable",
                "disabled_by_policy"
              ]
            },
            "requested_runtime": {
              "type": "string",
              "minLength": 1
            },
            "effective_runtime": {
              "type": "string",
              "minLength": 1
            },
            "disabled_reason_code": {
              "type": "string"
            },
            "remediation_action_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrowserActionResult"
          }
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redaction_profile_id": {
          "type": "string"
        }
      }
    }
  }
}
