      "given": "prepared; no original owner commit",
      "when": "recovery",
      "then": "preserve/fence until absence proved; no success or invented receipt"
    },
    {
      "name": "crash_committed",
      "given": "committed original owner bytes; append acknowledgement lost",
      "when": "recovery",
      "then": "resolve original exact SP-286 v2 identity/full value; never apply state twice"
    },
    {
      "name": "receipt_substitution",
      "given": "committed operation",
      "when": "different Storage instance or source identity/sequence/segment/offset/receipt",
      "then": "fence; no settled/publication"
    },
    {
      "name": "withdrawal",
      "given": "writer cutoff; one committed unsettled original",
      "when": "reader withdrawal requested",
      "then": "drain original before checkpoint withdrawn; subsequent writes/readers unavailable"
    },
    {
      "name": "checkpoint_cas",
      "given": "captured complete source frontier and exact prior checkpoint",
      "when": "concurrent checkpoint advance or source selection change",
      "then": "CAS fails; no rows/frontier committed; recapture source"
    },
    {
      "name": "checkpoint_rebuild",
      "given": "source retention/generation changed",
      "when": "History requested",
      "then": "stage and verify retained complete source, atomic publish; never resurrect removed refs"
    },
    {
      "name": "disclosure",
      "given": "valid source reference, revoked Project permission or deleted body",
      "when": "read including a returning-helper race",
      "then": "no body disclosure; refs grant no access"
    },
    {
      "name": "admission_absent",
      "given": "no family registry entry",
      "when": "any command or History projector",
      "then": "zero journal/body/event/checkpoint writes"
    },
    {
      "name": "coherent_restore",
      "given": "mixed backup generations or missing original operation/shared owner/first receipt",
      "when": "restore/retry",
      "then": "unavailable and mutation fenced; no reconstructed original"
    }
  ]
}
