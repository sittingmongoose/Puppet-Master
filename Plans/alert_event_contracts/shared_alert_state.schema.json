{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.storage_value.shared_alert_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "alert_id",
    "revision",
    "source_record_ref",
    "acknowledgement_state",
    "unread",
    "inbox_visible",
    "snooze_until"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.storage_value.shared_alert_state.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_record_ref": {
      "type": "string",
      "minLength": 1
    },
    "acknowledgement_state": {
      "enum": [
        "unacknowledged",
        "acknowledged",
        "snoozed",
        "dismissed"
      ]
    },
    "unread": {
      "type": "boolean"
    },
    "inbox_visible": {
      "type": "boolean"
    },
    "snooze_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
