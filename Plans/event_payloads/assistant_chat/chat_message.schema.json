{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.assistant_chat_event.chat_message.schema.v1",
  "$comment": "Static field-shape materialization only. This schema grants no registry admission, EventRecord append or dispatch authority, persistence binding, checkpoint advance, replay certification, or executable-depth credit.",
  "title": "chat.message payload",
  "description": "Closed, project-scoped chat message payload. Message content and attachments are durable references; transcripts, bodies, diffs, and credentials cannot be inlined.",
  "x-event-type": "chat.message",
  "x-family-id": "event-family-chat-message",
  "x-family-revision": "1.0.0-proposed",
  "x-scope-policy": "project_only",
  "x-retention-policy-proposal": "RP-AUTHORITY-INDEFINITE",
  "x-source-row-id": "ea-successor-row-2ce5ea6df00975c99634",
  "x-source-open-index": 21,
  "x-owner-evidence-lines": [274, 275, 1072, 1137, 1987],
  "x-event-append-authorized": false,
  "x-event-dispatch-authorized": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "thread_id",
    "message_id",
    "role",
    "content_ref",
    "actor_ref",
    "ts"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.assistant_chat_event.chat_message.schema.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "$ref": "#/$defs/stable_id"
    },
    "thread_id": {
      "$ref": "#/$defs/thread_id"
    },
    "message_id": {
      "$ref": "#/$defs/message_id"
    },
    "role": {
      "type": "string",
      "enum": ["user", "assistant", "system", "tool"]
    },
    "content_ref": {
      "$ref": "#/$defs/non_secret_ref"
    },
    "attachment_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_secret_ref"
      }
    },
    "actor_ref": {
      "$ref": "#/$defs/non_secret_ref"
    },
    "ts": {
      "$ref": "#/$defs/utc_timestamp"
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^thr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "message_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "non_secret_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 320,
      "pattern": "^pmref:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
