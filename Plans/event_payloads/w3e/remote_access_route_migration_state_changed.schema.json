                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "last_examined_cursor": {
          "$ref": "https://puppetmaster.local/schemas/event_record_index_checkpoint/1.0.0/schema.json#/$defs/coverage/properties/last_frame"
        },
        "filter_complete": {
          "const": true
        },
        "projection_generation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\u0000-\\u0020\\u007f]"
          }
        }
      }
    }
  }
}
