{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.event_payload.project_created.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stable_config_ref": {
      "type": "string",
      "pattern": "^ref:[A-Za-z0-9_.:-]+$(?![\\s\\S])",
      "maxLength": 256,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "creation_result_ref": {
      "type": "string",
      "pattern": "^ref:[A-Za-z0-9_.:-]+$(?![\\s\\S])",
      "maxLength": 256,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "operation_receipt_ref": {
      "type": "string",
      "pattern": "^ref:[A-Za-z0-9_.:-]+$(?![\\s\\S])",
      "maxLength": 256,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "completed_at_utc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "project_id",
    "project_revision",
    "stable_config_ref",
    "creation_result_ref",
    "operation_receipt_ref",
    "completed_at_utc"
  ]
}
