{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.goal_runtime_event.goal_completed.schema.v3",
  "$comment": "Prepared under CV-423/GRS-204/SP-430; not selected by the live registry. Old whole-v2 resource is unchanged. Native source custody is unbound. Identifier patterns are enforced by full-match in the named owner checker, including trailing-LF rejection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "thread_id",
    "goal_id",
    "continuation_id",
    "owning_run_id",
    "operation_id",
    "body_receipt_ref",
    "before_revision",
    "revision",
    "before_currentness_hash",
    "currentness_hash",
    "body_receipt_sha256",
    "user_stop_epoch",
    "next_attempt_ref",
    "state",
    "blocked_reason_ref",
    "completion_evidence_refs"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "thread_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "continuation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "owning_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "body_receipt_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "before_revision": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 2
    },
    "before_currentness_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "currentness_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_stop_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "next_attempt_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "const": "completed"
    },
    "blocked_reason_ref": {
      "type": "null"
    },
    "completion_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\r\\n]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  }
}
