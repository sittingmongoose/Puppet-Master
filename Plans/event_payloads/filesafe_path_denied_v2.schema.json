{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "pm.shared_integration_runtime.command_contracts.schema.v1#/$defs/WorkflowScopeV2"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "guard_type": {
      "enum": [
        "bash_guard",
        "file_guard",
        "security_filter"
      ]
    },
    "denial_code": {
      "type": "string",
      "minLength": 1
    },
    "path_preview": {
      "type": "string",
      "minLength": 1
    },
    "normalized_path": {
      "type": "string",
      "minLength": 1
    },
    "canonical_parent": {
      "type": "string",
      "minLength": 1
    },
    "path_kind": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "filesafe_scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "permission_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "worktree_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thread_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "computer_id": {
          "type": "string",
          "minLength": 1
        },
        "host_id": {
          "type": "string",
          "minLength": 1
        },
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "root_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "root_generation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "working_directory": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\).+"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "thread_id",
        "run_id",
        "computer_id",
        "host_id",
        "environment_id",
        "root_id",
        "root_generation",
        "working_directory"
      ]
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "scope",
    "ts",
    "guard_type",
    "denial_code",
    "path_preview",
    "path_kind",
    "operation",
    "project_id",
    "execution_context"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event_payloads/filesafe_path_denied/2.0.0",
  "title": "filesafe.path_denied prepared closed payload; not admission"
}
