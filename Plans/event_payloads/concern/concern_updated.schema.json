{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.concern_event.concern_updated.schema.v1",
  "$comment": "Static payload shape only. The owner/runtime must prove prior_revision current, concern_revision its successor, and changed_fields accurately names committed owner-record changes. This schema grants no append or dispatch authority.",
  "title": "concern.updated payload",
  "description": "Closed project-scoped payload for a typed non-lifecycle update to one durable concern record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "project_id", "concern_id", "concern_revision",
    "prior_revision", "concern_record_ref", "actor_ref", "currentness_basis_ref",
    "state", "update_kind", "changed_fields", "origin", "handler_target",
    "command_id", "correlation_id", "idempotency_key", "ts"
  ],
  "properties": {
    "schema_id": {"const": "pm.concern_event.concern_updated.schema.v1"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"$ref": "#/$defs/non_empty_id"},
    "concern_id": {"$ref": "#/$defs/non_empty_id"},
    "concern_revision": {"type": "integer", "minimum": 2},
    "prior_revision": {"type": "integer", "minimum": 1},
    "concern_record_ref": {"$ref": "#/$defs/non_secret_ref"},
    "actor_ref": {"$ref": "#/$defs/non_secret_ref"},
    "currentness_basis_ref": {"$ref": "#/$defs/non_secret_ref"},
    "source_refs": {"$ref": "#/$defs/ref_array"},
    "evidence_refs": {"$ref": "#/$defs/ref_array"},
    "state": {"$ref": "#/$defs/lifecycle_state"},
    "update_kind": {"enum": ["new_sighting", "classification", "scope", "lineage", "visibility", "attention", "blocking_effect"]},
    "changed_fields": {
      "type": "array",
      "items": {"enum": ["severity", "category", "scope_ref", "source_refs", "evidence_refs", "artifact_refs", "lineage_refs", "visibility_level", "attention_level", "chatworthy", "blocking_effect"]},
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true
    },
    "reason_code": {"$ref": "#/$defs/reason_code"},
    "origin": {"$ref": "#/$defs/origin"},
    "handler_target": {"const": "handlers::concern::update"},
    "command_id": {"const": "cmd.concern.update"},
    "correlation_id": {"$ref": "#/$defs/non_empty_id"},
    "idempotency_key": {"$ref": "#/$defs/non_empty_id"},
    "ts": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "non_empty_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "non_secret_ref": {"type": "string", "minLength": 8, "maxLength": 320, "pattern": "^pmref:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9_]*$"},
    "origin": {"enum": ["orchestrator", "concern_center", "dashboard", "api"]},
    "lifecycle_state": {"enum": ["active", "acknowledged", "resolved", "dismissed"]},
    "ref_array": {"type": "array", "items": {"$ref": "#/$defs/non_secret_ref"}, "maxItems": 64, "uniqueItems": true}
  }
}
