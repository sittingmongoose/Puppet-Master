{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.concern_event.concern_assigned.schema.v1",
  "$comment": "Static payload shape only. The owner/runtime must prove prior_revision is current, concern_revision is its successor, and assignment authority is independent of creator/resolver roles. This schema grants no append or dispatch authority.",
  "title": "concern.assigned payload",
  "description": "Closed project-scoped payload for assigning or reassigning a durable concern without changing its identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "project_id", "concern_id", "concern_revision",
    "prior_revision", "concern_record_ref", "actor_ref", "currentness_basis_ref",
    "assignment_kind", "result_owner_kind", "result_owner_ref", "state",
    "origin", "handler_target", "command_id", "correlation_id", "idempotency_key", "ts"
  ],
  "properties": {
    "schema_id": {"const": "pm.concern_event.concern_assigned.schema.v1"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"$ref": "#/$defs/non_empty_id"},
    "concern_id": {"$ref": "#/$defs/non_empty_id"},
    "concern_revision": {"type": "integer", "minimum": 2},
    "prior_revision": {"type": "integer", "minimum": 1},
    "concern_record_ref": {"$ref": "#/$defs/non_secret_ref"},
    "actor_ref": {"$ref": "#/$defs/non_secret_ref"},
    "currentness_basis_ref": {"$ref": "#/$defs/non_secret_ref"},
    "assignment_kind": {"enum": ["initial_assignment", "reassignment"]},
    "prior_owner_kind": {"$ref": "#/$defs/owner_kind"},
    "prior_owner_ref": {"$ref": "#/$defs/non_secret_ref"},
    "result_owner_kind": {"$ref": "#/$defs/owner_kind"},
    "result_owner_ref": {"$ref": "#/$defs/non_secret_ref"},
    "source_refs": {"$ref": "#/$defs/ref_array"},
    "evidence_refs": {"$ref": "#/$defs/ref_array"},
    "state": {"$ref": "#/$defs/lifecycle_state"},
    "reason_code": {"$ref": "#/$defs/reason_code"},
    "origin": {"$ref": "#/$defs/origin"},
    "handler_target": {"const": "handlers::concern::assign"},
    "command_id": {"const": "cmd.concern.assign"},
    "correlation_id": {"$ref": "#/$defs/non_empty_id"},
    "idempotency_key": {"$ref": "#/$defs/non_empty_id"},
    "ts": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "non_empty_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "non_secret_ref": {"type": "string", "minLength": 8, "maxLength": 320, "pattern": "^pmref:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9_]*$"},
    "origin": {"enum": ["orchestrator", "concern_center", "dashboard", "api"]},
    "owner_kind": {"enum": ["Runtime", "Package Overseer", "Seam Overseer", "Corroboration", "Graph Patch", "Recovery", "User", "External Resource"]},
    "lifecycle_state": {"enum": ["active", "acknowledged", "resolved", "dismissed"]},
    "ref_array": {"type": "array", "items": {"$ref": "#/$defs/non_secret_ref"}, "maxItems": 64, "uniqueItems": true}
  }
}
