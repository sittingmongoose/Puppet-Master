{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.concern_event.concern_created.schema.v1",
  "$comment": "Static payload shape only. The owner/runtime must prove the source sighting is authoritative and actor_ref equals the authorized creator identity. This schema grants no append or dispatch authority.",
  "title": "concern.created payload",
  "description": "Closed project-scoped payload that creates one durable concern record at revision one from explicit source references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "project_id", "concern_id", "concern_revision",
    "concern_record_ref", "actor_ref", "created_by_ref", "currentness_basis_ref",
    "source_refs", "state", "category", "severity", "owner_kind", "owner_ref",
    "origin", "handler_target", "command_id", "correlation_id", "idempotency_key", "ts"
  ],
  "properties": {
    "schema_id": {"const": "pm.concern_event.concern_created.schema.v1"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"$ref": "#/$defs/non_empty_id"},
    "concern_id": {"$ref": "#/$defs/non_empty_id"},
    "concern_revision": {"const": 1},
    "concern_record_ref": {"$ref": "#/$defs/non_secret_ref"},
    "actor_ref": {"$ref": "#/$defs/non_secret_ref"},
    "created_by_ref": {"$ref": "#/$defs/non_secret_ref"},
    "currentness_basis_ref": {"$ref": "#/$defs/non_secret_ref"},
    "source_refs": {"$ref": "#/$defs/non_empty_ref_array"},
    "evidence_refs": {"$ref": "#/$defs/ref_array"},
    "state": {"const": "active"},
    "reason_code": {"$ref": "#/$defs/reason_code"},
    "category": {"$ref": "#/$defs/reason_code"},
    "severity": {"enum": ["info", "warning", "error", "critical"]},
    "owner_kind": {"$ref": "#/$defs/owner_kind"},
    "owner_ref": {"$ref": "#/$defs/non_secret_ref"},
    "scope_ref": {"$ref": "#/$defs/non_secret_ref"},
    "run_ref": {"$ref": "#/$defs/non_secret_ref"},
    "origin": {"$ref": "#/$defs/origin"},
    "handler_target": {"const": "handlers::concern::create"},
    "command_id": {"const": "cmd.concern.create"},
    "correlation_id": {"$ref": "#/$defs/non_empty_id"},
    "idempotency_key": {"$ref": "#/$defs/non_empty_id"},
    "ts": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "non_empty_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "non_secret_ref": {"type": "string", "minLength": 8, "maxLength": 320, "pattern": "^pmref:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9_]*$"},
    "origin": {"enum": ["orchestrator", "concern_center", "dashboard", "api"]},
    "owner_kind": {"enum": ["Runtime", "Package Overseer", "Seam Overseer", "Corroboration", "Graph Patch", "Recovery", "User", "External Resource"]},
    "ref_array": {"type": "array", "items": {"$ref": "#/$defs/non_secret_ref"}, "maxItems": 64, "uniqueItems": true},
    "non_empty_ref_array": {"type": "array", "items": {"$ref": "#/$defs/non_secret_ref"}, "minItems": 1, "maxItems": 64, "uniqueItems": true}
  }
}
