{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.event_payload.subagent_context_rehydrated.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "child_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "before_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "after_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ref:[A-Za-z0-9_.:-]+$(?![\\s\\S])",
        "maxLength": 256,
        "not": {
          "pattern": "[\\r\\n]"
        }
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "effective_context_ref": {
      "type": "string",
      "pattern": "^ref:[A-Za-z0-9_.:-]+$(?![\\s\\S])",
      "maxLength": 256,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "occurred_at_utc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "project_id",
    "agent_id",
    "run_id",
    "child_run_id",
    "before_revision",
    "after_revision",
    "source_refs",
    "effective_context_ref",
    "occurred_at_utc"
  ],
  "$comment": "Closed logical body, also validated after SP-337 payload_ref resolution. Inline canonical MessagePack body is at most 16384 bytes; array cardinality is not a byte-size admission rule."
}
