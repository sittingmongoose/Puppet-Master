{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "event_type",
    "fact_ref",
    "provider",
    "subject_ref",
    "source_record_ref",
    "repository_identity_ref",
    "eligibility_snapshot_ref",
    "previous_eligibility_snapshot_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.event_payload.forge_repository_eligibility_changed.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "event_type": {
      "const": "forge.repository.eligibility_changed"
    },
    "fact_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "provider": {
      "$ref": "../../forge_integration_contracts.schema.json#/$defs/provider"
    },
    "subject_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "source_record_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "repository_identity_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "eligibility_snapshot_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "previous_eligibility_snapshot_ref": {
      "$ref": "#/$defs/opaque_ref"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/Plans/event_payloads/forge/forge_repository_eligibility_changed.schema.json",
  "title": "forge.repository.eligibility_changed 1.0.0 prepared payload",
  "$defs": {
    "opaque_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^pmref:[A-Za-z0-9._:-]+(?![\\s\\S])",
      "description": "New opaque non-secret Forge history handle. Exact bytes, full-match, no URL, path or content. Native identity is resolved through the owning record, never decoded from this handle."
    }
  }
}
