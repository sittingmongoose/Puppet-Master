{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event_payloads/panel_redocked/2.0.0",
  "title": "panel.redocked current chat-only settled audit payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storage_instance_id",
    "server_id",
    "scope_partition",
    "app_session_id",
    "interaction_transaction_id",
    "actor_ref",
    "correlation_id",
    "idempotency_key",
    "window_id",
    "owner_commit_ref",
    "command_result_ref",
    "dispatch_receipt_ref",
    "schema_id",
    "schema_version",
    "project_id",
    "workspace_tab_id",
    "panel_id",
    "command_id",
    "origin",
    "source_host",
    "target_host",
    "prior_host_revision",
    "new_host_revision",
    "settled_at_utc",
    "settled_only",
    "preview_state_included",
    "persisted",
    "host_state_persisted",
    "workspace_layout_changed_coemitted",
    "workspace_layout_event_ref"
  ],
  "properties": {
    "storage_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "server_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_partition": {
      "type": "string",
      "minLength": 1
    },
    "app_session_id": {
      "type": "string",
      "minLength": 1
    },
    "interaction_transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "window_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_commit_ref": {
      "type": "string",
      "minLength": 1
    },
    "command_result_ref": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_receipt_ref": {
      "type": "string",
      "minLength": 1
    },
    "schema_id": {
      "const": "pm.event.panel_redocked.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "workspace_tab_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "panel_id": {
      "const": "chat"
    },
    "command_id": {
      "const": "cmd.panel.redock"
    },
    "origin": {
      "enum": [
        "home_workspace",
        "global_shell"
      ]
    },
    "source_host": {
      "const": "detached_window"
    },
    "target_host": {
      "const": "chat_column"
    },
    "prior_host_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "new_host_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "settled_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "settled_only": {
      "const": true
    },
    "preview_state_included": {
      "const": false
    },
    "persisted": {
      "const": true
    },
    "host_state_persisted": {
      "const": false
    },
    "workspace_layout_changed_coemitted": {
      "const": false
    },
    "workspace_layout_event_ref": {
      "const": null
    }
  }
}
