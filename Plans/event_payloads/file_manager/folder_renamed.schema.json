{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.file_manager_event.folder_renamed.schema.v1",
  "$comment": "Static payload schema only. Runtime must prove source currentness, destination nonexistence or resolved conflict, preserved node identity, and FileSafe receipt linkage. No append or dispatch authority is granted.",
  "title": "folder.renamed payload",
  "description": "Closed Project-scoped receipt for a basename rename of one folder tree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "node_kind",
    "operation_id",
    "source_path_ref",
    "destination_path_ref",
    "affected_path_refs",
    "folder_ref",
    "path_snapshot_revision",
    "rename_scope",
    "identity_preserved",
    "operation_status",
    "filesafe_receipt_ref",
    "origin",
    "handler_target",
    "command_id",
    "correlation_id",
    "receipt_ref",
    "evidence_refs",
    "ts",
    "descendant_count"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.file_manager_event.folder_renamed.schema.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "$ref": "#/$defs/safe_id"
    },
    "node_kind": {
      "const": "folder"
    },
    "operation_id": {
      "$ref": "#/$defs/safe_id"
    },
    "source_path_ref": {
      "$ref": "#/$defs/path_ref"
    },
    "destination_path_ref": {
      "$ref": "#/$defs/path_ref"
    },
    "affected_path_refs": {
      "$ref": "#/$defs/path_ref_array"
    },
    "path_snapshot_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rename_scope": {
      "const": "basename"
    },
    "identity_preserved": {
      "const": true
    },
    "operation_status": {
      "const": "completed"
    },
    "filesafe_receipt_ref": {
      "$ref": "#/$defs/non_secret_ref"
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "handler_target": {
      "const": "handlers::file::rename"
    },
    "command_id": {
      "const": "cmd.file.rename"
    },
    "correlation_id": {
      "$ref": "#/$defs/safe_id"
    },
    "receipt_ref": {
      "$ref": "#/$defs/non_secret_ref"
    },
    "evidence_refs": {
      "$ref": "#/$defs/non_empty_ref_array"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "folder_ref": {
      "$ref": "#/$defs/non_secret_ref"
    },
    "descendant_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "non_secret_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 320,
      "pattern": "^pmref:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])",
      "description": "Opaque typed original-owner reference. Resolve under the referenced owner with current authorization, deletion and retention checks; spelling alone proves neither existence nor access."
    },
    "path_ref": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220,
      "pattern": "^pm-path-ref:v1:[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])",
      "not": {
        "pattern": "\\.\\."
      },
      "description": "Opaque handle to one exact path snapshot entry in the original operation receipt identified by receipt_ref. Scope segment must equal project; token resolves only inside that receipt and Project. Never decode as a filesystem path, use active focus, or grant access."
    },
    "path_ref_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "non_empty_ref_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_secret_ref"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "origin": {
      "enum": [
        "file_manager",
        "editor",
        "command_palette",
        "api"
      ]
    }
  }
}
