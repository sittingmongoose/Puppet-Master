{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.settings_inventory.schema.v1",
  "title": "Puppet Master canonical settings inventory registry",
  "description": "Shape owner for Plans/settings_inventory.json, the canonical inventory of user-facing settings consumed by the search-first Settings surface (F3-432), the fuzzy search contract (F3-433), the shelves and curation service (F3-435, F3-436, F3-437), the row renderer contract (F3-438), and the Project Settings Modal derivation (F3-442). Demo runtime fields (value, status, src) are intentionally not part of this shape: per-setting status is derived from live subsystem state per F3-435.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "generated_at_utc",
    "owner_doc",
    "owner_plan_unit",
    "provenance",
    "related_features_vocabulary",
    "categories",
    "settings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_id": {
      "const": "pm.settings_inventory.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "owner_doc": {
      "const": "Plans/FinalGUISpec.md"
    },
    "owner_plan_unit": {
      "const": "F3-441"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_path",
        "source_sha256",
        "disposition"
      ],
      "properties": {
        "source_path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "disposition": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "related_features_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "icon",
          "description",
          "subgroups"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "subgroups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "desc",
          "type",
          "scope",
          "tier",
          "search",
          "layering"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "label": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "type": {
            "enum": [
              "action",
              "keyvalue",
              "list",
              "multiselect",
              "number",
              "path",
              "radio",
              "select",
              "slider",
              "text",
              "toggle"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "presentation_options": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "description": "Family names offered by Theme; options retains the compatible composite storage values (DL-301)."
          },
          "presentation_contract": {
            "type": "string",
            "description": "Mapping and compatibility rules for the visible presentation choices (DL-301)."
          },
          "option_labels": {
            "type": "object",
            "description": "Display words for stored option values (F3-441, DL-230); a value without an entry shows as stored.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "default": {},
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "account",
                "global",
                "persona",
                "project",
                "provider",
                "run"
              ]
            },
            "uniqueItems": true
          },
          "tier": {
            "enum": [
              "simple",
              "advanced"
            ]
          },
          "recommended": {
            "description": "Recommended value for this setting (type mirrors the setting value type)."
          },
          "curated": {
            "type": "boolean"
          },
          "search": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "badges": {
            "type": "array",
            "items": {
              "enum": [
                "adjudication",
                "new",
                "restart"
              ]
            },
            "uniqueItems": true
          },
          "related_features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "layering": {
            "$ref": "#/$defs/layering"
          }
        },
        "additionalProperties": false
      }
    },
    "retired_input_ids": {
      "description": "SSYS-043/004: migration-only input IDs, disjoint from active settings rows and excluded from row counts. Placement may name them only to retire their presentation; this is not a Settings value or writer admission.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "layering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home",
        "may_differ_by",
        "computer_key",
        "combine",
        "atomic_group",
        "not_offered"
      ],
      "properties": {
        "home": {
          "enum": [
            "everywhere",
            "computer",
            "device",
            "project",
            "thing"
          ]
        },
        "may_differ_by": {
          "type": "array",
          "items": {
            "enum": [
              "everywhere",
              "computer",
              "device",
              "project"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "computer_key": {
          "enum": [
            null,
            "server",
            "execution_host"
          ]
        },
        "combine": {
          "enum": [
            "most_specific",
            "more_careful",
            "computer_ceiling",
            "per_item"
          ]
        },
        "atomic_group": {
          "enum": [
            null,
            "theme_pair"
          ]
        },
        "careful_order": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "boolean",
              "number"
            ]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "not_offered": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "everywhere": {
              "enum": [
                "names_a_program",
                "names_a_folder",
                "about_hardware",
                "about_the_network",
                "about_this_project",
                "about_the_screen",
                "not_about_the_screen",
                "set_inside_a_thing",
                "same_for_you",
                "managed"
              ]
            },
            "computer": {
              "enum": [
                "names_a_program",
                "names_a_folder",
                "about_hardware",
                "about_the_network",
                "about_this_project",
                "about_the_screen",
                "not_about_the_screen",
                "set_inside_a_thing",
                "same_for_you",
                "managed"
              ]
            },
            "device": {
              "enum": [
                "names_a_program",
                "names_a_folder",
                "about_hardware",
                "about_the_network",
                "about_this_project",
                "about_the_screen",
                "not_about_the_screen",
                "set_inside_a_thing",
                "same_for_you",
                "managed"
              ]
            },
            "project": {
              "enum": [
                "names_a_program",
                "names_a_folder",
                "about_hardware",
                "about_the_network",
                "about_this_project",
                "about_the_screen",
                "not_about_the_screen",
                "set_inside_a_thing",
                "same_for_you",
                "managed"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "may_differ_by": {
                "allOf": [
                  {
                    "contains": {
                      "const": "computer"
                    }
                  },
                  {
                    "contains": {
                      "const": "device"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "combine": {
                "const": "more_careful"
              }
            }
          },
          "then": {
            "required": [
              "careful_order"
            ]
          },
          "else": {
            "not": {
              "required": [
                "careful_order"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "may_differ_by": {
                "contains": {
                  "const": "computer"
                }
              }
            }
          },
          "then": {
            "properties": {
              "computer_key": {
                "enum": [
                  "server",
                  "execution_host"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "computer_key": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "may_differ_by": {
                "contains": {
                  "const": "everywhere"
                }
              }
            }
          },
          "then": {
            "properties": {
              "not_offered": {
                "not": {
                  "required": [
                    "everywhere"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "not_offered": {
                "required": [
                  "everywhere"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "may_differ_by": {
                "contains": {
                  "const": "computer"
                }
              }
            }
          },
          "then": {
            "properties": {
              "not_offered": {
                "not": {
                  "required": [
                    "computer"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "not_offered": {
                "required": [
                  "computer"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "may_differ_by": {
                "contains": {
                  "const": "device"
                }
              }
            }
          },
          "then": {
            "properties": {
              "not_offered": {
                "not": {
                  "required": [
                    "device"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "not_offered": {
                "required": [
                  "device"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "may_differ_by": {
                "contains": {
                  "const": "project"
                }
              }
            }
          },
          "then": {
            "properties": {
              "not_offered": {
                "not": {
                  "required": [
                    "project"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "not_offered": {
                "required": [
                  "project"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
