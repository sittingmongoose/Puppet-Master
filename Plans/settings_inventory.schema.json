{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.settings_inventory.schema.v1",
  "title": "Puppet Master canonical settings inventory registry",
  "description": "Shape owner for Plans/settings_inventory.json, the canonical inventory of user-facing settings consumed by the search-first Settings surface (F3-432), the fuzzy search contract (F3-433), the shelves and curation service (F3-435, F3-436, F3-437), the row renderer contract (F3-438), and the Project Settings Modal derivation (F3-442). Demo runtime fields (value, status, src) are intentionally not part of this shape: per-setting status is derived from live subsystem state per F3-435.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "generated_at_utc",
    "owner_doc",
    "owner_plan_unit",
    "provenance",
    "related_features_vocabulary",
    "categories",
    "settings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_id": {
      "const": "pm.settings_inventory.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "owner_doc": {
      "const": "Plans/FinalGUISpec.md"
    },
    "owner_plan_unit": {
      "const": "F3-441"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_path",
        "source_sha256",
        "disposition"
      ],
      "properties": {
        "source_path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "disposition": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "related_features_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "icon",
          "description",
          "subgroups"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "subgroups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "desc",
          "type",
          "scope",
          "tier",
          "search"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "label": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "type": {
            "enum": [
              "action",
              "keyvalue",
              "list",
              "multiselect",
              "number",
              "path",
              "radio",
              "select",
              "slider",
              "text",
              "toggle"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "account",
                "global",
                "persona",
                "project",
                "provider",
                "run"
              ]
            },
            "uniqueItems": true
          },
          "tier": {
            "enum": [
              "simple",
              "advanced"
            ]
          },
          "recommended": {
            "description": "Recommended value for this setting (type mirrors the setting value type)."
          },
          "curated": {
            "type": "boolean"
          },
          "search": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "badges": {
            "type": "array",
            "items": {
              "enum": [
                "adjudication",
                "new",
                "restart"
              ]
            },
            "uniqueItems": true
          },
          "related_features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "management_kind": {
            "description": "Owner-issued machine classification of record (Settings_System.md SSYS-007.A table and SSYS-018), consumed identically by the Settings import/Replace consumer and the DRY method owner: ordinary rows are the DL-095 Replace reset denominator; credential (SSYS-008/MA-070 OS credential-store custody), local_environment (SSYS-007 environment-specific values, including the GAAAF-004/Tools OAuth loopback bind-host row), run_scoped (SSYS-007.A creation/run-scoped preference outside durable Project Replace state) and owner_destination (FS-010 formatter custody; DRY method-guard custody) rows are excluded from Replace eligibility, reset, and transfer; value_dependent rows take the ordinary branch only for an owner-validated portable value form (portable_value_forms) bound to actual source/destination Project identity, revision, root, and preview/apply currentness; unresolved rows fail closed pending an explicit owner decision.  A JSON field type of path alone is not this boundary.  One-shot action rows are typed by `type` (SSYS-004) and omit this field; no missing-field fallback to ordinary exists.",
            "enum": [
              "ordinary",
              "credential",
              "local_environment",
              "owner_destination",
              "value_dependent",
              "run_scoped",
              "unresolved"
            ]
          },
          "portable_value_forms": {
            "description": "The owner-admitted portable value forms for one value_dependent row (SSYS-007.A): project_root_relative (a Project-root-relative value bound to the actual Project roots), project_root_placeholder (the owner-defined ${PROJECT_ROOT}-relative form), symbolic_default (exactly the owner-defined portable symbolic registry default token), or portable_remote_reference (a separately owner-approved portable remote reference where the row admits one).  Admission authority is always the typed owner read bound to source/destination identity, revision, root and currentness; string shape tests only refuse contradictions and never admit.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "project_root_relative",
                "project_root_placeholder",
                "symbolic_default",
                "portable_remote_reference"
              ]
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "keyvalue",
                    "list",
                    "multiselect",
                    "number",
                    "radio",
                    "select",
                    "slider",
                    "text",
                    "toggle"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "management_kind"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "management_kind": {
                  "const": "value_dependent"
                }
              },
              "required": [
                "management_kind"
              ]
            },
            "then": {
              "required": [
                "portable_value_forms"
              ]
            }
          },
          {
            "if": {
              "required": [
                "portable_value_forms"
              ]
            },
            "then": {
              "properties": {
                "management_kind": {
                  "const": "value_dependent"
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
