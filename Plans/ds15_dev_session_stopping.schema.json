{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "dev_session_id",
    "operation_id",
    "workflow_revision",
    "previous_state",
    "workflow_state",
    "outcome_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dev_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workflow_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "previous_state": {
      "enum": [
        "running",
        "restarting"
      ]
    },
    "workflow_state": {
      "const": "stopping"
    },
    "outcome_ref": {
      "description": "Stable non-secret reference. Raw credentials, tokens, auth values, credential paths, file contents, and provider-visible bytes are forbidden.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "thread_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workspace_tab_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "terminal_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dap_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.ds15.dev_session_stopping.payload.v1"
}
