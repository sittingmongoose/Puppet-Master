{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.web_capability_source_packet_receipt.schema.v1",
  "title": "Puppet Master Web Capability Source Packet Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "packet_id",
    "received_packet",
    "files",
    "finding_matrix",
    "negative_constraints"
  ],
  "properties": {
    "schema_id": {"type": "string", "const": "pm.web_capability_source_packet_receipt.v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "received_packet": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/PacketFile"}
    },
    "finding_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "generated_at_utc", "source_repo", "supersedes", "finding_ids", "finding_priorities"],
      "properties": {
        "schema_id": {"type": "string", "const": "pm.web_capability_findings_matrix.v3"},
        "generated_at_utc": {"type": "string", "minLength": 1},
        "source_repo": {"type": "string", "minLength": 1},
        "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "finding_ids": {
          "type": "array",
          "minItems": 19,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "finding_priorities": {
          "type": "object",
          "additionalProperties": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]}
        }
      }
    },
    "negative_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "PacketFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_name", "artifact_role", "sha256", "byte_size"],
      "properties": {
        "artifact_name": {"type": "string", "minLength": 1},
        "artifact_role": {
          "type": "string",
          "enum": ["review_addendum", "findings_matrix", "goal_prompt", "source_packet_archive"]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
