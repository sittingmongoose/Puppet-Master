        "normalization_rule": {"type": ["string", "null"]},
        "proposed_schema": {"$ref": "#/$defs/non_empty"},
        "proposed_sole_handler": {"$ref": "#/$defs/non_empty"},
        "gui_consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty"}},
        "availability_until_native_proof": {"enum": ["handler_unavailable", "inherit exact target", "local action state", "not_actionable", "protected_boundary_unproven"]},
        "event_receipt_rule": {"enum": ["receipt/projection only unless the exact event family is separately admitted by Event Authority; never infer runtime success", "no domain EventRecord; preserve accessibility/currentness/return evidence", "no dispatch or receipt"]},
        "conflict_evidence": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/conflict_evidence"}},
        "source_gap_findings": {"const": ["command_absent_from_ui_command_catalog", "command_absent_from_commands_system", "command_absent_from_typed_contract_schema", "command_absent_from_production_wiring", "command_absent_from_touch_closure", "native_application_and_handler_evidence_absent"]}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "approved_alias_to_exact"}}, "required": ["disposition"]}, "then": {"properties": {"proposed_exact_target": {"$ref": "#/$defs/command_id"}, "alias_registration": {"const": false}, "normalization_rule": {"type": "string", "minLength": 1}, "proposed_schema": {"type": "string", "pattern": "^Plans/[A-Za-z0-9_.-]+\\.schema\\.json#/\\$defs/[A-Za-z0-9_]+(?:\\|[A-Za-z0-9_]+)?(?: \\([^)]*\\))?$"}, "proposed_sole_handler": {"type": "string", "pattern": "^handlers::[a-z0-9_]+::[a-z0-9_]+$"}, "availability_until_native_proof": {"const": "inherit exact target"}, "event_receipt_rule": {"const": "receipt/projection only unless the exact event family is separately admitted by Event Authority; never infer runtime success"}}}},
        {"if": {"properties": {"disposition": {"const": "new_canonical_required"}}, "required": ["disposition"]}, "then": {"properties": {"proposed_exact_target": {"$ref": "#/$defs/command_id"}, "alias_registration": {"type": "null"}, "normalization_rule": {"type": "null"}, "proposed_schema": {"type": "string", "pattern": "^Plans/[A-Za-z0-9_.-]+\\.schema\\.json#/\\$defs/[A-Za-z0-9_]+\\|[A-Za-z0-9_]+(?: \\([^)]*\\))?$"}, "proposed_sole_handler": {"type": "string", "pattern": "^handlers::[a-z0-9_]+::[a-z0-9_]+$"}, "availability_until_native_proof": {"const": "handler_unavailable"}, "event_receipt_rule": {"const": "receipt/projection only unless the exact event family is separately admitted by Event Authority; never infer runtime success"}}}},
        {"if": {"properties": {"disposition": {"const": "typed_local_ui_action"}}, "required": ["disposition"]}, "then": {"properties": {"proposed_exact_target": {"$ref": "#/$defs/local_action_id"}, "alias_registration": {"type": "null"}, "normalization_rule": {"type": "null"}, "proposed_schema": {"type": "string", "pattern": "^Plans/[A-Za-z0-9_.-]+\\.schema\\.json#/\\$defs/[A-Za-z0-9_]+\\|[A-Za-z0-9_]+(?: \\([^)]*\\))?$"}, "proposed_sole_handler": {"const": "owner-local typed UI controller; no semantic-domain handler"}, "availability_until_native_proof": {"enum": ["local action state", "protected_boundary_unproven"]}, "event_receipt_rule": {"const": "no domain EventRecord; preserve accessibility/currentness/return evidence"}}}},
        {"if": {"properties": {"disposition": {"const": "rejected_with_reason"}}, "required": ["disposition"]}, "then": {"properties": {"alias_registration": {"type": "null"}, "normalization_rule": {"type": "null"}, "proposed_schema": {"type": "string", "pattern": "^none; use the exact replacement owner schema named in proposed_exact_target$"}, "proposed_sole_handler": {"const": "none"}, "availability_until_native_proof": {"const": "not_actionable"}, "event_receipt_rule": {"const": "no dispatch or receipt"}}}}
