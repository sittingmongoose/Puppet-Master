{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.runtime_artifact.context_snapshot.schema.v1",
  "title": "Runtime Artifact context_snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "artifact_id",
    "artifact_type",
    "project_id",
    "run_id",
    "attempt_id",
    "created_at_utc",
    "projection_freshness",
    "projection_health",
    "retention_class",
    "routing_refs",
    "type_payload"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.runtime_artifact.context_snapshot.schema.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "const": "context_snapshot"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "provider_attempt_ref": {
      "type": "string"
    },
    "usage_event_ref": {
      "type": "string"
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer_ref": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "detail_ref": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "source_surface": {
      "type": "string"
    },
    "projection_freshness": {
      "type": "string"
    },
    "projection_health": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "routing_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_ref"
      ],
      "properties": {
        "snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "context_kind": {
          "type": "string",
          "enum": [
            "project",
            "run",
            "attempt",
            "thread",
            "node",
            "provider"
          ]
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "included_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_secret_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "credentials",
              "tokens",
              "private_keys",
              "session_material",
              "environment_secrets",
              "user_private_data"
            ]
          }
        },
        "captured_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "contains_raw_secrets": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "ContextSnapshotApplicationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "scope",
        "storage_instance_id",
        "thread_id",
        "owner_object_ref",
        "owner_revision",
        "owner_sha256",
        "source_evidence",
        "read_checkpoint_ref",
        "source_host_ref",
        "return_context_ref"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.context_snapshot_application.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope": {
          "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/WorkflowScopeV2"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_object_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_revision": {
          "type": "integer",
          "minimum": 0
        },
        "owner_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_evidence": {
          "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/OwnerEvidenceRefV1"
        },
        "read_checkpoint_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "source_host_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "return_context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
