{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json",
  "title": "Puppet Master shared runtime command contracts",
  "description": "Pre-build typed requests, results, errors, cancellation, and idempotency for the 26 canonical shared-runtime commands plus the retained remote reconnect wrapper. These contracts authorize no EventRecord producer.",
  "oneOf": [
    {"$ref": "#/$defs/environment_connection_command_request"},
    {"$ref": "#/$defs/thread_outbox_retry_request"},
    {"$ref": "#/$defs/thread_outbox_cancel_request"},
    {"$ref": "#/$defs/thread_request_command_request"},
    {"$ref": "#/$defs/thread_spawn_command_request"},
    {"$ref": "#/$defs/thread_await_command_request"},
    {"$ref": "#/$defs/capability_ensure_request"},
    {"$ref": "#/$defs/tool_discover_request"},
    {"$ref": "#/$defs/tool_select_request"},
    {"$ref": "#/$defs/installation_lifecycle_command_request"},
    {"$ref": "#/$defs/authentication_command_request"},
    {"$ref": "#/$defs/eval_session_command_request"},
    {"$ref": "#/$defs/mcp_server_lifecycle_command_request"},
    {"$ref": "#/$defs/runtime_resource_inspect_request"},
    {"$ref": "#/$defs/back_seat_driver_mode_set_request"},
    {"$ref": "#/$defs/remote_reconnect_wrapper_request"},
    {"$ref": "#/$defs/environment_connection_command_result"},
    {"$ref": "#/$defs/thread_outbox_command_result"},
    {"$ref": "#/$defs/thread_request_command_result"},
    {"$ref": "#/$defs/thread_spawn_command_result"},
    {"$ref": "#/$defs/thread_await_command_result"},
    {"$ref": "#/$defs/capability_ensure_result"},
    {"$ref": "#/$defs/tool_discover_result"},
    {"$ref": "#/$defs/tool_select_result"},
    {"$ref": "#/$defs/installation_lifecycle_command_result"},
    {"$ref": "#/$defs/authentication_command_result"},
    {"$ref": "#/$defs/eval_session_command_result"},
    {"$ref": "#/$defs/mcp_server_lifecycle_command_result"},
    {"$ref": "#/$defs/runtime_resource_inspect_result"},
    {"$ref": "#/$defs/back_seat_driver_mode_set_result"},
    {"$ref": "#/$defs/command_error"},
    {"$ref": "#/$defs/command_cancellation"},
    {"$ref": "#/$defs/command_idempotency"}
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "nullable_non_empty_string": {"oneOf": [{"$ref": "#/$defs/non_empty_string"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time"},
    "nullable_timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "non_secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$"
    },
    "environment_connection_command_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["action", "environment_id", "expected_supervisor_generation", "expected_connection_epoch", "reason", "drain_policy"],
          "properties": {
            "command_id": {"enum": ["cmd.environment.connect", "cmd.environment.reconnect", "cmd.environment.disconnect"]},
            "action": {"enum": ["connect", "reconnect", "disconnect"]},
            "environment_id": {"$ref": "#/$defs/non_empty_string"},
            "expected_supervisor_generation": {"type": "integer", "minimum": 0},
            "expected_connection_epoch": {"type": "integer", "minimum": 0},
            "reason": {"$ref": "#/$defs/nullable_non_empty_string"},
            "drain_policy": {"oneOf": [{"enum": ["drain_bounded", "cancel_pending", "fail_if_busy"]}, {"type": "null"}]}
          }
        },
        {"if": {"properties": {"command_id": {"const": "cmd.environment.connect"}}}, "then": {"properties": {"action": {"const": "connect"}}}},
        {"if": {"properties": {"command_id": {"const": "cmd.environment.reconnect"}}}, "then": {"properties": {"action": {"const": "reconnect"}}}},
        {"if": {"properties": {"command_id": {"const": "cmd.environment.disconnect"}}}, "then": {"properties": {"action": {"const": "disconnect"}}}}
      ],
      "unevaluatedProperties": false
    },
    "thread_outbox_retry_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["outbox_entry_id", "expected_outbox_revision", "expected_target_generation"],
          "properties": {
            "command_id": {"const": "cmd.thread.outbox.retry"},
            "thread_id": {"$ref": "#/$defs/non_empty_string"},
            "outbox_entry_id": {"$ref": "#/$defs/non_empty_string"},
            "expected_outbox_revision": {"type": "integer", "minimum": 0},
            "expected_target_generation": {"type": "integer", "minimum": 0}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "thread_outbox_cancel_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["outbox_entry_id", "expected_outbox_revision", "cancellation_reason"],
          "properties": {
            "command_id": {"const": "cmd.thread.outbox.cancel"},
            "thread_id": {"$ref": "#/$defs/non_empty_string"},
            "outbox_entry_id": {"$ref": "#/$defs/non_empty_string"},
            "expected_outbox_revision": {"type": "integer", "minimum": 0},
            "cancellation_reason": {"$ref": "#/$defs/non_empty_string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "thread_request_command_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["request_id", "parent_thread_id", "requested_thread_kind", "bounded_request_ref", "target_generation"],
          "properties": {
            "command_id": {"const": "cmd.thread.request"},
            "request_id": {"$ref": "#/$defs/non_empty_string"},
            "parent_thread_id": {"$ref": "#/$defs/nullable_non_empty_string"},
            "requested_thread_kind": {"enum": ["foreground", "background", "branch", "agent_child"]},
            "bounded_request_ref": {"$ref": "#/$defs/non_secret_ref"},
            "target_generation": {"type": "integer", "minimum": 0}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "thread_spawn_command_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["spawn_request_id", "parent_thread_id", "requested_role", "bounded_context_ref", "target_generation"],
          "properties": {
            "command_id": {"const": "cmd.thread.spawn"},
            "spawn_request_id": {"$ref": "#/$defs/non_empty_string"},
            "parent_thread_id": {"$ref": "#/$defs/non_empty_string"},
            "requested_role": {"$ref": "#/$defs/non_empty_string"},
            "bounded_context_ref": {"$ref": "#/$defs/non_secret_ref"},
            "target_generation": {"type": "integer", "minimum": 0}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "thread_await_command_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["await_request_id", "condition_ref", "timeout_utc", "target_generation"],
          "properties": {
            "command_id": {"const": "cmd.thread.await"},
            "thread_id": {"$ref": "#/$defs/non_empty_string"},
            "await_request_id": {"$ref": "#/$defs/non_empty_string"},
            "condition_ref": {"$ref": "#/$defs/non_secret_ref"},
            "timeout_utc": {"$ref": "#/$defs/timestamp"},
            "target_generation": {"type": "integer", "minimum": 0}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "capability_ensure_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["capability_id", "provisioning_mode", "requirement_ref", "origin_operation_id"],
          "properties": {
            "command_id": {"const": "cmd.capability.ensure"},
            "capability_id": {"$ref": "#/$defs/non_empty_string"},
            "provisioning_mode": {"enum": ["Off", "Auto", "On"]},
            "requirement_ref": {"$ref": "#/$defs/non_secret_ref"},
            "origin_operation_id": {"$ref": "#/$defs/non_empty_string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "tool_discover_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["capability_query_ref", "stage_limit", "expected_registry_generation"],
          "properties": {
            "command_id": {"const": "cmd.tool.discover"},
            "capability_query_ref": {"$ref": "#/$defs/non_secret_ref"},
            "stage_limit": {"enum": ["installed", "project_enabled", "policy_available", "selected_for_request", "invoked"]},
            "expected_registry_generation": {"type": "integer", "minimum": 0}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "tool_select_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["selection_id", "tool_refs", "expected_registry_generation", "policy_snapshot_ref"],
          "properties": {
            "command_id": {"const": "cmd.tool.select"},
            "selection_id": {"$ref": "#/$defs/non_empty_string"},
            "tool_refs": {"$ref": "#/$defs/ref_list"},
            "expected_registry_generation": {"type": "integer", "minimum": 0},
            "policy_snapshot_ref": {"$ref": "#/$defs/non_secret_ref"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "nullable_non_secret_ref": {"oneOf": [{"$ref": "#/$defs/non_secret_ref"}, {"type": "null"}]},
    "ref_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/non_secret_ref"}},
    "canonical_command_id": {
      "enum": [
        "cmd.environment.connect",
        "cmd.environment.reconnect",
        "cmd.environment.disconnect",
        "cmd.thread.outbox.retry",
        "cmd.thread.outbox.cancel",
        "cmd.thread.request",
        "cmd.thread.spawn",
        "cmd.thread.await",
        "cmd.capability.ensure",
        "cmd.tool.discover",
        "cmd.tool.select",
        "cmd.installation.install",
        "cmd.installation.update",
        "cmd.installation.repair",
        "cmd.installation.rollback",
        "cmd.installation.verify",
        "cmd.authentication.start",
        "cmd.authentication.cancel",
        "cmd.authentication.resume",
        "cmd.eval.session.start",
        "cmd.eval.session.execute",
        "cmd.eval.session.stop",
        "cmd.mcp.server.connect",
        "cmd.mcp.server.reconnect",
        "cmd.resource.inspect",
        "cmd.bsd.set"
      ]
    },
    "command_idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "idempotency_key", "scope_ref", "binding_sha256", "replay_policy", "conflict_behavior"],
      "properties": {
        "schema_id": {"const": "pm.shared_runtime.command_idempotency.v1"},
        "idempotency_key": {"$ref": "#/$defs/non_empty_string"},
        "scope_ref": {"$ref": "#/$defs/non_secret_ref"},
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "replay_policy": {"enum": ["return_original_result", "join_inflight_same_binding", "reject_after_terminal"]},
        "conflict_behavior": {"const": "reject_same_key_different_binding"},
        "original_operation_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "original_result_ref": {"$ref": "#/$defs/nullable_non_secret_ref"}
      }
    },
    "command_request_envelope": {
      "type": "object",
      "required": [
        "schema_id", "schema_version", "command_id", "command_instance_id", "idempotency",
        "project_id", "project_home_server_id", "execution_host_id", "execution_environment_id",
        "source_location_id", "topology_generation", "actor_ref", "permission_snapshot_ref",
        "goal_id", "plan_id", "run_id", "thread_id", "agent_id", "crew_id",
        "deadline_utc", "recovery_of_operation_id"
      ],
      "properties": {
        "schema_id": {"const": "pm.shared_runtime.command_request.v1"},
        "schema_version": {"const": "1.0.0"},
        "command_id": {"$ref": "#/$defs/canonical_command_id"},
        "command_instance_id": {"$ref": "#/$defs/non_empty_string"},
        "idempotency": {"$ref": "#/$defs/command_idempotency"},
        "project_id": {"$ref": "#/$defs/non_empty_string"},
        "project_home_server_id": {"$ref": "#/$defs/non_empty_string"},
        "execution_host_id": {"$ref": "#/$defs/non_empty_string"},
        "execution_environment_id": {"$ref": "#/$defs/non_empty_string"},
        "source_location_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "topology_generation": {"type": "integer", "minimum": 0},
        "actor_ref": {"$ref": "#/$defs/non_secret_ref"},
        "permission_snapshot_ref": {"$ref": "#/$defs/non_secret_ref"},
        "goal_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "plan_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "run_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "thread_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "agent_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "crew_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "deadline_utc": {"$ref": "#/$defs/nullable_timestamp"},
        "recovery_of_operation_id": {"$ref": "#/$defs/nullable_non_empty_string"}
      }
    },
    "disabled_reason": {
      "enum": [
        "already_in_state", "approval_required", "auth_state_mismatch", "breaker_open",
        "capability_unavailable", "deadline_expired", "host_environment_mismatch",
        "lease_conflict", "official_source_unverified", "operation_in_progress",
        "outbox_state_mismatch", "permission_required", "policy_denied", "resource_blocked",
        "session_state_mismatch", "setup_required", "stale_projection", "target_missing",
        "topology_unavailable", "unsupported"
      ]
    },
    "command_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "category", "code", "retryability", "safe_user_message", "detail_ref"],
      "properties": {
        "schema_id": {"const": "pm.shared_runtime.command_error.v1"},
        "category": {"enum": ["validation", "stale_state", "permission", "policy", "resource", "topology", "capability", "external_dependency", "recovery", "internal_fail_closed"]},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "retryability": {"enum": ["not_retryable", "retry_after_state_change", "retry_after_backoff", "resume_same_operation", "manual_recovery_required"]},
        "safe_user_message": {"type": "string", "minLength": 1, "maxLength": 512},
        "detail_ref": {"$ref": "#/$defs/nullable_non_secret_ref"}
      }
    },
    "command_result_envelope": {
      "type": "object",
      "required": [
        "schema_id", "schema_version", "result_type", "command_id", "operation_id",
        "command_instance_id", "outcome", "observable_work_id", "current_revision_or_epoch",
        "projection_ref", "receipt_refs", "artifact_refs", "disabled_reason", "error",
        "recovery_actions", "replayed", "original_operation_id", "terminal_owner_result_ref"
      ],
      "properties": {
        "schema_id": {"const": "pm.shared_runtime.command_result.v1"},
        "schema_version": {"const": "1.0.0"},
        "result_type": {"type": "string", "minLength": 1},
        "command_id": {"$ref": "#/$defs/canonical_command_id"},
        "operation_id": {"$ref": "#/$defs/non_empty_string"},
        "command_instance_id": {"$ref": "#/$defs/non_empty_string"},
        "outcome": {"enum": ["accepted", "no_change", "blocked", "cancelled", "failed", "recovery_required"]},
        "observable_work_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "current_revision_or_epoch": {"type": "integer", "minimum": 0},
        "projection_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
        "receipt_refs": {"$ref": "#/$defs/ref_list"},
        "artifact_refs": {"$ref": "#/$defs/ref_list"},
        "disabled_reason": {"oneOf": [{"$ref": "#/$defs/disabled_reason"}, {"type": "null"}]},
        "error": {"oneOf": [{"$ref": "#/$defs/command_error"}, {"type": "null"}]},
        "recovery_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}},
        "replayed": {"type": "boolean"},
        "original_operation_id": {"$ref": "#/$defs/nullable_non_empty_string"},
        "terminal_owner_result_ref": {"$ref": "#/$defs/nullable_non_secret_ref"}
      },
      "allOf": [
        {
          "if": {"properties": {"replayed": {"const": true}}, "required": ["replayed"]},
          "then": {"properties": {"original_operation_id": {"$ref": "#/$defs/non_empty_string"}}}
        },
        {
          "if": {"properties": {"outcome": {"enum": ["blocked", "failed", "recovery_required"]}}, "required": ["outcome"]},
          "then": {"anyOf": [{"properties": {"disabled_reason": {"$ref": "#/$defs/disabled_reason"}}}, {"properties": {"error": {"$ref": "#/$defs/command_error"}}}]}
        }
      ]
    },
    "command_cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "command_instance_id", "operation_id", "cancellation_request_id",
        "state", "race_winner", "requested_at_utc", "acknowledged_at_utc",
        "cleanup_evidence_ref", "terminal_result_ref"
      ],
      "properties": {
        "schema_id": {"const": "pm.shared_runtime.command_cancellation.v1"},
        "command_instance_id": {"$ref": "#/$defs/non_empty_string"},
        "operation_id": {"$ref": "#/$defs/non_empty_string"},
        "cancellation_request_id": {"$ref": "#/$defs/non_empty_string"},
        "state": {"enum": ["requested", "acknowledged", "cleanup_confirmed", "won_by_completion", "failed"]},
        "race_winner": {"oneOf": [{"enum": ["cancellation", "completion", "none_yet"]}, {"type": "null"}]},
        "requested_at_utc": {"$ref": "#/$defs/timestamp"},
        "acknowledged_at_utc": {"$ref": "#/$defs/nullable_timestamp"},
        "cleanup_evidence_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
        "terminal_result_ref": {"$ref": "#/$defs/nullable_non_secret_ref"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "acknowledged"}}, "required": ["state"]},
          "then": {"properties": {"acknowledged_at_utc": {"$ref": "#/$defs/timestamp"}, "cleanup_evidence_ref": {"type": "null"}, "terminal_result_ref": {"type": "null"}}}
        },
        {
          "if": {"properties": {"state": {"const": "cleanup_confirmed"}}, "required": ["state"]},
          "then": {"properties": {"race_winner": {"const": "cancellation"}, "cleanup_evidence_ref": {"$ref": "#/$defs/non_secret_ref"}, "terminal_result_ref": {"$ref": "#/$defs/non_secret_ref"}}}
        },
        {
          "if": {"properties": {"state": {"const": "won_by_completion"}}, "required": ["state"]},
          "then": {"properties": {"race_winner": {"const": "completion"}, "terminal_result_ref": {"$ref": "#/$defs/non_secret_ref"}}}
        }
      ]
    },
    "installation_lifecycle_command_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": [
            "action", "subject_kind", "subject_id", "provider_cli", "acquisition_basis",
            "installation_id", "official_source_ref", "provenance_ref", "target_release_ref",
            "repair_plan_ref", "rollback_target_ref", "verification_policy_ref"
          ],
          "properties": {
            "command_id": {"enum": ["cmd.installation.install", "cmd.installation.update", "cmd.installation.repair", "cmd.installation.rollback", "cmd.installation.verify"]},
            "action": {"enum": ["install", "update", "repair", "rollback", "verify"]},
            "subject_kind": {"$ref": "#/$defs/non_empty_string"},
            "subject_id": {"$ref": "#/$defs/non_empty_string"},
            "provider_cli": {"type": "boolean"},
            "acquisition_basis": {"enum": ["explicit_user_acquisition", "post_consent_management", "non_provider_demand"]},
            "installation_id": {"$ref": "#/$defs/nullable_non_empty_string"},
            "official_source_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
            "provenance_ref": {"$ref": "#/$defs/non_secret_ref"},
            "target_release_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
            "repair_plan_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
            "rollback_target_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
            "verification_policy_ref": {"$ref": "#/$defs/nullable_non_secret_ref"}
          }
        },
        {"if": {"properties": {"command_id": {"const": "cmd.installation.install"}}}, "then": {"properties": {"action": {"const": "install"}}}},
        {"if": {"properties": {"command_id": {"const": "cmd.installation.update"}}}, "then": {"properties": {"action": {"const": "update"}}}},
        {"if": {"properties": {"command_id": {"const": "cmd.installation.repair"}}}, "then": {"properties": {"action": {"const": "repair"}}}},
        {"if": {"properties": {"command_id": {"const": "cmd.installation.rollback"}}}, "then": {"properties": {"action": {"const": "rollback"}}}},
        {"if": {"properties": {"command_id": {"const": "cmd.installation.verify"}}}, "then": {"properties": {"action": {"const": "verify"}}}},
        {
          "if": {"properties": {"provider_cli": {"const": true}, "action": {"const": "install"}}, "required": ["provider_cli", "action"]},
          "then": {"properties": {"acquisition_basis": {"const": "explicit_user_acquisition"}, "official_source_ref": {"$ref": "#/$defs/non_secret_ref"}}}
        }
      ],
      "unevaluatedProperties": false
    },
    "authentication_command_request": {
      "allOf": [
        {"$ref": "#/$defs/command_request_envelope"},
        {
          "type": "object",
          "required": ["action", "provider_id", "route_id", "profile_ref", "account_id", "connection_id", "auth_surface", "credential_ref", "authentication_operation_id", "expected_auth_revision", "continuation_ref"],
          "properties": {
            "command_id": {"enum": ["cmd.authentication.start", "cmd.authentication.cancel", "cmd.authentication.resume"]},
            "action": {"enum": ["start", "cancel", "resume"]},
            "provider_id": {"$ref": "#/$defs/non_empty_string"},
            "route_id": {"$ref": "#/$defs/non_empty_string"},
            "profile_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
            "account_id": {"$ref": "#/$defs/nullable_non_empty_string"},
            "connection_id": {"$ref": "#/$defs/nullable_non_empty_string"},
            "auth_surface": {"enum": ["protected_auth_browser", "device_code", "terminal_user_flow", "provider_owned_external"]},
            "credential_ref": {"$ref": "#/$defs/nullable_non_secret_ref"},
            "authentication_operation_id": {"$ref": "#/$defs/nullable_non_empty_string"},
            "expected_auth_revision": {"type": ["integer", "null"], "minimum": 0},
