{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.context_compaction_completed.schema.v1",
  "title": "Context compaction committed completion payload",
  "description": "Bounded content-free completion audit metadata. A CompactionReceipt reference is opaque, never a capability, content body, summary, prompt, path, URL with credentials, or content-derived digest. Semantic identity, gain and commit predicates remain mandatory under ACD-461 and SP-259.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "thread_id",
    "operation_id",
    "operation_generation",
    "compaction_receipt_ref",
    "input_context_revision",
    "output_context_revision",
    "context_epoch_id",
    "trigger",
    "disposition",
    "input_tokens",
    "output_tokens",
    "reclaimed_tokens",
    "input_bytes",
    "output_bytes",
    "committed_at_utc",
    "redaction_profile"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.context_compaction_completed.schema.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^thr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "operation_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "compaction_receipt_ref": {
      "type": "string",
      "minLength": 83,
      "maxLength": 83,
      "pattern": "^compaction_receipt:[0-9a-f]{64}$"
    },
    "input_context_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_context_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context_epoch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "trigger": {
      "enum": [
        "manual",
        "automatic",
        "micro_compaction"
      ]
    },
    "disposition": {
      "const": "committed"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reclaimed_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "input_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "committed_at_utc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 27,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "redaction_profile": {
      "const": "no_secrets"
    }
  }
}
