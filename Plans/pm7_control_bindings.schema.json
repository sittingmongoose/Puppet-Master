{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.pm7_control_bindings.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "owner_ref",
    "bindings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_id": {
      "const": "pm.pm7_control_bindings.v1"
    },
    "owner_ref": {
      "const": "Plans/Wiring_Matrix.md#WM-093"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "surface",
          "owner_ref",
          "disposition",
          "action_ids",
          "production_entries",
          "setting_ids",
          "payload",
          "no_production_reason"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "owner_ref": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          },
          "no_production_reason": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "command",
              "local",
              "non_dispatch"
            ]
          },
          "action_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "production_entries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "setting_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "quick_set_ref": {
            "type": "string",
            "pattern": "^(editor|terminal)\\.[a-z_]+$"
          },
          "reset_group_ref": {
            "type": "string",
            "pattern": "^(editor|terminal)\\.[a-z_]+$"
          },
          "concept_sources": {
            "description": "Source-name alignment only; these anchors are not native dispatcher, accessibility or effect proof.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "tokens",
                "concept_only"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^Concepts/.+\\.(js|css|json|html)$"
                },
                "tokens": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "concept_only": {
                  "const": true
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "command"
                }
              }
            },
            "then": {
              "properties": {
                "action_ids": {
                  "minItems": 1
                },
                "production_entries": {
                  "minItems": 1
                },
                "no_production_reason": {
                  "const": ""
                }
              }
            },
            "else": {
              "properties": {
                "production_entries": {
                  "maxItems": 0
                },
                "no_production_reason": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "held_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_ref",
          "direction",
          "reason"
        ],
        "properties": {
          "owner_ref": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
