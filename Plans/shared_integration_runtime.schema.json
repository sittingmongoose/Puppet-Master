    },
    "IntegrationCredentialLocalActionResult": {
      "allOf": [
        {
          "$ref": "https://puppetmaster.local/schemas/shared_integration_runtime/expansion/1.0.0/shared_integration_runtime_expansion_contracts.schema.json#/$defs/SIRLocalActionResult"
        },
        {
          "type": "object",
          "properties": {
            "action_id": {
              "enum": [
                "ui.credential_attachment.open_consumers",
                "ui.credential_attachment.open_details",
                "ui.credential_source.open_details"
              ]
            },
            "packet_token": {
              "enum": [
                "cmd.credential_attachment.open_consumers",
