{
  "$defs": {
    "platform_capability_catalog_entry": {
      "additionalProperties": false,
      "properties": {
        "allowed_evidence_sources": {
          "items": {
            "enum": [
              "live_runtime_discovery",
              "provider_policy_snapshot",
              "static_platform_baseline"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "capability_id": {
          "pattern": "^platform\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "type": "string"
        },
        "entry_state": {
          "enum": [
            "active",
            "deprecated",
            "retired"
          ]
        },
        "execution_classes": {
          "items": {
            "enum": [
              "direct_provider",
              "cli_bridged_provider",
              "server_bridged_provider"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "legacy_capability_key_aliases": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "owner_doc_ref": {
          "pattern": "^Plans/.+#[^#]+$",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "display_name",
        "owner_doc_ref",
        "entry_state",
        "execution_classes",
        "allowed_evidence_sources",
        "legacy_capability_key_aliases"
      ],
      "type": "object"
    },
    "platform_capability_ref": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^platform\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        "catalog_id": {
          "const": "pm.platform_capability_catalog"
        },
        "catalog_revision": {
          "minimum": 1,
          "type": "integer"
        },
        "catalog_schema_version": {
          "const": "1.0.0"
        },
        "ref_type": {
          "const": "platform_capability_catalog_entry"
        }
      },
      "required": [
        "ref_type",
        "catalog_id",
        "catalog_schema_version",
        "catalog_revision",
        "capability_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://puppetmaster.local/schemas/platform_capability_catalog/1.0.0/platform_capability_catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://puppetmaster.local/schemas/platform_capability_catalog/1.0.0/platform_capability_catalog.schema.json"
    },
    "catalog_id": {
      "const": "pm.platform_capability_catalog"
    },
    "catalog_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/platform_capability_catalog_entry"
      },
      "type": "array",
      "uniqueItems": true
    },
    "owner_doc_ref": {
      "const": "Plans/orchestrator-subagent-integration.md#platform-capability-manager"
    },
    "revision_state": {
      "enum": [
        "active",
        "superseded",
        "retired"
      ]
    },
    "schema_id": {
      "const": "pm.platform_capability_catalog.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "$schema",
    "schema_id",
    "schema_version",
    "catalog_id",
    "catalog_revision",
    "revision_state",
    "owner_doc_ref",
    "entries"
  ],
  "type": "object"
}
