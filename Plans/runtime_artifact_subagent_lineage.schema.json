{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.runtime_artifact.subagent_lineage.schema.v1",
  "title": "Runtime Artifact subagent_lineage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "artifact_id",
    "artifact_type",
    "project_id",
    "run_id",
    "attempt_id",
    "created_at_utc",
    "projection_freshness",
    "projection_health",
    "retention_class",
    "routing_refs",
    "type_payload"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.runtime_artifact.subagent_lineage.schema.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "const": "subagent_lineage"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "provider_attempt_ref": {
      "type": "string"
    },
    "usage_event_ref": {
      "type": "string"
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer_ref": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "detail_ref": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "source_surface": {
      "type": "string"
    },
    "projection_freshness": {
      "type": "string"
    },
    "projection_health": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "routing_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_attempt_ref",
        "child_attempt_refs"
      ],
      "properties": {
        "parent_attempt_ref": {
          "type": "string",
          "minLength": 1
        },
        "child_attempt_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parent_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "child_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1
        },
        "objective_ref": {
          "type": "string",
          "minLength": 1
        },
        "started_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "ended_at_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled",
            "blocked"
          ]
        },
        "result_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "child_run_id": {
          "type": "string",
          "minLength": 1
        },
        "child_thread_id": {
          "type": "string",
          "minLength": 1
        },
        "handoff_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "contains_raw_secrets": {
          "const": false
        }
      }
    }
  }
}
