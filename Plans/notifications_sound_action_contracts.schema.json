        "provider_kind",
        "destination_generation",
        "target_generation",
        "source_event_ref",
        "event_category",
        "test_send_mode",
        "outcome",
        "status_class",
        "http_status",
        "provider_message_id",
        "retry_count",
        "next_retry_time",
        "redaction_profile_ref",
        "request_digest",
        "response_digest",
        "credential_refs",
        "receipt_ref",
        "persisted_event_refs",
        "alert_state_mutated",
        "secret_refs_only",
        "observed_at"
      ],
      "properties": {
        "schema_id": {"const": "pm.notifications_sound.destination_test_result.v1"},
        "record_kind": {"const": "notification_destination_test_result"},
        "command_id": {"const": "cmd.notifications.destination.test"},
        "command_instance_id": {"$ref": "#/$defs/non_secret_ref"},
        "dispatch_id": {"$ref": "#/$defs/non_secret_ref"},
        "original_request_ref": {"$ref": "#/$defs/non_secret_ref"},
        "sir_dispatch_ref": {"$ref": "#/$defs/non_secret_ref"},
        "dispatcher_ref": {"$ref": "#/$defs/non_secret_ref"},
        "delivery_attempt_id": {"$ref": "#/$defs/non_secret_ref"},
        "destination_ref": {"$ref": "#/$defs/non_secret_ref"},
        "provider_kind": {"$ref": "#/$defs/provider_kind"},
        "destination_generation": {"$ref": "#/$defs/generation"},
        "target_generation": {"$ref": "#/$defs/generation"},
        "source_event_ref": {"$ref": "#/$defs/non_secret_ref"},
        "event_category": {"const": "test_send"},
        "test_send_mode": {"enum": ["mock", "live"]},
        "outcome": {
          "enum": [
            "delivered",
            "queued",
            "rate_limited",
            "failed_transient",
            "failed_permanent",
            "denied",
            "unavailable",
            "effect_unknown"
          ]
        },
        "status_class": {
          "enum": ["success", "transient_failure", "permanent_failure", "rate_limited", "unknown"]
        },
        "http_status": {
          "oneOf": [
            {"type": "integer", "minimum": 100, "maximum": 599},
            {"type": "null"}
          ]
        },
        "provider_message_id": {
          "oneOf": [
            {"$ref": "#/$defs/non_secret_ref"},
            {"type": "null"}
          ]
        },
        "retry_count": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "next_retry_time": {
          "oneOf": [
            {"$ref": "#/$defs/utc"},
            {"type": "null"}
          ]
        },
        "redaction_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "response_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "credential_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_secret_ref"}
        },
        "receipt_ref": {"$ref": "#/$defs/non_secret_ref"},
        "persisted_event_refs": {
          "description": "Expected event types stay empty; no persistent domain event is admitted for this action.",
          "type": "array",
          "maxItems": 0,
          "items": {"$ref": "#/$defs/non_secret_ref"}
        },
        "alert_state_mutated": {"const": false},
        "secret_refs_only": {"const": true},
        "observed_at": {"$ref": "#/$defs/utc"}
      }
    },
