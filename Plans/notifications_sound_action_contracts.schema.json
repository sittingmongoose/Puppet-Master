        "redaction_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "admitted_at": {"$ref": "#/$defs/utc"}
      }
    },
    "notification_destination_record": {
      "description": "SP-222 notification destination record subset used by the destination-test joins: enabled state, event-category allowlist, rate-limit/idempotency profiles, provider profile identity and the owner-issued last test receipt ref.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "scope",
        "destination_ref",
        "provider_kind",
        "enabled",
        "event_category_allowlist",
        "quiet_or_focus_policy_ref",
        "rate_limit_profile_ref",
        "idempotency_profile_ref",
        "last_test_receipt_ref",
        "generation"
      ],
      "properties": {
        "schema_id": {"const": "pm.notifications_sound.destination_record.v1"},
        "record_kind": {"const": "notification_destination"},
        "scope": {"$ref": "#/$defs/destination_scope"},
        "destination_ref": {"$ref": "#/$defs/non_secret_ref"},
        "provider_kind": {"$ref": "#/$defs/provider_kind"},
        "enabled": {"type": "boolean"},
        "event_category_allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "run_blocked",
              "approval_required",
              "human_input_requested",
              "run_failed",
              "run_completed",
              "goal_blocked",
              "provider_attention",
              "system_error",
              "security_attention",
              "quiet_digest",
              "test_send"
            ]
          }
        },
        "quiet_or_focus_policy_ref": {"$ref": "#/$defs/non_secret_ref"},
        "rate_limit_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "idempotency_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "last_test_receipt_ref": {
          "oneOf": [
            {"$ref": "#/$defs/non_secret_ref"},
            {"type": "null"}
          ]
        },
        "generation": {"$ref": "#/$defs/generation"}
      }
    },
    "destination_test_result": {
      "description": "Owner delivery-attempt outcome and secret-safe CV-298 receipt values. 'queued' and 'rate_limited' are nonterminal attempt states and never delivery success.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "command_id",
        "command_instance_id",
        "dispatch_id",
        "original_request_ref",
        "sir_dispatch_ref",
        "dispatcher_ref",
        "delivery_attempt_id",
