{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/notifications-sound-actions/1.0.0/notifications_sound_action_contracts.schema.json",
  "title": "Puppet Master Notifications and Sounds typed action companion",
  "description": "Closed static typed request/result/error/availability/currentness/effect companion for exactly cmd.notifications.destination.test and cmd.sound.preview (UCC-103, CV-298, PS-124, SP-222, F3-405, WM-039, RAP-039, ATS-016). It is technical specification only: shape validity, a schema-valid boolean, a copied ref, a hash equality or fixture self-consistency authenticates no issuer, dispatcher, permission, delivery attempt, audio device, receipt writer or physical custody. Handler status stays specified and both Touch rows stay partial.",
  "x-owner-ref": "Plans/UI_Command_Catalog.md#UCC-103",
  "x-owner-units": [
    "Plans/Contracts_V0.md#CV-298",
    "Plans/UI_Command_Catalog.md#UCC-103",
    "Plans/Permissions_System.md#PS-124",
    "Plans/storage-plan.md#SP-222",
    "Plans/FinalGUISpec.md#F3-405",
    "Plans/Wiring_Matrix.md#WM-039",
    "Plans/Runtime_Artifacts_Panel.md#RAP-039",
    "Plans/Automated_Testing_System.md#ATS-016",
    "Plans/Contracts_V0.md#CV-333",
    "Plans/Shared_Integration_Runtime.md#SIR-042"
  ],
  "x-action-scope": [
    "cmd.notifications.destination.test",
    "cmd.sound.preview"
  ],
  "x-negative-constraints": [
    "No new command, command alias, EventRecord, storage key, TTL, probe count, retry policy, destination provider or numerical default is introduced.",
    "cmd.settings.open_notifications stays retired, unregistered and non-alias.",
    "Queue admission, rate-limit admission or central acknowledgement is never delivery success.",
    "Mock and live test-send evidence remain distinct; local preview never sends externally and mutates no sound asset.",
    "No PM alert-state mutation, and no Runtime Artifacts delivery, storage, permission or alert-state authority."
  ],
  "oneOf": [
    {"$ref": "#/$defs/destination_test_request"},
    {"$ref": "#/$defs/destination_test_original"},
    {"$ref": "#/$defs/notification_destination_record"},
    {"$ref": "#/$defs/destination_test_result"},
    {"$ref": "#/$defs/sound_preview_request"},
    {"$ref": "#/$defs/sound_preview_original"},
    {"$ref": "#/$defs/sound_preview_result"},
    {"$ref": "#/$defs/availability_projection"},
    {"$ref": "#/$defs/action_error"},
    {"$ref": "#/$defs/destination_test_effect_binding"},
    {"$ref": "#/$defs/sound_preview_effect_binding"},
    {"$ref": "#/$defs/receipt_projection"}
  ],
  "$defs": {
    "action_id": {
      "description": "Exact action-qualified closure of the two authored routes; no other command, alias or sound-family member is admitted.",
      "enum": [
        "cmd.notifications.destination.test",
        "cmd.sound.preview"
      ]
    },
    "digest": {
      "description": "Bare lowercase SHA-256 hex, the form the existing Full Thread Sha256 contract and the owner digests use.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utc": {
      "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/UtcTimestamp"
    },
    "non_secret_ref": {
      "description": "Secret-free reference grammar owned by the shared runtime command contracts.",
      "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_secret_ref"
    },
    "identity_envelope": {
      "description": "Actual existing Full Thread IdentityEnvelope; no local identity is invented for this companion.",
      "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/IdentityEnvelope"
    },
    "central_error_code": {
      "description": "The exact closed central UICommandError code enumeration, reused by reference instead of restated.",
      "$ref": "https://puppetmaster.local/schemas/ui_command_response/2.0.0/ui_command_response.schema.json#/$defs/UICommandError/properties/code"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "destination_scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "global"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "project_ref"],
          "properties": {
            "kind": {"const": "project"},
            "project_ref": {"$ref": "#/$defs/non_secret_ref"}
          }
        }
      ]
    },
    "provider_kind": {
      "description": "CV-298 destination providers and the in-app/system/sound destinations; no additional provider is admitted.",
      "enum": [
        "slack",
        "discord",
        "generic_webhook",
        "ntfy",
        "pushover",
        "telegram",
        "in_app_toast_banner",
        "system_tray",
        "sound"
      ]
    },
    "sound_source_kind": {
      "description": "SP-222 sound manifest source_kind vocabulary.",
      "enum": ["built_in", "user_uploaded", "imported"]
    },
    "disabled_reason": {
      "description": "Closed disabled-reason set derived from the TCP-NOTIFY-SOUND rule (unavailable destination/asset, rate, policy, permission, handler). It is not a new permission or event vocabulary.",
      "enum": [
        "unavailable_destination",
        "unavailable_asset",
        "rate_limited",
        "policy_refused",
        "permission_denied",
        "handler_unavailable"
      ]
    },
    "destination_test_permission_basis": {
      "description": "PS-124/UCC-103 admission facts recorded by the notification destination owner; credential material appears as a ref only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_action",
        "destination_enabled",
        "live_send_authority",
        "rate_limit_admitted",
        "rate_limit_profile_ref",
        "credential_ref"
      ],
      "properties": {
        "explicit_action": {"const": true},
        "destination_enabled": {"type": "boolean"},
        "live_send_authority": {"type": "boolean"},
        "rate_limit_admitted": {"type": "boolean"},
        "rate_limit_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "credential_ref": {"$ref": "#/$defs/non_secret_ref"}
      }
    },
    "sound_preview_permission_basis": {
      "description": "Permissions-owned human read admission plus F3-405 explicit-gesture and availability facts for local playback.",
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_gesture", "read_admission", "asset_available", "asset_hidden"],
      "properties": {
        "explicit_gesture": {"const": true},
        "read_admission": {"type": "boolean"},
        "asset_available": {"type": "boolean"},
        "asset_hidden": {"type": "boolean"}
      }
    },
    "destination_test_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "command_id",
        "handler_id",
        "original_request_ref",
        "command_instance_id",
        "dispatch_id",
        "caller_ref",
        "sir_dispatch_ref",
        "dispatcher_ref",
        "scope",
        "destination_ref",
        "provider_kind",
        "destination_generation",
        "expected_target_generation",
        "explicit_action",
        "test_send_mode",
        "credential_ref",
        "redaction_profile_ref",
        "source_event_ref",
        "attention_key",
        "event_family",
        "event_category",
        "rate_limit_admission_ref",
        "permission_admission_ref",
        "idempotency_key",
        "secret_refs_only"
      ],
      "properties": {
        "schema_id": {"const": "pm.notifications_sound.destination_test_request.v1"},
        "command_id": {"const": "cmd.notifications.destination.test"},
        "handler_id": {"const": "handlers::notifications::destination_test"},
        "original_request_ref": {"$ref": "#/$defs/non_secret_ref"},
        "command_instance_id": {"$ref": "#/$defs/non_secret_ref"},
        "dispatch_id": {"$ref": "#/$defs/non_secret_ref"},
        "caller_ref": {"$ref": "#/$defs/non_secret_ref"},
        "sir_dispatch_ref": {"$ref": "#/$defs/non_secret_ref"},
        "dispatcher_ref": {"$ref": "#/$defs/non_secret_ref"},
        "scope": {"$ref": "#/$defs/destination_scope"},
        "destination_ref": {"$ref": "#/$defs/non_secret_ref"},
        "provider_kind": {"$ref": "#/$defs/provider_kind"},
        "destination_generation": {"$ref": "#/$defs/generation"},
        "expected_target_generation": {"$ref": "#/$defs/generation"},
        "explicit_action": {"const": true},
        "test_send_mode": {"enum": ["mock", "live"]},
        "credential_ref": {"$ref": "#/$defs/non_secret_ref"},
        "redaction_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_event_ref": {"$ref": "#/$defs/non_secret_ref"},
        "attention_key": {"$ref": "#/$defs/non_secret_ref"},
        "event_family": {"const": "test_send"},
        "event_category": {"const": "test_send"},
        "rate_limit_admission_ref": {"$ref": "#/$defs/non_secret_ref"},
        "permission_admission_ref": {"$ref": "#/$defs/non_secret_ref"},
        "idempotency_key": {"$ref": "#/$defs/non_secret_ref"},
        "secret_refs_only": {"const": true}
      }
    },
    "destination_test_original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "command_id",
        "request_ref",
        "command_instance_id",
        "dispatch_id",
        "caller_ref",
        "scope",
        "destination_ref",
        "destination_record_ref",
