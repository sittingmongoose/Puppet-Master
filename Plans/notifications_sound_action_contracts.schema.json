              "unredacted_identity"
            ]
          }
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inspect", "show_in_ledger", "show_source_event", "export"],
          "properties": {
            "inspect": {"const": "runtime_artifacts.inspect"},
            "show_in_ledger": {"const": "runtime_artifacts.show_in_ledger"},
            "show_source_event": {"const": "runtime_artifacts.show_source_event"},
            "export": {"const": "runtime_artifacts.export"}
          }
        },
        "secret_material_present": {"const": false},
        "authority": {"const": "projection_only_no_delivery_storage_permission_or_alert_state_authority"}
      }
    }
  }
}
