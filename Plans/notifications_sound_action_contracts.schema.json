    "availability_projection": {
      "description": "Action-qualified projected availability and currentness read from the existing production state selectors.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "availability_selector",
        "disabled_reason_selector",
        "availability",
        "disabled_reason",
        "currentness",
        "evaluated_at"
      ],
      "properties": {
        "schema_id": {"const": "pm.notifications_sound.availability.v1"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "availability_selector": {"type": "string", "minLength": 1},
        "disabled_reason_selector": {"type": "string", "minLength": 1},
        "availability": {"enum": ["available", "unavailable", "disabled"]},
        "disabled_reason": {
          "oneOf": [
            {"$ref": "#/$defs/disabled_reason"},
            {"type": "null"}
          ]
        },
        "currentness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_generation", "observed_generation", "stale"],
          "properties": {
            "target_generation": {"$ref": "#/$defs/generation"},
            "observed_generation": {"$ref": "#/$defs/generation"},
            "stale": {"type": "boolean"}
          }
        },
        "evaluated_at": {"$ref": "#/$defs/utc"}
      },
      "allOf": [
        {
          "if": {"properties": {"action_id": {"const": "cmd.notifications.destination.test"}}},
          "then": {
            "properties": {
              "availability_selector": {"const": "state.commands.notifications_destination_test.availability"},
              "disabled_reason_selector": {"const": "state.commands.notifications_destination_test.disabled_reason"},
              "disabled_reason": {
                "oneOf": [
                  {
                    "enum": [
                      "unavailable_destination",
                      "rate_limited",
                      "policy_refused",
                      "permission_denied",
                      "handler_unavailable"
                    ]
                  },
                  {"type": "null"}
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"action_id": {"const": "cmd.sound.preview"}}},
          "then": {
            "properties": {
              "availability_selector": {"const": "state.commands.sound_preview.availability"},
              "disabled_reason_selector": {"const": "state.commands.sound_preview.disabled_reason"},
              "disabled_reason": {
                "oneOf": [
                  {
                    "enum": [
                      "unavailable_asset",
                      "policy_refused",
                      "permission_denied",
                      "handler_unavailable"
                    ]
                  },
                  {"type": "null"}
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"availability": {"const": "available"}}},
          "then": {
            "properties": {
              "disabled_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"availability": {"enum": ["unavailable", "disabled"]}}},
          "then": {
            "properties": {"disabled_reason": {"$ref": "#/$defs/disabled_reason"}}
          }
        }
      ]
    },
    "action_error": {
      "description": "Action-qualified error projection over the unchanged closed central UICommandError grammar; no new error code is introduced.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "action_id", "phase", "code", "reason", "offending_field", "availability_reason"],
      "properties": {
        "schema_id": {"const": "pm.notifications_sound.action_error.v1"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "phase": {"enum": ["pre_dispatch", "post_dispatch", "execution"]},
        "code": {"$ref": "#/$defs/central_error_code"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512},
        "offending_field": {
          "oneOf": [
            {"type": "string", "maxLength": 160},
            {"type": "null"}
          ]
        },
        "availability_reason": {
          "oneOf": [
            {"$ref": "#/$defs/disabled_reason"},
            {"type": "null"}
          ]
        }
      }
    },
    "destination_test_effect_binding": {
      "description": "Exact existing-owner effect values for cmd.notifications.destination.test as declared by the current production-intent row.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "effect_kind",
        "receipt_or_event_refs",
        "expected_event_types",
        "receipt_kind",
        "external_send_rule",
        "alert_state_mutation_authorized",
        "projection_owner_ref"
      ],
      "properties": {
        "schema_id": {"const": "pm.notifications_sound.effect_binding.v1"},
        "action_id": {"const": "cmd.notifications.destination.test"},
        "effect_kind": {"const": "receipt"},
        "receipt_or_event_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"const": "cmd.notifications.destination.test.dispatch_receipt"}
        },
        "expected_event_types": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "receipt_kind": {"const": "owner_delivery_attempt_receipt"},
        "external_send_rule": {"const": "explicit_action_and_enabled_destination_and_live_send_authority_and_rate_limit_admission"},
        "alert_state_mutation_authorized": {"const": false},
        "projection_owner_ref": {"const": "Plans/Runtime_Artifacts_Panel.md#RAP-039"}
      }
    },
    "sound_preview_effect_binding": {
      "description": "Exact existing-owner effect values for cmd.sound.preview: a receipt-only, local-only, non-mutating playback action with no RAP-039 destination-test/export projection.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "effect_kind",
        "receipt_or_event_refs",
        "expected_event_types",
        "receipt_kind",
        "external_send_rule",
        "alert_state_mutation_authorized",
        "projection_owner_ref"
      ],
      "properties": {
        "schema_id": {"const": "pm.notifications_sound.effect_binding.v1"},
        "action_id": {"const": "cmd.sound.preview"},
        "effect_kind": {"const": "receipt"},
        "receipt_or_event_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"const": "cmd.sound.preview.dispatch_receipt"}
        },
        "expected_event_types": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "receipt_kind": {"const": "owner_local_playback_receipt"},
        "external_send_rule": {"const": "never"},
        "alert_state_mutation_authorized": {"const": false},
        "projection_owner_ref": {"const": null}
      }
    },
    "receipt_projection": {
      "description": "RAP-039 Runtime Artifacts projection of the destination-test delivery receipt: canonical refs, disclosed redactions, mock-versus-live marking and no gained authority. Local preview is out of this projection.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "receipt_ref",
        "source_event_ref",
        "delivery_attempt_id",
        "mock_or_live",
        "redaction_profile_ref",
        "redacted_fields",
        "routes",
        "secret_material_present",
        "authority"
      ],
      "properties": {
        "schema_id": {"const": "pm.notifications_sound.receipt_projection.v1"},
        "action_id": {"const": "cmd.notifications.destination.test"},
        "receipt_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_event_ref": {"$ref": "#/$defs/non_secret_ref"},
        "delivery_attempt_id": {"$ref": "#/$defs/non_secret_ref"},
        "mock_or_live": {"enum": ["mock", "live"]},
        "redaction_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "redacted_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
