{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/sound-asset-export-actions/1.0.0/sound_asset_export_action_contracts.schema.json",
  "title": "Puppet Master Sound asset export typed action companion",
  "description": "Closed static typed request/result/error/availability/currentness/effect/projection companion for exactly cmd.sound.asset.export (UCC-103, CV-298, CV-333, PS-124, SP-222, F3-405, WM-039, RAP-039, ATS-016, FileSafe). It is technical specification only: shape validity, a schema-valid boolean, a copied ref, a hash equality or fixture self-consistency authenticates no issuer, dispatcher, permission, handler, receipt writer, export writer or physical custody. Handler status stays specified and the Touch row stays partial.",
  "x-owner-ref": "Plans/UI_Command_Catalog.md#UCC-103",
  "x-owner-units": [
    "Plans/Contracts_V0.md#CV-298",
    "Plans/Contracts_V0.md#CV-333",
    "Plans/UI_Command_Catalog.md#UCC-103",
    "Plans/Permissions_System.md#PS-124",
    "Plans/storage-plan.md#SP-222",
    "Plans/FinalGUISpec.md#F3-405",
    "Plans/Wiring_Matrix.md#WM-039",
    "Plans/Runtime_Artifacts_Panel.md#RAP-039",
    "Plans/Automated_Testing_System.md#ATS-016",
    "Plans/Shared_Integration_Runtime.md#SIR-042",
    "Plans/FileSafe.md"
  ],
  "x-action-scope": [
    "cmd.sound.asset.export"
  ],
  "x-negative-constraints": [
    "No new command, command alias, EventRecord, storage key, TTL, export size cap, duration limit or numerical default is introduced.",
    "Export output reports the actual Sound-owner result with source/license/version/hash metadata and never secret material, raw provider URLs, tokens or private paths; the output target stays a canonical ref bound to the FileSafe write scope.",
    "Export never mutates the selected asset and never sends externally; Runtime Artifacts projects export evidence without gaining export, storage, permission or alert-state authority.",
    "No persistent domain event is admitted; expected event types stay empty.",
    "A schema-valid boolean, a copied ref or a matching hash never authenticates an owner issuer, dispatcher or receipt writer."
  ],
  "oneOf": [
    {"$ref": "#/$defs/export_request"},
    {"$ref": "#/$defs/export_original"},
    {"$ref": "#/$defs/sound_asset_manifest_record"},
    {"$ref": "#/$defs/export_result"},
    {"$ref": "#/$defs/availability_projection"},
    {"$ref": "#/$defs/action_error"},
    {"$ref": "#/$defs/export_effect_binding"},
    {"$ref": "#/$defs/export_evidence_projection"}
  ],
  "$defs": {
    "action_id": {
      "description": "Exact action-qualified closure; no other command, alias or sound-family member is admitted by this companion.",
      "enum": ["cmd.sound.asset.export"]
    },
    "digest": {
      "description": "Bare lowercase SHA-256 hex, the form the existing Full Thread Sha256 contract and the owner digests use.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utc": {
      "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/UtcTimestamp"
    },
    "non_secret_ref": {
      "description": "Secret-free reference grammar owned by the shared runtime command contracts.",
      "$ref": "https://puppetmaster.local/schemas/shared_runtime_commands/1.0.0/shared_runtime_command_contracts.schema.json#/$defs/non_secret_ref"
    },
    "identity_envelope": {
      "description": "Actual existing Full Thread IdentityEnvelope; no local identity is invented for this companion.",
      "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/IdentityEnvelope"
    },
    "central_error_code": {
      "description": "The exact closed central UICommandError code enumeration, reused by reference instead of restated.",
      "$ref": "https://puppetmaster.local/schemas/ui_command_response/2.0.0/ui_command_response.schema.json#/$defs/UICommandError/properties/code"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "asset_scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "global"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "project_ref"],
          "properties": {
            "kind": {"const": "project"},
            "project_ref": {"$ref": "#/$defs/non_secret_ref"}
          }
        }
      ]
    },
    "sound_source_kind": {
      "description": "SP-222 sound manifest source_kind vocabulary, reused from the accepted Notifications/Sounds companion instead of restated.",
      "$ref": "https://puppetmaster.local/schemas/notifications-sound-actions/1.0.0/notifications_sound_action_contracts.schema.json#/$defs/sound_source_kind"
    },
    "redacted_field": {
      "description": "The closed PS-124/RAP-039 redaction disclosure vocabulary reused from the accepted Notifications/Sounds receipt projection.",
      "$ref": "https://puppetmaster.local/schemas/notifications-sound-actions/1.0.0/notifications_sound_action_contracts.schema.json#/$defs/receipt_projection/properties/redacted_fields/items"
    },
    "disabled_reason": {
      "description": "Closed disabled-reason subset for the export route: unavailable asset, policy, permission, handler. No rate vocabulary is introduced for this local action.",
      "enum": [
        "unavailable_asset",
        "policy_refused",
        "permission_denied",
        "handler_unavailable"
      ]
    },
    "export_permission_basis": {
      "description": "PS-124 read admission plus the FileSafe-bound output facts recorded by the Sound asset owner: explicit user action, asset presence, read admission and an output target bound to the allowed-file write scope.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_action",
        "asset_present",
        "read_admission",
        "output_scope_bound"
      ],
      "properties": {
        "explicit_action": {"const": true},
        "asset_present": {"type": "boolean"},
        "read_admission": {"type": "boolean"},
        "output_scope_bound": {"type": "boolean"}
      }
    },
    "export_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "command_id",
        "handler_id",
        "original_request_ref",
        "command_instance_id",
        "dispatch_id",
        "caller_ref",
        "sir_dispatch_ref",
        "dispatcher_ref",
        "scope",
        "asset_ref",
        "source_kind",
        "asset_generation",
        "expected_target_generation",
        "explicit_action",
        "selection_gesture_ref",
        "permission_admission_ref",
        "output_target_ref",
        "redaction_profile_ref",
        "include_source_metadata",
        "include_license_metadata",
        "include_version_metadata",
        "include_hash_metadata",
        "external_send",
        "asset_mutation",
        "idempotency_key",
        "secret_refs_only"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.export_request.v1"},
        "command_id": {"const": "cmd.sound.asset.export"},
        "handler_id": {"const": "handlers::sound::asset_export"},
        "original_request_ref": {"$ref": "#/$defs/non_secret_ref"},
        "command_instance_id": {"$ref": "#/$defs/non_secret_ref"},
        "dispatch_id": {"$ref": "#/$defs/non_secret_ref"},
        "caller_ref": {"$ref": "#/$defs/non_secret_ref"},
        "sir_dispatch_ref": {"$ref": "#/$defs/non_secret_ref"},
        "dispatcher_ref": {"$ref": "#/$defs/non_secret_ref"},
        "scope": {"$ref": "#/$defs/asset_scope"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_kind": {"$ref": "#/$defs/sound_source_kind"},
        "asset_generation": {"$ref": "#/$defs/generation"},
        "expected_target_generation": {"$ref": "#/$defs/generation"},
        "explicit_action": {"const": true},
        "selection_gesture_ref": {"$ref": "#/$defs/non_secret_ref"},
        "permission_admission_ref": {"$ref": "#/$defs/non_secret_ref"},
        "output_target_ref": {
          "description": "Canonical secret-free export output target inside the FileSafe-bound write scope; never a raw local path.",
          "$ref": "#/$defs/non_secret_ref"
        },
        "redaction_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "include_source_metadata": {"const": true},
        "include_license_metadata": {"const": true},
        "include_version_metadata": {"const": true},
        "include_hash_metadata": {"const": true},
        "external_send": {"const": false},
        "asset_mutation": {"const": false},
        "idempotency_key": {"$ref": "#/$defs/non_secret_ref"},
        "secret_refs_only": {"const": true}
      }
    },
    "export_original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "command_id",
        "request_ref",
        "command_instance_id",
        "dispatch_id",
        "caller_ref",
        "scope",
        "asset_ref",
        "source_kind",
        "asset_generation",
        "target_generation",
        "manifest_record_ref",
        "output_target_ref",
        "redaction_profile_ref",
        "permission_basis",
        "selection_gesture_ref",
        "idempotency_key",
        "payload_sha256",
        "arguments_sha256",
        "admitted_at"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.export_original.v1"},
        "record_kind": {"const": "sound_asset_export_original"},
        "command_id": {"const": "cmd.sound.asset.export"},
        "request_ref": {"$ref": "#/$defs/non_secret_ref"},
        "command_instance_id": {"$ref": "#/$defs/non_secret_ref"},
        "dispatch_id": {"$ref": "#/$defs/non_secret_ref"},
        "caller_ref": {"$ref": "#/$defs/non_secret_ref"},
        "scope": {"$ref": "#/$defs/asset_scope"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_kind": {"$ref": "#/$defs/sound_source_kind"},
        "asset_generation": {"$ref": "#/$defs/generation"},
        "target_generation": {"$ref": "#/$defs/generation"},
        "manifest_record_ref": {"$ref": "#/$defs/non_secret_ref"},
        "output_target_ref": {"$ref": "#/$defs/non_secret_ref"},
        "redaction_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "permission_basis": {"$ref": "#/$defs/export_permission_basis"},
        "selection_gesture_ref": {"$ref": "#/$defs/non_secret_ref"},
        "idempotency_key": {"$ref": "#/$defs/non_secret_ref"},
        "payload_sha256": {"$ref": "#/$defs/digest"},
        "arguments_sha256": {"$ref": "#/$defs/digest"},
        "admitted_at": {"$ref": "#/$defs/utc"}
      }
    },
    "sound_asset_manifest_record": {
      "description": "SP-222 sound asset manifest subset used by the export joins: identity plus the mandatory source/license/version/hash metadata fields that export must carry without secrets. No storage family, key or retention schedule is admitted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "scope",
        "asset_ref",
        "source_kind",
        "display_name",
        "source_url_or_package_ref",
        "license_ref",
        "attribution",
        "version",
        "format",
        "duration_ms",
        "content_sha256",
        "generation"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.manifest_record.v1"},
        "record_kind": {"const": "sound_asset"},
        "scope": {"$ref": "#/$defs/asset_scope"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_kind": {"$ref": "#/$defs/sound_source_kind"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_url_or_package_ref": {"$ref": "#/$defs/non_secret_ref"},
        "license_ref": {"$ref": "#/$defs/non_secret_ref"},
        "attribution": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "format": {"enum": ["WAV", "MP3", "OGG"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "generation": {"$ref": "#/$defs/generation"}
      }
    },
    "export_result": {
      "description": "Actual Sound-owner export outcome with the redacted source/license/version/hash metadata disclosure. Export never mutates the asset, never sends externally and never exposes secret material or private paths.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "command_id",
        "command_instance_id",
        "dispatch_id",
        "original_request_ref",
        "sir_dispatch_ref",
        "dispatcher_ref",
        "asset_ref",
        "source_kind",
        "asset_generation",
        "target_generation",
        "outcome",
        "output_target_ref",
        "output_path_disclosure",
        "external_send",
        "asset_mutated",
        "substituted_asset_ref",
        "source_metadata_included",
        "license_metadata_included",
        "version_metadata_included",
        "hash_metadata_included",
        "redaction_profile_ref",
        "redacted_fields",
        "request_digest",
        "bundle_digest",
        "receipt_ref",
        "persisted_event_refs",
        "alert_state_mutated",
        "secret_refs_only",
        "observed_at"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.export_result.v1"},
        "record_kind": {"const": "sound_asset_export_result"},
        "command_id": {"const": "cmd.sound.asset.export"},
        "command_instance_id": {"$ref": "#/$defs/non_secret_ref"},
        "dispatch_id": {"$ref": "#/$defs/non_secret_ref"},
        "original_request_ref": {"$ref": "#/$defs/non_secret_ref"},
        "sir_dispatch_ref": {"$ref": "#/$defs/non_secret_ref"},
        "dispatcher_ref": {"$ref": "#/$defs/non_secret_ref"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "source_kind": {"$ref": "#/$defs/sound_source_kind"},
        "asset_generation": {"$ref": "#/$defs/generation"},
        "target_generation": {"$ref": "#/$defs/generation"},
        "outcome": {
          "enum": [
            "export_completed",
            "unavailable",
            "failed",
            "effect_unknown"
          ]
        },
        "output_target_ref": {"$ref": "#/$defs/non_secret_ref"},
        "output_path_disclosure": {"const": "canonical_ref_only_no_private_path"},
        "external_send": {"const": false},
        "asset_mutated": {"const": false},
        "substituted_asset_ref": {"const": null},
        "source_metadata_included": {"type": "boolean"},
        "license_metadata_included": {"type": "boolean"},
        "version_metadata_included": {"type": "boolean"},
        "hash_metadata_included": {"type": "boolean"},
        "redaction_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "redacted_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/redacted_field"}
        },
        "request_digest": {"$ref": "#/$defs/digest"},
        "bundle_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "receipt_ref": {"$ref": "#/$defs/non_secret_ref"},
        "persisted_event_refs": {
          "description": "Expected event types stay empty; the export outcome admits no persistent domain event.",
          "type": "array",
          "maxItems": 0,
          "items": {"$ref": "#/$defs/non_secret_ref"}
        },
        "alert_state_mutated": {"const": false},
        "secret_refs_only": {"const": true},
        "observed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "availability_projection": {
      "description": "Action-qualified projected availability and currentness read from the existing production state selectors.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "availability_selector",
        "disabled_reason_selector",
        "availability",
        "disabled_reason",
        "currentness",
        "evaluated_at"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.availability.v1"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "availability_selector": {"const": "state.commands.sound_asset_export.availability"},
        "disabled_reason_selector": {"const": "state.commands.sound_asset_export.disabled_reason"},
        "availability": {"enum": ["available", "unavailable", "disabled"]},
        "disabled_reason": {
          "oneOf": [
            {"$ref": "#/$defs/disabled_reason"},
            {"type": "null"}
          ]
        },
        "currentness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_generation", "observed_generation", "stale"],
          "properties": {
            "target_generation": {"$ref": "#/$defs/generation"},
            "observed_generation": {"$ref": "#/$defs/generation"},
            "stale": {"type": "boolean"}
          }
        },
        "evaluated_at": {"$ref": "#/$defs/utc"}
      },
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "available"}}},
          "then": {"properties": {"disabled_reason": {"type": "null"}}}
        },
        {
          "if": {"properties": {"availability": {"enum": ["unavailable", "disabled"]}}},
          "then": {"properties": {"disabled_reason": {"$ref": "#/$defs/disabled_reason"}}}
        }
      ]
    },
    "action_error": {
      "description": "Action-qualified error projection over the unchanged closed central UICommandError grammar; no new error code is introduced.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "action_id", "phase", "code", "reason", "offending_field", "availability_reason"],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.action_error.v1"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "phase": {"enum": ["pre_dispatch", "post_dispatch", "execution"]},
        "code": {"$ref": "#/$defs/central_error_code"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512},
        "offending_field": {
          "oneOf": [
            {"type": "string", "maxLength": 160},
            {"type": "null"}
          ]
        },
        "availability_reason": {
          "oneOf": [
            {"$ref": "#/$defs/disabled_reason"},
            {"type": "null"}
          ]
        }
      }
    },
    "export_effect_binding": {
      "description": "Exact existing-owner effect values for cmd.sound.asset.export as declared by the current production-intent row: a receipt-only export outcome with redacted evidence; Runtime Artifacts (RAP-039) projects it without gaining authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "effect_kind",
        "receipt_or_event_refs",
        "expected_event_types",
        "receipt_kind",
        "external_send_rule",
        "alert_state_mutation_authorized",
        "projection_owner_ref"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.effect_binding.v1"},
        "action_id": {"const": "cmd.sound.asset.export"},
        "effect_kind": {"const": "receipt"},
        "receipt_or_event_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"const": "cmd.sound.asset.export.dispatch_receipt"}
        },
        "expected_event_types": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "receipt_kind": {"const": "owner_export_receipt"},
        "external_send_rule": {"const": "never"},
        "alert_state_mutation_authorized": {"const": false},
        "projection_owner_ref": {"const": "Plans/Runtime_Artifacts_Panel.md#RAP-039"}
      }
    },
    "export_evidence_projection": {
      "description": "RAP-039 Runtime Artifacts projection of the export evidence: canonical receipt/source refs, disclosed redactions, no secret material and no gained authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "action_id",
        "receipt_ref",
        "asset_ref",
        "output_target_ref",
        "bundle_digest",
        "redaction_profile_ref",
        "redacted_fields",
        "routes",
        "secret_material_present",
        "authority"
      ],
      "properties": {
        "schema_id": {"const": "pm.sound_asset.export_evidence_projection.v1"},
        "action_id": {"const": "cmd.sound.asset.export"},
        "receipt_ref": {"$ref": "#/$defs/non_secret_ref"},
        "asset_ref": {"$ref": "#/$defs/non_secret_ref"},
        "output_target_ref": {"$ref": "#/$defs/non_secret_ref"},
        "bundle_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "redaction_profile_ref": {"$ref": "#/$defs/non_secret_ref"},
        "redacted_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/redacted_field"}
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inspect", "show_in_ledger", "show_source_event", "export"],
          "properties": {
            "inspect": {"const": "runtime_artifacts.inspect"},
            "show_in_ledger": {"const": "runtime_artifacts.show_in_ledger"},
            "show_source_event": {"const": "runtime_artifacts.show_source_event"},
            "export": {"const": "runtime_artifacts.export"}
          }
        },
        "secret_material_present": {"const": false},
        "authority": {"const": "projection_only_no_export_storage_permission_or_alert_state_authority"}
      }
    }
  }
}
