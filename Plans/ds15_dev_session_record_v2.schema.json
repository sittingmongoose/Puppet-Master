{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.ds15.dev_session_record.v2",
  "$ref": "#/$defs/dev_session_record",
  "$defs": {
    "dev_session_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "project_id",
        "dev_session_id",
        "workflow",
        "dap"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.dev_session_record.v2"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dev_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workflow": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "revision",
                "operation_id",
                "outcome_ref",
                "run_id",
                "thread_id",
                "workspace_tab_id",
                "terminal_session_id",
                "target_ref",
                "artifact_refs",
                "live_verification"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "created",
                    "running",
                    "stopping",
                    "stopped",
                    "restarting"
                  ]
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "operation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "outcome_ref": {
                  "description": "Stable non-secret reference. Raw credentials, tokens, auth values, credential paths, file contents, and provider-visible bytes are forbidden.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$(?![\\s\\S])"
                },
                "run_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "thread_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "workspace_tab_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "terminal_session_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "target_ref": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/non_secret_ref"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "artifact_refs": {
                  "$ref": "#/$defs/ref_list"
                },
                "live_verification": {
                  "enum": [
                    "verified",
                    "historical",
                    "recovery_required"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "dap": {
          "oneOf": [
            {
              "$ref": "#/$defs/dap_record_v1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "workflow": {
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "dap": {
              "type": "object"
            }
          }
        }
      ]
    },
    "dap_record_v1": {
      "title": "DebugSessionRecord using dev_session_record.v1 identity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "project_id",
        "dev_session_id",
        "dap_session_id",
        "topology",
        "adapter_capability_snapshot_ref",
        "owner_ref",
        "lease_ref",
        "session_generation",
        "permission_grant_ref",
        "policy_ref",
        "state",
        "waiter_arm_ref",
        "waiter_armed_at_utc",
        "triggered_at_utc",
        "log_refs",
        "artifact_refs",
        "cleanup_ref",
        "created_at_utc",
        "updated_at_utc",
        "terminal_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.dev_session_record.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dev_session_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dap_session_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "topology": {
          "$ref": "#/$defs/topology_identity"
        },
        "adapter_capability_snapshot_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "owner_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "lease_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "session_generation": {
          "type": "integer",
          "minimum": 0
        },
        "permission_grant_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "policy_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "state": {
          "enum": [
            "created",
            "awaiting_lease",
            "launching",
            "attaching",
            "running",
            "paused",
            "terminating",
            "terminated",
            "failed",
            "reconciling",
            "recovery_required"
          ]
        },
        "waiter_arm_ref": {
          "$ref": "#/$defs/nullable_non_secret_ref"
        },
        "waiter_armed_at_utc": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "triggered_at_utc": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "log_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "artifact_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "cleanup_ref": {
          "$ref": "#/$defs/nullable_non_secret_ref"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "terminal_at_utc": {
          "$ref": "#/$defs/nullable_timestamp"
        }
      }
    },
    "nullable_timestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_non_secret_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_secret_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "non_secret_ref": {
      "description": "Stable non-secret reference. Raw credentials, tokens, auth values, credential paths, file contents, and provider-visible bytes are forbidden.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$(?![\\s\\S])"
    },
    "ref_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_secret_ref"
      }
    },
    "topology_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_home_server_id",
        "execution_host_id",
        "execution_environment_id",
        "source_location_id",
        "topology_generation"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "project_home_server_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "execution_host_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "execution_environment_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_location_id": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "topology_generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nullable_non_empty_string": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_empty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
