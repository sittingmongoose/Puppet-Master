{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.storage.retention_hold_evidence.v2",
  "$defs": {
    "HoldCoreV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "hold_id",
        "hold_kind",
        "scope",
        "set_by_actor_ref",
        "set_reason",
        "set_at_utc",
        "cleared_by_actor_ref",
        "clear_reason",
        "cleared_at_utc",
        "event_refs",
        "redaction_profile"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.retention_hold_record.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "hold_id": {
          "type": "string",
          "minLength": 1
        },
        "hold_kind": {
          "enum": [
            "legal_hold",
            "preserved_run",
            "recent_run",
            "recovery_anchor",
            "manual_keep",
            "audit",
            "promotion",
            "evidence"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_kind"
          ],
          "properties": {
            "scope_kind": {
              "enum": [
                "application",
                "project",
                "thread",
                "run",
                "event",
                "safe_point",
                "receipt"
              ]
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "run_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "event_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "safe_point_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "receipt_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "set_by_actor_ref": {
          "type": "string",
          "minLength": 1
        },
        "set_reason": {
          "type": "string",
          "minLength": 1
        },
        "set_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "cleared_by_actor_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "clear_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "cleared_at_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "redaction_profile": {
          "enum": [
            "no_secrets",
            "redacted_refs_only"
          ]
        }
      }
    },
    "AppendReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence_id",
        "segment_generation",
        "segment_name",
        "byte_offset",
        "commit_group_id",
        "durability_class",
        "durable_end_offset",
        "durability_state",
        "manifest_generation",
        "acknowledged_at_utc"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "segment_generation": {
          "type": "integer",
          "minimum": 0
        },
        "segment_name": {
          "type": "string",
          "minLength": 1
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "commit_group_id": {
          "type": "string",
          "minLength": 1
        },
        "durability_class": {
          "enum": [
            "ordinary",
            "barrier"
          ]
        },
        "durable_end_offset": {
          "type": "integer",
          "minimum": 0
        },
        "durability_state": {
          "const": "synced"
        },
        "manifest_generation": {
          "type": "integer",
          "minimum": 0
        },
        "acknowledged_at_utc": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      }
    },
    "EventRecord": {
      "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json"
    },
    "CommandOutcome": {
      "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/CommandOutcomeRecord"
    },
    "Identity": {
      "$ref": "https://puppetmaster.local/schemas/full-thread-runtime-contracts.v1.json#/$defs/IdentityEnvelope"
    },
    "UIResponse": {
      "$ref": "https://puppetmaster.local/schemas/ui_command_response/2.0.0/ui_command_response.schema.json"
    },
    "read_token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "checkpoint_key",
        "checkpoint_ref",
        "generation_id",
        "generation_anchor_sha256",
        "frontier_revision",
        "frontier_sha256",
        "index_dataset_name",
        "source_selection",
        "redb_snapshot_id"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint_key": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "type": "string",
          "pattern": "^eig_[0-9a-f]{64}$"
        },
        "generation_anchor_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frontier_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "frontier_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index_dataset_name": {
          "type": "string",
          "minLength": 1
        },
        "source_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storage_instance_id",
            "current_ref",
            "current_bytes_sha256",
            "selected_segment_generation",
            "manifest_ref",
            "manifest_bytes_sha256",
            "manifest_generation",
            "recovery_epoch",
            "manifest_survivor_prefix_sha256",
            "retained_inventory_sha256",
            "durable_watermarks_sha256",
            "excluded_ranges_sha256",
            "retired_inputs_sha256"
          ],
          "properties": {
            "storage_instance_id": {
              "type": "string",
              "format": "uuid"
            },
            "current_ref": {
              "const": "storage/seglog/CURRENT"
            },
            "current_bytes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selected_segment_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "manifest_ref": {
              "const": "storage/seglog/manifest.v1.msgpack"
            },
            "manifest_bytes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifest_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "recovery_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "manifest_survivor_prefix_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retained_inventory_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "durable_watermarks_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "excluded_ranges_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retired_inputs_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "redb_snapshot_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_kind",
        "hold_id",
        "action",
        "semantic_scope_ref",
        "reason"
      ],
      "properties": {
        "scope_kind": {
          "enum": [
            "application",
            "project"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "hold_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "set",
            "clear"
          ]
        },
        "semantic_scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expected_hold_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "OriginalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_ref",
        "command_id",
        "command_instance_id",
        "idempotency_key",
        "actor_ref",
        "accepted_at_utc",
        "dispatch_id",
        "identity",
        "arguments"
      ],
      "properties": {
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "const": "cmd.storage.legal_hold.manage"
        },
        "command_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "actor_ref": {
          "type": "string",
          "minLength": 1
        },
        "accepted_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "dispatch_id": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "arguments": {
          "$ref": "#/$defs/Arguments"
        }
      }
    },
    "ResolvedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_ref",
        "scope",
        "policy_ref",
        "anchor_ref",
        "affected_semantic_refs"
      ],
      "properties": {
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_kind"
          ],
          "properties": {
            "scope_kind": {
              "enum": [
                "application",
                "project",
                "thread",
                "run",
                "event",
                "safe_point",
                "receipt"
              ]
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "run_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "event_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "safe_point_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "receipt_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "anchor_ref": {
          "type": "string",
          "minLength": 1
        },
        "affected_semantic_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "OwnerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "command_instance_id",
        "hold_key",
        "hold_id",
        "action",
        "status",
        "event_ref",
        "receipt_ref",
        "core_sha256"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage.legal_hold_result.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "command_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "hold_key": {
          "type": "string",
          "minLength": 1
        },
        "hold_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "set",
            "clear"
          ]
        },
        "status": {
          "enum": [
            "held",
            "cleared"
          ]
        },
        "event_ref": {
          "type": "string",
          "minLength": 1
        },
        "receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "core_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "OriginalPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "append_receipt",
        "source_value_sha256",
        "producer_semantic_digest",
        "payload_sha256"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "append_receipt": {
          "$ref": "#/$defs/AppendReceipt"
        },
        "source_value_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "producer_semantic_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Original exact first AppendReceipt plus verified immutable event hashes. Current source verification lives in the admission/read evidence; no obsolete original manifest snapshot is retained or reacquired."
    },
    "CommitBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "admission_id",
        "preimage_core_sha256",
        "committed_core_sha256"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "admission_id": {
          "type": "string",
          "minLength": 1
        },
        "preimage_core_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "committed_core_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "action",
        "phase",
        "request",
        "target",
        "preimage_core",
        "after_core",
        "receipt_ref",
        "event",
        "original_publication",
        "commit_binding",
        "owner_result",
        "command_outcome_ref",
        "command_outcome",
        "ui_response",
        "producer_intent",
        "pending_admission_id",
        "pending_sir_custody"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "set",
            "clear"
          ]
        },
        "phase": {
          "enum": [
            "prepared",
            "committed"
          ]
        },
        "request": {
          "$ref": "#/$defs/OriginalRequest"
        },
        "target": {
          "$ref": "#/$defs/ResolvedTarget"
        },
        "preimage_core": {
          "anyOf": [
            {
              "$ref": "#/$defs/HoldCoreV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_core": {
          "$ref": "#/$defs/HoldCoreV1"
        },
        "receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_publication": {
          "anyOf": [
            {
              "$ref": "#/$defs/OriginalPublication"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/OwnerResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "command_outcome_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "command_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "ui_response": {
          "anyOf": [
            {
              "$ref": "#/$defs/UIResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_id",
            "schema_version",
            "scope_kind",
            "event_id",
            "event_type",
            "project_id",
            "thread_id",
            "run_id",
            "node_id",
            "attempt_id",
            "actor_ref",
            "requested_account_ref",
            "effective_account_ref",
            "occurred_at_utc",
            "producer_sequence_id",
            "correlation_id",
            "causation_event_id",
            "parent_event_id",
            "idempotency_key",
            "payload_schema_id",
            "payload",
            "payload_ref",
            "redaction_profile",
            "replay_policy",
            "migration"
          ],
          "properties": {
            "schema_id": {
              "type": "string",
              "const": "pm.event.v0"
            },
            "schema_version": {
              "type": "string",
              "const": "2.0.0"
            },
            "scope_kind": {
              "type": "string",
              "enum": [
                "application",
                "project"
              ]
            },
            "event_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/non_empty_string"
            },
            "event_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
            },
            "project_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "thread_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "run_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "node_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "attempt_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "actor_ref": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/non_empty_string"
            },
            "requested_account_ref": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "effective_account_ref": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "occurred_at_utc": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/date_time_string"
            },
            "producer_sequence_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_negative_integer"
            },
            "correlation_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/non_empty_string"
            },
            "causation_event_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "parent_event_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "idempotency_key": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/non_empty_string"
            },
            "payload_schema_id": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/non_empty_string"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true
            },
            "payload_ref": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/nullable_non_empty_string"
            },
            "redaction_profile": {
              "type": "string",
              "enum": [
                "no_secrets",
                "redacted",
                "secret_refs_only"
              ]
            },
            "replay_policy": {
              "type": "string",
              "enum": [
                "append_once",
                "dedupe_by_event_id",
                "dedupe_by_idempotency_key",
                "projector_replay_only"
              ]
            },
            "migration": {
              "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json#/$defs/migration"
            }
          }
        },
        "pending_admission_id": {
          "type": "string",
          "minLength": 1
        },
        "pending_sir_custody": {
          "$ref": "#/$defs/PendingSIRCustody"
        }
      }
    },
    "LegacySetCustody": {
      "type": "object",
