{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/dcw/revision_run.schema.json",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "storage_instance_id",
    "recovery_epoch",
    "value_revision"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/inline"
    },
    {
      "$ref": "#/$defs/payload_reference"
    }
  ],
  "$defs": {
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "project_id",
        "thread_id",
        "bundle_id",
        "revision_id",
        "trigger",
        "note_reply_index",
        "status",
        "requested_revision_capability",
        "effective_revision_capability",
        "permission_snapshot_id",
        "annotation_ids",
        "changes",
        "created_at",
        "interrupted_at",
        "resumed_from_revision_id",
        "recovery_epoch",
        "value_revision",
        "phases",
        "intent"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.revision_run.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "trigger": {
          "enum": [
            "note_reply",
            "resubmit",
            "auto_fix"
          ]
        },
        "note_reply_index": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed"
          ]
        },
        "requested_revision_capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "effective_revision_capability": {
          "enum": [
            "schema_enforced_structured_revision",
            "validated_structured_revision",
            "chat_handoff_only"
          ]
        },
        "permission_snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "annotation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "interrupted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumed_from_revision_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "recovery_epoch": {
          "type": "integer",
          "minimum": 0,
          "format": "pm-uint"
        },
        "value_revision": {
          "type": "integer",
          "minimum": 0,
          "format": "pm-uint"
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase_sequence",
              "event_type",
              "source_ref",
              "predecessor_event_id",
              "intent_ref",
              "result",
              "prepared_event",
              "first_append_receipt",
              "original_event_value_commitment",
              "original_segment_ref",
              "publication"
            ],
            "properties": {
              "phase_sequence": {
                "type": "integer",
                "minimum": 0,
                "format": "pm-uint"
              },
              "event_type": {
                "enum": [
                  "bundle.revision_requested",
                  "bundle.revision_started",
                  "bundle.revision_completed",
                  "bundle.revision_interrupted"
                ]
              },
              "source_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "predecessor_event_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 1024
              },
              "intent_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "result_ref",
                  "intent_ref",
                  "kind",
                  "source_document_ref",
                  "source_document_version",
                  "source_document_sha256",
                  "output_document_refs",
                  "annotation_outcome_refs",
                  "safe_point_id",
                  "occurred_at_utc"
                ],
                "properties": {
                  "result_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "intent_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "kind": {
                    "enum": [
                      "accepted_request",
                      "start_authorized",
                      "completed",
                      "interrupted"
                    ]
                  },
                  "source_document_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "source_document_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "source_document_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "output_document_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "annotation_outcome_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "safe_point_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "occurred_at_utc": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  }
                }
              },
              "prepared_event": {
                "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json"
              },
              "first_append_receipt": {
                "anyOf": [
                  {
                    "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/AppendReceipt"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "original_event_value_commitment": {
                "anyOf": [
                  {
                    "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/original_event_value_commitment"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "original_segment_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 1024
              },
              "publication": {
                "enum": [
                  "prepared",
                  "receipted"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "publication": {
                      "const": "receipted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "first_append_receipt": {
                      "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/AppendReceipt"
                    },
                    "original_event_value_commitment": {
                      "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/original_event_value_commitment"
                    },
                    "original_segment_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "publication": {
                      "const": "prepared"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "first_append_receipt": {
                      "type": "null"
                    },
                    "original_event_value_commitment": {
                      "type": "null"
                    },
                    "original_segment_ref": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "thread_id",
            "bundle_id",
            "revision_id",
            "trigger",
            "requested_revision_capability",
            "effective_revision_capability",
            "permission_snapshot_id",
            "annotation_ids",
            "intent_ref",
            "actor_ref",
            "source_document_ref",
            "source_document_version",
            "source_document_sha256",
            "accepted_at"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "thread_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "bundle_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "revision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "trigger": {
              "enum": [
                "note_reply",
                "resubmit",
                "auto_fix"
              ]
            },
            "requested_revision_capability": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "effective_revision_capability": {
              "enum": [
                "schema_enforced_structured_revision",
                "validated_structured_revision",
                "chat_handoff_only"
              ]
            },
            "permission_snapshot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "annotation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "intent_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "actor_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "source_document_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "source_document_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "source_document_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "accepted_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        }
      }
    },
    "payload_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "recovery_epoch",
        "value_revision",
        "source_key",
        "source_payload_ref"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.revision_run.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "recovery_epoch": {
          "type": "integer",
          "minimum": 0,
          "format": "pm-uint"
        },
        "value_revision": {
          "type": "integer",
          "minimum": 0,
          "format": "pm-uint"
        },
        "source_key": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "revision_run.v1"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          ],
          "items": false
        },
        "source_payload_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blake3",
            "byte_size",
            "media_type"
          ],
          "properties": {
            "blake3": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1,
              "format": "pm-uint"
            },
            "media_type": {
              "const": "application/vnd.puppetmaster.revision-run+msgpack"
            }
          }
        }
      }
    }
  },
  "$comment": "DCW integer-only profile: pm-uint format validation is mandatory; integer domains refuse decimal/exponent floats and wrong types. JSON -0 is normalized to 0 before hashing; leading zeros are invalid JSON. Authenticate original values by exact types and canonical bytes.",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "pm.storage_value.revision_run.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "storage_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "project_id": {},
    "thread_id": {},
    "bundle_id": {},
    "revision_id": {},
    "trigger": {},
    "note_reply_index": {},
    "status": {},
    "requested_revision_capability": {},
    "effective_revision_capability": {},
    "permission_snapshot_id": {},
    "annotation_ids": {},
    "changes": {},
    "created_at": {},
    "interrupted_at": {},
    "resumed_from_revision_id": {},
    "recovery_epoch": {
      "type": "integer",
      "minimum": 0,
      "format": "pm-uint"
    },
    "value_revision": {
      "type": "integer",
      "minimum": 0,
      "format": "pm-uint"
    },
    "phases": {},
    "intent": {},
    "source_key": {},
    "source_payload_ref": {}
  }
}
