{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/dcw/wizard_seed_load_evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "storage_instance_id",
    "recovery_epoch",
    "value_revision",
    "source_ref",
    "request",
    "child",
    "seed",
    "result",
    "prepared_event",
    "first_append_receipt",
    "original_event_value_commitment",
    "original_segment_ref",
    "publication"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.storage_value.wizard_seed_load_evidence.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "storage_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "recovery_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "value_revision": {
      "type": "integer",
      "minimum": 0
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_ref",
        "actor_ref",
        "permission_snapshot_id",
        "project_id",
        "planning_run_id",
        "named_plan_id",
        "thread_group_id",
        "thread_id",
        "expected_child_revision",
        "expected_child_sha256",
        "command_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "permission_snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "planning_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "named_plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "thread_group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expected_child_revision": {
          "type": "integer",
          "minimum": 0
        },
        "expected_child_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "command_id": {
          "const": "cmd.project.chain_wizard_open_deferred"
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "planning_run_id",
        "named_plan_id",
        "thread_group_id",
        "thread_id",
        "thread_type",
        "thread_role",
        "revision",
        "sha256"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "planning_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "named_plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "thread_group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "thread_type": {
          "const": "planning_wizard"
        },
        "thread_role": {
          "const": "intake"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_ref",
        "seed_kind",
        "seed_id",
        "version",
        "sha256",
        "named_plan_id",
        "project_context_snapshot_ref",
        "project_context_snapshot_hash",
        "warning_refs",
        "lineage_refs",
        "work_intent_axes",
        "amendment_refs"
      ],
      "properties": {
        "seed_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "seed_kind": {
          "enum": [
            "ApprovedPRDPack",
            "normalized_requirements_pack",
            "assistant_chat_handoff_seed"
          ]
        },
        "seed_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "named_plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "project_context_snapshot_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "project_context_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "warning_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "lineage_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "work_intent_axes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "amendment_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_ref",
        "request_ref",
        "status",
        "child_ref",
        "child_revision",
        "child_sha256",
        "seed_ref",
        "seed_sha256",
        "project_context_snapshot_ref",
        "project_context_snapshot_hash",
        "occurred_at_utc"
      ],
      "properties": {
        "result_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "status": {
          "const": "seed_loaded"
        },
        "child_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "child_revision": {
          "type": "integer",
          "minimum": 0
        },
        "child_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "seed_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "seed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "project_context_snapshot_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "project_context_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "occurred_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "prepared_event": {
      "$ref": "https://puppetmaster.local/schemas/event_record/2.0.0/event_record.schema.json"
    },
    "first_append_receipt": {
      "anyOf": [
        {
          "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/AppendReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "original_event_value_commitment": {
      "anyOf": [
        {
          "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/original_event_value_commitment"
        },
        {
          "type": "null"
        }
      ]
    },
    "original_segment_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1024
    },
    "publication": {
      "enum": [
        "prepared",
        "receipted"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication": {
            "const": "receipted"
          }
        }
      },
      "then": {
        "properties": {
          "first_append_receipt": {
            "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/AppendReceipt"
          },
          "original_event_value_commitment": {
            "$ref": "https://puppetmaster.local/schemas/event_append_receipt_contracts/2.0.0#/$defs/original_event_value_commitment"
          },
          "original_segment_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "properties": {
          "first_append_receipt": {
            "type": "null"
          },
          "original_event_value_commitment": {
            "type": "null"
          },
          "original_segment_ref": {
            "type": "null"
          }
        }
      }
    }
  ]
}
