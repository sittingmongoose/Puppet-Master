        },
        "qualification": {
          "enum": [
            "qualified",
            "blocked",
            "unknown"
          ]
        },
        "native_reason_ref": {
          "oneOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "before": {
          "$ref": "#/$defs/view"
        },
        "proposed": {
          "$ref": "#/$defs/view"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path_effect"
          }
        },
        "ancestry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "merge_base_oids",
            "upstream_is_descendant",
            "rewritten_commit_oids"
          ],
          "properties": {
            "merge_base_oids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            },
            "upstream_is_descendant": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "rewritten_commit_oids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          }
        },
        "permission_snapshot_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "file_safe_decision_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "writer_lease_ref": {
