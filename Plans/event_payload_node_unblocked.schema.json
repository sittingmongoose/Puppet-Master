{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event_payloads/node_unblocked/1.0.0",
  "title": "node.unblocked prepared payload contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "replan_generation": {
      "type": "integer",
      "minimum": 0
    },
    "blocked_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "resolution": {
      "enum": [
        "approval_granted",
        "clarification_provided",
        "auth_recovered",
        "prerequisite_resolved",
        "safe_point_restored",
        "remediation_resolved",
        "replan_applied",
        "policy_or_permission_changed",
        "capacity_available",
        "manual_override_granted"
      ]
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "event_sequence",
    "ts",
    "run_id",
    "node_id",
    "replan_generation",
    "blocked_sequence",
    "resolution"
  ]
}
