    "ReleaseBundledArtifactAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "artifact_id",
        "artifact_kind",
        "artifact_role",
        "release_id",
        "pinned_version_ref",
        "source_revision_ref",
        "dependency_graph_ref",
        "license_notice_ref",
        "sbom_ref",
        "provenance_ref",
        "artifact_sha256",
        "signing_evidence_ref",
        "platform_matrix_ref",
        "protocol_compatibility_ref",
        "state_format_migration_ref",
        "activation_unit",
        "independent_updater_allowed",
        "acquisition_state",
        "disabled_reason",
        "implementation_time_reverification_required",
        "runtime_evidence_claimed",
        "event_effect_policy",
        "evaluated_at_utc"
      ],
      "properties": {
        "schema_id": {"const": "pm.release_update.bundled_artifact_admission.v1"},
        "record_kind": {"const": "ReleaseBundledArtifactAdmission"},
        "artifact_id": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "artifact_kind": {"enum": ["pm_tailnet_connector", "backup_engine_restic", "backup_transport_rclone"]},
        "artifact_role": {"enum": ["core_release_component", "local_backup_engine", "backup_transport"]},
        "release_id": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "pinned_version_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "source_revision_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "dependency_graph_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "license_notice_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "sbom_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "provenance_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "artifact_sha256": {"$ref": "#/$defs/ApplicationUpdateSha256"},
        "signing_evidence_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "platform_matrix_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
        "protocol_compatibility_ref": {"anyOf": [{"$ref": "#/$defs/ApplicationUpdateNonSecretRef"}, {"type": "null"}]},
        "state_format_migration_ref": {"anyOf": [{"$ref": "#/$defs/ApplicationUpdateNonSecretRef"}, {"type": "null"}]},
        "activation_unit": {"const": "same_puppet_master_release_or_image"},
        "independent_updater_allowed": {"const": false},
        "acquisition_state": {"enum": ["handler_unavailable", "blocked_missing_evidence", "admitted_static_only"]},
        "disabled_reason": {"anyOf": [{"enum": ["handler_unavailable", "provenance_missing", "license_review_required", "platform_unverified", "protocol_incompatible", "state_migration_unverified"]}, {"type": "null"}]},
        "implementation_time_reverification_required": {"const": true},
        "runtime_evidence_claimed": {"const": false},
        "event_effect_policy": {"const": "receipt_only_no_eventrecord_pending_event_authority"},
        "evaluated_at_utc": {"$ref": "#/$defs/ApplicationUpdateTimestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"artifact_kind": {"const": "pm_tailnet_connector"}}, "required": ["artifact_kind"]},
          "then": {
            "properties": {
              "artifact_role": {"const": "core_release_component"},
              "protocol_compatibility_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
              "state_format_migration_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"}
            }
          }
        },
        {
          "if": {"properties": {"artifact_kind": {"const": "backup_engine_restic"}}, "required": ["artifact_kind"]},
          "then": {"properties": {"artifact_role": {"const": "local_backup_engine"}}}
        },
        {
          "if": {"properties": {"artifact_kind": {"const": "backup_transport_rclone"}}, "required": ["artifact_kind"]},
          "then": {"properties": {"artifact_role": {"const": "backup_transport"}}}
        },
        {
          "if": {"properties": {"acquisition_state": {"enum": ["handler_unavailable", "blocked_missing_evidence"]}}, "required": ["acquisition_state"]},
          "then": {"properties": {"disabled_reason": {"type": "string"}}}
        }
      ]
    },
    "ReleaseOAuthRegistrationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "provider_kind",
