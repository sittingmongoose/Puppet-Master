    "ApplicationUpdateCommandAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "record_kind",
        "command_id",
        "available",
        "integration_evidence",
        "disabled_reason"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.release_update.availability.v1"
        },
        "record_kind": {
          "const": "ApplicationUpdateCommandAvailability"
        },
        "command_id": {
          "$ref": "#/$defs/ApplicationUpdateCommandId"
        },
        "available": {
          "type": "boolean"
        },
        "integration_evidence": {
          "$ref": "#/$defs/ApplicationUpdateIntegrationEvidence"
        },
        "disabled_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/ApplicationUpdateDisabledReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "properties": {
              "integration_evidence": {
                "properties": {
                  "central_registered": {
                    "const": true
                  },
                  "schema_bound": {
                    "const": true
                  },
                  "native_handler_bound": {
                    "const": true
                  },
                  "permission_route_bound": {
                    "const": true
                  },
                  "production_wired": {
                    "const": true
                  },
                  "receipt_or_admitted_event_bound": {
                    "const": true
                  }
                }
              },
              "disabled_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "disabled_reason": {
                "$ref": "#/$defs/ApplicationUpdateDisabledReason"
              }
            }
          }
        }
      ]
    },
