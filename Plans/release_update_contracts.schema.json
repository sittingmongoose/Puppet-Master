        "callback_registration_ref",
        "client_id_provenance_ref",
        "confidential_client_material_ref",
        "registration_state",
        "provider_approval_state",
        "callback_mode",
        "distributed_binary_contains_confidential_material",
        "release_gate_state",
        "disabled_reason",
        "runtime_test_status",
        "handler_available",
        "event_effect_policy",
        "evaluated_at_utc"
      ],
      "properties": {
        "schema_id": {"const": "pm.release_update.oauth_registration_gate.v1"},
        "record_kind": {"const": "ReleaseOAuthRegistrationGate"},
        "provider_kind": {"enum": ["google_drive", "microsoft_onedrive"]},
        "registration_ref": {"anyOf": [{"$ref": "#/$defs/ApplicationUpdateNonSecretRef"}, {"type": "null"}]},
        "callback_registration_ref": {"anyOf": [{"$ref": "#/$defs/ApplicationUpdateNonSecretRef"}, {"type": "null"}]},
        "client_id_provenance_ref": {"anyOf": [{"$ref": "#/$defs/ApplicationUpdateNonSecretRef"}, {"type": "null"}]},
        "confidential_client_material_ref": {"anyOf": [{"$ref": "#/$defs/ApplicationUpdateNonSecretRef"}, {"type": "null"}]},
        "registration_state": {"enum": ["unregistered", "approval_pending", "registered"]},
        "provider_approval_state": {"enum": ["not_submitted", "pending", "approved", "rejected"]},
        "callback_mode": {"enum": ["native_registered_redirect", "registered_web_callback", "approved_device_flow", "unavailable"]},
        "distributed_binary_contains_confidential_material": {"const": false},
        "release_gate_state": {"enum": ["handler_unavailable", "blocked", "admitted_static_only"]},
        "disabled_reason": {"anyOf": [{"enum": ["registration_missing", "provider_approval_pending", "callback_unavailable", "client_id_provenance_missing", "confidential_material_custody_missing", "handler_unavailable"]}, {"type": "null"}]},
        "runtime_test_status": {"const": "NOT_RUN"},
        "handler_available": {"const": false},
        "event_effect_policy": {"const": "receipt_only_no_eventrecord_pending_event_authority"},
        "evaluated_at_utc": {"$ref": "#/$defs/ApplicationUpdateTimestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"registration_state": {"enum": ["unregistered", "approval_pending"]}}, "required": ["registration_state"]},
          "then": {"properties": {"release_gate_state": {"enum": ["handler_unavailable", "blocked"]}, "disabled_reason": {"type": "string"}}}
        },
        {
          "if": {"properties": {"release_gate_state": {"const": "admitted_static_only"}}, "required": ["release_gate_state"]},
          "then": {
            "properties": {
              "registration_state": {"const": "registered"},
              "provider_approval_state": {"const": "approved"},
              "registration_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
              "callback_registration_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"},
              "client_id_provenance_ref": {"$ref": "#/$defs/ApplicationUpdateNonSecretRef"}
            }
          }
        }
      ]
    },
