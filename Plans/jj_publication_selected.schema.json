{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/jj-publication-selected/1.0.0/jj_publication_selected.schema.json",
  "$defs": {
    "bookmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "change_id",
        "commit_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "change_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        },
        "commit_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        }
      }
    },
    "remote_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "object_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "absent",
            "known",
            "unknown"
          ]
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "object_id": {
                "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
              }
            }
          },
          "else": {
            "properties": {
              "object_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookmark",
        "git_object_id",
        "refspec",
        "destination_ref",
        "expected_head",
        "proposed_head"
      ],
      "properties": {
        "bookmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "change_id",
            "commit_id"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "change_id": {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
            },
            "commit_id": {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
            }
          }
        },
        "git_object_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        },
        "refspec": {
          "type": "string",
          "minLength": 1
        },
        "destination_ref": {
          "type": "string",
          "minLength": 1
        },
        "expected_head": {
          "$ref": "#/$defs/remote_head"
        },
        "proposed_head": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "authority",
        "bookmarks",
        "remote_operation_target_ref",
        "target_selection_generation",
        "qualification_ref"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.jujutsu.publication_selected.request.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "authority": {
          "allOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/jujutsu-integration/1.0.0/jujutsu_integration_contracts.schema.json#/$defs/command_request"
            },
            {
              "properties": {
                "command_id": {
                  "const": "cmd.jujutsu.git.push"
                }
              }
            }
          ]
        },
        "bookmarks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bookmark"
          }
        },
        "remote_operation_target_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "target_selection_generation": {
          "type": "integer",
          "minimum": 0
        },
        "qualification_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "repository_context_ref",
        "expected_revision",
        "snapshot_id",
        "native_toolchain_ref",
        "publication_capability_ref",
        "qualified_targets",
        "source_evidence_refs",
        "recorded_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.source_control.jj_publication_qualification.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "repository_context_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "expected_revision": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/jujutsu_revision"
        },
        "snapshot_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        },
        "native_toolchain_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "publication_capability_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "qualified_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "mappings"
            ],
            "properties": {
              "target_id": {
                "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
              },
              "mappings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/mapping"
                }
              }
            }
          }
        },
        "source_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
          }
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "target_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "preview_ref",
        "command_instance_id",
        "operation_id",
        "repository_context_ref",
        "expected_revision",
        "remote_operation_target_ref",
        "target_selection_generation",
        "target_id",
        "push_url",
        "refspecs",
        "mappings",
        "qualification_ref",
        "force_guard"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.source_control.remote_publication_preview.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "preview_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "command_instance_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        },
        "operation_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        },
        "repository_context_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "expected_revision": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/jujutsu_revision"
        },
        "remote_operation_target_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "target_selection_generation": {
          "type": "integer",
          "minimum": 0
        },
        "target_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        },
        "push_url": {
          "type": "string",
          "minLength": 1
        },
        "refspecs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mapping"
          }
        },
        "qualification_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "force_guard": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/external_effect_reconciliation/properties/force_guard"
        }
      }
    },
    "target_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_request_ref",
        "operation_id",
        "target_id",
        "preview_ref",
        "mappings",
        "effect_state",
        "outcome",
        "observed_heads",
        "native_receipt_ref",
        "evidence_refs",
        "observed_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.source_control.remote_publication_observation.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "operation_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        },
        "target_id": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
        },
        "preview_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mapping"
          }
        },
        "effect_state": {
          "enum": [
            "not_attempted",
            "known_applied",
            "known_not_applied",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "succeeded",
            "rejected",
            "failed",
            "outcome_unknown"
          ]
        },
        "observed_heads": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destination_ref",
              "head"
            ],
            "properties": {
              "destination_ref": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "$ref": "#/$defs/remote_head"
              }
            }
          }
        },
        "native_receipt_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
          }
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "original_request_ref",
        "owner_result",
        "target_results"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.jujutsu.publication_selected.result.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "original_request_ref": {
          "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
        },
        "owner_result": {
          "$ref": "https://puppetmaster.local/schemas/jujutsu-integration/1.0.0/jujutsu_integration_contracts.schema.json#/$defs/command_result"
        },
        "target_results": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "reconciliation_ref",
              "observation_ref"
            ],
            "properties": {
              "target_id": {
                "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/identity_id"
              },
              "reconciliation_ref": {
                "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
              },
              "observation_ref": {
                "$ref": "https://puppetmaster.local/schemas/source-control/1.0.0/source_control_contracts.schema.json#/$defs/non_secret_ref"
              }
            }
          }
        }
      }
    },
    "fixture_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "result",
        "records"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "records": {
          "type": "object",
          "description": "Synthetic fixture-only resolver data; actual records are validated by owner definition.",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/qualification"
    },
    {
      "$ref": "#/$defs/target_preview"
    },
    {
      "$ref": "#/$defs/target_observation"
    },
    {
      "$ref": "#/$defs/result"
    }
  ]
}
