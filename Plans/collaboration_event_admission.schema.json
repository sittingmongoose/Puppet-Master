{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/collaboration_event_admission/1.0.0/collaboration_event_admission.schema.json",
  "title": "Collaborative workflow event admission ledger",
  "description": "Closed shape of Plans/collaboration_event_admission.json (SP-460). Each row prepares one family; admitted_static_contract rows also carry authority_contract_ref.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "ledger_id",
    "description",
    "admission_rule",
    "authority_refs",
    "rows"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.collaboration_event_admission.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ledger_id": {
      "const": "COLLABORATION-DL090-PREP-20261104"
    },
    "description": {
      "type": "string"
    },
    "admission_rule": {
      "type": "string"
    },
    "authority_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "family_id",
          "admission_status",
          "decision_refs",
          "semantic_owner_unit",
          "payload_owner_unit",
          "storage_owner_unit",
          "oracle_unit",
          "shared_units",
          "entry_point",
          "registry_row",
          "registry_row_sha256",
          "validation_case_ids",
          "admission_preconditions",
          "activation_preconditions"
        ],
        "properties": {
          "event_type": {
            "type": "string"
          },
          "family_id": {
            "type": "string",
            "pattern": "^event-family-[a-z0-9-]+$"
          },
          "admission_status": {
            "enum": [
              "prepared_not_admitted",
              "admitted_static_contract"
            ]
          },
          "authority_contract_ref": {
            "type": "string"
          },
          "decision_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "semantic_owner_unit": {
            "type": "string"
          },
          "payload_owner_unit": {
            "type": "string"
          },
          "storage_owner_unit": {
            "type": "string"
          },
          "oracle_unit": {
            "type": "string"
          },
          "shared_units": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entry_point": {
            "type": "string"
          },
          "registry_row": {
            "type": "object"
          },
          "registry_row_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "validation_case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "admission_preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activation_preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "admission_status": {
                  "const": "admitted_static_contract"
                }
              },
              "required": [
                "admission_status"
              ]
            },
            "then": {
              "required": [
                "authority_contract_ref"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "authority_contract_ref"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
