{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/browser_workspace_created_contracts/1.0.0",
  "title": "Browser workspace-created owner and filtered-checkpoint contracts",
  "description": "New browser.workspace.created-only technical bindings under DL-046. Closed schemas and synthetic checks are not authenticated producer, resolved source, currentness, native durability or runtime proof.",
  "x-pm-event-authority-binding": {
    "event_type": "browser.workspace.created",
    "binding_version": "1.0.0",
    "semantic_owner_ref": "Plans/Section15_MVP_Promoted_Features_Spec.md#SMPFS-167",
    "storage_owner_ref": "Plans/storage-plan.md#SP-266",
    "producer_component": "BrowserRuntimeService.workspace",
    "consumer_id": "browser.workspace_inventory.created.v1",
    "consumer_version": "1.0.0",
    "projector_id": "storage.browser_workspace_created_index.v1",
    "projector_version": "1.0.0",
    "checkpoint_family_id": "browser_workspace_created_index_checkpoint",
    "checkpoint_key": "browser_workspace_created_index_checkpoint.v1:{storage_instance_id}:{scope_partition}",
    "checkpoint_schema_id": "pm.storage_value.browser_workspace_created_index_checkpoint.v1",
    "checkpoint_schema_version": "1.0.0",
    "checkpoint_schema_pointer": "#/$defs/checkpoint",
    "source_payload_schema_ref": "Plans/browser_event_payloads.schema.json#/$defs/workspace_created",
    "source_payload_schema_id": "pm.browser_event.workspace_created.schema.v1",
    "source_retention_policy_id": "RP-AUTHORITY-INDEFINITE",
    "checkpoint_retention_policy_id": "RP-PROJECTION-3GEN",
    "retention_policy_version": "1.0.0",
    "definition_authority_ref": "Plans/Decision_Log.md#DL-046",
    "definition_status": "newly_authored_owner_contract",
    "native_proof": false
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "non_secret_ref": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/#-]*$",
      "not": { "pattern": "AuthBrowserSession|auth_browser_session|auth-browser-session|protected_auth|protected-auth" }
    },
    "source_cursor": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_generation", "recovery_epoch", "segment_generation", "segment_name", "byte_offset", "last_sequence_id", "last_event_id", "survivor_prefix_sha256", "projector_schema_version"],
      "properties": {
        "manifest_generation": { "type": "integer", "minimum": 0 },
        "recovery_epoch": { "type": "integer", "minimum": 0 },
        "segment_generation": { "type": "integer", "minimum": 0 },
        "segment_name": { "type": "string", "pattern": "^seg-[0-9]{6}-[0-9]{20}(?:-[0-9]{20}\\.seglog|\\.active)$" },
        "byte_offset": { "type": "integer", "minimum": 0 },
        "last_sequence_id": { "type": "integer", "minimum": 0 },
        "last_event_id": { "$ref": "#/$defs/non_secret_ref" },
        "survivor_prefix_sha256": { "$ref": "#/$defs/sha256" },
        "projector_schema_version": { "const": "1.0.0" }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_version", "checkpoint_id", "storage_instance_id", "project_id", "scope_partition", "projector_id", "projector_version", "event_type", "index_schema_id", "index_schema_version", "index_checkpoint_ref", "current_selection_sha256", "first_retained_sequence_id", "index_through_sequence_id", "filter_complete", "state", "health", "source_cursor", "updated_at_utc", "withdrawn_at_utc"],
      "properties": {
        "schema_id": { "const": "pm.storage_value.browser_workspace_created_index_checkpoint.v1" },
        "schema_version": { "const": "1.0.0" },
        "checkpoint_id": { "const": "browser.workspace.created" },
        "storage_instance_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "project_id": { "type": "string", "minLength": 1, "maxLength": 192 },
        "scope_partition": { "type": "string", "pattern": "^project~[A-Za-z0-9_-]+$" },
        "projector_id": { "const": "storage.browser_workspace_created_index.v1" },
        "projector_version": { "const": "1.0.0" },
        "event_type": { "const": "browser.workspace.created" },
        "index_schema_id": { "const": "pm.storage_value.event_record_index.v2" },
        "index_schema_version": { "const": "2.0.0" },
        "index_checkpoint_ref": { "$ref": "#/$defs/non_secret_ref" },
        "current_selection_sha256": { "$ref": "#/$defs/sha256" },
        "first_retained_sequence_id": { "type": ["integer", "null"], "minimum": 0 },
        "index_through_sequence_id": { "type": ["integer", "null"], "minimum": 0 },
        "filter_complete": { "type": "boolean" },
        "state": { "enum": ["current", "degraded", "withdrawn"] },
        "health": { "enum": ["healthy", "degraded"] },
        "source_cursor": { "oneOf": [{ "$ref": "#/$defs/source_cursor" }, { "type": "null" }] },
        "updated_at_utc": { "$ref": "#/$defs/timestamp" },
        "withdrawn_at_utc": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "current" } }, "required": ["state"] },
          "then": { "properties": { "filter_complete": { "const": true }, "health": { "const": "healthy" }, "withdrawn_at_utc": { "type": "null" } } }
        },
        {
          "if": { "properties": { "state": { "const": "degraded" } }, "required": ["state"] },
          "then": { "properties": { "health": { "const": "degraded" }, "withdrawn_at_utc": { "type": "null" } } }
        },
        {
          "if": { "properties": { "state": { "const": "withdrawn" } }, "required": ["state"] },
          "then": { "properties": { "withdrawn_at_utc": { "$ref": "#/$defs/timestamp" } } }
        },
        {
          "if": { "properties": { "source_cursor": { "type": "null" } }, "required": ["source_cursor"] },
          "then": { "properties": { "first_retained_sequence_id": { "type": "null" }, "index_through_sequence_id": { "type": "null" } } },
          "else": { "properties": { "first_retained_sequence_id": { "type": "integer" }, "index_through_sequence_id": { "type": "integer" } } }
        }
      ]
    }
  }
}
