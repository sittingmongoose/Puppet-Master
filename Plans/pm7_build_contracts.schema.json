{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.pm7_build.contracts.v1",
  "title": "PM7 build project, work and Pip contracts",
  "description": "Owner contracts CS-105/CS-106, SIR-054 and SSYS-056. Static schema only; no Event Authority or native implementation admission. Current owner/permission/identity comparison is semantic validation before dispatch.",
  "oneOf": [
    {
      "$ref": "#/$defs/project_switch_request"
    },
    {
      "$ref": "#/$defs/project_open_new_request"
    },
    {
      "$ref": "#/$defs/processes_open_request"
    },
    {
      "$ref": "#/$defs/work_panel_show_request"
    },
    {
      "$ref": "#/$defs/work_panel_pop_out_request"
    },
    {
      "$ref": "#/$defs/work_stop_request"
    },
    {
      "$ref": "#/$defs/work_restart_request"
    },
    {
      "$ref": "#/$defs/work_send_input_request"
    },
    {
      "$ref": "#/$defs/work_completion_delivery_request"
    },
    {
      "$ref": "#/$defs/work_clear_finished_request"
    },
    {
      "$ref": "#/$defs/work_quit_request"
    },
    {
      "$ref": "#/$defs/command_result"
    },
    {
      "$ref": "#/$defs/local_action_request"
    },
    {
      "$ref": "#/$defs/PipPartsRegistry"
    }
  ],
  "$defs": {
    "project_command_id": {
      "enum": [
        "cmd.project.open_in_new_workspace_tab",
        "cmd.project.switch_active_tab"
      ]
    },
    "work_command_id": {
      "enum": [
        "cmd.agents_and_processes.pop_out",
        "cmd.agents_and_processes.show",
        "cmd.chat.processes.open",
        "cmd.work.clear_finished",
        "cmd.work.quit",
        "cmd.work.restart",
        "cmd.work.send_input",
        "cmd.work.set_completion_delivery",
        "cmd.work.stop"
      ]
    },
    "project_local_action_id": {
      "enum": [
        "ui.project_switcher.open",
        "ui.project_switcher.close",
        "ui.project_switcher.all_projects"
      ]
    },
    "work_local_action_id": {
      "enum": [
        "ui.work_panel.close",
        "ui.work_panel.select_tab",
        "ui.work_panel.filter",
        "ui.work_panel.sort",
        "ui.work_panel.expand",
        "ui.work_panel.select",
        "ui.work_quit.open",
        "ui.work_quit.select",
        "ui.work_quit.cancel"
      ]
    },
    "pip_local_action_id": {
      "enum": [
        "ui.settings.pip_editor.open",
        "ui.settings.pip_editor.close",
        "ui.settings.pip_editor.replay"
      ]
    },
    "WorkTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "work_kind",
        "project_id",
        "server_id",
        "environment_id",
        "owner_thread_id",
        "generation",
        "pid",
        "pid_start_time",
        "process_group"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "work_kind": {
          "enum": [
            "agent",
            "process"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "server_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pid_start_time": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "process_group": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "work_kind": {
                "const": "process"
              }
            }
          },
          "then": {
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 1
              },
              "pid_start_time": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "process_group": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "idempotency_key",
        "outcome",
        "receipt_ref",
        "error",
        "generation"
      ],
      "properties": {
        "command_id": {
          "enum": [
            "cmd.project.switch_active_tab",
            "cmd.project.open_in_new_workspace_tab",
            "cmd.chat.processes.open",
            "cmd.agents_and_processes.show",
            "cmd.agents_and_processes.pop_out",
            "cmd.work.stop",
            "cmd.work.restart",
            "cmd.work.send_input",
            "cmd.work.set_completion_delivery",
            "cmd.work.clear_finished",
            "cmd.work.quit"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "enum": [
            "acknowledged",
            "succeeded",
            "refused",
            "view_local"
          ]
        },
        "receipt_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "stale_target",
            "pid_reused",
            "not_found",
            "not_permitted",
            "storage_read_only",
            "owner_unavailable",
            "system_service_read_only",
            "input_request_stale",
            "input_requires_terminal",
            "unsupported",
            "target_selection_changed"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "local_action_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "project_id",
        "return_focus_id",
        "view_id"
      ],
      "properties": {
        "action_id": {
          "enum": [
            "ui.project_switcher.open",
            "ui.project_switcher.close",
            "ui.work_panel.close",
            "ui.work_panel.select_tab",
            "ui.work_panel.filter",
            "ui.work_panel.sort",
            "ui.work_panel.expand",
            "ui.work_panel.select",
            "ui.work_quit.open",
            "ui.work_quit.select",
            "ui.work_quit.cancel",
            "ui.settings.pip_editor.open",
            "ui.settings.pip_editor.close",
            "ui.settings.pip_editor.replay",
            "ui.project_switcher.all_projects"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "return_focus_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "view_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {}
      }
    },
    "PipPartsRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_id",
        "owner_ref",
        "decision_ids",
        "setting_id",
        "parts",
        "presets",
        "mandatory_consumers",
        "scope",
        "claim_boundary"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schema_id": {
          "const": "pm.pip_parts.v1"
        },
        "owner_ref": {
          "const": "Plans/Settings_System.md#SSYS-056"
        },
        "decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "setting_id": {
          "const": "general.visual.pip-parts"
        },
        "parts": {
          "type": "array",
          "minItems": 25,
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "group",
              "default_enabled"
            ],
            "properties": {
              "id": {
                "enum": [
                  "sheet-hosts",
                  "status-faces",
                  "working-orbit",
                  "plans",
                  "wand-menu",
                  "empty-lists",
                  "state-faces",
                  "watches",
                  "wonders-while-typing",
                  "cheers",
                  "oops",
                  "gaze",
                  "blinks",
                  "sway-and-physics",
