              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "group": {
                "enum": [
                  "Where Pip appears",
                  "Faces",
                  "Motion",
                  "Look",
                  "Sound"
                ]
              },
              "default_enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "presets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Full",
            "Quiet",
            "Still",
            "Plain"
          ],
          "properties": {
            "Full": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "sheet-hosts",
                  "status-faces",
                  "working-orbit",
