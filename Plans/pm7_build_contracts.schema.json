                  "empty-lists",
                  "state-faces",
                  "watches",
                  "wonders-while-typing",
                  "cheers",
                  "oops",
                  "gaze",
                  "blinks",
                  "sway-and-physics",
                  "face-transitions",
                  "thinking-dots",
                  "idle-life",
                  "seat-colours",
                  "role-props",
                  "strings",
                  "cheeks-and-shine",
                  "setup-world-life",
                  "setup-voice",
                  "app-voice",
                  "setup-music"
                ]
              }
            },
            "Still": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "sheet-hosts",
                  "status-faces",
                  "working-orbit",
                  "plans",
                  "wand-menu",
                  "empty-lists",
                  "state-faces",
                  "watches",
                  "wonders-while-typing",
                  "cheers",
                  "oops",
                  "gaze",
                  "blinks",
                  "sway-and-physics",
                  "face-transitions",
                  "thinking-dots",
                  "idle-life",
                  "seat-colours",
                  "role-props",
                  "strings",
                  "cheeks-and-shine",
                  "setup-world-life",
                  "setup-voice",
                  "app-voice",
                  "setup-music"
                ]
              }
            },
            "Plain": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "sheet-hosts",
                  "status-faces",
                  "working-orbit",
                  "plans",
                  "wand-menu",
                  "empty-lists",
                  "state-faces",
                  "watches",
                  "wonders-while-typing",
                  "cheers",
                  "oops",
                  "gaze",
                  "blinks",
                  "sway-and-physics",
                  "face-transitions",
                  "thinking-dots",
                  "idle-life",
                  "seat-colours",
                  "role-props",
                  "strings",
                  "cheeks-and-shine",
