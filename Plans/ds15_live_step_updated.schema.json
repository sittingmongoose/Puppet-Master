{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "live_session_id",
    "step_id",
    "step_revision",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "live_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "step_revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "running",
        "passed",
        "failed"
      ]
    },
    "browser_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "session_class": {
      "enum": [
        "workspace_preview",
        "detached_preview",
        "automation_session",
        "normal_browsing"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.ds15.live_step_updated.payload.v1",
  "dependentRequired": {
    "browser_session_id": [
      "session_class"
    ],
    "session_class": [
      "browser_session_id"
    ]
  }
}
