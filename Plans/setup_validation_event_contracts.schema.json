          "pattern": "^[^\\r\\n]+(?![\\s\\S])"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[^\\r\\n]+(?![\\s\\S])"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[^\\r\\n]+(?![\\s\\S])"
        },
