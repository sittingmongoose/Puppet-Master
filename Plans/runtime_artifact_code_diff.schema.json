{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.runtime_artifact.code_diff.schema.v1",
  "title": "Runtime Artifact code_diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "artifact_id",
    "artifact_type",
    "project_id",
    "run_id",
    "attempt_id",
    "created_at_utc",
    "projection_freshness",
    "projection_health",
    "retention_class",
    "routing_refs",
    "type_payload"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.runtime_artifact.code_diff.schema.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "const": "code_diff"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "provider_attempt_ref": {
      "type": "string"
    },
    "usage_event_ref": {
      "type": "string"
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer_ref": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "detail_ref": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "source_surface": {
      "type": "string"
    },
    "projection_freshness": {
      "type": "string"
    },
    "projection_health": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "routing_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_paths"
      ],
      "properties": {
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diff_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "result_ref": {
          "type": "string",
          "minLength": 1
        },
        "change_summary": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "change_kind",
              "additions",
              "deletions"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "change_kind": {
                "type": "string",
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed",
                  "copied"
                ]
              },
              "previous_path": {
                "type": "string",
                "minLength": 1
              },
              "additions": {
                "type": "integer",
                "minimum": 0
              },
              "deletions": {
                "type": "integer",
                "minimum": 0
              },
              "patch_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "worktree_ref": {
          "type": "string",
          "minLength": 1
        },
        "commit_ref": {
          "type": "string",
          "minLength": 1
        },
        "contains_raw_secrets": {
          "const": false
        }
      }
    }
  }
}
