        "authority_granted",
        "bsd_finding_id",
        "finding_key",
        "severity",
        "finding_ref",
        "delivery_basis",
        "presentation_weight",
        "raised_against_generation",
        "latest_checked_generation",
        "emission_boundary_ref",
        "stale",
        "unreconfirmed"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.event_payload.bsd.advice_emitted.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/identifier"
        },
        "owner_operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_state_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 0
        },
        "binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "bsd_assignment_id": {
          "$ref": "#/$defs/identifier"
        },
        "primary_run_id": {
          "$ref": "#/$defs/identifier"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "primary_generation": {
          "type": "integer",
          "minimum": 0
        },
        "review_cycle_id": {
          "$ref": "#/$defs/identifier"
        },
        "primary_run_mutated": {
          "const": false
        },
        "authority_granted": {
          "const": false
        },
        "bsd_finding_id": {
          "$ref": "#/$defs/identifier"
        },
        "finding_key": {
          "$ref": "#/$defs/identifier"
        },
        "severity": {
          "enum": [
            "nit",
            "concern",
            "critical"
          ]
        },
        "finding_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "delivery_basis": {
          "enum": [
            "reconfirmed",
            "frozen_boundary",
            "async_nit",
            "terminal_timeout_stale"
          ]
        },
        "presentation_weight": {
          "enum": [
            "note",
            "aside"
          ]
        },
        "raised_against_generation": {
          "type": "integer",
          "minimum": 0
        },
        "latest_checked_generation": {
          "type": "integer",
          "minimum": 0
        },
        "emission_boundary_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "stale": {
          "type": "boolean"
        },
        "unreconfirmed": {
          "type": "boolean"
        }
      },
      "description": "Newly authored owner contract for bsd.advice_emitted at 1.0.0; prepared without admission. Original-source, relational, number and format predicates are owner contracts with a phase-2 oracle plan."
