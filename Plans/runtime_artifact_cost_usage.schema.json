{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.runtime_artifact.cost_usage.schema.v1",
  "title": "Runtime Artifact cost_usage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "artifact_id",
    "artifact_type",
    "project_id",
    "run_id",
    "attempt_id",
    "usage_event_ref",
    "usage_record_id",
    "created_at_utc",
    "projection_freshness",
    "projection_health",
    "retention_class",
    "routing_refs",
    "type_payload"
  ],
  "$defs": {
    "nonNegativeIntegerOrNull": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "nonNegativeNumberOrNull": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "stringOrNull": {
      "type": [
        "string",
        "null"
      ]
    },
    "refString": {
      "type": "string",
      "minLength": 1
    },
    "tokenBuckets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_total",
        "input_non_cached",
        "cache_read",
        "cache_write",
        "cache_write_1h",
        "output_total",
        "output_visible",
        "reasoning_tokens",
        "provider_total",
        "context_estimate",
        "counting_semantics",
        "usage_reporting_state"
      ],
      "properties": {
        "input_total": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "input_non_cached": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "cache_read": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "cache_write": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "cache_write_1h": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "cache_write_ttl": {
          "$ref": "#/$defs/stringOrNull"
        },
        "cache_write_breakdown_state": {
          "type": "string",
          "enum": [
            "reported",
            "fallback_short_ttl",
            "not_exposed",
            "unknown"
          ]
        },
        "output_total": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "output_visible": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull",
          "description": "Runtime artifact JSON wire alias for the UF-085 reasoning/thoughts bucket; interpreted only through counting_semantics and not an independent UsageEvent accounting field."
        },
        "thoughts_tokens": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull",
          "description": "Provider thoughts-specific raw count when separately exposed; maps into the UF-085 reasoning/thoughts semantics and does not replace reasoning_tokens/counting_semantics."
        },
        "provider_total": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "context_estimate": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "delta": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonNegativeIntegerOrNull"
          }
        },
        "cumulative": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonNegativeIntegerOrNull"
          }
        },
        "counting_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_total_includes_cache",
            "output_total_includes_reasoning",
            "provider_total_semantics"
          ],
          "properties": {
            "input_total_includes_cache": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "output_total_includes_reasoning": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "provider_total_semantics": {
              "type": "string",
              "enum": [
                "provider_reported",
                "derived_input_plus_output",
                "not_exposed",
                "unknown"
              ]
            }
          }
        },
        "usage_reporting_state": {
          "type": "string",
          "enum": [
            "final",
            "partial",
            "estimated",
            "unavailable",
            "unknown"
          ]
        }
      }
    },
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_route_kind",
        "model_id"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/refString"
        },
        "provider_route_kind": {
          "$ref": "#/$defs/refString"
        },
        "provider_account_ref": {
          "$ref": "#/$defs/stringOrNull"
        },
        "model_id": {
          "$ref": "#/$defs/refString"
        },
        "model_variant": {
          "$ref": "#/$defs/stringOrNull"
        },
        "reasoning_tier": {
          "$ref": "#/$defs/stringOrNull"
        },
        "context_window_tokens": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        }
      }
    },
    "costFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_status",
        "cost_microdollars",
        "cost_minor_units",
        "currency",
        "pricing_snapshot_id",
        "pricing_source",
        "pricing_effective_at",
        "pricing_version"
      ],
      "properties": {
        "cost_status": {
          "type": "string",
          "enum": [
            "provider_reported",
            "priced",
            "estimated",
            "hidden_subscription",
            "hidden_byok",
            "unknown"
          ]
        },
        "cost_microdollars": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "cost_minor_units": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "currency": {
          "$ref": "#/$defs/stringOrNull"
        },
        "pricing_snapshot_id": {
          "$ref": "#/$defs/stringOrNull"
        },
        "pricing_source": {
          "$ref": "#/$defs/stringOrNull"
        },
        "pricing_effective_at": {
          "$ref": "#/$defs/stringOrNull"
        },
        "pricing_version": {
          "$ref": "#/$defs/stringOrNull"
        },
        "bucket_costs_microdollars": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonNegativeIntegerOrNull"
          }
        },
        "custom_provider_price_row_ref": {
          "$ref": "#/$defs/stringOrNull"
        }
      }
    },
    "quotaFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_kind",
        "window_scope",
        "quota_status",
        "evidence_source",
        "reset_at",
        "cooldown_until",
        "quota_remaining",
        "quota_used",
        "quota_limit"
      ],
      "properties": {
        "window_kind": {
          "type": "string",
          "enum": [
            "rolling",
            "fixed",
            "billing",
            "session",
            "unknown"
          ]
        },
        "window_scope": {
          "$ref": "#/$defs/stringOrNull"
        },
        "quota_status": {
          "type": "string",
          "enum": [
            "reported",
            "disabled",
            "not_exposed",
            "estimated",
            "unknown"
          ]
        },
        "evidence_source": {
          "type": "string",
          "enum": [
            "provider_api",
            "provider_header",
            "cli_command",
            "statusline",
            "local_estimate",
            "not_exposed",
            "unknown"
          ]
        },
        "reset_at": {
          "$ref": "#/$defs/stringOrNull"
        },
        "cooldown_until": {
          "$ref": "#/$defs/stringOrNull"
        },
        "quota_remaining": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "quota_used": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "quota_limit": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "credits_remaining": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "credits_status": {
          "type": "string",
          "enum": [
            "reported",
            "not_exposed",
            "disabled",
            "unknown"
          ]
        }
      }
    },
    "authorityFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "source_confidence",
        "source_authority",
        "settlement_status",
        "raw_payload_ref",
        "redaction_status",
        "provider_payload_hash"
      ],
      "properties": {
        "source_class": {
          "type": "string",
          "enum": [
            "provider_reported",
            "provider_header",
            "cli_reported",
            "local_estimated",
            "pricing_estimated",
            "unknown"
          ]
        },
        "source_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "source_authority": {
          "$ref": "#/$defs/stringOrNull"
        },
        "settlement_status": {
          "type": "string",
          "enum": [
            "observed",
            "streaming_partial",
            "settled",
            "adjusted",
            "failed",
            "unknown"
          ]
        },
        "observed_at_utc": {
          "$ref": "#/$defs/stringOrNull"
        },
        "settled_at_utc": {
          "$ref": "#/$defs/stringOrNull"
        },
        "adjusted_at_utc": {
          "$ref": "#/$defs/stringOrNull"
        },
        "failure_class": {
          "$ref": "#/$defs/stringOrNull"
        },
        "partial_reason": {
          "$ref": "#/$defs/stringOrNull"
        },
        "raw_payload_ref": {
          "$ref": "#/$defs/stringOrNull"
        },
        "redaction_status": {
          "type": "string",
          "enum": [
            "redacted",
            "not_required",
            "pending",
            "unknown"
          ]
        },
        "provider_payload_hash": {
          "$ref": "#/$defs/stringOrNull"
        }
      }
    }
  },
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.runtime_artifact.cost_usage.schema.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "const": "cost_usage"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "provider_attempt_ref": {
      "type": "string"
    },
    "usage_event_ref": {
      "type": "string",
      "minLength": 1
    },
    "usage_record_id": {
      "type": "string",
      "minLength": 1
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer_ref": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "detail_ref": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "source_surface": {
      "type": "string"
    },
    "projection_freshness": {
      "type": "string"
    },
    "projection_health": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "routing_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_event_ref",
        "usage_record_id",
        "reasoning_tokens",
        "provider",
        "usage",
        "cost",
        "quota",
        "authority",
        "refs",
        "flags"
      ],
      "properties": {
        "usage_event_ref": {
          "type": "string",
          "minLength": 1
        },
        "usage_record_id": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Compatibility/wire alias mirrored from usage.reasoning_tokens for UF-085 reasoning/thoughts drill-through; not source authority or an extra total."
        },
        "total_tokens": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "provider": {
          "$ref": "#/$defs/providerIdentity"
        },
        "usage": {
          "$ref": "#/$defs/tokenBuckets"
        },
        "cost": {
          "$ref": "#/$defs/costFields"
        },
        "quota": {
          "$ref": "#/$defs/quotaFields"
        },
        "authority": {
          "$ref": "#/$defs/authorityFields"
        },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usage_event_ref",
            "usage_record_id",
            "provider_attempt_ref",
            "raw_payload_ref"
          ],
          "properties": {
            "usage_event_ref": {
              "type": "string",
              "minLength": 1
            },
            "usage_record_id": {
              "type": "string",
              "minLength": 1
            },
            "provider_attempt_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "attempt_id": {
              "$ref": "#/$defs/stringOrNull"
            },
            "run_id": {
              "$ref": "#/$defs/stringOrNull"
            },
            "thread_id": {
              "$ref": "#/$defs/stringOrNull"
            },
            "node_id": {
              "$ref": "#/$defs/stringOrNull"
            },
            "tool_call_id": {
              "$ref": "#/$defs/stringOrNull"
            },
            "parent_usage_record_id": {
              "$ref": "#/$defs/stringOrNull"
            },
            "dedupe_key": {
              "$ref": "#/$defs/stringOrNull"
            },
            "raw_payload_ref": {
              "$ref": "#/$defs/stringOrNull"
            },
            "receipt_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "child_usage_event_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_estimated",
            "is_provider_reported",
            "is_cli_reported",
            "is_local_context_estimate",
            "is_subscription_hidden",
            "is_byok",
            "unknown_reason"
          ],
          "properties": {
            "is_estimated": {
              "type": "boolean"
            },
            "is_provider_reported": {
              "type": "boolean"
            },
            "is_cli_reported": {
              "type": "boolean"
            },
            "is_local_context_estimate": {
              "type": "boolean"
            },
            "is_subscription_hidden": {
              "type": "boolean"
            },
            "is_byok": {
              "type": "boolean"
            },
            "unknown_reason": {
              "$ref": "#/$defs/stringOrNull"
            },
            "display_cost_policy": {
              "type": "string",
              "enum": [
                "show",
                "hide",
                "subscription_covered",
                "unknown"
              ]
            }
          }
        },
        "stream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stop_reason": {
              "$ref": "#/$defs/stringOrNull"
            },
            "abort_requested": {
              "type": "boolean"
            },
            "usage_observed_before_abort": {
              "type": "boolean"
            },
            "stream_end_source": {
              "$ref": "#/$defs/stringOrNull"
            }
          }
        },
        "overflow_evidence": {
          "type": "object",
          "additionalProperties": true
        },
        "provider_compat": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
