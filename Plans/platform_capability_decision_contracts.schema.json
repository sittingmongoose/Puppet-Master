      "properties": {
        "capability_key": {
          "type": "string"
        },
        "degraded_reason": {
          "type": "string"
        },
        "effective_capability": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        },
        "platform_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "requested_capability": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        }
      },
      "required": [
        "platform_id",
        "capability_key",
        "effective_capability",
        "ts"
      ],
      "type": "object"
    },
    "p_platform_capability_evidence_ref": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "evidence_ref_type": {
              "const": "runtime_probe_receipt"
            },
            "source_kind": {
              "const": "live_runtime_discovery"
            }
          }
        },
        {
          "properties": {
            "evidence_ref_type": {
              "const": "provider_policy_snapshot"
            },
            "source_kind": {
              "const": "provider_policy_snapshot"
            }
          }
        },
        {
          "properties": {
            "evidence_ref_type": {
              "const": "platform_baseline_revision"
            },
            "source_kind": {
              "const": "static_platform_baseline"
            }
          }
        }
      ],
      "properties": {
        "evidence_ref": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_ref_type": {
          "enum": [
            "runtime_probe_receipt",
            "provider_policy_snapshot",
            "platform_baseline_revision"
          ]
        },
        "finding": {
          "enum": [
            "supports_available",
            "supports_degraded",
            "supports_unavailable"
          ]
        },
        "observed_at_utc": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "live_runtime_discovery",
            "provider_policy_snapshot",
            "static_platform_baseline"
          ]
        },
        "source_revision_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "evidence_ref_type",
        "evidence_ref",
        "finding",
        "observed_at_utc",
        "source_revision_ref"
      ],
      "type": "object"
    },
    "p_platform_capability_ref": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^platform\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$",
