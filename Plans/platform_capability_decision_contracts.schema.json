        "occurred_at_utc": {
          "$ref": "#/$defs/e_date_time_string"
        },
        "producer_sequence_id": {
          "$ref": "#/$defs/e_nullable_non_negative_integer"
        },
        "correlation_id": {
          "$ref": "#/$defs/e_non_empty_string"
        },
        "causation_event_id": {
          "$ref": "#/$defs/e_nullable_non_empty_string"
        },
        "parent_event_id": {
          "$ref": "#/$defs/e_nullable_non_empty_string"
        },
        "idempotency_key": {
          "$ref": "#/$defs/e_non_empty_string"
