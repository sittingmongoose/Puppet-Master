        "project_id": {
          "$ref": "#/$defs/e_nullable_non_empty_string"
        },
        "thread_id": {
          "$ref": "#/$defs/e_nullable_non_empty_string"
        },
        "run_id": {
          "$ref": "#/$defs/e_nullable_non_empty_string"
        },
        "node_id": {
          "$ref": "#/$defs/e_nullable_non_empty_string"
        },
        "attempt_id": {
          "$ref": "#/$defs/e_nullable_non_empty_string"
