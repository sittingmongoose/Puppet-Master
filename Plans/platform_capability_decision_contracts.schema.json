    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "physical_key",
        "state",
        "request",
        "request_sha256",
        "catalog_selection",
        "source_decisions",
        "frozen_producer_input",
        "frozen_input_sha256",
        "original_storage_fields",
        "append_receipt",
        "committed_at_utc"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.platform_capability_decision.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_key": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "pending_append",
            "committed"
          ]
        },
        "request": {
          "$ref": "#/$defs/evaluation_request"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalog_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_id",
            "catalog_schema_version",
            "catalog_revision",
            "catalog_revision_sha256",
            "selected_entry"
          ],
          "properties": {
            "catalog_id": {
              "const": "pm.platform_capability_catalog"
            },
            "catalog_schema_version": {
              "const": "1.0.0"
            },
            "catalog_revision": {
              "type": "integer",
              "minimum": 1
            },
            "catalog_revision_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selected_entry": {
              "additionalProperties": false,
              "properties": {
                "allowed_evidence_sources": {
                  "items": {
                    "enum": [
                      "live_runtime_discovery",
                      "provider_policy_snapshot",
                      "static_platform_baseline"
                    ]
                  },
                  "maxItems": 3,
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "capability_id": {
                  "pattern": "^platform\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                  "type": "string"
                },
                "display_name": {
                  "minLength": 1,
                  "type": "string"
                },
                "entry_state": {
                  "enum": [
                    "active",
                    "deprecated",
                    "retired"
                  ]
                },
                "execution_classes": {
                  "items": {
                    "enum": [
                      "direct_provider",
                      "cli_bridged_provider",
                      "server_bridged_provider"
                    ]
                  },
                  "maxItems": 3,
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "legacy_capability_key_aliases": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array",
                  "uniqueItems": true
                },
                "owner_doc_ref": {
                  "pattern": "^Plans/.+#[^#]+$",
                  "type": "string"
                }
              },
              "required": [
                "capability_id",
                "display_name",
                "owner_doc_ref",
                "entry_state",
                "execution_classes",
                "allowed_evidence_sources",
                "legacy_capability_key_aliases"
              ],
              "type": "object"
            }
          }
        },
        "source_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence",
              "subject",
              "source_owner_ref",
              "source_record_sha256",
              "original_verification_ref",
              "original_freshness_ref",
              "redaction_profile"
            ],
            "properties": {
              "evidence": {
                "$ref": "#/$defs/p_platform_capability_evidence_ref"
              },
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "platform_id",
                  "provider_id",
                  "capability_ref",
                  "execution_class"
                ],
                "properties": {
                  "scope": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "project_id"
                        ],
                        "properties": {
                          "kind": {
                            "const": "application"
                          },
                          "project_id": {
                            "type": "null"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "project_id"
                        ],
                        "properties": {
                          "kind": {
                            "const": "project"
                          },
                          "project_id": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    ]
                  },
                  "platform_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "capability_ref": {
                    "$ref": "#/$defs/p_platform_capability_ref"
                  },
                  "execution_class": {
                    "enum": [
                      "direct_provider",
                      "cli_bridged_provider",
                      "server_bridged_provider"
                    ]
                  }
                }
              },
              "source_owner_ref": {
                "type": "string",
                "minLength": 1
              },
              "source_record_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "original_verification_ref": {
                "type": "string",
                "minLength": 1
              },
              "original_freshness_ref": {
                "type": "string",
                "minLength": 1
              },
              "redaction_profile": {
                "const": "no_secrets"
              }
            }
          },
          "minItems": 0,
          "maxItems": 3
        },
        "frozen_producer_input": {
          "$ref": "#/$defs/frozen_input"
        },
        "frozen_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_storage_fields": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sequence_id",
                "observed_at_utc",
                "persisted_at_utc"
              ],
              "properties": {
                "sequence_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "observed_at_utc": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "persisted_at_utc": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "append_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/a_AppendReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "committed_at_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "pending_append"
              }
            }
          },
          "then": {
            "properties": {
              "append_receipt": {
                "type": "null"
              },
              "committed_at_utc": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "committed"
              }
            }
          },
          "then": {
            "properties": {
              "original_storage_fields": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sequence_id",
                  "observed_at_utc",
                  "persisted_at_utc"
                ],
                "properties": {
                  "sequence_id": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "observed_at_utc": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  },
                  "persisted_at_utc": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  }
                }
              },
              "append_receipt": {
                "$ref": "#/$defs/a_AppendReceipt"
              },
              "committed_at_utc": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          }
        }
      ]
    },
    "read_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
