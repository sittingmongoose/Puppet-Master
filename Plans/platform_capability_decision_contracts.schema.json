                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "project_id"
              ],
              "properties": {
                "kind": {
                  "const": "project"
                },
                "project_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "evaluation_id": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
