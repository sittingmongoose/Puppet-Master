{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.evidence_artifact_binding_modes.v1",
  "title": "Puppet Master evidence artifact binding modes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "captured_at_utc",
    "expected_historical_snapshot_count",
    "expected_live_current_count",
    "forbidden_live_current_tokens",
    "entries"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.evidence_artifact_binding_modes.v1"
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expected_historical_snapshot_count": {
      "type": "integer",
      "minimum": 0
    },
    "expected_live_current_count": {
      "type": "integer",
      "minimum": 1
    },
    "forbidden_live_current_tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mode",
          "node_id",
          "rationale"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^Plans/\\.evidence/[^/]+/evidence\\.json$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "historical_snapshot",
              "live_current"
            ]
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "bundle_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
