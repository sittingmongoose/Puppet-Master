{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/dt_number_domain/1.0.0",
  "description": "Current DT numeric boundary only. Retained exact-integer source recipes are not rewritten. Booleans are JSON booleans, never numbers.",
  "anyOf": [
    {
      "type": [
        "null",
        "boolean",
        "string"
      ]
    },
    {
      "type": "number",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    {
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    {
      "type": "object",
      "additionalProperties": {
        "$ref": "#"
      }
    }
  ]
}
