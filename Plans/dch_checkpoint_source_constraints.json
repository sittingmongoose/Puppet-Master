{
  "schema_id": "pm.dch.checkpoint_source_constraints.v1",
  "purpose": "Nonstored source-selector constraints only. Preserve every original strict-v4 lexical/type/range constraint beside the exact canonical SP-278 stored selector.",
  "source_constraint_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "storage_instance_id",
      "checkpoint_key",
      "checkpoint_ref",
      "generation_id",
      "generation_anchor_sha256",
      "frontier_revision",
      "frontier_sha256",
      "index_dataset_name",
      "source_selection"
    ],
    "properties": {
      "storage_instance_id": {
        "type": "string",
        "format": "uuid",
        "minLength": 36,
        "maxLength": 36,
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$(?![\\s\\S])"
      },
      "checkpoint_key": {
        "type": "string",
        "minLength": 1
      },
      "checkpoint_ref": {
        "type": "string",
        "minLength": 1
      },
      "generation_id": {
        "type": "string",
        "pattern": "^eig_[0-9a-f]{64}$(?![\\s\\S])"
      },
      "generation_anchor_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
      },
      "frontier_revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      },
      "frontier_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
      },
      "index_dataset_name": {
        "type": "string",
        "minLength": 1
      },
      "source_selection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "storage_instance_id",
          "current_ref",
          "current_bytes_sha256",
          "selected_segment_generation",
          "manifest_ref",
          "manifest_bytes_sha256",
          "manifest_generation",
          "recovery_epoch",
          "manifest_survivor_prefix_sha256",
          "retained_inventory_sha256",
          "durable_watermarks_sha256",
          "excluded_ranges_sha256",
          "retired_inputs_sha256"
        ],
        "properties": {
          "storage_instance_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$(?![\\s\\S])"
          },
          "current_ref": {
            "const": "storage/seglog/CURRENT"
          },
          "current_bytes_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "selected_segment_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "manifest_ref": {
            "const": "storage/seglog/manifest.v1.msgpack"
          },
          "manifest_bytes_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "manifest_generation": {
            "type": "integer",
