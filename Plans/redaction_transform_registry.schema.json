{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/redaction-transform-registry/1.0.0/redaction_transform_registry.schema.json",
  "title": "Puppet Master Redaction Transform Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "schema_version",
    "owner_doc",
    "runtime_evidence",
    "transforms"
  ],
  "properties": {
    "$schema": {
      "const": "https://puppetmaster.local/schemas/redaction_transform_registry.schema.json"
    },
    "schema_id": {
      "const": "pm.redaction_transform_registry.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "owner_doc": {
      "const": "Plans/storage-plan.md"
    },
    "runtime_evidence": {
      "const": false
    },
    "transforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transform"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform_id",
        "transform_version",
        "kind",
        "applies_to",
        "input_class",
        "output_rule",
        "prohibited_inputs",
        "quarantine_on_match",
        "retention_effect",
        "auth_browser_session_disposition",
        "implementation_status",
        "source_refs"
      ],
      "properties": {
        "transform_id": {
          "type": "string",
          "pattern": "^rt\\.[a-z0-9_.-]+\\.v1$"
        },
        "transform_version": {
          "const": "1.0.0"
        },
        "kind": {
          "enum": [
            "validation_filter",
            "bounded_normalization",
            "retained_media_transform",
            "hard_exclusion"
          ]
        },
        "applies_to": {
          "$ref": "#/$defs/string_list"
        },
        "input_class": {
          "$ref": "#/$defs/non_empty_string"
        },
        "output_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "prohibited_inputs": {
          "$ref": "#/$defs/string_list"
        },
        "quarantine_on_match": {
          "type": "boolean"
        },
        "retention_effect": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auth_browser_session_disposition": {
          "enum": [
            "not_applicable",
            "reject_entire_subject_no_output"
          ]
        },
        "implementation_status": {
          "const": "contract_only_no_runtime_evidence"
        },
        "source_refs": {
          "$ref": "#/$defs/string_list"
        }
      }
    }
  }
}
