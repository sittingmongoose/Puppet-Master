    "oracles": [
      {
        "id": "SEA-NATIVE-01",
        "positive": "Coordinator installs exact immutable floor with source/manifest boundary and terminal receipt before writer activation.",
        "negative": "Missing floor, graph edge, receipt or mismatched instance prevents activation.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-02",
        "positive": "Verified empty source allows all-null boundary tuple.",
        "negative": "Partially null or guessed retained-tail boundary is refused.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-03",
        "positive": "Actual original frame CRC and synchronized frame/watermark precede metadata admission.",
        "negative": "A four-field dedupe row, persisted timestamp or early watermark cannot authorize metadata.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-04",
        "positive": "Same source and instance produce same exact semantic bytes and metadata identities across retry.",
        "negative": "Different bytes under either identity return idempotency_conflict without append.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-05",
        "positive": "Original caller keeps original result when metadata fails.",
        "negative": "Metadata failure cannot rewrite original receipt or rerun original action.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-06",
        "positive": "Metadata gets own sequence and successful synced frame/watermark receipt.",
        "negative": "Original receipt alone cannot acknowledge metadata or advance producer cursor.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-07",
        "positive": "Crash before metadata commit preserves pending original dependency for retry.",
        "negative": "Recovery cannot skip unproved pending source.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-08",
        "positive": "Crash after metadata sync before canonical prefix commit preserves original/meta evidence and reuses settlement once; after prefix commit a lost derived checkpoint rebuilds without reemit.",
        "negative": "Checkpoint or metadata durability alone cannot release pending evidence or impersonate canonical prefix custody.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-09",
        "positive": "New producer skips actual metadata frames without emitting; reader permits valid historical one-hop join.",
        "negative": "Producer metadata-about-metadata emission and reader cycles/self/nonpreceding refs fail.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-10",
        "positive": "Lost derived progress rebuilds from actual immutable floor, authenticated compact prefix and verified current tail.",
        "negative": "Lost canonical prefix requires coherent mandatory backup or fence; no inferred prefix from absence/timestamp/disposable cursor.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-11",
        "positive": "Actual authenticated same-family prefix plus preserved original and metadata event/scoped identities proves prior settlement after expiry without source-presence or receipt claim.",
        "negative": "Original above prefix, wrong identity/scope, missing canonical bytes or forged CAS/read authority yields unavailable and zero reemit.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-12",
        "positive": "Existing live-ref/maintenance dependency preserves original/meta evidence until canonical prefix commit; afterward only that dependency may clear.",
        "negative": "Ordinary TTL/count pressure or derived checkpoint cannot release evidence before canonical commit; all other hold/ref predicates continue.",
        "status": "NOT_RUN"
      },
      {
        "id": "SEA-NATIVE-13",
        "positive": "Actual survivor translation preserves identity and first-append provenance under target CURRENT.",
