          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_empty_string"
        },
        "provider_project_id": {
          "description": "The provider's own stable identifier for the project container, distinct from its display name. Null where the provider has no project layer or issues no separate project identifier. Obtained from a provider resource and never parsed from a remote or display URL.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "repository_locator": {
          "type": "object",
          "required": [
            "organization_or_workspace",
            "project",
            "repository_slug"
          ],
          "properties": {
            "organization_or_workspace": {
              "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_empty_string"
            },
            "project": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "repository_slug": {
              "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_empty_string"
            }
          },
          "additionalProperties": false
        },
        "scope_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "currentness_ref": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_secret_ref"
        },
        "observed_at_utc": {
          "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "enum": [
                  "azure_devops",
                  "bitbucket_data_center"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "repository_locator": {
                "properties": {
                  "project": {
                    "$ref": "https://puppetmaster.local/schemas/forge-integrations/1.0.0/forge_integration_contracts.schema.json#/$defs/non_empty_string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "azure_devops"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "provider_project_id"
            ],
            "properties": {
              "provider_project_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            }
          }
        }
      ]
    },
