{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/assistant_plan_runtime_contracts/1.0.0/assistant_plan_runtime_contracts.schema.json",
  "x-schema-id": "pm.assistant_plan_runtime_contracts.v1",
  "title": "pm.assistant_plan_runtime_contracts.v1",
  "$defs": {
    "AssistantPlanRecordV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "physical_key",
        "source_revision",
        "record"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.assistant_plan_record.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_key": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "record": {
          "$ref": "https://puppetmaster.local/schemas/assistant_plan_cancel_custody/1.0.0/schema.json#/$defs/AssistantPlanRecord"
        }
      }
    },
    "AssistantPlanRecordApplicationV1": {
      "$ref": "https://puppetmaster.local/schemas/application-workflows/1.0.0/contracts.schema.json#/$defs/AssistantPlanRecordApplicationV1"
    },
    "PlanRunV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "storage_instance_id",
        "physical_key",
        "source_revision",
        "record",
        "run_completion_anchor"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.assistant_plan_run.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_key": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "record": {
          "$ref": "https://puppetmaster.local/schemas/assistant_plan_cancel_custody/1.0.0/schema.json#/$defs/PlanRun"
        },
        "run_completion_anchor": {
          "anyOf": [
            {
              "$ref": "https://puppetmaster.local/schemas/assistant_plan_cancel_custody/1.0.0/schema.json#/$defs/RunCompletionAnchor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "record": {
                "properties": {
                  "state": {
                    "enum": [
                      "completed",
                      "cancelled"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "run_completion_anchor": {
                "$ref": "https://puppetmaster.local/schemas/assistant_plan_cancel_custody/1.0.0/schema.json#/$defs/RunCompletionAnchor"
              }
            }
          },
          "else": {
            "properties": {
              "run_completion_anchor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "PlanRunApplicationV1": {
      "$ref": "https://puppetmaster.local/schemas/application-workflows/1.0.0/contracts.schema.json#/$defs/AssistantPlanRunApplicationV1"
    },
    "AssistantPlanRevisionApplicationV1": {
      "$ref": "https://puppetmaster.local/schemas/application-workflows/1.0.0/contracts.schema.json#/$defs/AssistantPlanDocumentRevisionApplicationV1"
    },
    "AssistantPlanCommandRequestApplicationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "context",
        "assistant_plan_id",
        "plan_version",
        "plan_sha256",
        "source_revision_ref",
        "frozen_target_ref",
        "goal_binding_ref",
        "crew_definition_ref"
      ],
      "properties": {
        "command_id": {
          "enum": [
            "cmd.chat.plan.create",
            "cmd.chat.plan.revise",
            "cmd.chat.plan.build",
            "cmd.chat.plan.build_with_crew",
            "cmd.chat.plan.cancel",
            "cmd.chat.plan.export",
            "cmd.chat.plan.open_details",
            "cmd.chat.plan.open_version",
            "cmd.chat.plan.view.set"
          ]
        },
        "context": {
          "$ref": "https://puppetmaster.local/Plans/shared_integration_runtime.schema.json#/$defs/WorkflowCommandContextV1"
        },
        "assistant_plan_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "frozen_target_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "goal_binding_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "crew_definition_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command_id": {
                "enum": [
                  "cmd.chat.plan.build",
                  "cmd.chat.plan.build_with_crew"
                ]
              }
            },
            "required": [
              "command_id"
            ]
          },
          "then": {
            "properties": {
              "assistant_plan_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "plan_version": {
                "type": "integer",
                "minimum": 1
              },
              "plan_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "AssistantPlanCommandResultApplicationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "assistant_plan_id",
        "plan_version",
        "plan_sha256",
        "outcome",
        "owner_result_evidence",
        "plan_run_ref",
        "artifact_ref",
        "todo_binding_ref",
        "return_context_ref"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assistant_plan_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_version": {
          "anyOf": [
