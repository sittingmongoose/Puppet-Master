{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/continuity_event_contracts/1.0.0/schema.json",
  "title": "Continuity source-lineage facts, W3I phase 1, prepared without admission",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:@/+-]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "$comment": "Enforce the original CV-317 EventRecord time profile with the shared fail-closed timestamp helper in phase 2; format is never annotation-only."
    },
    "durable_read_token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "checkpoint_key",
        "checkpoint_ref",
        "generation_id",
        "generation_anchor_sha256",
        "frontier_revision",
        "frontier_sha256",
        "index_dataset_name",
        "source_selection"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint_key": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "type": "string",
          "pattern": "^eig_[0-9a-f]{64}$"
        },
        "generation_anchor_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frontier_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "frontier_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index_dataset_name": {
          "type": "string",
          "minLength": 1
        },
        "source_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storage_instance_id",
            "current_ref",
            "current_bytes_sha256",
            "selected_segment_generation",
            "manifest_ref",
            "manifest_bytes_sha256",
            "manifest_generation",
            "recovery_epoch",
            "manifest_survivor_prefix_sha256",
            "retained_inventory_sha256",
            "durable_watermarks_sha256",
            "excluded_ranges_sha256",
            "retired_inputs_sha256"
          ],
          "properties": {
            "storage_instance_id": {
              "type": "string",
              "format": "uuid"
            },
            "current_ref": {
              "const": "storage/seglog/CURRENT"
            },
            "current_bytes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selected_segment_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "manifest_ref": {
              "const": "storage/seglog/manifest.v1.msgpack"
            },
            "manifest_bytes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifest_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "recovery_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "manifest_survivor_prefix_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retained_inventory_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "durable_watermarks_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "excluded_ranges_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retired_inputs_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "actor_identified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "continuity_id",
        "stream_id",
        "fact_ref",
        "actor_ref",
        "actor_kind",
        "source_event_id",
        "provenance_ref",
        "redaction_profile_id",
        "redaction_decision",
        "created_at_utc",
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "continuity_id": {
          "$ref": "#/$defs/id"
        },
        "stream_id": {
          "$ref": "#/$defs/id"
        },
        "fact_ref": {
          "$ref": "#/$defs/id"
        },
        "actor_ref": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "$ref": "#/$defs/id"
        },
        "source_event_id": {
          "$ref": "#/$defs/id"
        },
        "provenance_ref": {
          "$ref": "#/$defs/id"
        },
        "redaction_profile_id": {
          "$ref": "#/$defs/id"
        },
        "redaction_decision": {
          "$ref": "#/$defs/id"
        },
        "replay_checkpoint_ref": {
          "$ref": "#/$defs/id"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "schema_id": {
          "const": "pm.continuity.actor_identified.payload.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        }
      },
      "$comment": "NEWLY AUTHORED under DL-450, CV-1600. Records identification of the actor responsible for the original source event. Runtime equality/custody guards: actor_ref and actor_kind equal the independently resolved original source principal and principal kind. No payload carries raw source content, secrets, or caller-assigned Storage metadata."
    },
    "provenance_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "continuity_id",
        "stream_id",
        "fact_ref",
        "actor_ref",
        "actor_kind",
        "source_event_id",
        "provenance_ref",
        "redaction_profile_id",
        "redaction_decision",
        "created_at_utc",
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "continuity_id": {
          "$ref": "#/$defs/id"
        },
        "stream_id": {
          "$ref": "#/$defs/id"
        },
        "fact_ref": {
          "$ref": "#/$defs/id"
        },
        "actor_ref": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "$ref": "#/$defs/id"
        },
        "source_event_id": {
          "$ref": "#/$defs/id"
        },
        "provenance_ref": {
          "$ref": "#/$defs/id"
        },
        "redaction_profile_id": {
          "$ref": "#/$defs/id"
        },
        "redaction_decision": {
          "$ref": "#/$defs/id"
        },
        "replay_checkpoint_ref": {
          "$ref": "#/$defs/id"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "schema_id": {
          "const": "pm.continuity.provenance_recorded.payload.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        }
      },
      "$comment": "NEWLY AUTHORED under DL-450, CV-1601. Records the original source and provenance of a continuity record. Runtime equality/custody guards: provenance_ref resolves the exact retained output or handoff version that names source_event_id; a route target is not provenance evidence. No payload carries raw source content, secrets, or caller-assigned Storage metadata."
    },
    "redaction_applied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "continuity_id",
        "stream_id",
        "fact_ref",
        "actor_ref",
        "actor_kind",
        "source_event_id",
        "provenance_ref",
        "redaction_profile_id",
        "redaction_decision",
        "created_at_utc",
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "continuity_id": {
          "$ref": "#/$defs/id"
        },
        "stream_id": {
          "$ref": "#/$defs/id"
        },
        "fact_ref": {
          "$ref": "#/$defs/id"
        },
        "actor_ref": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "$ref": "#/$defs/id"
        },
        "source_event_id": {
          "$ref": "#/$defs/id"
        },
        "provenance_ref": {
          "$ref": "#/$defs/id"
        },
        "redaction_profile_id": {
          "$ref": "#/$defs/id"
        },
        "redaction_decision": {
          "$ref": "#/$defs/id"
        },
        "replay_checkpoint_ref": {
          "$ref": "#/$defs/id"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "schema_id": {
          "const": "pm.continuity.redaction_applied.payload.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        }
      },
      "$comment": "NEWLY AUTHORED under DL-450, CV-1602. Records the actual redaction disposition attached to the original continuity source. Runtime equality/custody guards: redaction_profile_id and redaction_decision equal the actual original redaction owner result for provenance_ref, including its transform/version; a requested transform is not an applied result. No payload carries raw source content, secrets, or caller-assigned Storage metadata."
    },
    "replay_checkpointed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "continuity_id",
        "stream_id",
        "fact_ref",
        "actor_ref",
        "actor_kind",
        "source_event_id",
        "provenance_ref",
        "redaction_profile_id",
        "redaction_decision",
        "replay_checkpoint_ref",
        "created_at_utc",
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "continuity_id": {
          "$ref": "#/$defs/id"
        },
        "stream_id": {
          "$ref": "#/$defs/id"
        },
        "fact_ref": {
          "$ref": "#/$defs/id"
        },
        "actor_ref": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "$ref": "#/$defs/id"
        },
        "source_event_id": {
          "$ref": "#/$defs/id"
        },
        "provenance_ref": {
          "$ref": "#/$defs/id"
        },
        "redaction_profile_id": {
          "$ref": "#/$defs/id"
        },
        "redaction_decision": {
          "$ref": "#/$defs/id"
        },
        "replay_checkpoint_ref": {
          "$ref": "#/$defs/id"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "schema_id": {
          "const": "pm.continuity.replay_checkpointed.payload.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        }
      },
      "$comment": "NEWLY AUTHORED under DL-450, CV-1603. Records a verified saved position reached while replaying the original audit source stream. Runtime equality/custody guards: replay_checkpoint_ref resolves the original source stream checkpoint, whose complete SP-278 durable token and examined prefix include source_event_id; it is an upstream checkpoint, never this event or its downstream continuity checkpoint. No payload carries raw source content, secrets, or caller-assigned Storage metadata."
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "project_id",
        "continuity_id",
        "stream_id",
        "event_type",
        "event_id",
        "sequence_id",
        "publication_id",
        "body_event_id"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.continuity_record.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "continuity_id": {
          "$ref": "#/$defs/id"
        },
        "stream_id": {
          "$ref": "#/$defs/id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "publication_id": {
          "$ref": "#/$defs/id"
        },
        "event_type": {
          "enum": [
            "continuity.actor_identified",
            "continuity.provenance_recorded",
            "continuity.redaction_applied",
            "continuity.replay_checkpointed"
          ]
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "body_event_id": {
          "$ref": "#/$defs/id"
        }
      },
      "$comment": "Physical derived row only. body_event_id equals event_id and resolves the complete original logical continuity_record snapshot through original full-value custody. No duplicated large body or separately authoritative projected snapshot."
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "projector_id",
        "projector_version",
        "storage_instance_id",
        "project_id",
        "stream_id",
        "publication_id",
        "admitted_event_types",
        "index_read_token",
        "index_through_sequence_id",
        "source_cursor",
        "filter_complete",
        "state",
        "withdrawn_at_utc",
        "retired_publications",
        "hold_refs"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.continuity_replay_checkpoint.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "projector_id": {
          "const": "storage.continuity_projector.v1"
        },
        "projector_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "$ref": "#/$defs/id"
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "stream_id": {
          "$ref": "#/$defs/id"
        },
        "publication_id": {
          "$ref": "#/$defs/id"
        },
        "admitted_event_types": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "continuity.actor_identified",
              "continuity.provenance_recorded",
              "continuity.redaction_applied",
              "continuity.replay_checkpointed"
            ]
          }
        },
        "index_read_token": {
          "$ref": "#/$defs/durable_read_token"
        },
        "index_through_sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source_cursor": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_generation",
                "segment_name",
                "byte_offset",
                "frame_end_offset",
                "last_sequence_id",
                "last_event_id"
              ],
              "properties": {
                "segment_generation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "segment_name": {
                  "type": "string",
                  "pattern": "^seg-[0-9]{6,}-[0-9]{20}(-[0-9]{20}\\.seglog|\\.active)$"
                },
                "byte_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "frame_end_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "last_sequence_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "last_event_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "filter_complete": {
          "const": true
        },
        "state": {
          "enum": [
            "current",
            "withdrawn"
          ]
        },
        "withdrawn_at_utc": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "retired_publications": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/checkpoint_core"
          }
        },
        "hold_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "current"
              }
            }
          },
          "then": {
            "properties": {
              "withdrawn_at_utc": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "withdrawn_at_utc": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      ]
    },
    "checkpoint_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "projector_id",
        "projector_version",
        "storage_instance_id",
        "project_id",
        "stream_id",
        "publication_id",
        "admitted_event_types",
        "index_read_token",
        "index_through_sequence_id",
        "source_cursor",
        "filter_complete",
        "state",
        "withdrawn_at_utc",
        "hold_refs"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.storage_value.continuity_replay_checkpoint.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "projector_id": {
          "const": "storage.continuity_projector.v1"
        },
        "projector_version": {
          "const": "1.0.0"
        },
        "storage_instance_id": {
          "$ref": "#/$defs/id"
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "stream_id": {
          "$ref": "#/$defs/id"
        },
        "publication_id": {
          "$ref": "#/$defs/id"
        },
        "admitted_event_types": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "continuity.actor_identified",
              "continuity.provenance_recorded",
              "continuity.redaction_applied",
              "continuity.replay_checkpointed"
            ]
          }
        },
        "index_read_token": {
          "$ref": "#/$defs/durable_read_token"
        },
        "index_through_sequence_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source_cursor": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_generation",
                "segment_name",
                "byte_offset",
                "frame_end_offset",
                "last_sequence_id",
                "last_event_id"
              ],
              "properties": {
                "segment_generation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "segment_name": {
                  "type": "string",
                  "pattern": "^seg-[0-9]{6,}-[0-9]{20}(-[0-9]{20}\\.seglog|\\.active)$"
                },
                "byte_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "frame_end_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "last_sequence_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "last_event_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "filter_complete": {
          "const": true
        },
        "state": {
          "enum": [
            "current",
            "withdrawn"
          ]
        },
        "withdrawn_at_utc": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "hold_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "current"
              }
            }
          },
          "then": {
            "properties": {
              "withdrawn_at_utc": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "withdrawn_at_utc": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      ]
    }
  }
}
