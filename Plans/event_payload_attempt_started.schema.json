{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/event_payloads/attempt_started/1.0.0",
  "title": "attempt.started prepared payload contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "replan_generation": {
      "type": "integer",
      "minimum": 0
    },
    "scheduler_lane": {
      "enum": [
        "remediation",
        "unblocker",
        "normal"
      ]
    },
    "permission_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_model_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "effective_model_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "safe_point_id": {
      "type": "string",
      "minLength": 1
    },
    "remediation_root_id": {
      "type": "string",
      "minLength": 1
    },
    "remediation_parent_attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_account_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "effective_account_snapshot_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "event_sequence",
    "ts",
    "run_id",
    "thread_id",
    "node_id",
    "attempt_id",
    "replan_generation",
    "scheduler_lane",
    "permission_snapshot_id",
    "requested_model_snapshot_id",
    "effective_model_snapshot_id",
    "runtime_snapshot_ref"
  ]
}
