        },
        "capability_profile_hash": {
          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program_compile_result/properties/capability_profile_hash"
        },
        "ast_hash": {
          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program_compile_result/properties/ast_hash"
        },
        "ast": {
          "$ref": "#/$defs/browser_program_ast_v2"
        },
        "static_bounds": {
          "$ref": "#/$defs/static_bounds"
        }
