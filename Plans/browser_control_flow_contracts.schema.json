          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program_compile_result/properties/no_effect_before_execution"
        },
        "program_id": {
          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program_compile_result/properties/program_id"
        },
        "source_hash": {
          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program_compile_result/properties/source_hash"
        },
