    "browser_compile_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "request",
        "result",
        "program"
      ],
      "properties": {
        "record_kind": {
          "const": "browser_control_compile_validation"
        },
        "request": {
          "$ref": "#/$defs/browser_compile_request_v2"
        },
        "result": {
          "$ref": "#/$defs/browser_compile_result_v2"
        },
        "program": {
          "$ref": "#/$defs/browser_program_v2"
        }
      }
    },
    "browser_result_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "program",
        "resolved_schema_ref",
        "result_schema_utf8",
        "result_schema_resources",
        "terminal_subject",
        "terminal_workspace_revision",
