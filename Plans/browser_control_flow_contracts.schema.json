        "source_hash",
        "compiler_hash",
        "browser_program_api_digest",
        "capability_profile_hash",
        "ast_hash",
        "ast",
        "static_bounds"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.browser_program.compile_result.v2"
        },
        "record_kind": {
