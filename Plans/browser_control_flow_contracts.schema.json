          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program/properties/effective_execution_strategy"
        },
        "required_capabilities": {
          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program/properties/required_capabilities"
        },
        "program_workspace_id": {
          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program/properties/program_workspace_id"
        },
        "expected_workspace_revision": {
          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program/properties/expected_workspace_revision"
        },
        "budgets": {
          "$ref": "pm.section15_browser_program_contracts.schema.v1#/$defs/browser_program/properties/budgets"
