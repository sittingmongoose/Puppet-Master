            "evidence_kind": {
              "const": "record_hash_comparison"
            },
            "expected_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "referenced_material_field": {
              "type": "null"
            },
            "referenced_material_ref": {
              "type": "null"
            },
            "expected_material_hash": {
              "type": "null"
            },
            "observed_material_hash": {
              "type": "null"
            },
            "expected_material_length": {
              "type": "null"
            },
            "observed_material_length": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "unreadable_record"
            },
            "evidence_kind": {
              "const": "record_decode_failure"
            },
            "expected_hash": {
              "type": "null"
            },
            "referenced_material_field": {
              "type": "null"
            },
            "referenced_material_ref": {
              "type": "null"
            },
            "expected_material_hash": {
              "type": "null"
            },
            "observed_material_hash": {
              "type": "null"
            },
            "expected_material_length": {
              "type": "null"
            },
            "observed_material_length": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "corrupt_referenced_material"
            },
            "evidence_kind": {
              "const": "referenced_material_integrity_check"
            },
            "expected_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "referenced_material_field": {
              "type": "string"
            },
            "referenced_material_ref": {
              "type": "string",
              "minLength": 1
            },
            "expected_material_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "observed_material_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_material_length": {
              "type": "integer"
            },
            "observed_material_length": {
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "unsupported_content_scope"
            },
            "evidence_kind": {
              "const": "content_scope_validation"
            },
            "expected_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "referenced_material_field": {
              "type": "string"
            },
            "referenced_material_ref": {
              "type": "string",
              "minLength": 1
            },
            "expected_material_hash": {
              "type": "null"
            },
            "observed_material_hash": {
              "type": "null"
            },
            "expected_material_length": {
              "type": "null"
            },
            "observed_material_length": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
