{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/usage_run_estimate/1.0.0/usage_run_estimate_contracts.schema.json",
  "title": "Usage pre-start run estimate static contract schemas",
  "description": "Closed shapes for UF-104/DL-138 pre-start estimates. Each figure is independently based: pricing supports cost and latency samples support duration. Known figures remain visible when the other basis is absent; neither yields a number when both are absent. Hard Plan budget is an admission/stop rule, not an estimate settlement. Static schema and fixture consistency only; no provider, pricing lookup, runtime, visual or performance claim.",
  "oneOf": [
    {
      "$ref": "#/$defs/run_estimate"
    },
    {
      "$ref": "#/$defs/run_estimate_no_basis"
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_negative_integer_range": {
      "description": "[lo, hi], both non-negative integers.",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "items": false,
      "minItems": 2
    },
    "positive_integer_range": {
      "description": "[lo, hi] for replies, both at least 1.",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2
    },
    "estimate_basis": {
      "description": "Independent figure bases: pricing_snapshot_id for cost_microdollars and latency_sample_ref for duration_s (UF-104, DL-138).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pricing_snapshot_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "latency_sample_ref": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "minProperties": 1
    },
    "run_estimate": {
      "description": "At least one supported cost or duration range. Each present basis requires its figure and each figure requires its own basis; replies is optional for reply-counted kinds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "basis",
        "source_class"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.usage.run_estimate.v1"
        },
        "duration_s": {
          "$ref": "#/$defs/non_negative_integer_range"
        },
        "cost_microdollars": {
          "$ref": "#/$defs/non_negative_integer_range"
        },
        "replies": {
          "$ref": "#/$defs/positive_integer_range"
        },
        "basis": {
          "$ref": "#/$defs/estimate_basis"
        },
        "source_class": {
          "const": "pricing_estimated"
        }
      },
      "anyOf": [
        {
          "required": [
            "duration_s"
          ]
        },
        {
          "required": [
            "cost_microdollars"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "required": [
                  "pricing_snapshot_id"
                ]
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "required": [
              "cost_microdollars"
            ]
          },
          "else": {
            "properties": {
              "cost_microdollars": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "required": [
                  "latency_sample_ref"
                ]
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "required": [
              "duration_s"
            ]
          },
          "else": {
            "properties": {
              "duration_s": false
            }
          }
        }
      ]
    },
    "run_estimate_no_basis": {
      "description": "Neither figure is available because both pricing and latency bases are missing; surfaces show no range, never $0.00.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "missing_basis",
        "source_class"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.usage.run_estimate_no_basis.v1"
        },
        "missing_basis": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pricing_snapshot",
              "latency_samples"
            ]
          },
          "maxItems": 2
        },
        "source_class": {
          "const": "pricing_estimated"
        }
      }
    }
  }
}
