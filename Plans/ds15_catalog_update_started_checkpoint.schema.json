{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "scope",
    "consumer_id",
    "index_read_token",
    "through_sequence_id",
    "last_event_id",
    "state"
  ],
  "properties": {
    "schema_id": {
      "const": "pm.ds15.catalog_update_started.checkpoint.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "consumer_id": {
      "const": "reader.ds15.catalog_update_started.v1@1.0.0"
    },
    "index_read_token": {
      "$ref": "#/$defs/read_token"
    },
    "through_sequence_id": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "current",
        "withdrawn"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "project_id",
        "user_id",
        "computer_id",
        "profile_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "project",
            "app"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "computer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "project"
              }
            }
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "app"
              }
            }
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.ds15.catalog_update_started.checkpoint.v1",
  "$defs": {
    "read_token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "checkpoint_key",
        "checkpoint_ref",
        "generation_id",
        "generation_anchor_sha256",
        "frontier_revision",
        "frontier_sha256",
        "index_dataset_name",
        "source_selection"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint_key": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "type": "string",
          "pattern": "^eig_[0-9a-f]{64}$"
        },
        "generation_anchor_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frontier_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "frontier_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index_dataset_name": {
          "type": "string",
          "minLength": 1
        },
        "source_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storage_instance_id",
            "current_ref",
            "current_bytes_sha256",
            "selected_segment_generation",
            "manifest_ref",
            "manifest_bytes_sha256",
            "manifest_generation",
            "recovery_epoch",
            "manifest_survivor_prefix_sha256",
            "retained_inventory_sha256",
            "durable_watermarks_sha256",
            "excluded_ranges_sha256",
            "retired_inputs_sha256"
          ],
          "properties": {
            "storage_instance_id": {
              "type": "string",
              "format": "uuid"
            },
            "current_ref": {
              "const": "storage/seglog/CURRENT"
            },
            "current_bytes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selected_segment_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "manifest_ref": {
              "const": "storage/seglog/manifest.v1.msgpack"
            },
            "manifest_bytes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifest_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "recovery_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "manifest_survivor_prefix_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retained_inventory_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "durable_watermarks_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "excluded_ranges_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retired_inputs_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
