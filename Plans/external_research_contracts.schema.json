{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/external_research/1.0.0/external_research_contracts.schema.json",
  "title": "External Research static contract schemas",
  "description": "Closed record shapes for the external research capability owned by Plans/External_Research.md: the research job record, the classified finding record, the decision packet and its card, the budget receipt and the run manifest. Static schema and fixture consistency only; no runtime, provider, security, performance or readiness claim.",
  "oneOf": [
    {"$ref": "#/$defs/research_job_record"},
    {"$ref": "#/$defs/research_finding_record"},
    {"$ref": "#/$defs/research_decision_packet"},
    {"$ref": "#/$defs/research_decision_card"},
    {"$ref": "#/$defs/research_budget_receipt"},
    {"$ref": "#/$defs/research_run_manifest"}
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_utc_timestamp": {
      "oneOf": [
        {"$ref": "#/$defs/utc_timestamp"},
        {"type": "null"}
      ]
    },
    "usd_amount": {
      "type": "number",
      "minimum": 0
    },
    "admitted_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_class", "path", "sha256"],
      "properties": {
        "input_class": {
          "description": "Closed admission vocabulary. A decision record, answered packet or decision sheet has no admissible value here, so research input leakage is not expressible.",
          "enum": ["frozen_plans_snapshot", "product_brief", "arm_artifact"]
        },
        "path": {"$ref": "#/$defs/non_empty_string"},
        "sha256": {"$ref": "#/$defs/sha256_hex"}
      }
    },
    "finding_citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "locator", "sha256"],
      "properties": {
        "source_path": {"$ref": "#/$defs/non_empty_string"},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "sha256": {"$ref": "#/$defs/sha256_hex"}
      }
    },
    "output_tree_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_path", "manifest_sha256", "telemetry_quiesced"],
      "properties": {
        "tree_path": {"$ref": "#/$defs/non_empty_string"},
        "manifest_sha256": {"$ref": "#/$defs/sha256_hex"},
        "telemetry_quiesced": {
          "description": "The monitor and every other telemetry writer were stopped before the tree was hashed. A tree hashed while a writer was live is not a frozen tree.",
          "const": true
        }
      }
    },
    "rehash_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "assertion_document"],
      "properties": {
        "path": {"$ref": "#/$defs/non_empty_string"},
        "reason": {"$ref": "#/$defs/non_empty_string"},
        "assertion_document": {"type": "boolean"}
      }
    },
    "research_job_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "research_job_id",
        "topic_id",
        "project_id",
        "arm_id",
        "stage",
        "admitted_inputs",
        "admitted_lead_count",
        "max_model_responses",
        "max_job_seconds",
        "responses_admitted",
        "elapsed_seconds",
        "terminal_state",
        "bound_by",
        "bound_by_source",
        "assertions_saved",
        "run_manifest_ref"
      ],
      "properties": {
        "schema_id": {"const": "pm.external_research.research_job.v1"},
        "schema_version": {"const": "1.0.0"},
        "research_job_id": {"$ref": "#/$defs/non_empty_string"},
        "topic_id": {"$ref": "#/$defs/non_empty_string"},
        "project_id": {"$ref": "#/$defs/non_empty_string"},
        "arm_id": {"$ref": "#/$defs/non_empty_string"},
        "stage": {"enum": ["discovery", "implementation", "history", "reconcile", "compare"]},
        "admitted_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/admitted_input"}
        },
        "admitted_lead_count": {"type": "integer", "minimum": 0},
        "max_model_responses": {"type": "integer", "minimum": 1},
        "max_job_seconds": {"type": "integer", "minimum": 1},
        "responses_admitted": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "terminal_state": {"enum": ["finished", "responses", "time", "budget", "other"]},
        "bound_by": {"enum": ["designed_stop", "response_ceiling", "job_time_limit", "budget_cap", "other"]},
        "bound_by_source": {
          "description": "Read from the runtime's own result record and the durable meter. An adapter label alone is not a source, because an adapter may report any denial as a budget denial when the cause was the response ceiling.",
          "enum": ["runtime_result_record", "durable_meter", "both"]
        },
        "assertions_saved": {"type": "integer", "minimum": 0},
        "run_manifest_ref": {"$ref": "#/$defs/non_empty_string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"stage": {"enum": ["discovery", "implementation", "history"]}},
            "required": ["stage"]
          },
          "then": {
            "properties": {
              "admitted_inputs": {
                "items": {
                  "not": {
                    "properties": {"input_class": {"const": "frozen_plans_snapshot"}},
                    "required": ["input_class"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"bound_by": {"const": "designed_stop"}},
            "required": ["bound_by"]
          },
          "then": {
            "properties": {"terminal_state": {"const": "finished"}},
            "required": ["terminal_state"]
          }
        }
      ]
    },
    "research_finding_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "finding_id",
        "topic_id",
        "union_id",
        "finding_class",
        "title",
        "proposition",
        "citations",
        "credit_state",
        "credited_job_ref",
        "in_union",
        "landing_path",
        "rejection_check_refs"
      ],
      "properties": {
        "schema_id": {"const": "pm.external_research.finding.v1"},
        "schema_version": {"const": "1.0.0"},
        "finding_id": {"$ref": "#/$defs/non_empty_string"},
        "topic_id": {"$ref": "#/$defs/non_empty_string"},
        "union_id": {"$ref": "#/$defs/non_empty_string"},
        "finding_class": {"enum": ["correction", "capability", "product_choice", "unsupported_or_covered"]},
        "title": {"$ref": "#/$defs/non_empty_string"},
        "proposition": {"$ref": "#/$defs/non_empty_string"},
        "citations": {
          "description": "At least one cited passage. A credit without a cited passage is not expressible.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/finding_citation"}
        },
        "credit_state": {"enum": ["credited", "partial", "refused", "candidate"]},
        "credited_job_ref": {
          "oneOf": [
            {"$ref": "#/$defs/non_empty_string"},
            {"type": "null"}
          ]
        },
        "in_union": {"type": "boolean"},
        "landing_path": {"enum": ["repair_authorization", "user_decision", "none"]},
        "rejection_check_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"finding_class": {"const": "correction"}},
            "required": ["finding_class"]
          },
          "then": {
            "properties": {"landing_path": {"const": "repair_authorization"}},
            "required": ["landing_path"]
          }
        },
        {
          "if": {
            "properties": {"finding_class": {"enum": ["capability", "product_choice"]}},
            "required": ["finding_class"]
          },
          "then": {
            "properties": {"landing_path": {"const": "user_decision"}},
            "required": ["landing_path"]
          }
        },
        {
          "if": {
            "properties": {"finding_class": {"const": "unsupported_or_covered"}},
            "required": ["finding_class"]
          },
          "then": {
            "properties": {"landing_path": {"const": "none"}},
            "required": ["landing_path"]
          }
        },
        {
          "if": {
            "properties": {"credit_state": {"const": "candidate"}},
            "required": ["credit_state"]
          },
          "then": {
            "properties": {
              "in_union": {"const": false},
              "rejection_check_refs": {"minItems": 1}
            },
            "required": ["in_union", "rejection_check_refs"]
          }
        },
        {
          "if": {
            "properties": {"credit_state": {"const": "credited"}},
            "required": ["credit_state"]
          },
          "then": {
            "properties": {"credited_job_ref": {"$ref": "#/$defs/non_empty_string"}},
            "required": ["credited_job_ref"]
          }
        }
      ]
    },
    "research_decision_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "decision_packet_id",
        "topic_id",
        "project_id",
        "artifact_ref",
        "card_refs",
        "presentation",
        "status_label_mode",
        "created_at_utc"
      ],
      "properties": {
        "schema_id": {"const": "pm.external_research.decision_packet.v1"},
        "schema_version": {"const": "1.0.0"},
        "decision_packet_id": {"$ref": "#/$defs/non_empty_string"},
        "topic_id": {"$ref": "#/$defs/non_empty_string"},
        "project_id": {"$ref": "#/$defs/non_empty_string"},
        "artifact_ref": {
          "description": "The one chat artifact containing every item, openable throughout presentation. The artifact surface itself is owned by Plans/assistant-chat-design.md under DL-036.",
          "$ref": "#/$defs/non_empty_string"
        },
        "card_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "presentation": {"const": "one_at_a_time"},
        "status_label_mode": {
          "description": "Text labels only. Colored border bars, stripes and emoji glyphs are not expressible.",
          "const": "text_only"
        },
        "created_at_utc": {"$ref": "#/$defs/utc_timestamp"}
      }
    },
    "research_decision_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "decision_card_id",
        "decision_packet_id",
        "finding_ref",
        "finding_class",
        "plain_name",
        "question",
        "why_it_came_up",
        "what_you_get",
        "what_it_costs",
        "options",
        "recommendation",
        "allowed_responses",
        "disposition",
        "disposition_recorded_at_utc"
      ],
      "properties": {
        "schema_id": {"const": "pm.external_research.decision_card.v1"},
        "schema_version": {"const": "1.0.0"},
        "decision_card_id": {"$ref": "#/$defs/non_empty_string"},
        "decision_packet_id": {"$ref": "#/$defs/non_empty_string"},
        "finding_ref": {"$ref": "#/$defs/non_empty_string"},
        "finding_class": {
          "description": "A correction lands under the standing repair authorization and never becomes a card, so its class is not admissible here.",
          "enum": ["capability", "product_choice"]
        },
        "plain_name": {"$ref": "#/$defs/non_empty_string"},
        "question": {"$ref": "#/$defs/non_empty_string"},
        "why_it_came_up": {"$ref": "#/$defs/non_empty_string"},
        "what_you_get": {"$ref": "#/$defs/non_empty_string"},
        "what_it_costs": {"$ref": "#/$defs/non_empty_string"},
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "recommendation": {
          "oneOf": [
            {"$ref": "#/$defs/non_empty_string"},
            {"type": "null"}
          ]
        },
        "allowed_responses": {
          "description": "The fixed DL-036 response set, in order. The contract for these responses is owned by Plans/assistant-chat-design.md; this field binds the card to it and admits no variation.",
          "type": "array",
          "prefixItems": [
            {"const": "approve"},
            {"const": "deny"},
            {"const": "deny_with_changes"},
            {"const": "ask_a_question"}
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        },
        "disposition": {"enum": ["pending", "approve", "deny", "deny_with_changes", "ask_a_question"]},
        "disposition_recorded_at_utc": {"$ref": "#/$defs/nullable_utc_timestamp"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"disposition": {"const": "pending"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {"disposition_recorded_at_utc": {"type": "null"}},
            "required": ["disposition_recorded_at_utc"]
          },
          "else": {
            "properties": {"disposition_recorded_at_utc": {"$ref": "#/$defs/utc_timestamp"}},
            "required": ["disposition_recorded_at_utc"]
          }
        }
      ]
    },
    "research_budget_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "budget_receipt_id",
        "research_job_ref",
        "arm_id",
        "lifetime_cap_usd",
        "captured_usage_usd",
        "in_flight_allowance_usd",
        "unresolved_usage_usd",
        "allowance_basis",
        "reconciled_jobs_for_average",
        "native_records_present",
        "valuation_basis",
        "estimate_disclaimer",
        "admission_decision"
      ],
      "properties": {
        "schema_id": {"const": "pm.external_research.budget_receipt.v1"},
        "schema_version": {"const": "1.0.0"},
        "budget_receipt_id": {"$ref": "#/$defs/non_empty_string"},
        "research_job_ref": {"$ref": "#/$defs/non_empty_string"},
        "arm_id": {"$ref": "#/$defs/non_empty_string"},
        "lifetime_cap_usd": {"$ref": "#/$defs/usd_amount"},
        "captured_usage_usd": {"$ref": "#/$defs/usd_amount"},
        "in_flight_allowance_usd": {"$ref": "#/$defs/usd_amount"},
        "unresolved_usage_usd": {"$ref": "#/$defs/usd_amount"},
        "allowance_basis": {"enum": ["cold_allowance", "same_arm_same_stage_average"]},
        "reconciled_jobs_for_average": {"type": "integer", "minimum": 0},
        "native_records_present": {"type": "boolean"},
        "valuation_basis": {"enum": ["native_usage_records", "runtime_reported_cost", "tariff_floor"]},
        "estimate_disclaimer": {
          "description": "Captured usage is an upper-bound estimate, never a billed amount or a certified total liability. The disclaimer is required, so a receipt cannot be published without it.",
          "const": "captured_usage_is_an_upper_bound_estimate_not_a_billed_amount"
        },
        "admission_decision": {"enum": ["admitted", "denied"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"allowance_basis": {"const": "same_arm_same_stage_average"}},
            "required": ["allowance_basis"]
          },
          "then": {
            "properties": {"reconciled_jobs_for_average": {"minimum": 2}},
            "required": ["reconciled_jobs_for_average"]
          }
        },
        {
          "if": {
            "properties": {"native_records_present": {"const": false}},
            "required": ["native_records_present"]
          },
          "then": {
            "properties": {"unresolved_usage_usd": {"exclusiveMinimum": 0}},
            "required": ["unresolved_usage_usd"]
          }
        },
        {
          "if": {
            "properties": {"native_records_present": {"const": true}},
            "required": ["native_records_present"]
          },
          "then": {
            "properties": {"valuation_basis": {"enum": ["native_usage_records", "runtime_reported_cost", "tariff_floor"]}},
            "required": ["valuation_basis"]
          },
          "else": {
            "properties": {"valuation_basis": {"const": "tariff_floor"}},
            "required": ["valuation_basis"]
          }
        }
      ]
    },
    "research_run_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "run_manifest_id",
        "topic_id",
        "protocol_freeze_sha256",
        "protocol_file_hashes",
        "protocol_fingerprint",
        "freeze_recorded_at_utc",
        "first_job_started_at_utc",
        "freeze_precedes_first_job",
        "runtime_identity",
        "output_tree_manifests",
        "rehash_differences"
      ],
      "properties": {
        "schema_id": {"const": "pm.external_research.run_manifest.v1"},
        "schema_version": {"const": "1.0.0"},
        "run_manifest_id": {"$ref": "#/$defs/non_empty_string"},
        "topic_id": {"$ref": "#/$defs/non_empty_string"},
        "protocol_freeze_sha256": {"$ref": "#/$defs/sha256_hex"},
        "protocol_file_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256_hex"}
        },
        "protocol_fingerprint": {"$ref": "#/$defs/non_empty_string"},
        "freeze_recorded_at_utc": {"$ref": "#/$defs/utc_timestamp"},
        "first_job_started_at_utc": {"$ref": "#/$defs/utc_timestamp"},
        "freeze_precedes_first_job": {
          "description": "The representable form of the ordering obligation: a manifest that declares the freeze did not precede the first job it governed is rejected. The timestamp comparison itself is an owner obligation stated in ERS-014.",
          "const": true
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["binary_path", "reported_version", "binary_sha256", "capture_basis"],
          "properties": {
            "binary_path": {"$ref": "#/$defs/non_empty_string"},
            "reported_version": {"$ref": "#/$defs/non_empty_string"},
            "binary_sha256": {"$ref": "#/$defs/sha256_hex"},
            "capture_basis": {
              "description": "Read from the installed binary at capability time. A declared or hardcoded runtime version has no admissible value here.",
              "const": "installed_binary_at_capability_time"
            }
          }
        },
        "output_tree_manifests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/output_tree_manifest"}
        },
        "rehash_differences": {
          "type": "array",
          "items": {"$ref": "#/$defs/rehash_difference"}
        }
      }
    }
  }
}
