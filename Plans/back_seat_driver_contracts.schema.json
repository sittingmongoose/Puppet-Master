        "project_id",
        "scope_kind",
        "expected_epoch",
        "actor_ref",
        "permission_snapshot_ref",
        "idempotency_key",
        "source_surface",
        "return_route",
        "bsd_finding_id",
        "finding_key"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.bsd.finding_dismiss_request.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "request_type": {
          "const": "BSDFindingDismissRequest"
