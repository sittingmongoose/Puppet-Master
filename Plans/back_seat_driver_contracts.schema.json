          "$ref": "#/$defs/non_secret_ref"
        },
        "permission_snapshot_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "idempotency_key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_surface": {
          "enum": [
            "bsd_note",
            "bsd_details"
          ]
        },
        "return_route": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "bsd_finding_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "finding_key": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "bsd_finding_dismiss_result": {
      "description": "BSDFindingDismissResult, BSD-037. An accepted dismissal reports the finding closed with closed_reason dismissed_by_user under the resulting epoch; the closure is durable across restart and advisor reset, and the finding reopens only on a changed evidence fingerprint as a recorded reopen. A prior-epoch request is rejected stale_epoch and a finding that is no longer emitted is rejected already_in_state. Every path fixes primary_run_mutated false and authority_granted false and carries a projection reference (section 18).",
      "type": "object",
      "additionalProperties": false,
      "x-primary-identity-fields": [
        "command_instance_id"
      ],
      "required": [
        "schema_id",
        "schema_version",
        "result_type",
        "command_id",
        "command_instance_id",
        "outcome",
        "error_code",
        "resulting_epoch",
        "projection_ref",
        "primary_run_mutated",
        "authority_granted",
        "bsd_finding_id",
        "finding_key",
        "finding_state",
        "closed_reason"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.bsd.finding_dismiss_result.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "result_type": {
          "const": "BSDFindingDismissResult"
        },
        "command_id": {
