{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/expectation-packet.v1.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "family_id", "role_id", "intent", "discovery_directive", "detailed_plan_assertions_withheld_until_lock", "capability_slice_manifest_sha256", "source_binding_population_sha256", "expectation_payload_sha256"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "schema_id": {"const": "pm.plan_assurance.expectation_packet.v1.1"},
    "family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]},
    "role_id": {"enum": ["LOCAL_EXPECTATION_MODELER", "OPEN_DISCOVERY_RESEARCHER"]},
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["user_outcomes", "non_goals", "risk_signals"],
      "properties": {
        "user_outcomes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "non_goals": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "risk_signals": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    },
    "discovery_directive": {
      "type": "object", "additionalProperties": false,
      "required": ["independent_from_finished_plan", "external_research_required", "creative_inspiration_required", "comparators_and_adjacent_approaches_required", "failure_evidence_required"],
      "properties": {
        "independent_from_finished_plan": {"const": true},
        "external_research_required": {"type": "boolean"},
        "creative_inspiration_required": {"type": "boolean"},
        "comparators_and_adjacent_approaches_required": {"type": "boolean"},
        "failure_evidence_required": {"type": "boolean"}
      }
    },
    "detailed_plan_assertions_withheld_until_lock": {"const": true},
    "capability_slice_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_binding_population_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectation_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
