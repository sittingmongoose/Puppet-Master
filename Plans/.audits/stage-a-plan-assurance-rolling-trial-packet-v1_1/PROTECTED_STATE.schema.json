{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/protected-state.v1.1.json",
  "title": "Compact Plan Assurance Protected Repository State",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "packet_id", "receipt_id", "trial_id", "generation_id", "phase", "effective_contract_sha256", "packet_core_population_sha256", "source_snapshot_sha256", "source_snapshot_population_sha256", "repository_root", "captured_at_utc", "collector", "exclusion_contract", "git_state", "protected_populations", "run_root_observation", "invariance_payload_sha256", "comparison", "verification_mode", "terminal", "receipt_payload_sha256"],
  "properties": {
    "schema_version": {"const": "1.1.0"}, "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1_1"},
    "receipt_id": {"type": "string", "minLength": 1}, "trial_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1}, "phase": {"enum": ["BEFORE", "AFTER"]},
    "effective_contract_sha256": {"$ref": "#/$defs/sha256"}, "packet_core_population_sha256": {"$ref": "#/$defs/sha256"},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha256"}, "source_snapshot_population_sha256": {"$ref": "#/$defs/sha256"},
    "repository_root": {"type": "string", "minLength": 1}, "captured_at_utc": {"type": "string", "format": "date-time"},
    "collector": {"$ref": "#/$defs/collector"}, "exclusion_contract": {"$ref": "#/$defs/exclusion"},
    "git_state": {"$ref": "#/$defs/git_state"}, "protected_populations": {"$ref": "#/$defs/protected"},
    "run_root_observation": {"$ref": "#/$defs/run_observation"},
    "invariance_payload_sha256": {"$ref": "#/$defs/sha256"},
    "comparison": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/comparison"}]},
    "verification_mode": {"const": "LIVE_CAPTURED"},
    "terminal": {"enum": ["PASS", "INPUT_DRIFT_STOP", "BLOCKED", "INVALID"]},
    "receipt_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"phase": {"const": "BEFORE"}}}, "then": {"properties": {"comparison": {"type": "null"}, "run_root_observation": {"properties": {"exists": {"const": false}}}}}},
    {"if": {"properties": {"phase": {"const": "AFTER"}}}, "then": {"properties": {"comparison": {"$ref": "#/$defs/comparison"}, "run_root_observation": {"properties": {"exists": {"const": true}}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256"], "properties": {"bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}, "record_count": {"type": "integer", "minimum": 0}}},
    "status_digest": {"type": "object", "additionalProperties": false, "required": ["encoded_bytes", "sha256", "record_count"], "properties": {"encoded_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}, "record_count": {"type": "integer", "minimum": 0}, "algorithm_id": {"type": "string"}}},
    "collector": {"type": "object", "additionalProperties": false, "required": ["collector_sha256", "command_contract_sha256", "algorithm_id", "git_executable_sha256", "git_version", "git_object_format"], "properties": {"collector_sha256": {"$ref": "#/$defs/sha256"}, "command_contract_sha256": {"$ref": "#/$defs/sha256"}, "algorithm_id": {"const": "pm.plan_assurance.protected_state.compact.v1.1"}, "git_executable_sha256": {"$ref": "#/$defs/sha256"}, "git_version": {"type": "string", "minLength": 1}, "git_object_format": {"enum": ["sha1", "sha256"]}}},
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["authorized_run_root", "repo_relative_run_root", "repo_relative_path_encoding", "strict_subtree_match", "only_untracked_status_rows_may_be_excluded", "tracked_or_staged_row_is_terminal", "symlink_or_nonregular_entry_is_terminal", "created_regular_file_link_count_must_equal", "absent_before", "exclusion_contract_sha256"], "properties": {"authorized_run_root": {"type": "string", "minLength": 1}, "repo_relative_run_root": {"type": "string", "pattern": "^Plans/\\.audits/[A-Za-z0-9._/-]+$"}, "repo_relative_path_encoding": {"const": "ascii"}, "strict_subtree_match": {"const": true}, "only_untracked_status_rows_may_be_excluded": {"const": true}, "tracked_or_staged_row_is_terminal": {"const": true}, "symlink_or_nonregular_entry_is_terminal": {"const": true}, "created_regular_file_link_count_must_equal": {"const": 1}, "absent_before": {"const": true}, "exclusion_contract_sha256": {"$ref": "#/$defs/sha256"}}},
    "head": {"type": "object", "additionalProperties": false, "required": ["commit_oid", "tree_oid", "symbolic_ref", "symbolic_ref_target_oid"], "properties": {"commit_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "tree_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "symbolic_ref": {"type": ["string", "null"]}, "symbolic_ref_target_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"}}},
    "storage_file": {"type": "object", "additionalProperties": false, "required": ["identity", "entry_kind", "mode", "bytes", "sha256"], "properties": {"identity": {"const": "git-path:index"}, "entry_kind": {"const": "regular_file"}, "mode": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "git_state": {"type": "object", "additionalProperties": false, "required": ["head", "index", "status", "diffs"], "properties": {
      "head": {"$ref": "#/$defs/head"},
      "index": {"type": "object", "additionalProperties": false, "required": ["logical_stage_entries_z", "storage_file"], "properties": {"logical_stage_entries_z": {"$ref": "#/$defs/digest"}, "storage_file": {"$ref": "#/$defs/storage_file"}}},
      "status": {"type": "object", "additionalProperties": false, "required": ["raw_porcelain_v2_z", "normalized", "classifications", "untracked_outside_run_root_content"], "properties": {"raw_porcelain_v2_z": {"$ref": "#/$defs/digest"}, "normalized": {"$ref": "#/$defs/status_digest"}, "classifications": {"type": "object", "additionalProperties": false, "required": ["staged", "tracked_worktree", "unmerged", "untracked_outside_run_root", "excluded_run_root_untracked"], "properties": {"staged": {"$ref": "#/$defs/status_digest"}, "tracked_worktree": {"$ref": "#/$defs/status_digest"}, "unmerged": {"$ref": "#/$defs/status_digest"}, "untracked_outside_run_root": {"$ref": "#/$defs/status_digest"}, "excluded_run_root_untracked": {"$ref": "#/$defs/status_digest"}}}, "untracked_outside_run_root_content": {"$ref": "#/$defs/population"}}},
      "diffs": {"type": "object", "additionalProperties": false, "required": ["index_vs_head", "worktree_vs_index"], "properties": {"index_vs_head": {"$ref": "#/$defs/digest"}, "worktree_vs_index": {"$ref": "#/$defs/digest"}}}
    }},
    "population": {"type": "object", "additionalProperties": false, "required": ["algorithm_id", "population_sha256", "entry_count", "regular_file_count", "directory_count", "symlink_count", "nonregular_count", "regular_file_bytes"], "properties": {"algorithm_id": {"type": "string", "minLength": 1}, "population_sha256": {"$ref": "#/$defs/sha256"}, "entry_count": {"type": "integer", "minimum": 0}, "regular_file_count": {"type": "integer", "minimum": 0}, "directory_count": {"type": "integer", "minimum": 0}, "symlink_count": {"type": "integer", "minimum": 0}, "nonregular_count": {"type": "integer", "minimum": 0}, "regular_file_bytes": {"type": "integer", "minimum": 0}}},
    "bound_entry": {"type": "object", "additionalProperties": false, "required": ["input_id", "contract_path_sha256", "entry_kind", "mode", "link_count", "bytes", "sha256"], "properties": {"input_id": {"type": "string", "minLength": 1}, "contract_path_sha256": {"$ref": "#/$defs/sha256"}, "entry_kind": {"const": "regular_file"}, "mode": {"type": "integer", "minimum": 0}, "link_count": {"const": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "bound_inputs": {"type": "object", "additionalProperties": false, "required": ["population_sha256", "entry_count", "entries"], "properties": {"population_sha256": {"$ref": "#/$defs/sha256"}, "entry_count": {"type": "integer", "minimum": 1}, "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bound_entry"}}}},
    "plans_population": {"type": "object", "required": ["algorithm_id", "population_sha256", "entry_count", "regular_file_count", "directory_entry_count", "symlink_count", "nonregular_count", "regular_file_bytes", "path_class_counts", "artifact_role_counts", "unknown_classification_count", "equals_source_snapshot_population"], "properties": {"algorithm_id": {"type": "string"}, "population_sha256": {"$ref": "#/$defs/sha256"}, "entry_count": {"type": "integer", "minimum": 1}, "regular_file_count": {"type": "integer", "minimum": 1}, "directory_entry_count": {"type": "integer", "minimum": 1}, "symlink_count": {"type": "integer", "minimum": 0}, "nonregular_count": {"type": "integer", "minimum": 0}, "regular_file_bytes": {"type": "integer", "minimum": 0}, "path_class_counts": {"type": "array"}, "artifact_role_counts": {"type": "array"}, "unknown_classification_count": {"type": "integer", "minimum": 0}, "equals_source_snapshot_population": {"const": true}}, "additionalProperties": false},
    "protected": {"type": "object", "additionalProperties": false, "required": ["plans_excluding_run_root", "bound_inputs"], "properties": {"plans_excluding_run_root": {"$ref": "#/$defs/plans_population"}, "bound_inputs": {"$ref": "#/$defs/bound_inputs"}}},
    "run_observation": {"type": "object", "additionalProperties": false, "required": ["exists", "filesystem_population_sha256", "entry_count", "regular_file_count", "directory_count", "regular_file_bytes", "symlink_count", "nonregular_count", "multi_link_regular_file_count", "filesystem_regular_path_set_sha256", "excluded_status_path_set_sha256", "path_sets_equal"], "properties": {"exists": {"type": "boolean"}, "filesystem_population_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "entry_count": {"type": "integer", "minimum": 0}, "regular_file_count": {"type": "integer", "minimum": 0}, "directory_count": {"type": "integer", "minimum": 0}, "regular_file_bytes": {"type": "integer", "minimum": 0}, "symlink_count": {"type": "integer", "minimum": 0}, "nonregular_count": {"type": "integer", "minimum": 0}, "multi_link_regular_file_count": {"type": "integer", "minimum": 0}, "filesystem_regular_path_set_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "excluded_status_path_set_sha256": {"$ref": "#/$defs/sha256"}, "path_sets_equal": {"type": "boolean"}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["before_receipt_file_sha256", "before_invariance_payload_sha256", "after_invariance_payload_sha256", "comparison_contract_sha256", "mismatch_count", "mismatch_codes", "terminal"], "properties": {"before_receipt_file_sha256": {"$ref": "#/$defs/sha256"}, "before_invariance_payload_sha256": {"$ref": "#/$defs/sha256"}, "after_invariance_payload_sha256": {"$ref": "#/$defs/sha256"}, "comparison_contract_sha256": {"$ref": "#/$defs/sha256"}, "mismatch_count": {"type": "integer", "minimum": 0}, "mismatch_codes": {"type": "array", "items": {"type": "string"}}, "terminal": {"enum": ["PASS", "INPUT_DRIFT_STOP"]}}}
  }
}
