{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/capability-slice-manifest.v1.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "family_id", "slice_id", "named_surface_commitments", "detailed_plan_assertion_commitment_sha256", "source_binding_population_sha256", "model_visible_before_lock", "external_transmission_before_lock", "manifest_payload_sha256"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "schema_id": {"const": "pm.plan_assurance.capability_slice_manifest.v1.1"},
    "family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]},
    "slice_id": {"type": "string", "minLength": 1},
    "named_surface_commitments": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "detailed_plan_assertion_commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_binding_population_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_visible_before_lock": {"const": false},
    "external_transmission_before_lock": {"const": false},
    "manifest_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
