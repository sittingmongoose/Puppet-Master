{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/semantic-execution-envelope.v1.1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "packet_id", "trial_id", "generation_id", "dispatches", "conditional_failure_templates", "cross_family_challenge_templates", "global_topology", "worker_context_policy", "tool_policy", "write_policy", "canary_policy", "budget_contract_sha256", "envelope_payload_sha256", "terminal"],
  "properties": {
    "schema_version": {"const": "1.1.0"}, "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1_1"},
    "trial_id": {"type": "string", "minLength": 1}, "generation_id": {"type": "string", "minLength": 1},
    "dispatches": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/dispatch"}},
    "conditional_failure_templates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/failure_template"}},
    "cross_family_challenge_templates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/challenge_template"}},
    "global_topology": {"type": "object", "additionalProperties": false, "required": ["controller_count", "active_units_maximum", "direct_workers_maximum", "descendants_allowed", "sole_writer"], "properties": {"controller_count": {"const": 1}, "active_units_maximum": {"const": 12}, "direct_workers_maximum": {"const": 11}, "descendants_allowed": {"const": false}, "sole_writer": {"const": "TRIAL_CONTROLLER"}}},
    "worker_context_policy": {"type": "object", "additionalProperties": false, "required": ["fork_turns", "history_inherited", "repo_read_authorized", "audit_read_authorized", "only_hash_bound_payloads"], "properties": {"fork_turns": {"const": "none"}, "history_inherited": {"const": false}, "repo_read_authorized": {"const": false}, "audit_read_authorized": {"const": false}, "only_hash_bound_payloads": {"const": true}}},
    "tool_policy": {"const": {"OPEN_DISCOVERY_RESEARCHER": ["web_search", "web_open"], "FAILURE_EVIDENCE_RESEARCHER": ["web_search", "web_open"], "other_semantic_roles": [], "filesystem_tools": [], "shell_tools": []}},
    "write_policy": {"const": {"worker_writes": false, "controller_write_root_only": true}},
    "canary_policy": {"type": "object", "additionalProperties": false, "required": ["required", "audit_canary_occurrences_maximum", "cross_family_calibration_leakage_maximum", "failure_terminal"], "properties": {"required": {"const": true}, "audit_canary_occurrences_maximum": {"const": 0}, "cross_family_calibration_leakage_maximum": {"const": 0}, "failure_terminal": {"const": "TRIAL_INVALID"}}},
    "budget_contract_sha256": {"$ref": "#/$defs/sha"}, "envelope_payload_sha256": {"$ref": "#/$defs/sha"}, "terminal": {"const": "FROZEN_BEFORE_EXTERNAL_AUTHORITY"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dispatch": {"type": "object", "additionalProperties": false, "required": ["dispatch_id", "family_id", "role_id", "model", "reasoning_effort", "payload_ref", "payload_sha256", "response_schema_id", "maximum_input_bytes", "maximum_output_bytes", "semantic_retry_maximum"], "properties": {"dispatch_id": {"type": "string", "minLength": 1}, "family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}, "role_id": {"enum": ["LOCAL_EXPECTATION_MODELER", "OPEN_DISCOVERY_RESEARCHER"]}, "model": {"const": "gpt-5.6-sol"}, "reasoning_effort": {"const": "xhigh"}, "payload_ref": {"type": "string", "pattern": "^STAGING/[A-Za-z0-9._/-]+$"}, "payload_sha256": {"$ref": "#/$defs/sha"}, "response_schema_id": {"type": "string", "minLength": 1}, "maximum_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "maximum_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "semantic_retry_maximum": {"const": 0}}},
    "failure_template": {"type": "object", "additionalProperties": false, "required": ["family_id", "role_id", "trigger_source", "payload_rule_id", "maximum_invocations", "fork_turns", "descendants_allowed"], "properties": {"family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}, "role_id": {"const": "FAILURE_EVIDENCE_RESEARCHER"}, "trigger_source": {"const": "controller-derived RESEARCH_ADEQUACY_RECEIPT"}, "payload_rule_id": {"type": "string", "minLength": 1}, "maximum_invocations": {"const": 1}, "fork_turns": {"const": "none"}, "descendants_allowed": {"const": false}}},
    "challenge_template": {"type": "object", "additionalProperties": false, "required": ["target_family_id", "challenger_family_id", "role_id", "reuses_existing_family_context", "payload_rule_id", "fresh_context_forbidden", "descendants_allowed"], "properties": {"target_family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}, "challenger_family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}, "role_id": {"const": "CROSS_FAMILY_CHALLENGER"}, "reuses_existing_family_context": {"const": true}, "payload_rule_id": {"type": "string", "minLength": 1}, "fresh_context_forbidden": {"const": true}, "descendants_allowed": {"const": false}}}
  }
}
