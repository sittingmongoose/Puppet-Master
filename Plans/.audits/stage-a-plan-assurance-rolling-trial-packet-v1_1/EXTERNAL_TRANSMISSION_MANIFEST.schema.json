{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/external-transmission-manifest.v1.1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "packet_id", "trial_id", "generation_id", "run_root", "static_payloads", "controller_only_payloads", "derived_payload_rules", "authorized_output_classes", "forbidden_populations", "canary_assertions", "private_repo_data_disclosed", "manifest_payload_sha256", "terminal"],
  "properties": {
    "schema_version": {"const": "1.1.0"}, "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1_1"},
    "trial_id": {"type": "string", "minLength": 1}, "generation_id": {"type": "string", "minLength": 1}, "run_root": {"type": "string", "minLength": 1},
    "static_payloads": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/payload"}},
    "controller_only_payloads": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/controller_payload"}},
    "derived_payload_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/derived"}},
    "authorized_output_classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
    "forbidden_populations": {"const": ["Plans/.audits/**", "F3 hidden oracle", "F3 hidden source portfolio", "F3 benchmark controls outside accessibility calibration", "parent conversation history", "unlisted repository bytes", "canary registry and canary token values"]},
    "canary_assertions": {"type": "object", "additionalProperties": false, "required": ["canary_registry_ref", "canary_registry_file_sha256", "canary_registry_payload_sha256", "tokens_checked", "static_payloads_checked", "controller_payloads_checked", "occurrences", "terminal"], "properties": {"canary_registry_ref": {"const": "CONTROL/CANARY_REGISTRY.json"}, "canary_registry_file_sha256": {"$ref": "#/$defs/sha"}, "canary_registry_payload_sha256": {"$ref": "#/$defs/sha"}, "tokens_checked": {"type": "integer", "minimum": 2, "maximum": 32}, "static_payloads_checked": {"const": 8}, "controller_payloads_checked": {"const": 4}, "occurrences": {"const": 0}, "terminal": {"const": "PASS"}}},
    "private_repo_data_disclosed": {"const": true}, "manifest_payload_sha256": {"$ref": "#/$defs/sha"}, "terminal": {"const": "FROZEN_BEFORE_EXTERNAL_AUTHORITY"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["payload_id", "family_id", "role_id", "ref", "bytes", "sha256", "schema_id", "artifact_kind", "payload_schema_id", "source_binding_population_sha256", "model_visible", "private_repo_data", "source_class_allowlist"], "properties": {"payload_id": {"type": "string", "minLength": 1}, "family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}, "role_id": {"enum": ["LOCAL_EXPECTATION_MODELER", "OPEN_DISCOVERY_RESEARCHER"]}, "ref": {"type": "string", "pattern": "^STAGING/[A-Za-z0-9._/-]+$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha"}, "schema_id": {"const": "pm.plan_assurance.semantic_artifact_envelope.v1.1"}, "artifact_kind": {"const": "EXPECTATION_PACKET"}, "payload_schema_id": {"const": "pm.plan_assurance.expectation_packet.v1.1"}, "source_binding_population_sha256": {"$ref": "#/$defs/sha"}, "model_visible": {"const": true}, "private_repo_data": {"const": true}, "source_class_allowlist": {"const": ["canonical"]}}},
    "controller_payload": {"type": "object", "additionalProperties": false, "required": ["payload_id", "family_id", "ref", "bytes", "sha256", "schema_id", "artifact_kind", "payload_schema_id", "source_binding_population_sha256", "model_visible_before_lock", "external_transmission_before_lock", "source_class_allowlist"], "properties": {"payload_id": {"type": "string", "minLength": 1}, "family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}, "ref": {"type": "string", "pattern": "^CONTROL/CAPABILITY_SLICES/[A-Za-z0-9._/-]+$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha"}, "schema_id": {"const": "pm.plan_assurance.semantic_artifact_envelope.v1.1"}, "artifact_kind": {"const": "CAPABILITY_SLICE_MANIFEST"}, "payload_schema_id": {"const": "pm.plan_assurance.capability_slice_manifest.v1.1"}, "source_binding_population_sha256": {"$ref": "#/$defs/sha"}, "model_visible_before_lock": {"const": false}, "external_transmission_before_lock": {"const": false}, "source_class_allowlist": {"const": ["canonical"]}}},
    "derived": {"type": "object", "additionalProperties": false, "required": ["rule_id", "input_schema_ids", "output_schema_id", "maximum_bytes", "hash_binding_required", "unlisted_bytes_forbidden"], "properties": {"rule_id": {"type": "string", "minLength": 1}, "input_schema_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "output_schema_id": {"type": "string", "minLength": 1}, "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "hash_binding_required": {"const": true}, "unlisted_bytes_forbidden": {"const": true}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["schema_id", "maximum_bytes", "may_be_retransmitted_only_by_bound_rule"], "properties": {"schema_id": {"type": "string", "minLength": 1}, "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "may_be_retransmitted_only_by_bound_rule": {"const": true}}}
  }
}
