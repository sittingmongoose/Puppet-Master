{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/semantic-artifact-envelope.v1.1.json",
  "title": "Hash-bound envelope for prelaunch packets and embedded semantic stage records",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "packet_id", "trial_id", "generation_id", "artifact_id", "artifact_kind", "family_id", "stage_id", "payload_schema_id", "payload", "source_bindings", "provenance_mode", "created_before_external_authority", "payload_sha256", "terminal"],
  "properties": {
    "schema_version": {"const": "1.1.0"}, "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1_1"},
    "trial_id": {"type": "string", "minLength": 1}, "generation_id": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "minLength": 1},
    "artifact_kind": {"enum": ["CAPABILITY_SLICE_MANIFEST", "EXPECTATION_PACKET", "LOCAL_EXPECTATIONS", "LOCAL_EXPECTATIONS_LOCK", "DISCOVERY_CLAIMS", "DISCOVERY_LOCK", "FAILURE_EVIDENCE_CARDS", "ADEQUACY_RECOVERY_RECEIPT", "GRAPH_MERGE_RECEIPT", "TARGETED_PASS_RECEIPT", "RESOURCE_RECEIPT", "ARTIFACT_VALIDATION"]},
    "family_id": {"oneOf": [{"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}, {"type": "null"}]},
    "stage_id": {"type": "string", "pattern": "^S[0-8]_[A-Z0-9_]+$"}, "payload_schema_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "source_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["ref", "bytes", "sha256"], "properties": {"ref": {"type": "string", "pattern": "^Plans/[A-Za-z0-9._/-]+$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "provenance_mode": {"const": "CANONICAL_SOURCE_BINDINGS_ONLY"},
    "created_before_external_authority": {"type": "boolean"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "terminal": {"enum": ["FROZEN", "DONE", "BLOCKED", "INVALID"]}
  }
}
