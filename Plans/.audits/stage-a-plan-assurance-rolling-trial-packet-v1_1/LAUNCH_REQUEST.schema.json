{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/launch-request.v1.1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "trial_id", "generation_id", "packet_id", "packet_core_population_sha256", "base_contract_sha256", "repair_contract_sha256", "effective_contract_sha256", "requesting_task_path", "expected_authority_task_path", "authority_delivery_mode", "request_status", "base_artifact_validator_sha256", "v1_1_artifact_validator_sha256", "source_snapshot_ref", "source_snapshot_sha256", "source_snapshot_population_sha256", "protected_before_ref", "protected_before_receipt_sha256", "protected_before_invariance_sha256", "run_root", "budget_contract_sha256", "topology_contract_sha256", "external_transmission_manifest_ref", "external_transmission_manifest_sha256", "execution_envelope_ref", "execution_envelope_sha256", "prelaunch_staging_manifest_sha256", "created_at_utc", "expires_at_utc", "max_uses", "launch_binding_sha256"],
  "properties": {
    "schema_version": {"const": "1.1.0"}, "request_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1}, "generation_id": {"type": "string", "minLength": 1},
    "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1_1"},
    "packet_core_population_sha256": {"$ref": "#/$defs/sha"}, "base_contract_sha256": {"const": "e034bbd8531f793490a6098261e94845cadf4ec632df63f7d3377f762c728c9a"},
    "repair_contract_sha256": {"$ref": "#/$defs/sha"}, "effective_contract_sha256": {"$ref": "#/$defs/sha"},
    "requesting_task_path": {"type": "string", "pattern": "^/root(?:/|$)"}, "expected_authority_task_path": {"type": "string", "pattern": "^/root(?:/|$)"},
    "authority_delivery_mode": {"const": "codex_system_collaboration_envelope"}, "request_status": {"const": "AWAITING_FRESH_AUTHORITY"},
    "base_artifact_validator_sha256": {"const": "115f2610dc422f730a54d33d029261f8a5aa64e05ddbffde14c540990f7e07d8"},
    "v1_1_artifact_validator_sha256": {"$ref": "#/$defs/sha"},
    "source_snapshot_ref": {"const": "SOURCE_SNAPSHOT.json"}, "source_snapshot_sha256": {"$ref": "#/$defs/sha"}, "source_snapshot_population_sha256": {"$ref": "#/$defs/sha"},
    "protected_before_ref": {"const": "PROTECTED_BEFORE.json"}, "protected_before_receipt_sha256": {"$ref": "#/$defs/sha"}, "protected_before_invariance_sha256": {"$ref": "#/$defs/sha"},
    "run_root": {"type": "string", "minLength": 1}, "budget_contract_sha256": {"$ref": "#/$defs/sha"}, "topology_contract_sha256": {"$ref": "#/$defs/sha"},
    "external_transmission_manifest_ref": {"const": "EXTERNAL_TRANSMISSION_MANIFEST.json"}, "external_transmission_manifest_sha256": {"$ref": "#/$defs/sha"},
    "execution_envelope_ref": {"const": "SEMANTIC_EXECUTION_ENVELOPE.json"}, "execution_envelope_sha256": {"$ref": "#/$defs/sha"},
    "prelaunch_staging_manifest_sha256": {"$ref": "#/$defs/sha"}, "created_at_utc": {"type": "string", "format": "date-time"}, "expires_at_utc": {"type": "string", "format": "date-time"},
    "max_uses": {"const": 1}, "launch_binding_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
