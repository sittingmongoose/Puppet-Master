    },
    "contract_depth_complete": {
      "type": "boolean"
    },
    "bulk_registration_allowed": {
      "type": "boolean"
    },
    "pass": {
      "type": "boolean"
    },
    "counts": {
      "type": "object"
    },
    "input_pins": {
      "type": "object"
    },
    "named_checks": {
      "type": "object"
    },
    "failures": {
      "type": "array"
    },
    "scripts_binding": {
      "type": "object"
    },
