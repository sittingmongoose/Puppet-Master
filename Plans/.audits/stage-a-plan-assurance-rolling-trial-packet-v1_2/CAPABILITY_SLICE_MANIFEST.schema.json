{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/capability-slice-manifest.v1.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "trial_id", "generation_id", "family_id", "slice_id", "provenance_mode", "worker_visibility", "audit_or_noncanonical_path_count", "spans", "span_population_sha256", "terminal", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1_2"},
    "trial_id": {"const": "stage-a-plan-assurance-rolling-trial-v1_2-run-001"},
    "generation_id": {"const": "generation-v1_2-001-20260717"},
    "family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]},
    "slice_id": {"type": "string", "minLength": 1},
    "provenance_mode": {"const": "EXACT_CANONICAL_SOURCE_SPANS_ONLY"},
    "worker_visibility": {"type": "string", "minLength": 1},
    "audit_or_noncanonical_path_count": {"const": 0},
    "spans": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "document_id", "start_byte", "end_byte", "span_sha256", "source_file_sha256", "source_file_bytes"], "properties": {"path": {"type": "string", "pattern": "^Plans/(?!\\.audits/).+"}, "document_id": {"type": "string", "minLength": 1}, "start_byte": {"const": 0}, "end_byte": {"type": "integer", "minimum": 1}, "span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_file_bytes": {"type": "integer", "minimum": 1}}}},
    "span_population_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal": {"const": "FROZEN"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
