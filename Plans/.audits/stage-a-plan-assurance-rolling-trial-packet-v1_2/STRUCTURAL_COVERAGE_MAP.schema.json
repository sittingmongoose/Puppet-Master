{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/structural-coverage-map.v1.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "trial_id", "generation_id", "representation_id", "structural_generation_binding_sha256", "source_snapshot_sha256", "source_population_sha256", "source_physical_population_sha256", "source_classification_population_sha256", "source_counts", "canonical_population_count", "noncanonical_class_commitments", "logical_map", "collections", "ordered_shards", "capability_slices", "limits", "terminal", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1_2"},
    "trial_id": {"const": "stage-a-plan-assurance-rolling-trial-v1_2-run-001"},
    "generation_id": {"const": "generation-v1_2-001-20260717"},
    "representation_id": {"const": "pm.plan_assurance.structural_map.ordered_shards.v1.2"},
    "structural_generation_binding_sha256": {"$ref": "#/$defs/sha"},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha"},
    "source_population_sha256": {"$ref": "#/$defs/sha"},
    "source_physical_population_sha256": {"$ref": "#/$defs/sha"},
    "source_classification_population_sha256": {"$ref": "#/$defs/sha"},
    "source_counts": {"type": "object"},
    "canonical_population_count": {"type": "integer", "minimum": 1},
    "noncanonical_class_commitments": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["path_class", "entry_count", "population_sha256", "semantic_reread"], "properties": {"path_class": {"enum": ["generated", "governance_support", "source_lineage", "audit", "retired", "unknown"]}, "entry_count": {"type": "integer", "minimum": 0}, "population_sha256": {"$ref": "#/$defs/sha"}, "semantic_reread": {"const": false}}}},
    "logical_map": {"type": "object", "required": ["logical_decoded_bytes", "logical_map_sha256", "v1_1_active_structural_map_sha256", "clean_rebuild_sha256", "scalar_fields"]},
    "collections": {"type": "array", "minItems": 10, "maxItems": 10},
    "ordered_shards": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "required": ["shard_index", "collection_index", "collection", "ref", "row_start", "row_end_exclusive", "row_count", "physical_bytes", "decoded_bytes", "physical_sha256", "rows_sha256", "payload_sha256"]}},
    "capability_slices": {"type": "array", "minItems": 4, "maxItems": 4},
    "limits": {"type": "object", "required": ["ordinary_descriptor_bytes_maximum", "shard_physical_bytes_maximum", "shard_decoded_bytes_maximum", "logical_decoded_bytes_maximum", "shards_maximum"]},
    "terminal": {"const": "PASS"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
