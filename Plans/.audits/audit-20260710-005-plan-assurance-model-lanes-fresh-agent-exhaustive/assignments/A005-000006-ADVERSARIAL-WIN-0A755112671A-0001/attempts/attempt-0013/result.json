    {
      "item_id": "A005-000006-GAP-003",
      "item_type": "gap",
      "title": "No concurrency, partial-failure, or recovery lifecycle is encoded",
      "statement": "The artifact has no revision, causal predecessor, idempotency key, optimistic-concurrency token, completion state, failed-subpart representation, retry state, rollback target, or supersession relation. Concurrent producers can race, partially generated diffs are indistinguishable from complete diffs, and recovery or rollback cannot be validated.",
      "severity": "high",
      "confidence": "high",
      "gap_kind": "missing_lifecycle_and_recovery",
      "impact": "Consumers may apply stale or incomplete diffs, duplicate work, lose conflicts, or claim recovery without a machine-checkable basis.",
      "builder_discretion": "Add explicit lifecycle states and invariants for causality, uniqueness, completion, partial failure, retries, supersession, conflict detection, and rollback applicability.",
