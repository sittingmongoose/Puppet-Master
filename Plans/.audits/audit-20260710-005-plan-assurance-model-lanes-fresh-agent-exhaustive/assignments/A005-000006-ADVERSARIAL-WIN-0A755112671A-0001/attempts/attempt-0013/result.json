  "items": [
    {
      "item_id": "A005-000006-GAP-001",
      "item_type": "gap",
      "title": "The code-diff payload has no code-diff contract",
      "statement": "type_payload accepts any nonempty object and the envelope does not require files, hunks, base or target revisions, operation kinds, encoding, applicability, conflict semantics, or deletion markers. A conforming artifact can therefore contain no diff at all; consumers cannot implement, migrate, render accessibly, guard destructive changes, or construct meaningful positive and negative test oracles from this schema.",
      "severity": "critical",
      "confidence": "high",
      "gap_kind": "missing_domain_contract",
      "impact": "Invalid, ambiguous, or destructive payloads can validate while consumers disagree about meaning and safety.",
      "builder_discretion": "Define a versioned code-diff payload with explicit operations, file and hunk structure, base and target identity, content encoding, applicability and conflict rules, and deletion semantics.",
      "feature_keys": ["runtime_artifact", "code_diff"],
      "evidence": [
        {
          "path": "Plans/runtime_artifact_code_diff.schema.json",
          "line_start": 1,
          "line_end": 1,
