    },
    {
      "item_id": "A005-000006-GAP-002",
      "item_type": "gap",
      "title": "Envelope values and references are not semantically constrained",
      "statement": "Most identifiers and references are arbitrary strings; created_at_utc has no date-time format; projection_freshness, projection_health, and retention_class have no enumerated vocabulary; reference arrays lack uniqueness and maximum bounds; optional content, actor, and producer references have no integrity or authority rules; and strings, arrays, and the payload have no size limits. This leaves caller and consumer routing, trust, privacy retention, GUI truth, offline interpretation, localization, scaling, and cross-document seams non-falsifiable.",
      "severity": "high",
      "confidence": "high",
      "gap_kind": "weak_envelope_constraints",
      "impact": "Malformed, spoofed, stale, misleading, oversized, or unresolvable artifacts can pass validation and propagate inconsistent behavior.",
      "builder_discretion": "Specify identifier and reference formats, referential integrity and authorization rules, enumerated state vocabularies, RFC 3339 timestamps, privacy and retention semantics, locale handling, uniqueness, and bounded sizes.",
      "feature_keys": ["runtime_artifact", "routing", "projection"],
      "evidence": [
