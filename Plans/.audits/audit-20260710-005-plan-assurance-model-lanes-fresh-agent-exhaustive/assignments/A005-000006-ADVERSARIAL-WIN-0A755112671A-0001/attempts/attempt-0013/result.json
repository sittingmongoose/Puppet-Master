    {"dimension": "gui_misleading_states", "status": "gap_found", "summary": "A GUI may present arbitrary freshness, health, summary, or opaque payload data as authoritative because truth vocabularies and derivation rules are absent.", "evidence_item_ids": ["A005-000006-GAP-002"]},
    {"dimension": "offline_network_loss", "status": "gap_found", "summary": "No cached, pending, unavailable, retrying, or remotely verified state distinguishes offline data from current data.", "evidence_item_ids": ["A005-000006-GAP-003"]},
