    {"dimension": "invalid_states_transitions", "status": "gap_found", "summary": "projection_freshness and projection_health are arbitrary strings and no artifact lifecycle or transition invariants exist.", "evidence_item_ids": ["A005-000006-GAP-002", "A005-000006-GAP-003"]},
    {"dimension": "concurrency_races", "status": "gap_found", "summary": "No revision, causal predecessor, uniqueness rule, idempotency key, or concurrency token prevents stale or racing artifacts.", "evidence_item_ids": ["A005-000006-GAP-003"]},
    {"dimension": "partial_failure", "status": "gap_found", "summary": "The schema cannot distinguish a complete diff from one missing files or hunks after partial generation.", "evidence_item_ids": ["A005-000006-GAP-001", "A005-000006-GAP-003"]},
