    {"dimension": "accessibility", "status": "gap_found", "summary": "Because the payload has no semantic operation, file, or hunk model, accessible consumers cannot reliably expose structured change meaning rather than raw opaque content.", "evidence_item_ids": ["A005-000006-GAP-001"]},
