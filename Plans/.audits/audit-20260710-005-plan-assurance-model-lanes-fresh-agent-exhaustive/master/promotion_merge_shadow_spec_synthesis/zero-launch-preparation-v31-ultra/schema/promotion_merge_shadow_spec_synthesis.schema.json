{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/audit005/promotion-merge-shadow-spec-synthesis-candidate-v1.schema.json",
  "title": "Audit005 promotion, merge, and shadow-spec synthesis candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "synthesis_id",
    "status",
    "feature_count",
    "seam_count",
    "reverse_shadow_candidate_count",
    "source_feature_inventory_sha256",
    "dependency_checkpoint_hashes",
    "feature_decisions",
    "seam_adjudications",
    "reverse_shadow_adjudications",
    "shadow_spec_entries",
    "effects",
    "credit"
  ],
  "properties": {
    "schema_version": {
      "const": "audit005-promotion-merge-shadow-spec-synthesis-candidate-v1"
    },
    "audit_id": {
      "const": "audit-20260710-005-plan-assurance-model-lanes-fresh-agent-exhaustive"
    },
    "synthesis_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^A005PMSSS-[A-Z0-9._-]+$"
    },
    "status": {
      "enum": [
        "candidate_only_blocked_pending_independent_luna_postrun",
        "rejected_fail_closed"
      ]
    },
    "feature_count": {
      "const": 3888
    },
    "seam_count": {
      "const": 9365
    },
    "reverse_shadow_candidate_count": {
      "const": 46
    },
    "source_feature_inventory_sha256": {
      "const": "a53e72afb5f52e7e95797f2179c7fd8da14ebf6e148efd544781614784113267"
    },
    "dependency_checkpoint_hashes": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "feature_decisions": {
      "type": "array",
      "minItems": 3888,
      "maxItems": 3888,
      "items": {
        "$ref": "#/$defs/featureDecision"
      }
    },
    "seam_adjudications": {
      "type": "array",
      "minItems": 9365,
      "maxItems": 9365,
      "items": {
        "$ref": "#/$defs/seamAdjudication"
      }
    },
    "reverse_shadow_adjudications": {
      "type": "array",
      "minItems": 46,
      "maxItems": 46,
      "items": {
        "$ref": "#/$defs/reverseShadowAdjudication"
      }
    },
    "shadow_spec_entries": {
      "type": "array",
      "minItems": 3888,
      "maxItems": 3888,
      "items": {
        "$ref": "#/$defs/shadowSpecEntry"
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_performed",
        "activation_performed",
        "canonical_write_performed",
        "promotion_committed",
        "merge_committed",
        "shadow_spec_published"
      ],
      "properties": {
        "launch_performed": {"const": false},
        "activation_performed": {"const": false},
        "canonical_write_performed": {"const": false},
        "promotion_committed": {"const": false},
        "merge_committed": {"const": false},
        "shadow_spec_published": {"const": false}
      }
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "research", "scenario", "promotion", "merge", "spec", "certification"],
      "properties": {
        "coverage": {"const": 0},
        "research": {"const": 0},
        "scenario": {"const": 0},
        "promotion": {"const": 0},
        "merge": {"const": 0},
        "spec": {"const": 0},
        "certification": {"const": 0}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "featureRef": {
      "type": "string",
      "pattern": "^OPF::A005OM-[0-9]{4}::PF-[0-9]{4}$"
    },
    "evidenceRefArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "featureDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_ref",
        "research_evidence_refs",
        "scenario_evidence_refs",
        "seam_evidence_refs",
        "reverse_shadow_evidence_refs",
        "delta_evidence_refs",
        "disposition",
        "merge_target_ref",
        "uncertainty",
        "rationale"
      ],
      "properties": {
        "feature_ref": {"$ref": "#/$defs/featureRef"},
        "research_evidence_refs": {"$ref": "#/$defs/evidenceRefArray"},
        "scenario_evidence_refs": {"$ref": "#/$defs/evidenceRefArray"},
        "seam_evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "reverse_shadow_evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "delta_evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "disposition": {
          "enum": ["promote_candidate", "hold", "quarantine", "retire_candidate"]
        },
        "merge_target_ref": {
          "oneOf": [
            {"$ref": "#/$defs/featureRef"},
            {"type": "null"}
          ]
        },
        "uncertainty": {
          "enum": ["none", "bounded", "material"]
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "seamAdjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_ref", "endpoint_refs", "disposition", "evidence_refs", "rationale"],
      "properties": {
        "edge_ref": {"type": "string", "minLength": 1},
        "endpoint_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/featureRef"}
        },
        "disposition": {
          "enum": [
            "same_feature_merge_candidate",
            "shared_subsystem_distinct",
            "dependency_or_interface_seam",
            "conflict_requires_plan_revision",
            "unsupported_candidate",
            "uncertain_requires_targeted_research"
          ]
        },
        "evidence_refs": {"$ref": "#/$defs/evidenceRefArray"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "reverseShadowAdjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_key", "endpoint_refs", "quarantined_at_observation", "final_disposition", "luna_evidence_refs", "rationale"],
      "properties": {
        "edge_key": {"type": "string", "minLength": 1},
        "endpoint_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/featureRef"}
        },
        "quarantined_at_observation": {"type": "boolean"},
        "final_disposition": {
          "enum": ["merge_candidate", "related_but_distinct", "quarantine", "unsupported"]
        },
        "luna_evidence_refs": {"$ref": "#/$defs/evidenceRefArray"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "shadowSpecEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_ref", "shadow_text", "source_lineage_refs", "canonical_target_candidates", "canonical_write_authorized"],
      "properties": {
        "feature_ref": {"$ref": "#/$defs/featureRef"},
        "shadow_text": {"type": "string", "minLength": 1},
        "source_lineage_refs": {"$ref": "#/$defs/evidenceRefArray"},
        "canonical_target_candidates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "canonical_write_authorized": {"const": false}
      }
    }
  }
}
