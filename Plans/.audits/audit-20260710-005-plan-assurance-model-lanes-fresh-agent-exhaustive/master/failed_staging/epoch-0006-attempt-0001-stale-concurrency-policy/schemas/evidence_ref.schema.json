{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exact_quote": {
      "minLength": 1,
      "type": "string"
    },
    "line_end": {
      "minimum": 1,
      "type": "integer"
    },
    "line_start": {
      "minimum": 1,
      "type": "integer"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "path",
    "line_start",
    "line_end",
    "exact_quote",
    "source_sha256"
  ],
  "type": "object"
}
