{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_path": {
      "minLength": 1,
      "type": "string"
    },
    "assignment_id": {
      "minLength": 1,
      "type": "string"
    },
    "assignment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "audit_id": {
      "const": "audit-20260710-005-plan-assurance-model-lanes-fresh-agent-exhaustive"
    },
    "capsule_ref": {
      "minLength": 1,
      "type": "string"
    },
    "capsule_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "fresh_lane_subagent": {
      "const": true
    },
    "lane_thread_id": {
      "minLength": 1,
      "type": "string"
    },
    "model": {
      "const": "gpt-5.6-sol"
    },
    "output_directory": {
      "minLength": 1,
      "type": "string"
    },
    "protocol_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reasoning_effort": {
      "const": "xhigh"
    },
    "result_schema_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "dispatch-receipt-v1"
    },
    "task_thread_id": {
      "minLength": 1,
      "type": "string"
    },
    "terminal_schema_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "audit_id",
    "schema_version",
    "assignment_id",
    "attempt_id",
    "task_thread_id",
    "model",
    "reasoning_effort",
    "assignment_sha256",
    "capsule_ref",
    "capsule_sha256",
    "result_schema_ref",
    "terminal_schema_ref",
    "protocol_root_sha256",
    "output_directory",
    "lane_thread_id",
    "agent_path",
    "fresh_lane_subagent"
  ],
  "type": "object"
}
