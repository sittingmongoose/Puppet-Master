{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_id": {
      "minLength": 1,
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "audit_id": {
      "const": "audit-20260710-005-plan-assurance-model-lanes-fresh-agent-exhaustive"
    },
    "dispatch_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "result_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "terminal-seal-v1"
    },
    "status": {
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "task_thread_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "audit_id",
    "schema_version",
    "assignment_id",
    "attempt_id",
    "task_thread_id",
    "dispatch_receipt_sha256",
    "result_sha256",
    "result_bytes",
    "status"
  ],
  "type": "object"
}
