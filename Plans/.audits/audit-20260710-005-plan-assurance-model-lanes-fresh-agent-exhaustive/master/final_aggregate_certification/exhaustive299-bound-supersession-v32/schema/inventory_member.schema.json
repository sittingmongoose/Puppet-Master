{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:puppet-master:audit005:exhaustive299:inventory-member:v32",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "ordinal", "path", "sha256"],
  "properties": {
    "category": {
      "enum": [
        "semantic_document",
        "generated_governance_integrity_join"
      ]
    },
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 299},
    "path": {"type": "string", "pattern": "^Plans/[^\\u0000]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
