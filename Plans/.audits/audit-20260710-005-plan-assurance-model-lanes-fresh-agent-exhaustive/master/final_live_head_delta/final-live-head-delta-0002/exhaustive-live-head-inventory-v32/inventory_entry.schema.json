{
  "$id": "audit005-exhaustive-live-head-inventory-entry-v32",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "semantic_canonical",
            "generated_governance"
          ]
        },
        "frozen_source_scope_member": {
          "type": "boolean"
        },
        "rule_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "class",
        "rule_id",
        "frozen_source_scope_member"
      ],
      "type": "object"
    },
    "head": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "present": {
                "const": true
              }
            },
            "required": [
              "present"
            ]
          },
          "then": {
            "properties": {
              "blob_oid": {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              "mode": {
                "const": "100644"
              },
              "object_type": {
                "const": "blob"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "present": {
                "const": false
              }
            },
            "required": [
              "present"
            ]
          },
          "then": {
            "properties": {
              "blob_oid": {
                "const": null
              },
              "mode": {
                "const": null
              },
              "object_type": {
                "const": null
              }
            }
          }
        }
      ],
      "properties": {
        "blob_oid": {
          "pattern": "^[0-9a-f]{40}$",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "present": {
          "type": "boolean"
        }
      },
      "required": [
        "present",
        "mode",
        "object_type",
        "blob_oid"
      ],
      "type": "object"
    },
    "ordinal": {
      "minimum": 1,
      "type": "integer"
    },
    "path": {
      "pattern": "^Plans/(?!\\.audits/).+",
      "type": "string"
    },
    "schema_version": {
      "const": "audit005-exhaustive-live-head-inventory-entry-v32"
    },
    "status_ordinal": {
      "minimum": 1,
      "type": "integer"
    },
    "tracked": {
      "type": "boolean"
    },
    "working_tree": {
      "additionalProperties": false,
      "properties": {
        "file_type": {
          "const": "regular"
        },
        "link_count": {
          "const": 1
        },
        "mode": {
          "const": "100644"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file_type",
        "mode",
        "link_count",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "xy": {
      "enum": [
        " M",
        "??"
      ]
    }
  },
  "required": [
    "schema_version",
    "ordinal",
    "status_ordinal",
    "xy",
    "path",
    "tracked",
    "working_tree",
    "head",
    "classification"
  ],
  "type": "object"
}
