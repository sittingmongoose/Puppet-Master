{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:puppetmaster:audit005:governance-command-receipt:v1",
  "title": "Audit005 governance command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "harness_authority_sha256",
    "run_id",
    "command_id",
    "ordinal",
    "command",
    "interpreter",
    "script",
    "environment_sha256",
    "started_at_utc",
    "finished_at_utc",
    "started_unix_ns",
    "finished_unix_ns",
    "duration_monotonic_ns",
    "termination",
    "stdout",
    "stderr",
    "inventory",
    "inventory_diff",
    "no_protected_write",
    "outcome",
    "execution_count",
    "retry_count",
    "descendant_count",
    "followup_count",
    "credit",
    "certification",
    "independent_luna_authorization"
  ],
  "properties": {
    "schema_version": {
      "const": "audit005-governance-command-receipt-v1"
    },
    "audit_id": {
      "const": "audit-20260710-005-plan-assurance-model-lanes-fresh-agent-exhaustive"
    },
    "harness_authority_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_id": {
      "type": "string",
      "pattern": "^GCRH-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{8}$"
    },
    "command_id": {
      "enum": [
        "plans-run-gates",
        "shards-check"
      ]
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "argv",
        "cwd",
        "shell"
      ],
      "properties": {
        "display": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "const": "/Users/jaredsmacbookair/Documents/PuppetMaster"
        },
        "shell": {
          "const": false
        }
      }
    },
    "interpreter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "which_path",
        "which_sha256",
        "runtime_sys_executable",
        "runtime_sys_executable_sha256",
        "runtime_realpath",
        "runtime_realpath_sha256",
        "version"
      ],
      "properties": {
        "token": {
          "const": "python3"
        },
        "which_path": {
          "type": "string",
          "minLength": 1
        },
        "which_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_sys_executable": {
          "type": "string",
          "minLength": 1
        },
        "runtime_sys_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_realpath": {
          "type": "string",
          "minLength": 1
        },
        "runtime_realpath_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_relative_path",
        "absolute_path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "repository_relative_path": {
          "type": "string",
          "pattern": "^scripts/pm-[a-z-]+\\.py$"
        },
        "absolute_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "environment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "started_unix_ns": {
      "type": "integer",
      "minimum": 0
    },
    "finished_unix_ns": {
      "type": "integer",
      "minimum": 0
    },
    "duration_monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "returncode",
        "exit_code",
        "signal"
      ],
      "properties": {
        "returncode": {
          "type": "integer"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "signal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "stdout": {
      "$ref": "#/$defs/captured_stream"
    },
    "stderr": {
      "$ref": "#/$defs/captured_stream"
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "pre_repository_sha256",
        "post_repository_sha256",
        "pre_canonical_plans_sha256",
        "post_canonical_plans_sha256",
        "pre_entry_count",
        "post_entry_count",
        "pre_artifact",
        "post_artifact"
      ],
      "properties": {
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pre_repository_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "post_repository_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pre_canonical_plans_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "post_canonical_plans_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pre_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "post_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "pre_artifact": {
          "type": "string",
          "minLength": 1
        },
        "post_artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inventory_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "sha256",
        "delta_count",
        "delta_paths_sha256"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "delta_count": {
          "type": "integer",
          "minimum": 0
        },
        "delta_paths_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "no_protected_write": {
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "PASS_NO_WRITE",
        "FAIL_EXIT_NO_WRITE",
        "FAIL_SIGNAL_NO_WRITE",
        "FAIL_PROTECTED_WRITE"
      ]
    },
    "execution_count": {
      "const": 1
    },
    "retry_count": {
      "const": 0
    },
    "descendant_count": {
      "const": 0
    },
    "followup_count": {
      "const": 0
    },
    "credit": {
      "const": 0
    },
    "certification": {
      "const": false
    },
    "independent_luna_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "sha256",
        "task_thread_id"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_thread_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "captured_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "bytes",
        "sha256"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
