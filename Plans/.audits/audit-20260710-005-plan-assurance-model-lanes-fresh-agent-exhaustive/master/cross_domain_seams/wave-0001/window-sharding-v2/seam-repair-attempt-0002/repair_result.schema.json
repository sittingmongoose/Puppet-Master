{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_path": {
      "type": "string"
    },
    "assignment_id": {
      "enum": [
        "A005CDSV2-0002",
        "A005CDSV2-0006",
        "A005CDSV2-0039"
      ]
    },
    "attempt_id": {
      "const": "attempt-0002"
    },
    "corrected_result": {
      "type": "object"
    },
    "model": {
      "const": "gpt-5.6-sol"
    },
    "reasoning_effort": {
      "const": "xhigh"
    },
    "repair_attestation": {
      "additionalProperties": false,
      "properties": {
        "cross_fields_closed": {
          "const": true
        },
        "no_new_decisions": {
          "const": true
        },
        "no_promotion": {
          "const": true
        },
        "only_permitted_edges_changed": {
          "const": true
        },
        "source_registration_closed": {
          "const": true
        }
      },
      "required": [
        "only_permitted_edges_changed",
        "no_new_decisions",
        "source_registration_closed",
        "cross_fields_closed",
        "no_promotion"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "cross-domain-seam-repair-result-v1"
    },
    "source_result_sha256": {
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "completed"
    }
  },
  "required": [
    "schema_version",
    "assignment_id",
    "attempt_id",
    "agent_path",
    "model",
    "reasoning_effort",
    "status",
    "source_result_sha256",
    "corrected_result",
    "repair_attestation"
  ],
  "type": "object"
}
