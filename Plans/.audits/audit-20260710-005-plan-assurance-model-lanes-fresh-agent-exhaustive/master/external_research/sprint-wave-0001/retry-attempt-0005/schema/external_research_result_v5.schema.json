{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-research-result-v5",
  "title": "Audit 005 external research recovery result v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "schema_version", "phase", "assignment_id", "attempt_id", "controller_thread_id", "agent_path", "model", "reasoning_effort", "status", "activation_transaction_id", "activation_core_sha256", "leaf_dispatch_authorization_sha256", "topic", "owner_domains", "feature_refs", "research_questions", "source_availability", "unavailable_evidence", "sources", "findings", "competitor_standard_patterns", "failure_modes", "implications", "novel_ideas", "unresolved_questions", "self_attestation"],
  "properties": {
    "audit_id": {"type": "string", "const": "audit-20260710-005-plan-assurance-model-lanes-fresh-agent-exhaustive"},
    "schema_version": {"type": "string", "const": "external-research-result-v5"},
    "phase": {"type": "string", "const": "external_research_current_web_research"},
    "assignment_id": {"type": "string", "pattern": "^ER-000[38]$"},
    "attempt_id": {"type": "string", "const": "attempt-0005"},
    "controller_thread_id": {"type": "string", "const": "019f5078-6501-7223-b52f-2251010bdc41"},
    "agent_path": {"type": "string", "pattern": "^/root/a005_external_research_recovery_er_000[38]_attempt_0005_terminal$"},
    "model": {"type": "string", "const": "gpt-5.6-luna"},
    "reasoning_effort": {"type": "string", "const": "max"},
    "status": {"type": "string", "const": "completed"},
    "activation_transaction_id": {"type": "string", "pattern": "^A005-ER5-[0-9a-f]{24}$"},
    "activation_core_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "leaf_dispatch_authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "topic": {"type": "string", "minLength": 1},
    "owner_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^OPF::A005OM-[0-9]{4}::PF-[0-9]{4}$"}},
    "research_questions": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "source_availability": {"type": "string", "enum": ["available", "limited", "unavailable"]},
    "unavailable_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources": {
      "type": "array", "minItems": 0, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "title", "publisher", "published_date", "access_date", "source_tier", "material_relevance"],
        "properties": {
          "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "published_date": {"type": ["string", "null"]},
          "access_date": {"type": "string", "const": "2026-07-11"},
          "source_tier": {"type": "string", "enum": ["official", "primary", "standard", "mature_open_source", "secondary"]},
          "material_relevance": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "claim", "evidence_class", "source_urls", "confidence", "notes"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "enum": ["supported_claim", "inference", "no_evidence"]},
          "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^\\s]+$"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "competitor_standard_patterns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pattern_id", "pattern", "evidence_class", "source_urls", "implication"],
        "properties": {
          "pattern_id": {"type": "string", "minLength": 1},
          "pattern": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "enum": ["supported_claim", "inference", "no_evidence"]},
          "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^\\s]+$"}},
          "implication": {"type": "string", "minLength": 1}
        }
      }
    },
    "failure_modes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["failure_id", "failure_mode", "evidence_class", "source_urls", "mitigation_or_gap"],
        "properties": {
          "failure_id": {"type": "string", "minLength": 1},
          "failure_mode": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "enum": ["supported_claim", "inference", "no_evidence"]},
          "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^\\s]+$"}},
          "mitigation_or_gap": {"type": "string", "minLength": 1}
        }
      }
    },
    "implications": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["implication_id", "implication", "evidence_class", "source_urls", "rationale"],
        "properties": {
          "implication_id": {"type": "string", "minLength": 1},
          "implication": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "enum": ["supported_claim", "inference", "no_evidence"]},
          "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^\\s]+$"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "novel_ideas": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["idea_id", "idea", "evidence_class", "source_urls", "rationale"],
        "properties": {
          "idea_id": {"type": "string", "minLength": 1},
          "idea": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "enum": ["supported_claim", "inference", "no_evidence"]},
          "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^\\s]+$"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question_id", "question", "evidence_class", "source_urls"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "enum": ["supported_claim", "inference", "no_evidence"]},
          "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^\\s]+$"}}
        }
      }
    },
    "self_attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["current_web_research_performed", "official_or_primary_sources_first", "direct_urls_only", "source_count_contract_checked", "supported_inference_no_evidence_labels_present", "no_fabricated_claims", "no_long_quotations", "topic_and_refs_binding_verified", "exact_attempt_id_verified", "fresh_direct_terminal_contract_acknowledged", "fresh_current_public_web_research_redone", "canonical_agent_path_is_only_leaf_known_identity", "native_identity_deferred_to_controller_receipt_and_capture", "prior_attempt_result_bodies_and_peer_outputs_not_read", "leaf_local_schema_conformance_check_passed_before_final_write", "exact_schema_key_set_verified", "source_registry_unique_and_complete", "source_registry_completed_before_claim_emission", "activation_core_and_authorization_verified", "blocked_prelaunch_intent_treated_as_lineage_only", "result_required_before_pmr1", "pmr1_not_returned_before_result_write"],
      "properties": {
        "current_web_research_performed": {"type": "boolean", "const": true},
        "official_or_primary_sources_first": {"type": "boolean", "const": true},
        "direct_urls_only": {"type": "boolean", "const": true},
        "source_count_contract_checked": {"type": "boolean", "const": true},
        "supported_inference_no_evidence_labels_present": {"type": "boolean", "const": true},
        "no_fabricated_claims": {"type": "boolean", "const": true},
        "no_long_quotations": {"type": "boolean", "const": true},
        "topic_and_refs_binding_verified": {"type": "boolean", "const": true},
        "exact_attempt_id_verified": {"type": "boolean", "const": true},
        "fresh_direct_terminal_contract_acknowledged": {"type": "boolean", "const": true},
        "fresh_current_public_web_research_redone": {"type": "boolean", "const": true},
        "canonical_agent_path_is_only_leaf_known_identity": {"type": "boolean", "const": true},
        "native_identity_deferred_to_controller_receipt_and_capture": {"type": "boolean", "const": true},
        "prior_attempt_result_bodies_and_peer_outputs_not_read": {"type": "boolean", "const": true},
        "leaf_local_schema_conformance_check_passed_before_final_write": {"type": "boolean", "const": true},
        "exact_schema_key_set_verified": {"type": "boolean", "const": true},
        "source_registry_unique_and_complete": {"type": "boolean", "const": true},
        "source_registry_completed_before_claim_emission": {"type": "boolean", "const": true},
        "activation_core_and_authorization_verified": {"type": "boolean", "const": true},
        "blocked_prelaunch_intent_treated_as_lineage_only": {"type": "boolean", "const": true},
        "result_required_before_pmr1": {"type": "boolean", "const": true},
        "pmr1_not_returned_before_result_write": {"type": "boolean", "const": true}
      }
    }
  }
}
