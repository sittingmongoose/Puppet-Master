{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_count": {
      "const": 2
    },
    "attempt_id": {
      "const": "attempt-0007"
    },
    "controller_thread_id": {
      "type": "string"
    },
    "coverage_credit": {
      "const": 0
    },
    "digest_semantics_version": {
      "const": "raw-file-and-canonical-object-explicit-v7.1"
    },
    "leaves": {
      "items": {
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "merge_credit": {
      "const": 0
    },
    "native_state_file_sha256": {
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_state_path": {
      "type": "string"
    },
    "promotion_credit": {
      "const": 0
    },
    "research_credit": {
      "const": 0
    },
    "schema_version": {
      "const": "external-research-native-capture-v7.1"
    },
    "spec_credit": {
      "const": 0
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "controller_thread_id",
    "assignment_count",
    "native_state_path",
    "native_state_file_sha256",
    "digest_semantics_version",
    "leaves",
    "coverage_credit",
    "research_credit",
    "promotion_credit",
    "spec_credit",
    "merge_credit"
  ],
  "type": "object"
}
