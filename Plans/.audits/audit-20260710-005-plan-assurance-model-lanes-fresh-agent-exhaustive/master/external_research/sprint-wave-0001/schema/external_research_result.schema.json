{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit 005 external research result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "schema_version",
    "phase",
    "assignment_id",
    "attempt_id",
    "task_thread_id",
    "model",
    "reasoning_effort",
    "status",
    "packet_binding",
    "research_scope",
    "sources",
    "findings",
    "competitive_patterns",
    "failure_modes",
    "pm_implications",
    "novel_ideas",
    "unresolved_questions",
    "self_attestation"
  ],
  "properties": {
    "audit_id": {
      "const": "audit-20260710-005-plan-assurance-model-lanes-fresh-agent-exhaustive"
    },
    "schema_version": {
      "const": "external-research-result-v1"
    },
    "phase": {
      "const": "external_research_sprint_wave_0001"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^ER-000[1-8]$"
    },
    "attempt_id": {
      "const": "attempt-0001"
    },
    "task_thread_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "const": "gpt-5.6-luna"
    },
    "reasoning_effort": {
      "const": "max"
    },
    "status": {
      "const": "completed"
    },
    "packet_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_sha256",
        "topic",
        "feature_refs",
        "research_questions",
        "output_directory",
        "result_schema_sha256"
      ],
      "properties": {
        "packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "feature_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "research_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "result_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "research_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_or_primary_sources_first",
        "current_web_research_required",
        "minimum_sources_when_available",
        "maximum_sources",
        "direct_urls_only",
        "search_result_urls_forbidden",
        "access_date_required",
        "long_quotations_forbidden"
      ],
      "properties": {
        "official_or_primary_sources_first": {
          "const": true
        },
        "current_web_research_required": {
          "const": true
        },
        "minimum_sources_when_available": {
          "const": 8
        },
        "maximum_sources": {
          "const": 12
        },
        "direct_urls_only": {
          "const": true
        },
        "search_result_urls_forbidden": {
          "const": true
        },
        "access_date_required": {
          "const": true
        },
        "long_quotations_forbidden": {
          "const": true
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title",
          "publisher",
          "published_date",
          "accessed_date",
          "source_type",
          "material_relevance",
          "claims_supported"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "published_date": {
            "type": "string",
            "minLength": 1
          },
          "accessed_date": {
            "type": "string",
            "pattern": "^2026-07-11$"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official_standard",
              "official_documentation",
              "official_security_guidance",
              "peer_reviewed",
              "mature_open_source",
              "competitor_product_documentation",
              "platform_security_guidance",
              "primary_research"
            ]
          },
          "material_relevance": {
            "type": "string",
            "minLength": 1
          },
          "claims_supported": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "evidence_source_urls",
          "label",
          "confidence",
          "relevance",
          "limitations"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "label": {
            "type": "string",
            "enum": [
              "supported_claim",
              "inference",
              "no_evidence"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "competitive_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_url",
          "pattern",
          "tradeoffs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "tradeoffs": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_mode",
          "trigger",
          "impact",
          "mitigation",
          "evidence_label"
        ],
        "properties": {
          "failure_mode": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pm_implications": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "novel_ideas": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idea",
          "rationale",
          "risks",
          "basis_label"
        ],
        "properties": {
          "idea": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "risks": {
            "type": "string",
            "minLength": 1
          },
          "basis_label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "why_unresolved",
          "required_evidence"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "why_unresolved": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "self_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_direct_child",
        "fork_turns_none",
        "no_descendants",
        "no_followups",
        "no_active_shadow_inputs",
        "no_canonical_plan_writes",
        "direct_urls_only",
        "no_fabricated_claims",
        "long_quotes_avoided",
        "exactly_one_result_written",
        "returned_pmr1"
      ],
      "properties": {
        "fresh_direct_child": {
          "const": true
        },
        "fork_turns_none": {
          "const": true
        },
        "no_descendants": {
          "const": true
        },
        "no_followups": {
          "const": true
        },
        "no_active_shadow_inputs": {
          "const": true
        },
        "no_canonical_plan_writes": {
          "const": true
        },
        "direct_urls_only": {
          "const": true
        },
        "no_fabricated_claims": {
          "const": true
        },
        "long_quotes_avoided": {
          "const": true
        },
        "exactly_one_result_written": {
          "const": true
        },
        "returned_pmr1": {
          "const": true
        }
      }
    }
  }
}

