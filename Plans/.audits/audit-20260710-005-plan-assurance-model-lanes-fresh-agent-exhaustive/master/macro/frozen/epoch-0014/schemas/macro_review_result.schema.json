{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_id": {
      "minLength": 1,
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "audit_id": {
      "const": "audit-20260710-005-plan-assurance-model-lanes-fresh-agent-exhaustive"
    },
    "coverage": {
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "exact_quote": {
                  "minLength": 1,
                  "type": "string"
                },
                "line_end": {
                  "minimum": 1,
                  "type": "integer"
                },
                "line_start": {
                  "minimum": 1,
                  "type": "integer"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "source_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "exact_quote",
                "line_end",
                "line_start",
                "path",
                "source_sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "builder_discretion",
          "confidence",
          "dimensions",
          "evidence",
          "gap_kind",
          "impact",
          "item_id",
          "item_type",
          "severity",
          "source_unit_refs",
          "statement",
          "title"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "model": {
      "const": "gpt-5.6-sol"
    },
    "phase": {
      "const": "blind_macro_window_review"
    },
    "reasoning_effort": {
      "const": "xhigh"
    },
    "schema_version": {
      "const": "macro-review-result-v1"
    },
    "segments": {
      "minItems": 1,
      "type": "array"
    },
    "self_attestation": {
      "type": "object"
    },
    "source_binding": {
      "type": "object"
    },
    "status": {
      "const": "completed"
    },
    "synthesis": {
      "type": "object"
    },
    "task_thread_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "assignment_id",
    "attempt_id",
    "audit_id",
    "coverage",
    "items",
    "model",
    "phase",
    "reasoning_effort",
    "schema_version",
    "segments",
    "self_attestation",
    "source_binding",
    "status",
    "synthesis",
    "task_thread_id"
  ],
  "title": "Audit 005 macro review result v1",
  "type": "object"
}
