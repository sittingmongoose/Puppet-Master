      "additionalProperties": false,
      "properties": {
        "no_canonical_writes": {
          "const": true
        },
        "no_external_research_during_blind_review": {
          "const": true
        },
        "no_peer_result_access": {
          "const": true
        },
        "no_prior_audit_access": {
          "const": true
        },
        "no_unrelated_source_access": {
          "const": true
        },
        "terminal_after_submission": {
          "const": true
        }
      },
      "required": [
        "no_canonical_writes",
        "no_external_research_during_blind_review",
        "no_peer_result_access",
        "no_prior_audit_access",
        "no_unrelated_source_access",
        "terminal_after_submission"
