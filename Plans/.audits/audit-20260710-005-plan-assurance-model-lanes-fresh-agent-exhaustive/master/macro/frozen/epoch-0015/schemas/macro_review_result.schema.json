            "items": {
              "additionalProperties": false,
              "properties": {
                "exact_quote": {
                  "minLength": 1,
                  "type": "string"
                },
                "line_end": {
                  "minimum": 1,
                  "type": "integer"
                },
                "line_start": {
                  "minimum": 1,
                  "type": "integer"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "source_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "exact_quote",
                "line_end",
                "line_start",
                "path",
                "source_sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
