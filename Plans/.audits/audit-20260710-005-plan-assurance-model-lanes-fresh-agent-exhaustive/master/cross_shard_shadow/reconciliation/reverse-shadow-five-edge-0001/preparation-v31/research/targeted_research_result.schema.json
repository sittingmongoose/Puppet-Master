          "question_id": {"type": "string", "pattern": "^RSRQ-[0-9]{5}-[A-Z-]+$"},
          "question": {"type": "string", "minLength": 40},
          "axis_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["authority_owner", "lifecycle_transition", "user_outcome", "state_boundary", "failure_semantics"]}}
