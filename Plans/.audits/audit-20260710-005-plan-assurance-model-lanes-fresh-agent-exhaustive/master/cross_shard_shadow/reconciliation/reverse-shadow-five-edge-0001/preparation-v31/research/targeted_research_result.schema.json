        "normalized_edge_key": {"type": "string", "minLength": 10},
        "endpoint_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "missing_axes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["user_outcome", "failure_semantics"]}}
