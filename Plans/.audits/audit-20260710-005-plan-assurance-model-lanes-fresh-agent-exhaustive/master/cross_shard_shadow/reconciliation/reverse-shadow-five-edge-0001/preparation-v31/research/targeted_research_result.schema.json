    "attempt_id": {"const": "attempt-0001"},
    "agent_path": {"type": "string"},
    "model": {"const": "gpt-5.6-sol"},
    "reasoning_effort": {"const": "ultra"},
    "status": {"enum": ["completed_candidate_only", "blocked_no_authoritative_evidence"]},
    "input_binding": {
