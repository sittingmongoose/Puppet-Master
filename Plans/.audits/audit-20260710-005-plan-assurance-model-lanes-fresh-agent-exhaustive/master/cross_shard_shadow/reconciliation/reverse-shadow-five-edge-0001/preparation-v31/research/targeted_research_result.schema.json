          "unresolved_facts": {"type": "array", "items": {"type": "string", "minLength": 10}},
          "search_trace": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {"type": "string", "minLength": 10},
