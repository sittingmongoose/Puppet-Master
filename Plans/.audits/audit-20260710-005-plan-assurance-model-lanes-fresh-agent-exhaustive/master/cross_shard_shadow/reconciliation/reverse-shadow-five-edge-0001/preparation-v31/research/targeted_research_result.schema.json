    },
    "source_registry": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "pattern": "^RSRSRC-[0-9]{4}$"},
