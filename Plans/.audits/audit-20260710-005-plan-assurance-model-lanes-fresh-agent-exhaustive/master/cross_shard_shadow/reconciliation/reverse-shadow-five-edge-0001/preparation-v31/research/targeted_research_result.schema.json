        "feature_registry_sha256": {"$ref": "#/$defs/sha256"},
        "protected_inputs_sha256": {"$ref": "#/$defs/sha256"},
        "seam_result_sha256": {"$ref": "#/$defs/sha256"},
        "reverse_shadow_result_sha256": {"$ref": "#/$defs/sha256"},
