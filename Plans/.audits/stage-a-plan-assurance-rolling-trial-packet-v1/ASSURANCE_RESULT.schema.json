{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/assurance-result.v1.json",
  "title": "Plan Assurance Family Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trial_id", "family_id", "pilot_mode", "discovery_efficacy_eligible", "scale_inference_eligible", "risk_tier", "input_bindings", "method_slice_status", "plan_slice_status", "worker_receipts", "fresh_challenge_receipt", "obligation_metric_rows", "metrics", "stage_losses", "passes", "controls", "critical_misses", "novelty", "resource_receipts", "family_accounting", "gates", "limitations", "terminal"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "trial_id": {"type": "string", "minLength": 1},
    "family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]},
    "pilot_mode": {"enum": ["novel_method_signal", "revealed_known_answer_realization_calibration_excluded_from_discovery_efficacy"]},
    "discovery_efficacy_eligible": {"type": "boolean"},
    "scale_inference_eligible": {"type": "boolean"},
    "risk_tier": {"enum": ["R1", "R2", "R3"]},
    "input_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural_slice_sha256", "surface_denominator_sha256", "obligation_graph_sha256", "controls_sha256", "control_registry_ref", "control_registry_sha256", "research_portfolio_ref", "research_portfolio_sha256", "research_adequacy_ref", "research_adequacy_sha256", "fresh_challenge_ref", "fresh_challenge_sha256", "artifact_validator_sha256"],
      "properties": {
        "structural_slice_sha256": {"$ref": "#/$defs/sha256"},
        "surface_denominator_sha256": {"$ref": "#/$defs/sha256"},
        "obligation_graph_sha256": {"$ref": "#/$defs/sha256"},
        "controls_sha256": {"$ref": "#/$defs/sha256"},
        "control_registry_ref": {"type": "string", "minLength": 1},
        "control_registry_sha256": {"$ref": "#/$defs/sha256"},
        "research_portfolio_ref": {"type": "string", "minLength": 1},
        "research_portfolio_sha256": {"$ref": "#/$defs/sha256"},
        "research_adequacy_ref": {"type": "string", "minLength": 1},
        "research_adequacy_sha256": {"$ref": "#/$defs/sha256"},
        "fresh_challenge_ref": {"type": "string", "minLength": 1},
        "fresh_challenge_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_validator_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "method_slice_status": {"enum": ["METHOD_SLICE_READY", "METHOD_SLICE_REVISE", "METHOD_SLICE_BLOCKED", "METHOD_SLICE_INVALID"]},
    "plan_slice_status": {"enum": ["PLAN_SLICE_READY_WITHIN_ENVELOPE", "PLAN_SLICE_NOT_READY_GAPS_FOUND", "PLAN_SLICE_LIMITED", "PLAN_SLICE_NOT_EVALUATED"]},
    "worker_receipts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/worker_receipt"}},
    "fresh_challenge_receipt": {"$ref": "#/$defs/challenge_receipt"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounded_semantic_coverage", "evidence_sufficiency", "exact_source_retrieval_diagnostic", "claim_precision", "authority_safety", "named_scenario_realization", "disposition_completeness", "control_summary", "grounded_novelty", "critical_miss_summary", "cost_latency"],
      "properties": {
        "bounded_semantic_coverage": {"$ref": "#/$defs/weighted_metric"},
        "evidence_sufficiency": {"$ref": "#/$defs/weighted_metric"},
        "exact_source_retrieval_diagnostic": {"$ref": "#/$defs/retrieval_metric"},
        "claim_precision": {"$ref": "#/$defs/fraction_metric"},
        "authority_safety": {"$ref": "#/$defs/authority_metric"},
        "named_scenario_realization": {"$ref": "#/$defs/weighted_metric"},
        "disposition_completeness": {"$ref": "#/$defs/fraction_metric"},
        "control_summary": {"$ref": "#/$defs/control_summary"},
        "grounded_novelty": {"$ref": "#/$defs/novelty_metric"},
        "critical_miss_summary": {"$ref": "#/$defs/miss_metric"},
        "cost_latency": {"$ref": "#/$defs/cost_metric"}
      }
    },
    "obligation_metric_rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation_metric_row"}},
    "stage_losses": {"type": "array", "items": {"$ref": "#/$defs/stage_loss"}},
    "passes": {"type": "array", "items": {"$ref": "#/$defs/pass_receipt"}},
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "critical_misses": {"type": "array", "items": {"$ref": "#/$defs/critical_miss"}},
    "novelty": {"type": "array", "items": {"$ref": "#/$defs/novel"}},
    "resource_receipts": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "family_accounting": {"$ref": "#/$defs/family_accounting"},
    "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "terminal": {"enum": ["METHOD_SLICE_READY", "METHOD_SLICE_REVISE", "RESEARCH_LIMITED", "BUDGET_STOP", "METHOD_SLICE_BLOCKED", "METHOD_SLICE_INVALID", "INPUT_DRIFT_STOP", "SAFETY_ABORT"]}
  },
  "allOf": [
    {
      "if": {"properties": {"family_id": {"const": "ACCESSIBILITY_CONTROL_CONTRACTS"}}, "required": ["family_id"]},
      "then": {"properties": {"pilot_mode": {"const": "revealed_known_answer_realization_calibration_excluded_from_discovery_efficacy"}, "discovery_efficacy_eligible": {"const": false}, "scale_inference_eligible": {"const": false}}},
      "else": {"properties": {"pilot_mode": {"const": "novel_method_signal"}, "discovery_efficacy_eligible": {"const": true}, "scale_inference_eligible": {"const": true}}}
    },
    {
      "if": {"properties": {"method_slice_status": {"const": "METHOD_SLICE_READY"}}, "required": ["method_slice_status"]},
      "then": {
        "properties": {
          "terminal": {"const": "METHOD_SLICE_READY"},
          "passes": {"minItems": 2},
          "metrics": {"properties": {
            "authority_safety": {"properties": {"unsafe_promotions": {"const": 0}, "false_critical_blockers": {"const": 0}, "contradicted_mandatory_claims": {"const": 0}}},
            "cost_latency": {"properties": {"all_reported_tokens": {"type": "integer"}, "within_fuse": {"const": true}}}
          }}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "severity": {"enum": ["critical", "major", "moderate", "minor"]},
    "fraction_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "ratio", "zero_denominator_rule", "numerator_ids", "denominator_ids"],
      "properties": {
        "numerator": {"type": "number", "minimum": 0},
        "denominator": {"type": "number", "minimum": 0},
        "ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "zero_denominator_rule": {"enum": ["not_applicable", "invalid_metric", "vacuous_pass_for_empty_required_population"]},
        "numerator_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "denominator_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "weighted_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earned_weight", "possible_weight", "ratio", "weights", "severity_strata", "partial_credit", "exact_source_identity_used", "raw_uncovered_ids"],
      "properties": {
        "earned_weight": {"type": "number", "minimum": 0},
        "possible_weight": {"type": "number", "minimum": 0},
        "ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["critical", "major", "moderate", "minor"],
          "properties": {
            "critical": {"const": 5},
            "major": {"const": 3},
            "moderate": {"const": 2},
            "minor": {"const": 1}
          }
        },
        "severity_strata": {"type": "object"},
        "partial_credit": {"const": 0.5},
        "exact_source_identity_used": {"const": false},
        "raw_uncovered_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "retrieval_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "retrieved", "target", "ratio", "equivalent_claims", "diagnostic_only", "semantic_weight"],
      "properties": {
        "applicable": {"type": "boolean"},
        "retrieved": {"type": ["integer", "null"], "minimum": 0},
        "target": {"type": ["integer", "null"], "minimum": 0},
        "ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "equivalent_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "diagnostic_only": {"const": true},
        "semantic_weight": {"const": 0}
      }
    },
    "authority_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandatory_claims_correctly_authorized", "mandatory_claims", "ratio", "classification_accuracy", "unsafe_promotions", "false_critical_blockers", "contradicted_mandatory_claims"],
      "properties": {
        "mandatory_claims_correctly_authorized": {"type": "integer", "minimum": 0},
        "mandatory_claims": {"type": "integer", "minimum": 0},
        "ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "classification_accuracy": {"$ref": "#/$defs/fraction_metric"},
        "unsafe_promotions": {"type": "integer", "minimum": 0},
        "false_critical_blockers": {"type": "integer", "minimum": 0},
        "contradicted_mandatory_claims": {"type": "integer", "minimum": 0}
      }
    },
    "control_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_pass", "positive_total", "negative_pass", "negative_total", "unanswerable", "overlap_flagged"],
      "properties": {
        "positive_pass": {"type": "integer", "minimum": 0},
        "positive_total": {"type": "integer", "minimum": 0},
        "negative_pass": {"type": "integer", "minimum": 0},
        "negative_total": {"type": "integer", "minimum": 0},
        "unanswerable": {"type": "integer", "minimum": 0},
        "overlap_flagged": {"type": "integer", "minimum": 0}
      }
    },
    "novelty_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "critical_or_major_count", "adopted", "conditional", "rejected", "readiness_bonus"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "critical_or_major_count": {"type": "integer", "minimum": 0},
        "adopted": {"type": "integer", "minimum": 0},
        "conditional": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "readiness_bonus": {"const": 0}
      }
    },
    "miss_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "weight", "ids"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "weight": {"type": "number", "minimum": 0},
        "ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "cost_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_tokens_observable", "all_reported_tokens", "effective_total_source", "input_includes_cached", "searches", "opens", "active_ms", "wall_ms", "dollars", "dollar_null_reason", "within_fuse"],
      "properties": {
        "native_tokens_observable": {"type": "boolean"},
        "all_reported_tokens": {"type": ["integer", "null"], "minimum": 0},
        "effective_total_source": {"enum": ["native", "derived_exact", "unavailable"]},
        "input_includes_cached": {"type": ["boolean", "null"]},
        "searches": {"type": "integer", "minimum": 0},
        "opens": {"type": "integer", "minimum": 0},
        "active_ms": {"type": "integer", "minimum": 0},
        "wall_ms": {"type": "integer", "minimum": 0},
        "dollars": {"type": ["number", "null"], "minimum": 0},
        "dollar_null_reason": {"type": ["string", "null"]},
        "within_fuse": {"type": "boolean"}
      }
    },
    "stage_loss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "severity", "primary_stage", "loss_code", "downstream_stages", "measurement_only"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "severity": {"$ref": "#/$defs/severity"},
        "primary_stage": {"enum": ["structural_mapping", "surface_discovery", "discovery", "failure_evidence_recovery", "adjudication", "named_realization", "consumer_propagation", "validation_controls", "measurement_only"]},
        "loss_code": {"type": "string", "minLength": 1},
        "downstream_stages": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "measurement_only": {"type": "boolean"}
      }
    },
    "pass_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_id", "pass_kind", "opening_weight", "added_critical_or_major_ids", "material_revisions", "closed_weight", "remaining_weight", "adequacy_gap_count", "clean", "clean_streak_after", "all_reported_tokens", "active_ms"],
      "properties": {
        "pass_id": {"type": "string", "minLength": 1},
        "pass_kind": {"enum": ["initial_union", "targeted_closure", "cross_family_seam"]},
        "opening_weight": {"type": "number", "minimum": 0},
        "added_critical_or_major_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "material_revisions": {"type": "integer", "minimum": 0},
        "closed_weight": {"type": "number", "minimum": 0},
        "remaining_weight": {"type": "number", "minimum": 0},
        "adequacy_gap_count": {"type": "integer", "minimum": 0},
        "clean": {"type": "boolean"},
        "clean_streak_after": {"type": "integer", "minimum": 0, "maximum": 2},
        "all_reported_tokens": {"type": ["integer", "null"], "minimum": 0},
        "active_ms": {"type": "integer", "minimum": 0}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "registry_definition_sha256", "control_kind", "answerability", "instance_ids", "unresolved_identity_selectors", "scenario_ids", "obligation_ids", "components", "overlaps_obligation_ids", "terminal"],
      "properties": {
        "control_id": {"type": "string", "minLength": 1},
        "registry_definition_sha256": {"$ref": "#/$defs/sha256"},
        "control_kind": {"enum": ["positive_sentinel", "negative_sentinel", "discovery_generated"]},
        "answerability": {"enum": ["answerable", "unanswerable", "partially_answerable"]},
        "instance_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unresolved_identity_selectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "obligation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "actors_entrypoints", "surface_consumer", "lifecycle", "authority", "failure_recovery", "persistence", "accessibility_user_truth", "wiring", "observability_currentness", "oracle", "discretion"],
          "properties": {
            "identity": {"$ref": "#/$defs/control_component"}, "actors_entrypoints": {"$ref": "#/$defs/control_component"},
            "surface_consumer": {"$ref": "#/$defs/control_component"}, "lifecycle": {"$ref": "#/$defs/control_component"},
            "authority": {"$ref": "#/$defs/control_component"}, "failure_recovery": {"$ref": "#/$defs/control_component"},
            "persistence": {"$ref": "#/$defs/control_component"}, "accessibility_user_truth": {"$ref": "#/$defs/control_component"},
            "wiring": {"$ref": "#/$defs/control_component"}, "observability_currentness": {"$ref": "#/$defs/control_component"},
            "oracle": {"$ref": "#/$defs/control_component"}, "discretion": {"$ref": "#/$defs/control_component"}
          }
        },
        "overlaps_obligation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "terminal": {"enum": ["PASS", "FAIL", "CONTROL_UNANSWERABLE", "BLOCKED", "NOT_APPLICABLE"]}
      }
    },
    "control_component": {
      "type": "object", "additionalProperties": false,
      "required": ["applicability", "status", "evidence_refs", "gap_refs"],
      "properties": {
        "applicability": {"enum": ["applicable", "not_applicable"]},
        "status": {"enum": ["full", "partial", "absent", "not_applicable"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "gap_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "critical_miss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["miss_id", "obligation_id", "primary_loss_stage", "consequence", "status"],
      "properties": {
        "miss_id": {"type": "string", "minLength": 1},
        "obligation_id": {"type": "string", "minLength": 1},
        "primary_loss_stage": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "specified", "excluded", "accepted_residual", "blocked"]}
      }
    },
    "novel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idea_id", "severity", "evidence_ids", "user_value_or_risk_rationale", "disposition"],
      "properties": {
        "idea_id": {"type": "string", "minLength": 1},
        "severity": {"$ref": "#/$defs/severity"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "user_value_or_risk_rationale": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["adopted", "adapted", "conditional", "inspiration_only", "rejected", "unresolved"]}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "context_id", "worker_role", "invocation_id", "activity_kind", "target_family_id", "challenge_id", "activity_binding_sha256", "operation_receipt_ids", "attempt_ordinal", "retry_kind", "prior_attempt_receipt_id", "role_id", "stage_id", "pass_id", "requested_model", "effective_model", "input_tokens", "cached_input_tokens", "input_includes_cached", "visible_output_tokens", "reasoning_output_tokens", "output_includes_reasoning", "native_total_tokens", "derived_total_tokens", "effective_total_tokens", "effective_total_source", "raw_bytes", "searches", "opens", "queue_ms", "active_ms", "wall_ms", "started_at_utc", "finished_at_utc", "retries", "failure_class"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1},
        "worker_role": {"enum": ["LOCAL_EXPECTATION_MODELER", "OPEN_DISCOVERY_RESEARCHER", "FAILURE_EVIDENCE_RESEARCHER"]},
        "invocation_id": {"type": "string", "minLength": 1},
        "activity_kind": {"enum": ["local_expectation", "open_discovery", "failure_recovery", "fresh_challenge", "targeted_closure"]},
        "target_family_id": {"oneOf": [{"type": "null"}, {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}]},
        "challenge_id": {"type": ["string", "null"]},
        "activity_binding_sha256": {"$ref": "#/$defs/sha256"},
        "operation_receipt_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "attempt_ordinal": {"type": "integer", "minimum": 1, "maximum": 2},
        "retry_kind": {"enum": ["none", "infrastructure"]},
        "prior_attempt_receipt_id": {"type": ["string", "null"]},
        "role_id": {"enum": ["LOCAL_EXPECTATION_MODELER", "OPEN_DISCOVERY_RESEARCHER", "FAILURE_EVIDENCE_RESEARCHER", "CROSS_FAMILY_CHALLENGER", "TARGETED_CLOSURE"]},
        "stage_id": {"enum": ["S3_INDEPENDENT_DISCOVERY", "S4_FAILURE_RECOVERY", "S6_CROSS_FAMILY_CHALLENGE", "S7_TARGETED_CLOSURE"]},
        "pass_id": {"type": "string", "minLength": 1},
        "requested_model": {"type": ["string", "null"]},
        "effective_model": {"type": ["string", "null"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_includes_cached": {"type": ["boolean", "null"]},
        "visible_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_includes_reasoning": {"type": ["boolean", "null"]},
        "native_total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "derived_total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "effective_total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "effective_total_source": {"enum": ["native", "derived_exact", "unavailable"]},
        "raw_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "searches": {"type": "integer", "minimum": 0},
        "opens": {"type": "integer", "minimum": 0},
        "queue_ms": {"type": "integer", "minimum": 0},
        "active_ms": {"type": "integer", "minimum": 0},
        "wall_ms": {"type": "integer", "minimum": 0},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "finished_at_utc": {"type": "string", "format": "date-time"},
        "retries": {"type": "integer", "minimum": 0, "maximum": 1},
        "failure_class": {"type": ["string", "null"]}
      }
    },
    "family_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at_utc", "finished_at_utc", "elapsed_ms", "input_tokens", "output_tokens", "all_reported_tokens", "semantic_contexts", "infrastructure_retries", "searches", "opens", "artifact_files", "artifact_bytes", "largest_artifact_bytes", "targeted_followups", "closure_cycles"],
      "properties": {
        "started_at_utc": {"type": "string", "format": "date-time"},
        "finished_at_utc": {"type": "string", "format": "date-time"},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "all_reported_tokens": {"type": "integer", "minimum": 0},
        "semantic_contexts": {"type": "integer", "minimum": 0},
        "infrastructure_retries": {"type": "integer", "minimum": 0, "maximum": 1},
        "searches": {"type": "integer", "minimum": 0},
        "opens": {"type": "integer", "minimum": 0},
        "artifact_files": {"type": "integer", "minimum": 0},
        "artifact_bytes": {"type": "integer", "minimum": 0},
        "largest_artifact_bytes": {"type": "integer", "minimum": 0},
        "targeted_followups": {"type": "integer", "minimum": 0},
        "closure_cycles": {"type": "integer", "minimum": 0}
      }
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "ref", "sha256", "schema_id", "producer_context_id", "family_id", "trial_id", "generation_id", "canonical_bytes"],
      "properties": {
        "artifact_type": {"enum": ["LOCAL_EXPECTATIONS", "LOCAL_EXPECTATIONS_LOCK", "RESEARCH_PORTFOLIO_OPEN", "DISCOVERY_CLAIMS", "DISCOVERY_LOCK", "RESEARCH_ADEQUACY_RECEIPT", "RESEARCH_PORTFOLIO_FAILURE", "ADEQUACY_RECOVERY_RECEIPT"]},
        "ref": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "schema_id": {"type": "string", "minLength": 1},
        "producer_context_id": {"type": "string", "minLength": 1}, "family_id": {"type": "string", "minLength": 1}, "trial_id": {"type": "string", "minLength": 1},
        "generation_id": {"type": "string", "minLength": 1}, "canonical_bytes": {"const": true}
      }
    },
    "worker_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_role", "context_id", "terminal", "artifact_bindings"],
      "properties": {
        "worker_role": {"enum": ["LOCAL_EXPECTATION_MODELER", "OPEN_DISCOVERY_RESEARCHER", "FAILURE_EVIDENCE_RESEARCHER"]},
        "context_id": {"type": "string", "minLength": 1},
        "terminal": {"enum": ["DONE", "STOPPED", "MATERIAL_BLOCKER"]},
        "artifact_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_binding"}}
      }
    },
    "challenge_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_family_id", "challenger_family_id", "challenger_context_id", "target_graph_sha256", "finding_ids", "all_findings_dispositioned", "terminal"],
      "properties": {
        "target_family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]},
        "challenger_family_id": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]},
        "challenger_context_id": {"type": "string", "minLength": 1},
        "target_graph_sha256": {"$ref": "#/$defs/sha256"},
        "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "all_findings_dispositioned": {"type": "boolean"},
        "terminal": {"enum": ["DONE", "STOPPED", "MATERIAL_BLOCKER"]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "scope", "hard", "terminal", "evidence_refs"],
      "properties": {
        "gate_id": {"enum": ["G3_DISCOVERY_AND_ADEQUACY", "G4_GRAPH_INTEGRITY", "G5_REALIZATION_AND_CONTROLS", "G6_FRONTIER_STABILITY", "G7_TRIAL_REPORTING", "P1_PLAN_SEMANTIC_ENVELOPE", "P2_PLAN_NAMED_REALIZATION", "P3_PLAN_DECISION_VISIBILITY"]},
        "scope": {"enum": ["method", "plan_slice", "resource", "integrity"]},
        "hard": {"type": "boolean"},
        "terminal": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "obligation_metric_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "severity", "applicable", "semantic_credit", "evidence_required", "evidence_credit", "requires_named_realization", "realization_credit", "disposition", "is_gap"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^obl-"},
        "severity": {"$ref": "#/$defs/severity"},
        "applicable": {"type": "boolean"},
        "semantic_credit": {"enum": [0, 0.5, 1]},
        "evidence_required": {"type": "boolean"},
        "evidence_credit": {"enum": [0, 0.5, 1]},
        "requires_named_realization": {"type": "boolean"},
        "realization_credit": {"enum": [0, 0.5, 1]},
        "disposition": {"enum": ["open", "specified", "not_applicable", "explicitly_excluded", "residual_risk_accepted", "blocked", "superseded"]},
        "is_gap": {"type": "boolean"}
      }
    }
  }
}
