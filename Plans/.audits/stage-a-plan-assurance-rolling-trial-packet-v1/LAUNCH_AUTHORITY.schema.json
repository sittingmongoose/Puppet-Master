{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/launch-authority.v1.json",
  "title": "Separate Plan Assurance Trial Launch Authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trial_id", "generation_id", "packet_id", "contract_sha256", "artifact_validator_sha256", "launch_request_ref", "launch_request_sha256", "launch_binding_sha256", "authority_mode", "trusted_capability_ref", "trusted_capability_sha256", "trusted_capability_id", "authorization_message_sha256", "observed_sender_task_path", "observed_message_id", "observed_turn_id", "one_use_nonce_sha256", "offline_cryptographic_verification", "single_use_marker_ref", "max_uses", "trial_launch_authorized", "run_root", "external_research_authorized", "model_calls_authorized", "external_transmission_disclosed_and_accepted", "canonical_plan_writes_authorized", "generated_or_governance_writes_authorized", "git_write_authorized", "budget_contract_sha256", "source_snapshot_must_be_fresh", "issued_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "trial_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_validator_sha256": {"$ref": "#/$defs/sha256"},
    "launch_request_ref": {"type": "string", "minLength": 1},
    "launch_request_sha256": {"$ref": "#/$defs/sha256"},
    "launch_binding_sha256": {"$ref": "#/$defs/sha256"},
    "authority_mode": {"const": "codex_live_orchestrator_sender"},
    "trusted_capability_ref": {"type": "string", "minLength": 1},
    "trusted_capability_sha256": {"$ref": "#/$defs/sha256"},
    "trusted_capability_id": {"type": "string", "minLength": 1},
    "authorization_message_sha256": {"$ref": "#/$defs/sha256"},
    "observed_sender_task_path": {"type": "string", "pattern": "^/root(?:/|$)"},
    "observed_message_id": {"type": "string", "minLength": 1},
    "observed_turn_id": {"type": "string", "minLength": 1},
    "one_use_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "offline_cryptographic_verification": {"const": false},
    "single_use_marker_ref": {"type": "string", "minLength": 1},
    "max_uses": {"const": 1},
    "trial_launch_authorized": {"const": true},
    "run_root": {"type": "string", "minLength": 1},
    "external_research_authorized": {"const": true},
    "model_calls_authorized": {"const": true},
    "external_transmission_disclosed_and_accepted": {"const": true},
    "canonical_plan_writes_authorized": {"const": false},
    "generated_or_governance_writes_authorized": {"const": false},
    "git_write_authorized": {"const": false},
    "budget_contract_sha256": {"$ref": "#/$defs/sha256"},
    "source_snapshot_must_be_fresh": {"const": true},
    "issued_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
