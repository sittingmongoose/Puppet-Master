{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/trial-summary.v1.json",
  "title": "Plan Assurance Rolling Trial Campaign Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trial_id", "contract_sha256", "artifact_validator_sha256", "launch_authority_ref", "launch_authority_sha256", "source_snapshot_ref", "source_snapshot_sha256", "family_result_bindings", "controller_resource_receipts", "cross_family_seam_passes", "artifact_manifest", "execution_window", "totals", "protected_invariance", "gates", "calibration_reporting", "terminal"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "trial_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_validator_sha256": {"$ref": "#/$defs/sha256"},
    "launch_authority_ref": {"type": "string", "minLength": 1},
    "launch_authority_sha256": {"$ref": "#/$defs/sha256"},
    "source_snapshot_ref": {"type": "string", "minLength": 1},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "family_result_bindings": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/family_binding"}},
    "controller_resource_receipts": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "cross_family_seam_passes": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/seam_pass"}},
    "artifact_manifest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "execution_window": {"$ref": "#/$defs/window"},
    "totals": {"$ref": "#/$defs/totals"},
    "protected_invariance": {"type": "object", "additionalProperties": false, "required": ["before_ref", "before_sha256", "after_ref", "after_sha256", "pass"], "properties": {"before_ref": {"type": "string", "minLength": 1}, "before_sha256": {"$ref": "#/$defs/sha256"}, "after_ref": {"type": "string", "minLength": 1}, "after_sha256": {"$ref": "#/$defs/sha256"}, "pass": {"type": "boolean"}}},
    "gates": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/gate"}},
    "calibration_reporting": {"type": "object", "additionalProperties": false, "required": ["novel_signal_family_ids", "calibration_only_family_ids", "accessibility_counted_in_discovery_efficacy", "accessibility_counted_in_scale_inference"], "properties": {"novel_signal_family_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "MIGRATIONS_DURABLE_STATE"]}}, "calibration_only_family_ids": {"const": ["ACCESSIBILITY_CONTROL_CONTRACTS"]}, "accessibility_counted_in_discovery_efficacy": {"const": false}, "accessibility_counted_in_scale_inference": {"const": false}}},
    "terminal": {"enum": ["READY_FOR_SCALE_DECISION", "VALID_NEGATIVE_METHOD_REVISE", "RESEARCH_LIMITED", "BUDGET_STOP", "TRIAL_BLOCKED", "TRIAL_INVALID", "INPUT_DRIFT_STOP", "SAFETY_ABORT"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "family": {"enum": ["USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]},
    "family_binding": {"type": "object", "additionalProperties": false, "required": ["family_id", "result_ref", "result_sha256"], "properties": {"family_id": {"$ref": "#/$defs/family"}, "result_ref": {"type": "string", "minLength": 1}, "result_sha256": {"$ref": "#/$defs/sha256"}}},
    "window": {"type": "object", "additionalProperties": false, "required": ["started_at_utc", "finished_at_utc", "elapsed_ms"], "properties": {"started_at_utc": {"type": "string", "format": "date-time"}, "finished_at_utc": {"type": "string", "format": "date-time"}, "elapsed_ms": {"type": "integer", "minimum": 0}}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "context_id", "worker_role", "invocation_id", "activity_kind", "target_family_id", "challenge_id", "role_id", "stage_id", "pass_id", "activity_binding_sha256", "attempt_ordinal", "retry_kind", "prior_attempt_receipt_id", "input_tokens", "visible_output_tokens", "reasoning_output_tokens", "output_includes_reasoning", "native_total_tokens", "effective_total_tokens", "effective_total_source", "searches", "opens", "raw_bytes", "started_at_utc", "finished_at_utc", "failure_class"], "properties": {"receipt_id": {"type": "string", "minLength": 1}, "context_id": {"type": "string", "minLength": 1}, "worker_role": {"const": "TRIAL_CONTROLLER"}, "invocation_id": {"type": "string", "minLength": 1}, "activity_kind": {"const": "cross_family_seam"}, "target_family_id": {"type": "null"}, "challenge_id": {"type": "null"}, "role_id": {"const": "TRIAL_CONTROLLER"}, "stage_id": {"const": "S7_COVERAGE_FEEDBACK"}, "pass_id": {"type": "string", "minLength": 1}, "activity_binding_sha256": {"$ref": "#/$defs/sha256"}, "attempt_ordinal": {"const": 1}, "retry_kind": {"const": "none"}, "prior_attempt_receipt_id": {"type": "null"}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "visible_output_tokens": {"type": ["integer", "null"], "minimum": 0}, "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_includes_reasoning": {"type": ["boolean", "null"]}, "native_total_tokens": {"type": ["integer", "null"], "minimum": 0}, "effective_total_tokens": {"type": ["integer", "null"], "minimum": 0}, "effective_total_source": {"enum": ["native", "derived_exact", "unavailable"]}, "searches": {"type": "integer", "minimum": 0}, "opens": {"type": "integer", "minimum": 0}, "raw_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}, "started_at_utc": {"type": "string", "format": "date-time"}, "finished_at_utc": {"type": "string", "format": "date-time"}, "failure_class": {"type": "null"}}},
    "seam_pass": {"type": "object", "additionalProperties": false, "required": ["pass_id", "resource_receipt_id", "invocation_id", "added_critical_or_major_ids", "material_revisions", "adequacy_gap_count", "clean", "clean_streak_after"], "properties": {"pass_id": {"type": "string", "minLength": 1}, "resource_receipt_id": {"type": "string", "minLength": 1}, "invocation_id": {"type": "string", "minLength": 1}, "added_critical_or_major_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "material_revisions": {"type": "integer", "minimum": 0}, "adequacy_gap_count": {"type": "integer", "minimum": 0}, "clean": {"type": "boolean"}, "clean_streak_after": {"type": "integer", "minimum": 0, "maximum": 2}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "owner_scope", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "owner_scope": {"enum": ["shared", "controller", "USAGE_ACCOUNTING_TRUTH", "WEB_RESEARCH_BEHAVIOR", "ACCESSIBILITY_CONTROL_CONTRACTS", "MIGRATIONS_DURABLE_STATE"]}, "bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "totals": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "all_reported_tokens", "semantic_contexts", "searches", "opens", "artifact_files", "artifact_bytes", "largest_artifact_bytes", "elapsed_ms"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "all_reported_tokens": {"type": "integer", "minimum": 0}, "semantic_contexts": {"type": "integer", "minimum": 0}, "searches": {"type": "integer", "minimum": 0}, "opens": {"type": "integer", "minimum": 0}, "artifact_files": {"type": "integer", "minimum": 0}, "artifact_bytes": {"type": "integer", "minimum": 0}, "largest_artifact_bytes": {"type": "integer", "minimum": 0}, "elapsed_ms": {"type": "integer", "minimum": 0}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["gate_id", "terminal", "evidence_refs"], "properties": {"gate_id": {"enum": ["G0_PROTOCOL_AND_AUTHORITY", "G1_WHOLE_CORPUS_MAP", "G2_NAMED_DENOMINATOR", "G3_DISCOVERY_AND_ADEQUACY", "G4_GRAPH_INTEGRITY", "G5_REALIZATION_AND_CONTROLS", "G6_FRONTIER_STABILITY", "G7_TRIAL_REPORTING"]}, "terminal": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  }
}
