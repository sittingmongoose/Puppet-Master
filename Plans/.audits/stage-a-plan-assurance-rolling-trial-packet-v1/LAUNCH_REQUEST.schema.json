{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppet-master.local/schemas/plan-assurance/launch-request.v1.json",
  "title": "Plan Assurance Trial Launch Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "trial_id", "generation_id", "packet_id", "requesting_task_path", "expected_authority_task_path", "authority_delivery_mode", "request_status", "contract_sha256", "artifact_validator_sha256", "source_snapshot_sha256", "protected_before_receipt_sha256", "protected_before_state_sha256", "run_root", "budget_contract_sha256", "topology_contract_sha256", "external_transmission_manifest_ref", "external_transmission_manifest_sha256", "exact_execution_envelope_sha256", "created_at_utc", "expires_at_utc", "max_uses", "launch_binding_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "packet_id": {"const": "stage-a-plan-assurance-rolling-trial-packet-v1"},
    "requesting_task_path": {"type": "string", "pattern": "^/root(?:/|$)"},
    "expected_authority_task_path": {"type": "string", "pattern": "^/root(?:/|$)"},
    "authority_delivery_mode": {"const": "codex_system_collaboration_envelope"},
    "request_status": {"const": "AWAITING_EXTERNAL_ATTESTATION"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_validator_sha256": {"$ref": "#/$defs/sha256"},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "protected_before_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "protected_before_state_sha256": {"$ref": "#/$defs/sha256"},
    "run_root": {"type": "string", "minLength": 1},
    "budget_contract_sha256": {"$ref": "#/$defs/sha256"},
    "topology_contract_sha256": {"$ref": "#/$defs/sha256"},
    "external_transmission_manifest_ref": {"type": "string", "minLength": 1},
    "external_transmission_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "exact_execution_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "max_uses": {"const": 1},
    "launch_binding_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
