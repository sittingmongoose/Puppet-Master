{
  "protocol_id": "a004.document_window_reviewer_protocol.v1",
  "model": "gpt-5.6-sol",
  "reasoning_effort": "ultra",
  "assignment_limit": 1,
  "read_only": true,
  "blindness": {
    "prior_audits": "forbidden",
    "other_reviewer_results": "forbidden",
    "unrelated_windows": "forbidden",
    "outside_capsule_plan_content": "forbidden"
  },
  "universal_lens": [
    "callers and consumers",
    "states and transitions",
    "authority and ownership",
    "failure, cancellation, timeout, recovery, and replay",
    "security, privacy, permissions, and destructive boundaries",
    "GUI truth and degraded-state disclosure",
    "cross-surface propagation and reconciliation",
    "operations and observability",
    "scale, concurrency, and lifecycle races",
    "compatibility and migration",
    "deterministic executable test oracles"
  ],
  "role_rule": "Apply only the role and role_instructions in the immutable metadata capsule. Never infer or imitate the other role's conclusions.",
  "absence_claim_rule": "For a missing-contract claim, cite the nearest exact in-scope lines that establish the relevant contract surface and explain why the required element is absent from this bounded capsule. Do not infer from outside knowledge.",
  "output_rule": "Return exactly one valid JSON object with no Markdown fence and no surrounding prose.",
  "result_schema": {
    "required_top_level_keys_exactly": [
      "schema_version",
      "assignment_id",
      "runner_id",
      "role",
      "window_id",
      "doc_id",
      "document_path",
      "core_range",
      "context_ranges",
      "source_sha256",
      "source_excerpt_ref",
      "source_excerpt_sha256",
      "capsule_ref",
      "capsule_sha256",
      "capsule_bytes",
      "model",
      "reasoning_effort",
      "prior_substantive_assignment_count",
      "terminal_after_result",
      "no_followup_reuse",
      "hash_validation",
      "observations",
      "candidate_findings",
      "explicit_non_gaps",
      "unknowns",
      "exact_evidence_refs",
      "scope_compliance"
    ],
    "fixed_values": {
      "schema_version": "a004_window_review_result_v1",
      "runner_id": "runner-10",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "ultra",
      "prior_substantive_assignment_count": 0,
      "terminal_after_result": true,
      "no_followup_reuse": true,
      "hash_validation": {
        "capsule": true,
        "source_excerpt": true,
        "sizes": true
      }
    },
    "capsule_echo_fields": [
      "assignment_id",
      "role",
      "window_id",
      "doc_id",
      "document_path",
      "core_range",
      "context_ranges",
      "source_sha256",
      "source_excerpt_ref",
      "source_excerpt_sha256",
      "capsule_ref",
      "capsule_sha256",
      "capsule_bytes"
    ],
    "observation_item_keys_exactly": ["observation_id", "summary", "evidence_ids"],
    "candidate_finding_item_keys_exactly": ["finding_id", "gap_type", "severity", "summary", "why_gap", "evidence_ids"],
    "severity_enum": ["critical", "high", "medium", "low"],
    "explicit_non_gap_item_keys_exactly": ["non_gap_id", "summary", "evidence_ids"],
    "unknown_item_keys_exactly": ["unknown_id", "summary", "why_unresolved_within_capsule", "evidence_ids"],
    "evidence_item_keys_exactly": ["evidence_id", "path", "line_start", "line_end", "quote"],
    "scope_compliance_keys_exactly": ["allowed_files_read", "other_files_read", "prior_audits_read", "other_results_read", "unrelated_windows_read", "role_leakage"]
  },
  "evidence_rules": [
    "Every populated observation, finding, explicit non-gap, and unknown has one or more evidence_ids.",
    "Every evidence_id resolves to exactly one exact_evidence_refs item.",
    "Evidence path equals the capsule document_path.",
    "Evidence line ranges fall wholly inside the capsule core or context ranges.",
    "Evidence quote is the exact full source text for line_start through line_end, preserving Markdown, punctuation, case, and embedded newlines.",
    "Arrays may be empty only when warranted; exact_evidence_refs must not be empty."
  ],
  "scope_compliance_fixed_values": {
    "other_files_read": [],
    "prior_audits_read": false,
    "other_results_read": false,
    "unrelated_windows_read": false,
    "role_leakage": false
  },
  "terminal_rule": "This is the agent's only substantive assignment. After returning the JSON, the agent is terminal and performs no further work."
}
