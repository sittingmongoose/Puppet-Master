        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "error_code": {
                "$ref": "#/$defs/assistant_chat_command_error_code"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
