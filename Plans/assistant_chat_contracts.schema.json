          "if": {
            "properties": {
              "outcome": {
                "const": "named"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "title"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "route_unavailable"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
