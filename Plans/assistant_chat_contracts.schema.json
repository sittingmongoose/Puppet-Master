          "$ref": "#/$defs/non_empty_string"
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "error_code": {
          "oneOf": [
            {
              "$ref": "#/$defs/assistant_chat_command_error_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "projection_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
