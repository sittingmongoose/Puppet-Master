{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppetmaster.local/schemas/assistant_chat_contracts/1.0.0/schema.json",
  "title": "Assistant chat command contracts",
  "$comment": "Owner contract schema named by Plans/Commands_System.md (Puppet Master Assistant Redesign Central Registration Addendum - 2026-09-03, \"Naming them here does not create them\"; CS-078, and CS-087 for the closure wave) for Plans/assistant-chat-design.md. Written 2026-09-27 as the companion of the wand-modules compile (ledgers pldg-20260927-005 and pldg-20260927-006; DL-126): the request/result pairs of every command whose contracts the central table points at this file, cmd.chat.goal.open_editor (GoalEditorRoute -> RouteResult), cmd.chat.composer.destination.set and cmd.chat.composer.destination.clear (ACD-462), cmd.chat.thread.regenerate_title (ACD-462, ACD-479), cmd.chat.eli5.set (ELI5ThreadOverrideRequest with the value on, off or inherit; UCC-175, ACD-484) and cmd.chat.eli5.explain_reply (ELI5ExplainReplyRequest/Result; UCC-174, CS-087, ACD-484). Where canon states only a command's meaning the shape is the minimal command envelope plus the target identity. ComposerDestination and ThreadTitleAttempt restate the fields Plans/Collaborative_Workflows.md section 4.5 and ACD-479 give them and are not new records: the record families pm.chat.composer_destination.v1 and pm.chat.thread_title_generation.v1 stay requires_central_adjudication. A definition here is a contract shape, not a handler, a catalogue registration or an admission: every command stays handler_unavailable, and cmd.chat.eli5.explain_reply stays a DL-035 candidate exclusion (WM-064). Requests and results are not records and add no storage key, EventRecord, writer, Settings key or physical family. DL-138 companion (2026-09-29): ThreadCrewAutoOverride is only the optional field projection of ACD-076 existing thread metadata; it adds no record envelope, durable family, storage key, writer or Settings value. Reopen persistence remains the existing owner's runtime obligation.",
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "non_secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:)(?!sk-[A-Za-z0-9_-]{8,}$)(?!.*(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer))[A-Za-z][A-Za-z0-9._:/#-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "assistant_chat_command_error_code": {
      "description": "The shared typed owner error kinds of the Puppet Master Assistant Redesign Central Registration Addendum (Plans/Commands_System.md, 'Typed error vocabulary', CS-078). A failure stays a failure and never returns a success-shaped result.",
      "enum": [
        "invalid_request",
        "owner_unavailable",
        "command_not_registered",
        "permission_denied",
        "stale_revision",
        "stale_currentness",
        "target_not_found",
        "precondition_failed",
        "idempotency_conflict",
        "quota_exhausted",
        "manual_stop_latched",
        "cancelled"
      ]
    },
    "GoalEditorRoute": {
      "description": "GoalEditorRoute for cmd.chat.goal.open_editor, a navigation_wrapper (UI_Command_Catalog.md, Assistant chat composer, title and ELI5 rows; Commands_System.md central contract records). It navigates to Goal Activity Detail in edit mode from the Goal hover menu for the thread's present Goal; it is a route, not a Goal mutation (a Goal revision is cmd.chat.goal.update, owned by Plans/Goal_Runtime_System.md). The catalog states the command's meaning only, so the shape is the minimal envelope plus the thread and Goal identity. Contract shape only: handler_unavailable until admission.",
      "type": "object",
      "additionalProperties": false,
      "x-primary-identity-fields": [
        "command_instance_id"
      ],
      "required": [
        "schema_id",
        "schema_version",
        "request_type",
        "command_id",
        "command_instance_id",
        "project_id",
        "actor_ref",
        "permission_snapshot_ref",
        "idempotency_key",
        "source_surface",
        "return_route",
        "thread_id",
        "goal_id"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.chat.goal_editor_route.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "request_type": {
          "const": "GoalEditorRoute"
        },
        "command_id": {
          "const": "cmd.chat.goal.open_editor"
        },
        "command_instance_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "project_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "actor_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "permission_snapshot_ref": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "idempotency_key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_surface": {
          "const": "goal_hover"
        },
        "return_route": {
          "$ref": "#/$defs/non_secret_ref"
        },
        "thread_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "goal_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "RouteResult": {
      "description": "RouteResult for cmd.chat.goal.open_editor. Accepted means the route to Goal Activity Detail in edit mode was opened; route success changes no Goal state. Rejected carries a typed error and opens nothing.",
      "type": "object",
      "additionalProperties": false,
      "x-primary-identity-fields": [
        "command_instance_id"
      ],
      "required": [
        "schema_id",
        "schema_version",
        "result_type",
        "command_id",
        "command_instance_id",
        "outcome",
        "error_code",
        "projection_ref",
        "route_target",
        "edit_mode",
        "goal_id"
      ],
      "properties": {
        "schema_id": {
          "const": "pm.chat.route_result.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "result_type": {
          "const": "RouteResult"
        },
        "command_id": {
          "const": "cmd.chat.goal.open_editor"
        },
