                "$ref": "#/$defs/ComposerDestination"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "destination": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
