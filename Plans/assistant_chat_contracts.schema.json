        },
        "goal_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "error_code": {
                "$ref": "#/$defs/assistant_chat_command_error_code"
              }
            }
          }
        }
      ]
    },
    "composer_destination_kind": {
      "description": "ComposerDestination.destination_kind, closed by Plans/Collaborative_Workflows.md section 4.5 (Composer destination targeting), which owns the collaborative values.",
      "enum": [
        "assistant",
        "crew",
        "brainstorm",
        "review",
        "chat_room",
        "plan_revision"
      ]
    },
    "ComposerDestination": {
      "description": "The composer destination persisted with the composer buffer (record family pm.chat.composer_destination.v1, payload-semantics owner Plans/assistant-chat-design.md; fields as Plans/Collaborative_Workflows.md section 4.5 states them: destination_kind, destination_id, optional participant_id, display_label, state_generation). The stored label alone is never sufficient: dispatch revalidates the target and state_generation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_kind",
        "destination_id",
        "display_label",
        "state_generation"
      ],
      "properties": {
        "destination_kind": {
          "$ref": "#/$defs/composer_destination_kind"
        },
        "destination_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "participant_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "display_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "state_generation": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "composer_destination_side_effects": {
      "description": "What a destination change never does (ACD-462; Collaborative_Workflows.md section 4.5): it never creates or starts the workflow it names, never sends unsent composer input, and never clears composer text or attachments. Every member is false on every path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_started",
        "unsent_input_sent",
        "composer_buffer_cleared"
      ],
      "properties": {
        "workflow_started": {
          "const": false
        },
        "unsent_input_sent": {
          "const": false
        },
        "composer_buffer_cleared": {
          "const": false
        }
      }
    },
    "ComposerDestinationSetRequest": {
      "description": "ComposerDestinationSetRequest for cmd.chat.composer.destination.set (ACD-462; UCC-156 row). Binds the exact originating thread and an existing workflow, participant or Plan-revision target, which the composer chrome then names. The target is revalidated at dispatch, so changing the active tab never redirects a pending request. Contract shape only: handler_unavailable until admission.",
