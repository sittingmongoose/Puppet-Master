            "auth",
            "provider_dispatch"
          ]
        },
        "owner": {
          "$ref": "https://puppetmaster.local/proposals/goal_certified_original_sources.v1.schema.json#/$defs/OwnerBinding"
        },
        "complete_original_request": {
          "$ref": "https://puppetmaster.local/proposals/goal_certified_original_sources.v1.schema.json#/$defs/OriginalStructuredValue"
        },
        "complete_original_input_sources": {
          "type": "array",
          "items": {
            "$ref": "https://puppetmaster.local/proposals/goal_certified_original_sources.v1.schema.json#/$defs/OriginalValue"
          },
          "minItems": 1
        },
        "complete_original_output": {
          "$ref": "https://puppetmaster.local/proposals/goal_certified_original_sources.v1.schema.json#/$defs/OriginalStructuredValue"
