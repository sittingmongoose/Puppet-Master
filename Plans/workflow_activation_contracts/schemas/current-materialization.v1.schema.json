        "origin": {
          "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/OwnerIssueOriginPhysical"
        }
      }
    },
    "ProvisioningReceiptOriginalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "origin"
      ],
      "properties": {
        "source": {
          "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/ProvisioningReceiptPhysical"
        },
        "origin": {
          "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/OwnerIssueOriginPhysical"
        }
      }
    },
    "ActivationDecisionSourceOriginalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "origin"
      ],
      "properties": {
        "source": {
          "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/ActivationDecisionSourcePhysical"
        },
        "origin": {
          "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/OwnerIssueOriginPhysical"
        }
      }
    },
    "CompletionRequirementSourceOriginalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "origin"
      ],
      "properties": {
        "source": {
          "allOf": [
            {
              "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/CompletionRequirementSourcePhysical"
            },
            {
              "properties": {
                "record": {
                  "$ref": "https://puppetmaster.local/proposals/activation_seven_operational_custody.v2.schema.json#/$defs/CurrentCompletionRequirementSource"
                }
              }
            }
          ]
        },
        "origin": {
          "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/OwnerIssueOriginPhysical"
        }
      }
    },
    "NativeRequestSourceOriginalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "origin"
      ],
      "properties": {
        "source": {
          "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/NativeRequestSourcePhysical"
        },
        "origin": {
          "$ref": "https://puppetmaster.local/proposals/workflow_activation_sources.v4.schema.json#/$defs/OwnerIssueOriginPhysical"
        }
      }
    },
    "OriginalActivationSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_compile",
        "certified_graph",
        "native_intake",
        "provisioning",
        "activation_decision",
        "completion_requirements",
        "source_request"
      ],
      "properties": {
        "native_compile": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/NativeCompileSourceOriginalValue"
        },
        "certified_graph": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/CertifiedGraphSourceOriginalValue"
        },
        "native_intake": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/NativeIntakeSourceOriginalValue"
        },
        "provisioning": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/ProvisioningReceiptOriginalValue"
        },
        "activation_decision": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/ActivationDecisionSourceOriginalValue"
        },
        "completion_requirements": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/CompletionRequirementSourceOriginalValue"
        },
        "source_request": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/NativeRequestSourceOriginalValue"
        }
      }
    },
    "CurrentMaterializeArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_candidates",
        "original_activation_sources",
        "seven_durable_original_inputs"
      ],
      "properties": {
        "native_candidates": {
          "allOf": [
            {
              "$ref": "https://puppetmaster.local/proposals/native_worknode_current_activation.v1.schema.json#/$defs/MaterializeCurrentCandidates"
            },
            {
              "properties": {
                "inputs": {
                  "properties": {
                    "original_required_set": {
                      "$ref": "https://puppetmaster.local/proposals/activation_seven_operational_custody.v2.schema.json#/$defs/CurrentRequiredSet"
                    }
                  }
                }
              }
            }
          ]
        },
        "original_activation_sources": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/OriginalActivationSources"
        },
        "seven_durable_original_inputs": {
          "$ref": "https://puppetmaster.local/proposals/current_activation_materialization_join.v1.schema.json#/$defs/SevenDurableOriginalInputs"
        }
      }
    }
  }
}
