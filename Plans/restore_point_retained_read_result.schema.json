{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reader_binding",
    "kind",
    "project_id",
    "restore_point_id",
    "record_ref",
    "original_record_hash",
    "terminal_event_id",
    "current_hold_refs",
    "read_token",
    "read_through",
    "action_authority",
    "durable_effects",
    "family"
  ],
  "properties": {
    "reader_binding": {
      "const": "reader.storage.restore_point_retained_custody@1.0.0"
    },
    "kind": {
      "const": "retained_native_terminal"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "restore_point_id": {
      "type": "string",
      "minLength": 1
    },
    "record_ref": {
      "type": "string",
      "minLength": 1
    },
    "original_record_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "terminal_event_id": {
      "type": "string",
      "minLength": 1
    },
    "current_hold_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "read_token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_instance_id",
        "checkpoint_key",
        "checkpoint_ref",
        "generation_id",
        "generation_anchor_sha256",
        "frontier_revision",
        "frontier_sha256",
        "index_dataset_name",
        "source_selection",
        "redb_snapshot_id"
      ],
      "properties": {
        "storage_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint_key": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "type": "string",
          "pattern": "^eig_[0-9a-f]{64}$"
        },
        "generation_anchor_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frontier_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "frontier_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index_dataset_name": {
          "type": "string",
          "minLength": 1
        },
        "source_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storage_instance_id",
            "current_ref",
            "current_bytes_sha256",
            "selected_segment_generation",
            "manifest_ref",
            "manifest_bytes_sha256",
            "manifest_generation",
            "recovery_epoch",
            "manifest_survivor_prefix_sha256",
            "retained_inventory_sha256",
            "durable_watermarks_sha256",
            "excluded_ranges_sha256",
            "retired_inputs_sha256"
          ],
          "properties": {
            "storage_instance_id": {
              "type": "string",
              "format": "uuid"
            },
            "current_ref": {
              "const": "storage/seglog/CURRENT"
            },
            "current_bytes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selected_segment_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "manifest_ref": {
              "const": "storage/seglog/manifest.v1.msgpack"
            },
            "manifest_bytes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifest_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "recovery_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "manifest_survivor_prefix_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retained_inventory_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "durable_watermarks_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "excluded_ranges_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "retired_inputs_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "redb_snapshot_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "read_through": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_generation",
        "recovery_epoch",
        "segment_generation",
        "segment_name",
        "byte_offset",
        "last_sequence_id",
        "last_event_id",
        "survivor_prefix_sha256"
      ],
      "properties": {
        "manifest_generation": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "segment_generation": {
          "type": "integer",
          "minimum": 0
        },
        "segment_name": {
          "type": "string",
          "minLength": 1
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "last_sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "last_event_id": {
          "type": "string",
          "minLength": 1
        },
        "survivor_prefix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "action_authority": {
      "const": "none"
    },
    "durable_effects": {
      "type": "array",
      "maxItems": 0
    },
    "family": {
      "enum": [
        "expired",
        "deleted"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.restore_point.retained_read_result.v1"
}
