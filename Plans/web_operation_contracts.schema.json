{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm.web_operation_contracts.schema.v1",
  "title": "Puppet Master Web Operation And Browser Contracts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "pm.web_operation_contracts.schema.v1"
    }
  },
  "$defs": {
    "InvocationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "invocation_source": {
                "enum": ["agent_initiated", "goal", "prd", "planning_wizard", "subagent"]
              }
            },
            "required": ["invocation_source"]
          },
          "then": {
            "required": ["agent_reason"]
          }
        }
      ],
      "required": ["invocation_source"],
      "properties": {
        "invocation_source": {
          "type": "string",
          "enum": ["slash", "palette", "nl_user", "agent_initiated", "goal", "prd", "planning_wizard", "subagent"]
        },
        "agent_reason": {"type": "string", "minLength": 1},
        "source_user_message_id": {"type": "string"},
        "source_goal_id": {"type": "string"},
        "source_subagent_id": {"type": "string"},
        "source_prd_id": {"type": "string"},
        "source_planning_run_id": {"type": "string"}
      }
    },
    "WebOperation": {
      "type": "string",
      "enum": ["search", "read", "extract", "research", "deep_research", "crawl", "map"]
    },
    "WebToolId": {
      "type": "string",
      "enum": ["websearch", "webfetch", "webextract", "webresearch", "webcrawl", "webmap"]
    },
    "CachePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_age_seconds": {"type": "integer", "minimum": 0},
        "store": {"type": "boolean"},
        "cache_key_ref": {"type": "string"},
        "redaction_profile_id": {"type": "string"}
      }
    },
    "CacheRecord": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"cache_state": {"const": "stored"}}},
          "then": {
            "required": ["ttl_seconds", "no_secret_verified", "redaction_profile_id"],
            "properties": {
              "no_secret_verified": {"const": true}
            }
          }
        }
      ],
      "required": ["cache_state"],
      "properties": {
        "cache_state": {"type": "string", "enum": ["hit", "miss", "bypassed", "stored", "not_stored"]},
        "cache_ref": {"type": "string"},
        "content_hash": {"type": "string"},
        "ttl_seconds": {"type": "integer", "minimum": 0},
        "no_secret_verified": {"type": "boolean"},
        "redaction_profile_id": {"type": "string"}
      }
    },
    "WebOperationJob": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["completed", "failed", "cancelled", "timeout"]}
            },
            "required": ["status"]
          },
          "then": {"required": ["finished_at_utc"]}
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["failed", "timeout"]}
            },
            "required": ["status"]
          },
          "then": {"required": ["failure_reason_code"]}
        }
      ],
      "required": ["job_id", "web_operation", "tool_id", "invocation", "status", "created_at_utc", "not_runtime_queue"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "web_operation": {"$ref": "#/$defs/WebOperation"},
        "tool_id": {"$ref": "#/$defs/WebToolId"},
        "invocation": {"$ref": "#/$defs/InvocationProvenance"},
        "provider_job_id": {"type": "string"},
        "provider_adapter_id": {"type": "string"},
        "status": {"type": "string", "enum": ["queued", "polling", "running", "partial", "completed", "failed", "cancelled", "timeout", "denied"]},
        "status_source": {"type": "string", "enum": ["pm_composed", "provider_poll", "provider_webhook", "browser_runtime"]},
        "poll_ref": {"type": "string"},
        "progress_ref": {"type": "string"},
        "partial_result_ref": {"type": "string"},
        "result_ref": {"type": "string"},
        "permission_snapshot_id": {"type": "string"},
        "cache_ref": {"type": "string"},
        "redaction_profile_id": {"type": "string"},
        "timeout_ms": {"type": "integer", "minimum": 0},
        "created_at_utc": {"type": "string", "minLength": 1},
        "updated_at_utc": {"type": "string"},
        "finished_at_utc": {"type": "string"},
        "failure_reason_code": {"type": "string"},
        "cancelled": {"type": "boolean"},
        "not_runtime_queue": {"type": "boolean", "const": true}
      }
    },
    "CitationRecord": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"evidence_kind": {"const": "extract"}}},
          "then": {"required": ["extract_receipt_ref"]}
        },
        {
          "if": {"properties": {"evidence_kind": {"enum": ["read", "browser_snapshot", "browser_screenshot", "provider_native_read"]}}},
          "then": {"required": ["read_receipt_ref"]}
        }
      ],
      "required": ["citation_id", "url", "source_ref", "evidence_kind", "snippet_only"],
      "properties": {
        "citation_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "source_ref": {"type": "string", "minLength": 1},
        "read_receipt_ref": {"type": "string"},
        "extract_receipt_ref": {"type": "string"},
        "evidence_kind": {"type": "string", "enum": ["read", "extract", "browser_snapshot", "browser_screenshot", "provider_native_read"]},
        "quoted_span_ref": {"type": "string"},
        "snippet_only": {"type": "boolean", "const": false}
      }
    },
    "ResearchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url", "selection_reason", "read_state"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "selection_reason": {"type": "string", "minLength": 1},
        "read_state": {"type": "string", "enum": ["selected", "read", "extracted", "skipped", "failed", "denied"]},
        "read_receipt_ref": {"type": "string"},
        "extract_receipt_ref": {"type": "string"},
        "browser_artifact_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "ReadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "url", "web_operation", "tool_id", "content_ref", "read_at_utc"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "web_operation": {"const": "read"},
        "tool_id": {"const": "webfetch"},
        "content_ref": {"type": "string", "minLength": 1},
        "page_representation_ref": {"type": "string"},
        "browser_session_id": {"type": "string"},
        "read_at_utc": {"type": "string", "minLength": 1},
        "redaction_profile_id": {"type": "string"},
        "content_hash": {"type": "string"}
      }
    },
    "WebEgressPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "ssrf_private_host_policy", "robots_policy", "redirect_policy"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "ssrf_private_host_policy": {
          "type": "string",
          "enum": ["deny_private_hosts", "allow_with_explicit_approval", "allow_for_configured_provider_endpoint"]
        },
        "robots_policy": {"type": "string", "enum": ["respect", "explicit_override_required", "not_applicable"]},
        "redirect_policy": {"type": "string", "enum": ["same_origin", "public_http_only", "deny_redirects", "explicit_approval_required"]},
        "dns_rebind_check": {"type": "boolean"},
        "blocked_host_reason_code": {"type": "string"},
        "fanout_limit": {"type": "integer", "minimum": 0},
        "max_depth": {"type": "integer", "minimum": 0},
        "secret_redaction_required": {"type": "boolean"}
      }
    },
    "WebActionInput": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["web_operation", "tool_id", "query"],
          "properties": {
            "web_operation": {"const": "search"},
            "tool_id": {"const": "websearch"},
            "query": {"type": "string", "minLength": 1},
            "max_results": {"type": "integer", "minimum": 1},
            "adapter_hint": {"type": "string"},
            "sources": {"type": "array", "items": {"type": "string"}},
            "categories": {"type": "array", "items": {"type": "string"}},
            "include_domains": {"type": "array", "items": {"type": "string"}},
            "exclude_domains": {"type": "array", "items": {"type": "string"}},
            "time_range": {"type": "string"},
            "cache_policy": {"$ref": "#/$defs/CachePolicy"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["web_operation", "tool_id", "url"],
          "properties": {
            "web_operation": {"const": "read"},
            "tool_id": {"const": "webfetch"},
            "url": {"type": "string", "minLength": 1},
            "adapter_hint": {"type": "string"},
            "formats": {"type": "array", "items": {"type": "string"}},
            "pdf_mode": {"type": "string", "enum": ["fast", "auto", "ocr"]},
            "cache_policy": {"$ref": "#/$defs/CachePolicy"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["web_operation", "tool_id", "url"],
          "properties": {
            "web_operation": {"const": "extract"},
            "tool_id": {"const": "webextract"},
            "url": {"type": "string", "minLength": 1},
            "adapter_hint": {"type": "string"},
            "detail_hint": {"type": "string", "enum": ["fast", "balanced", "deep"]},
            "schema_ref": {"type": "string"},
            "prompt": {"type": "string"},
            "schema_mode": {"type": "string", "enum": ["strict", "lenient"]},
            "actions": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/BrowserActionInput"}},
            "actions_total_timeout_ms": {"type": "integer", "minimum": 0, "maximum": 30000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["web_operation", "tool_id", "task"],
          "properties": {
            "web_operation": {"const": "research"},
            "tool_id": {"const": "webresearch"},
            "task": {"type": "string", "minLength": 1},
            "adapter_hint": {"type": "string"},
            "research_mode": {"type": "string", "enum": ["standard"]},
            "depth_hint": {"type": "string", "enum": ["fast", "balanced", "deep"]},
            "max_sources": {"type": "integer", "minimum": 1},
            "auto_read_cap": {"type": "integer", "minimum": 0},
            "autonomous": {"type": "boolean"},
            "starting_urls": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
            "schema_ref": {"type": "string"},
            "schema_mode": {"type": "string", "enum": ["strict", "lenient"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["web_operation", "tool_id", "task"],
          "properties": {
            "web_operation": {"const": "deep_research"},
            "tool_id": {"const": "webresearch"},
            "task": {"type": "string", "minLength": 1},
            "adapter_hint": {"type": "string"},
            "research_mode": {"const": "deep"},
            "depth_hint": {"type": "string", "enum": ["balanced", "deep"]},
            "max_sources": {"type": "integer", "minimum": 1},
            "auto_read_cap": {"type": "integer", "minimum": 0},
            "autonomous": {"type": "boolean"},
            "starting_urls": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
            "schema_ref": {"type": "string"},
            "schema_mode": {"type": "string", "enum": ["strict", "lenient"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["web_operation", "tool_id", "root_url"],
          "properties": {
            "web_operation": {"const": "crawl"},
            "tool_id": {"const": "webcrawl"},
            "root_url": {"type": "string", "minLength": 1},
            "adapter_hint": {"type": "string"},
            "max_pages": {"type": "integer", "minimum": 1},
            "max_depth": {"type": "integer", "minimum": 0},
            "same_origin_only": {"type": "boolean"},
            "include_paths": {"type": "array", "items": {"type": "string"}},
            "exclude_paths": {"type": "array", "items": {"type": "string"}},
            "respect_robots": {"type": "boolean"},
            "dedup": {"type": "boolean"},
            "search": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["web_operation", "tool_id", "root_url"],
          "properties": {
            "web_operation": {"const": "map"},
            "tool_id": {"const": "webmap"},
            "root_url": {"type": "string", "minLength": 1},
            "adapter_hint": {"type": "string"},
            "max_pages": {"type": "integer", "minimum": 1},
            "max_depth": {"type": "integer", "minimum": 0},
            "same_origin_only": {"type": "boolean"},
            "include_paths": {"type": "array", "items": {"type": "string"}},
            "exclude_paths": {"type": "array", "items": {"type": "string"}},
            "search": {"type": "string"}
          }
        }
      ]
    },
    "WebActionResult": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"web_operation": {"const": "search"}}},
          "then": {"properties": {"tool_id": {"const": "websearch"}, "operation_input": {"properties": {"web_operation": {"const": "search"}, "tool_id": {"const": "websearch"}}}}}
        },
        {
          "if": {"properties": {"web_operation": {"const": "read"}}},
          "then": {"properties": {"tool_id": {"const": "webfetch"}, "operation_input": {"properties": {"web_operation": {"const": "read"}, "tool_id": {"const": "webfetch"}}}}}
        },
        {
          "if": {"properties": {"web_operation": {"const": "extract"}}},
          "then": {"properties": {"tool_id": {"const": "webextract"}, "operation_input": {"properties": {"web_operation": {"const": "extract"}, "tool_id": {"const": "webextract"}}}}}
        },
        {
          "if": {"properties": {"web_operation": {"const": "research"}}},
          "then": {"properties": {"tool_id": {"const": "webresearch"}, "operation_input": {"properties": {"web_operation": {"const": "research"}, "tool_id": {"const": "webresearch"}}}}}
        },
        {
          "if": {"properties": {"web_operation": {"const": "deep_research"}}},
          "then": {"properties": {"tool_id": {"const": "webresearch"}, "operation_input": {"properties": {"web_operation": {"const": "deep_research"}, "tool_id": {"const": "webresearch"}}}}}
        },
        {
          "if": {"properties": {"web_operation": {"const": "crawl"}}},
          "then": {"properties": {"tool_id": {"const": "webcrawl"}, "operation_input": {"properties": {"web_operation": {"const": "crawl"}, "tool_id": {"const": "webcrawl"}}}}}
        },
        {
          "if": {"properties": {"web_operation": {"const": "map"}}},
          "then": {"properties": {"tool_id": {"const": "webmap"}, "operation_input": {"properties": {"web_operation": {"const": "map"}, "tool_id": {"const": "webmap"}}}}}
        }
      ],
      "required": ["web_operation", "tool_id", "invocation", "operation_input", "success", "provider_fallback_occurred"],
      "properties": {
        "web_operation": {"$ref": "#/$defs/WebOperation"},
        "tool_id": {"$ref": "#/$defs/WebToolId"},
        "invocation": {"$ref": "#/$defs/InvocationProvenance"},
        "operation_input": {"$ref": "#/$defs/WebActionInput"},
        "success": {"type": "boolean"},
        "support_tier": {"$ref": "#/$defs/ProviderSupportTier"},
        "execution_path": {"type": "string"},
        "requested_adapter_id": {"type": "string"},
        "effective_adapter_id": {"type": "string"},
        "adapter_selection_reason": {"type": "string"},
        "provider_fallback_occurred": {"type": "boolean"},
        "provider_fallback_summary": {"type": "string"},
        "source_count": {"type": "integer", "minimum": 0},
        "sources_ref": {"type": "string"},
        "content_ref": {"type": "string"},
        "map_ref": {"type": "string"},
        "answer_summary_ref": {"type": "string"},
        "read_receipts": {"type": "array", "items": {"$ref": "#/$defs/ReadReceipt"}},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/CitationRecord"}},
        "cache": {"$ref": "#/$defs/CacheRecord"},
        "permission": {"$ref": "#/$defs/WebPermissionDecision"},
        "job_ref": {"type": "string"},
        "job": {"$ref": "#/$defs/WebOperationJob"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "error_code": {"type": "string"},
        "error_message": {"type": "string"}
      }
    },
    "WebPermissionDecision": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "deny"}}},
          "then": {"required": ["denial_reason_code"]}
        }
      ],
      "required": ["permission_snapshot_id", "decision", "invocation"],
      "properties": {
        "permission_snapshot_id": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "enum": ["allow", "ask", "deny"]},
        "invocation": {"$ref": "#/$defs/InvocationProvenance"},
        "invocation_ref": {"type": "string"},
        "tool_use_id": {"type": "string"},
        "approval_scope_key": {"type": "string"},
        "denial_reason_code": {"type": "string"},
        "allowed_action_ids": {"type": "array", "items": {"type": "string"}},
        "headless_denied": {"type": "boolean"}
      }
    },
    "ProviderCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "support_tier", "enabled_state", "health_state"],
      "properties": {
        "operation": {"$ref": "#/$defs/WebOperation"},
        "support_tier": {"$ref": "#/$defs/ProviderSupportTier"},
        "enabled_state": {"type": "string", "enum": ["enabled", "disabled", "configured", "unconfigured", "unavailable"]},
        "health_state": {"type": "string", "enum": ["healthy", "degraded", "unavailable", "unknown"]},
        "cost_policy_ref": {"type": "string"},
        "cache_policy": {"$ref": "#/$defs/CachePolicy"},
        "fallback_rank": {"type": "integer", "minimum": 0},
        "robots_supported": {"type": "boolean"},
        "ssrf_private_host_policy_ref": {"type": "string"}
      }
    },
    "ProviderSupportTier": {
      "type": "string",
      "enum": ["native", "model_native", "native_ish", "near_native", "pm_composed", "partial", "fallback_only", "unsupported", "unavailable"]
    },
    "WebProviderAdapterRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "adapter_id", "provider_id", "adapter_kind", "capabilities", "capability_source_refs", "capability_claim_state", "projection_state", "secrets_policy", "last_health_check_ref"],
      "properties": {
        "registry_id": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string"},
        "adapter_kind": {
          "type": "string",
          "enum": ["pm_native", "direct_api", "mcp_server", "model_native", "cli_bridge", "server_bridge"]
        },
        "account_ref": {"type": "string"},
        "credential_ref": {"type": "string"},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/ProviderCapability"}},
        "capability_source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "capability_claim_state": {
          "type": "string",
          "enum": ["source_packet_seed_pending_live_health", "live_health_checked", "disabled_by_policy", "unsupported_by_provider"]
        },
        "projection_state": {"type": "string", "enum": ["not_projected", "projected", "stale", "failed", "external_not_managed"]},
        "mcp_projection_ref": {"type": "string"},
        "egress_policy": {"$ref": "#/$defs/WebEgressPolicy"},
        "capability_egress_policy_map": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "secrets_policy": {"type": "string", "enum": ["secret_refs_only", "no_secrets_required", "external_managed"]},
        "last_health_check_ref": {"type": "string"}
      }
    },
    "McpProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_id", "mcp_server_id", "target_runtime", "projection_state", "no_secret_serialization"],
      "properties": {
        "projection_id": {"type": "string", "minLength": 1},
        "mcp_server_id": {"type": "string", "minLength": 1},
        "target_runtime": {"type": "string", "minLength": 1},
        "projection_state": {"type": "string", "enum": ["generated", "not_required", "stale", "failed", "external_not_managed"]},
        "provider_config_ref": {"type": "string"},
        "capability_refs": {"type": "array", "items": {"type": "string"}},
        "no_secret_serialization": {"type": "boolean", "const": true},
        "health_ref": {"type": "string"}
      }
    },
    "ProviderProjectionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "target_runtime",
        "target_config_path",
        "target_surface",
        "projection_state",
        "provider_ids",
        "capability_refs",
        "no_secret_serialization",
        "credential_binding",
        "health_refs",
        "egress_policy_refs",
        "projected_config"
      ],
      "properties": {
        "projection_id": {"type": "string", "minLength": 1},
        "target_runtime": {"type": "string", "minLength": 1},
        "target_config_path": {"type": "string", "minLength": 1},
        "target_surface": {"type": "string", "enum": ["mcp_config", "codex_config", "model_native", "server_bridge"]},
        "config_key_path": {"type": "string"},
        "projection_state": {"type": "string", "enum": ["generated_fixture", "not_required", "stale", "failed", "external_not_managed"]},
        "provider_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "capability_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "no_secret_serialization": {"type": "boolean", "const": true},
        "credential_binding": {"type": "string", "enum": ["secret_refs_only", "no_secrets_required", "external_managed"]},
        "credential_refs": {"type": "array", "items": {"type": "string"}},
        "health_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "egress_policy_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "projected_config": {"type": "object", "minProperties": 1}
      }
    },
    "ResearchSynthesisStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "step_kind", "input_source_refs", "output_ref", "created_at_utc"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "step_kind": {"type": "string", "enum": ["source_selection", "read", "extract", "subquestion", "compare", "synthesize", "closure_check"]},
        "input_source_refs": {"type": "array", "items": {"type": "string"}},
        "read_receipt_refs": {"type": "array", "items": {"type": "string"}},
        "citation_refs": {"type": "array", "items": {"type": "string"}},
        "output_ref": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "minLength": 1}
      }
    },
    "ResearchSubagentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subagent_record_id", "assignment", "status", "created_at_utc"],
      "properties": {
        "subagent_record_id": {"type": "string", "minLength": 1},
        "source_subagent_id": {"type": "string"},
        "assignment": {"type": "string", "minLength": 1},
        "source_scope_refs": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["assigned", "running", "completed", "failed", "cancelled"]},
        "result_ref": {"type": "string"},
        "failure_reason_code": {"type": "string"},
        "created_at_utc": {"type": "string", "minLength": 1},
        "finished_at_utc": {"type": "string"}
      }
    },
    "ResearchRun": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "invocation": {
                "properties": {
                  "invocation_source": {
                    "enum": ["prd", "planning_wizard"]
                  }
                },
                "required": ["invocation_source"]
              }
            },
            "required": ["invocation"]
          },
          "then": {
            "anyOf": [
              {"required": ["ledger_source_evidence_ref"]},
              {"required": ["plan_source_evidence_ref"]}
            ]
          }
        }
      ],
      "required": ["research_run_id", "mode", "task", "invocation", "sources", "read_receipts", "citations", "closure_state"],
      "properties": {
        "research_run_id": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["standard", "deep"]},
        "task": {"type": "string", "minLength": 1},
        "invocation": {"$ref": "#/$defs/InvocationProvenance"},
        "provider_mode": {"type": "string", "enum": ["pm_composed", "provider_autonomous"]},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ResearchSource"}},
        "read_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ReadReceipt"}},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/CitationRecord"}},
        "synthesis_steps": {"type": "array", "items": {"$ref": "#/$defs/ResearchSynthesisStep"}},
        "subagent_records": {"type": "array", "items": {"$ref": "#/$defs/ResearchSubagentRecord"}},
        "subagent_refs": {"type": "array", "items": {"type": "string"}},
        "subquestion_refs": {"type": "array", "items": {"type": "string"}},
        "coverage_report_ref": {"type": "string"},
        "closure_state": {"type": "string", "enum": ["sufficient", "partial", "failed", "denied", "cancelled"]},
        "failure_reason_code": {"type": "string"},
        "ledger_source_evidence_ref": {"type": "string"},
        "plan_source_evidence_ref": {"type": "string"}
      }
    },
    "DeepResearchRun": {
      "allOf": [
        {"$ref": "#/$defs/ResearchRun"},
        {
          "type": "object",
          "properties": {
            "mode": {"const": "deep"}
          }
        }
      ]
    },
    "PageRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"prompt_injection_detected": {"const": true}},
            "required": ["prompt_injection_detected"]
          },
          "then": {"required": ["prompt_injection_chips", "visible_card_ref"]}
        }
      ],
      "required": ["page_representation_id", "url", "detail_level", "observed_at_utc"],
      "properties": {
        "page_representation_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "detail_level": {"type": "string", "enum": ["minimal", "standard", "full"]},
        "observe_ref": {"type": "string"},
        "find_results_ref": {"type": "string"},
        "detail_ref": {"type": "string"},
        "accessibility_tree_ref": {"type": "string"},
        "layout_bounds_ref": {"type": "string"},
        "form_refs": {"type": "array", "items": {"type": "string"}},
        "iframe_refs": {"type": "array", "items": {"type": "string"}},
        "console_ref": {"type": "string"},
        "network_ref": {"type": "string"},
        "screenshot_artifact_ref": {"type": "string"},
        "pdf_artifact_ref": {"type": "string"},
        "prompt_injection_detected": {"type": "boolean"},
        "prompt_injection_chips": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "visible_card_ref": {"type": "string"},
        "observed_at_utc": {"type": "string", "minLength": 1},
        "redaction_profile_id": {"type": "string"}
      }
    },
    "BrowserSession": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "runtime_unavailable"}},
            "required": ["state"]
          },
          "then": {"required": ["runtime_state_ref"]}
        },
        {
          "if": {
            "properties": {"open_watch_state": {"const": "fallback_open_external"}},
            "required": ["open_watch_state"]
          },
          "then": {"required": ["fallback_route_ref"]}
        }
      ],
      "required": ["browser_session_id", "session_class", "state", "show_when_possible", "open_watch_state", "created_at_utc", "redaction_profile_id"],
      "properties": {
        "browser_session_id": {"type": "string", "minLength": 1},
        "session_class": {"type": "string", "enum": ["site_reader", "research_session", "testing", "user_visible_browser"]},
        "state": {"type": "string", "enum": ["active", "collapsed", "detached", "background", "closed", "runtime_unavailable"]},
        "show_when_possible": {"type": "boolean"},
        "open_watch_state": {"type": "string", "enum": ["open_available", "watch_available", "fallback_open_external", "background_only", "unavailable"]},
        "fallback_route_ref": {"type": "string"},
        "runtime_state_ref": {"type": "string"},
        "active_url": {"type": "string"},
        "page_representation_ref": {"type": "string"},
        "created_at_utc": {"type": "string", "minLength": 1},
        "closed_at_utc": {"type": "string"},
        "redaction_profile_id": {"type": "string"}
      }
    },
    "BrowserRuntimeState": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime_state": {"const": "runtime_unavailable"}
            },
            "required": ["runtime_state"]
          },
          "then": {
            "required": ["disabled_reason_code", "remediation_action_ids"]
          }
        }
      ],
      "required": ["runtime_state", "requested_runtime", "effective_runtime"],
      "properties": {
        "runtime_state": {"type": "string", "enum": ["available", "degraded", "runtime_unavailable", "disabled_by_policy"]},
        "requested_runtime": {"type": "string", "minLength": 1},
        "effective_runtime": {"type": "string", "minLength": 1},
        "capability_snapshot_ref": {"type": "string"},
        "disabled_reason_code": {"type": "string"},
        "remediation_action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "playwright_cdp_role": {"type": "string", "enum": ["not_used", "reference_only", "fallback_only"]}
      }
    },
    "BrowserActionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type"],
      "properties": {
        "action_type": {
          "type": "string",
          "enum": ["navigate", "back", "reload", "refresh", "observe", "find", "detail", "snapshot", "screenshot", "pdf", "console", "network", "open_tab", "select_tab", "close_tab", "click", "scroll", "type", "fill_form", "select_option", "hover", "drag", "press_key", "upload_file", "handle_dialog", "wait_for", "verify_text", "verify_element", "verify_value", "set_viewport"]
        },
        "input_action_label": {
          "type": "string",
          "enum": ["navigate", "back", "reload", "refresh", "observe", "find", "detail", "snapshot", "screenshot", "PDF", "pdf", "console", "network", "open_tab", "select_tab", "close_tab", "click", "scroll", "type", "fill form", "fill_form", "select option", "select_option", "hover", "drag", "press key", "press_key", "file upload", "upload_file", "dialog handle", "handle_dialog", "wait", "wait_for", "verify visible text", "verify text", "verify_text", "verify element", "verify_element", "verify value", "verify_value", "set_viewport"]
        },
        "url": {"type": "string"},
        "tab_id": {"type": "string"},
        "selector": {"type": "string"},
        "locator_ref": {"type": "string"},
        "query": {"type": "string"},
        "value": {"type": "string"},
        "values": {"type": "array", "items": {"type": "string"}},
        "form_values": {"type": "object", "additionalProperties": {"type": "string"}},
        "option_value": {"type": "string"},
        "file_refs": {"type": "array", "items": {"type": "string"}},
        "dialog_action": {"type": "string", "enum": ["accept", "dismiss"]},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "timeout_ms": {"type": "integer", "minimum": 0},
        "verification_expected": {"type": "string"},
        "verification_ref": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "BrowserActionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser_session_id", "action", "invocation", "success", "created_at_utc", "redaction_status"],
      "properties": {
        "browser_session_id": {"type": "string", "minLength": 1},
        "action": {"$ref": "#/$defs/BrowserActionInput"},
        "invocation": {"$ref": "#/$defs/InvocationProvenance"},
        "success": {"type": "boolean"},
        "page_representation": {"$ref": "#/$defs/PageRepresentation"},
        "screenshot_artifact_ref": {"type": "string"},
        "pdf_artifact_ref": {"type": "string"},
        "console_ref": {"type": "string"},
        "network_ref": {"type": "string"},
        "redaction_status": {"type": "string", "enum": ["not_needed", "applied", "blocked", "failed"]},
        "omitted_count": {"type": "integer", "minimum": 0},
        "warning_codes": {"type": "array", "items": {"type": "string"}},
        "error_code": {"type": "string"},
        "created_at_utc": {"type": "string", "minLength": 1}
      }
    },
    "BrowserRecordingArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "invocation", "actions", "runtime_state", "artifact_refs", "redaction_profile_id"],
      "properties": {
        "session": {"$ref": "#/$defs/BrowserSession"},
        "invocation": {"$ref": "#/$defs/InvocationProvenance"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/BrowserActionResult"}},
        "runtime_state": {"$ref": "#/$defs/BrowserRuntimeState"},
        "artifact_refs": {"type": "array", "items": {"type": "string"}},
        "redaction_profile_id": {"type": "string"}
      }
    },
    "ResearchProgressCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_use_id", "operation", "phase", "cancelled", "created_at_utc"],
      "properties": {
        "tool_use_id": {"type": "string", "minLength": 1},
        "operation": {"$ref": "#/$defs/WebOperation"},
        "phase": {"type": "string", "enum": ["queued", "searching", "reading", "extracting", "crawling", "mapping", "synthesizing", "completed", "denied", "failed", "cancelled"]},
        "detail": {"type": "string"},
        "pages_completed": {"type": "integer", "minimum": 0},
        "pages_total": {"type": "integer", "minimum": 0},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "estimated_remaining_ms": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "boolean"},
        "partial_result_ref": {"type": "string"},
        "created_at_utc": {"type": "string", "minLength": 1}
      }
    },
    "WebDeniedOperationCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denial_reason_code", "denial_source", "allowed_action_ids"],
      "properties": {
        "denial_reason_code": {"type": "string", "minLength": 1},
        "denial_source": {"type": "string", "enum": ["policy", "permission", "mode", "user", "provider", "runtime"]},
        "suggested_recovery_action": {"type": "string"},
        "allowed_action_ids": {"type": "array", "items": {"type": "string"}},
        "headless_denied": {"type": "boolean"}
      }
    },
    "WebBatchOperationCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "operation", "total", "completed", "failed", "continue_on_error"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "operation": {"$ref": "#/$defs/WebOperation"},
        "total": {"type": "integer", "minimum": 1},
        "completed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "continue_on_error": {"type": "boolean"},
        "shared_host_permission_ref": {"type": "string"},
        "timeout_policy_ref": {"type": "string"}
      }
    },
    "WebOperationCard": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"card_kind": {"const": "denied"}}},
          "then": {"required": ["denial"]}
        },
        {
          "if": {"properties": {"card_kind": {"enum": ["progress", "partial"]}}},
          "then": {"required": ["progress"]}
        },
        {
          "if": {"properties": {"card_kind": {"const": "fallback"}}},
          "then": {"required": ["provider_fallback_summary"]}
        },
        {
          "if": {"properties": {"card_kind": {"const": "batch"}}},
          "then": {"required": ["batch"]}
        },
        {
          "if": {"properties": {"card_kind": {"const": "settings_health"}}},
          "then": {"required": ["settings_health_ref", "credential_status_ref"]}
        },
        {
          "if": {"properties": {"command_id": {"const": "cmd.chat.web.search"}}},
          "then": {"properties": {"web_operation": {"const": "search"}, "tool_id": {"const": "websearch"}}}
        },
        {
          "if": {"properties": {"command_id": {"const": "cmd.chat.web.fetch"}}},
          "then": {"properties": {"web_operation": {"const": "read"}, "tool_id": {"const": "webfetch"}}}
        },
        {
          "if": {"properties": {"command_id": {"const": "cmd.chat.web.extract"}}},
          "then": {"properties": {"web_operation": {"const": "extract"}, "tool_id": {"const": "webextract"}}}
        },
        {
          "if": {"properties": {"command_id": {"const": "cmd.chat.web.research"}}},
          "then": {"properties": {"web_operation": {"enum": ["research", "deep_research"]}, "tool_id": {"const": "webresearch"}}}
        },
        {
          "if": {"properties": {"command_id": {"const": "cmd.chat.web.crawl"}}},
          "then": {"properties": {"web_operation": {"const": "crawl"}, "tool_id": {"const": "webcrawl"}}}
        },
        {
          "if": {"properties": {"command_id": {"const": "cmd.chat.web.map"}}},
          "then": {"properties": {"web_operation": {"const": "map"}, "tool_id": {"const": "webmap"}}}
        }
      ],
      "required": ["card_id", "card_kind", "command_id", "web_operation", "tool_id", "invocation", "card_state", "operation_input_ref", "operation_input_preview", "created_at_utc"],
      "properties": {
        "card_id": {"type": "string", "minLength": 1},
        "card_kind": {"type": "string", "enum": ["operation", "progress", "denied", "partial", "fallback", "refs", "settings_health", "approval", "session", "batch"]},
        "command_id": {"type": "string", "enum": ["cmd.chat.web.search", "cmd.chat.web.fetch", "cmd.chat.web.extract", "cmd.chat.web.research", "cmd.chat.web.crawl", "cmd.chat.web.map"]},
        "web_operation": {"$ref": "#/$defs/WebOperation"},
        "tool_id": {"$ref": "#/$defs/WebToolId"},
        "invocation": {"$ref": "#/$defs/InvocationProvenance"},
        "card_state": {"type": "string", "enum": ["pending", "running", "completed", "denied", "partial", "failed", "blocked", "unavailable", "background", "cancelled"]},
        "operation_input_ref": {"type": "string", "minLength": 1},
        "operation_input_preview": {"type": "string", "minLength": 1},
        "collapsed_label": {"type": "string"},
        "progress": {"$ref": "#/$defs/ResearchProgressCard"},
        "denial": {"$ref": "#/$defs/WebDeniedOperationCard"},
        "batch": {"$ref": "#/$defs/WebBatchOperationCard"},
        "provider_fallback_summary": {"type": "string"},
        "requested_adapter_id": {"type": "string"},
        "effective_adapter_id": {"type": "string"},
        "source_count": {"type": "integer", "minimum": 0},
        "sources_ref": {"type": "string"},
        "content_ref": {"type": "string"},
        "citation_refs": {"type": "array", "items": {"type": "string"}},
        "settings_health_ref": {"type": "string"},
        "cost_policy_ref": {"type": "string"},
        "credential_status_ref": {"type": "string"},
        "approval_ref": {"type": "string"},
        "browser_session_id": {"type": "string"},
        "created_at_utc": {"type": "string", "minLength": 1}
      }
    },
    "TestingBrowserManifest": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "visibility_state": {"const": "runtime_unavailable"}
            },
            "required": ["visibility_state"]
          },
          "then": {
            "required": ["disabled_reason_code", "remediation_action_ids"]
          }
        },
        {
          "if": {
            "properties": {
              "open_watch_state": {"const": "fallback_open_external"}
            },
            "required": ["open_watch_state"]
          },
          "then": {
            "required": ["fallback_route_ref"]
          }
        }
      ],
      "required": ["browser_session_id", "visibility_state", "open_watch_state", "evidence_refs", "redaction_manifest_ref"],
      "properties": {
        "browser_session_id": {"type": "string", "minLength": 1},
        "visibility_state": {"type": "string", "enum": ["show_when_possible", "visible", "collapsed", "detached", "background", "runtime_unavailable"]},
        "open_watch_state": {"type": "string", "enum": ["open_available", "watch_available", "fallback_open_external", "background_only", "unavailable"]},
        "stream_refs": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fallback_route_ref": {"type": "string"},
        "disabled_reason_code": {"type": "string"},
        "remediation_action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "redaction_manifest_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
